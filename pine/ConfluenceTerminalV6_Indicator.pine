//@version=6
indicator("CONFLUENCE TERMINAL V6 | NASDAQ FUTURES", shorttitle = "CT V6 | NQ", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// =====================================================================================
// CONFLUENCE TERMINAL V6 | NASDAQ FUTURES (NQ / MNQ)
// Execution: 1M / 5M  ·  Setup: 15M  ·  Direction: 1H  ·  Macro: 4H
// All higher-timeframe values use the PREVIOUS COMPLETED HTF bar (expr[1] + lookahead_on).
// All entries/events are evaluated on CONFIRMED chart bars only.
// =====================================================================================

// ───────────────────────────── §0 CONSTANTS ─────────────────────────────
string TZ     = "America/New_York"
color  C_BULL = #26A69A
color  C_BEAR = #EF5350
color  C_NEU  = #8A8F98
color  C_GOLD = #F6C343
color  C_TXT  = #D1D4DC
color  C_HEAD = #2A2E39
color  C_BG   = #131722
color  C_BSL  = #4FC3F7
color  C_SSL  = #FF8A65

// ───────────────────────────── §1 INPUTS ─────────────────────────────
string G1 = "01 · Instrument & Risk"
int    iContracts  = input.int(1, "Contracts", minval = 1, maxval = 50, group = G1)
float  iMaxRiskUsd = input.float(1200.0, "Max $ risk per trade (all contracts)", minval = 1.0, group = G1)
bool   iRejectUsd  = input.bool(true, "Reject trades above max $ risk", group = G1)
bool   iUseAcct    = input.bool(false, "Size suggestion also uses account %", group = G1)
float  iAcct       = input.float(50000.0, "Account size ($)", minval = 0.0, group = G1)
float  iAcctPct    = input.float(1.0, "Account risk %", minval = 0.05, maxval = 10.0, step = 0.05, group = G1)

string G2 = "02 · Context & Structure"
int    iHtfLen     = input.int(3, "HTF swing length (4H / 1H / 15M)", minval = 2, maxval = 10, group = G2)
int    iEmaLen     = input.int(20, "Trend EMA length", minval = 5, maxval = 200, group = G2)
int    iIntLen     = input.int(2, "Internal swing length (chart)", minval = 1, maxval = 6, group = G2)
int    iExtLen     = input.int(5, "External swing length (chart)", minval = 3, maxval = 20, group = G2)
float  iDispBody   = input.float(0.6, "Displacement · min body (× ATR)", minval = 0.2, maxval = 3.0, step = 0.05, group = G2)
float  iDispRatio  = input.float(0.55, "Displacement · min body / range", minval = 0.3, maxval = 0.95, step = 0.05, group = G2)
bool   iExtReqDisp = input.bool(false, "External BOS requires displacement close", group = G2)
bool   iAnalysisSignals = input.bool(false, "Allow entries on 15M / 1H charts", group = G2)

string G3 = "03 · Sessions & ORB (New York time)"
bool   iUseAM    = input.bool(true, "NY AM", inline = "am", group = G3)
string iSessAM   = input.session("0930-1200", "", inline = "am", group = G3)
bool   iUsePM    = input.bool(true, "NY PM", inline = "pm", group = G3)
string iSessPM   = input.session("1330-1600", "", inline = "pm", group = G3)
bool   iUseLon   = input.bool(false, "London", inline = "ln", group = G3)
string iSessLon  = input.session("0300-0600", "", inline = "ln", group = G3)
bool   iUseAsia  = input.bool(false, "Asia", inline = "as", group = G3)
string iSessAsia = input.session("2000-2359", "", inline = "as", group = G3)
int    iOrbMin   = input.int(15, "Opening range (minutes)", options = [5, 15, 30], group = G3)
bool   iSessionOnly = input.bool(true, "Entries only inside enabled sessions", group = G3)

string G4 = "04 · Entry Models"
string iMode     = input.string("Both", "Trade mode", options = ["Both", "Continuation only", "Confirmed reversals only"], group = G4)
bool   iLongs    = input.bool(true, "Longs", inline = "dir", group = G4)
bool   iShorts   = input.bool(true, "Shorts", inline = "dir", group = G4)
bool   iUsePB    = input.bool(true, "Trend pullback (FVG / OB / level / HTF FVG)", group = G4)
bool   iUseEmaPB = input.bool(true, "Include EMA pullbacks (weakest location)", group = G4)
string iTrig     = input.string("MSS or displacement", "Continuation trigger", options = ["MSS only", "MSS or displacement", "Any confirmed rejection"], group = G4)
