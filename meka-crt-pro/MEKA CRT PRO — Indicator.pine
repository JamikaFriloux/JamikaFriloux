//@version=6
// #HEADER_BEGIN
indicator("MEKA CRT PRO", shorttitle = "MEKA CRT PRO", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 300)
// #HEADER_END
// ═══════════════════════════════════════════════════════════════════════════════
//  MEKA CRT PRO — Candle Range Theory trading assistant (Pine Script v6)
//  Private build. Optimised for a 5-minute chart; 4H / 1H / 15M are pulled in
//  automatically with non-repainting request.security() calls.
//
//  EXACT RULES (full write-up: docs/CRT_RULES.md)
//  R1  Reference candle  = last COMPLETED candle of the 4H and of the 1H TF.
//      Valid only if  minRangeATR·ATR14(refTF) ≤ high-low ≤ maxRangeATR·ATR14(refTF).
//      A failed candle keeps the previous valid range for `rangeMaxAge` more
//      candles, then the range expires. Levels only change on a new VALID candle.
//  R2  CRT HIGH / LOW = reference high / low. CRT 50% = (high+low)/2.
//  R3  Breach  = a closed chart bar trades ≥ `sweepTicks` beyond a level.
//      Sweep   = after a breach, a chart bar CLOSES back inside the level within
//                `reclaimBars` bars (the breach bar itself counts).
//      Breakout= `acceptBars` consecutive closes beyond, or the window expires.
//      Unconfirmed = breached, neither of the above yet. One event per level.
//  R4  Setup   = a qualifying sweep (CRT level, or a CRT-aligned liquidity pool)
//                → direction is AWAY from the swept side.
//  R5  15M     = a 15M candle that CLOSED after the breach began breaks the last
//                confirmed 15M swing in the setup direction (MSS/CHoCH), and/or
//                prints a displacement candle (selectable).
//  R6  5M      = a completed chart candle after 15M confirmation: structure break
//                and/or retest of the 15M break level (selectable).
//  R7  Filters = entry window, anti-chase max stop distance, discount/premium,
//                4H bias, minimum R:R to TP2. Signal at bar close; simulated fill
//                at the NEXT bar's open.
//  R8  Exits   = stop below/above sweep extreme + buffer; TP1 = CRT 50% (or
//                internal liquidity / R); TP2 = opposite CRT boundary (or
//                external liquidity / R). Stop is assumed first when a bar
//                touches both stop and target.
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────── INPUTS ─────────────────────────────
string G_DSP = "① Display"
string dispMode    = input.string("Clean", "Chart mode", options = ["Clean", "Detailed"], group = G_DSP)
string primaryTF   = input.string("Setup TF (1H)", "Clean-mode range", options = ["Setup TF (1H)", "Higher TF (4H)"], group = G_DSP)
bool   show4H      = input.bool(true, "Detailed: show higher-TF (4H) range", group = G_DSP)
bool   show1H      = input.bool(true, "Detailed: show setup-TF (1H) range", group = G_DSP)
bool   showHist    = input.bool(true, "Detailed: keep previous CRT ranges", group = G_DSP)
int    histCount   = input.int(3, "Previous ranges kept (per TF)", minval = 1, maxval = 10, group = G_DSP)
bool   showPD      = input.bool(false, "Premium / discount shading", group = G_DSP)
bool   showPools   = input.bool(true, "Detailed: show BSL / SSL liquidity levels", group = G_DSP)
bool   showMSS     = input.bool(true, "Detailed: show 15M MSS / CHoCH", group = G_DSP)
int    keepTrades  = input.int(4, "Trades kept on chart", minval = 1, maxval = 30, group = G_DSP)
bool   showDash    = input.bool(true, "Show dashboard", group = G_DSP)
string dashPosIn   = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DSP)
string dashSizeIn  = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_DSP)
bool   showSim     = input.bool(false, "Dashboard: simulated trade tally (R)", group = G_DSP, tooltip = "Counts only trades the indicator simulated on this chart. Not a backtest — use the companion strategy for measured results.")

string G_CRT = "② CRT reference candles"
string tfHigh      = input.timeframe("240", "Higher CRT timeframe (context)", group = G_CRT)
string tfLow       = input.timeframe("60", "Setup CRT timeframe", group = G_CRT)
string tfConf      = input.timeframe("15", "Confirmation timeframe", group = G_CRT)
float  minRangeATR = input.float(0.35, "Min reference range (× ref-TF ATR14)", minval = 0.0, step = 0.05, group = G_CRT)
float  maxRangeATR = input.float(3.0, "Max reference range (× ref-TF ATR14)", minval = 0.5, step = 0.1, group = G_CRT)
int    rangeMaxAge = input.int(2, "Keep last valid range through N failed candles", minval = 0, maxval = 10, group = G_CRT)
string setupSrc    = input.string("1H + 4H CRT", "Setups may originate from", options = ["1H + 4H CRT", "Setup TF (1H) only", "Higher TF (4H) only"], group = G_CRT)
bool   usePools    = input.bool(true, "Also accept CRT-aligned liquidity-pool sweeps", group = G_CRT, tooltip = "A swept SSL pool qualifies for a LONG only if it sits in the discount half (≤ 50%) of the active CRT range; a BSL pool qualifies for a SHORT only in the premium half. Targets still come from that CRT range.")

string G_SWP = "③ Sweep / reclaim rules"
int    sweepTicks  = input.int(1, "Min penetration beyond level (ticks)", minval = 1, group = G_SWP)
int    reclaimBars = input.int(6, "Reclaim window (chart bars, incl. breach bar)", minval = 1, maxval = 50, group = G_SWP)
int    acceptBars  = input.int(3, "Breakout = N consecutive closes beyond", minval = 1, maxval = 20, group = G_SWP)
float  maxSweepATR = input.float(3.0, "Max sweep depth for a setup (× chart ATR14)", minval = 0.1, step = 0.1, group = G_SWP)

string G_CNF = "④ 15M confirmation"
string confMode    = input.string("MSS or Displacement", "Confirmation required", options = ["MSS / CHoCH", "MSS or Displacement", "MSS + Displacement"], group = G_CNF)
bool   reqChoch    = input.bool(false, "Require CHoCH (break against prior 15M structure)", group = G_CNF)
int    pivL15      = input.int(3, "15M swing: left bars", minval = 1, maxval = 20, group = G_CNF)
int    pivR15      = input.int(2, "15M swing: right bars (confirmation delay)", minval = 1, maxval = 20, group = G_CNF)
float  dispMult    = input.float(0.8, "Displacement: body ≥ × 15M ATR14", minval = 0.1, step = 0.1, group = G_CNF)
int    confExpiry  = input.int(48, "15M confirmation must arrive within (chart bars)", minval = 3, maxval = 500, group = G_CNF)

string G_ENT = "⑤ 5M entry"
string trigMode    = input.string("Break or Retest", "Entry trigger", options = ["Break or Retest", "5M structure break", "Retest of 15M break", "Momentum candle"], group = G_ENT)
int    pivL5       = input.int(3, "Entry-TF swing: left bars", minval = 1, maxval = 20, group = G_ENT)
int    pivR5       = input.int(2, "Entry-TF swing: right bars", minval = 1, maxval = 20, group = G_ENT)
