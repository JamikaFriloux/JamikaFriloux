//@version=6
// #HEADER_BEGIN
indicator("MEKA CRT PRO", shorttitle = "MEKA CRT", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 300)
// #HEADER_END
// ═══════════════════════════════════════════════════════════════════════════════
//  MEKA CRT PRO — Candle Range Theory trading assistant (Pine Script v6)
//  Private build. Optimised for a 5-minute chart; 4H / 1H / 15M are pulled in
//  automatically with non-repainting request.security() calls.
//
//  EXACT RULES (full write-up: docs/CRT_RULES.md)
//  R1  Reference candle  = last COMPLETED candle of the 4H and of the 1H TF.
//      Valid only if  minRangeATR·ATR14(refTF) ≤ high-low ≤ maxRangeATR·ATR14(refTF).
//      A failed candle keeps the previous valid range for `rangeMaxAge` more
//      candles, then the range expires. Levels only change on a new VALID candle.
//  R2  CRT HIGH / LOW = reference high / low. CRT 50% = (high+low)/2.
//  R3  Breach  = a closed chart bar trades ≥ `sweepTicks` beyond a level.
//      Sweep   = after a breach, a chart bar CLOSES back inside the level within
//                `reclaimBars` bars (the breach bar itself counts).
//      Breakout= `acceptBars` consecutive closes beyond, or the window expires.
//      Unconfirmed = breached, neither of the above yet. One event per level.
//  R4  Setup   = a qualifying sweep (CRT level, or a CRT-aligned liquidity pool)
//                → direction is AWAY from the swept side.
//  R5  15M     = a 15M candle that CLOSED after the breach began breaks the last
//                confirmed 15M swing in the setup direction (MSS/CHoCH), and/or
//                prints a displacement candle (selectable).
//  R6  5M      = a completed chart candle after 15M confirmation: structure break
//                and/or retest of the 15M break level (selectable).
//  R7  Filters = entry window, anti-chase max stop distance, discount/premium,
//                4H bias, minimum R:R to TP2. Signal at bar close; simulated fill
//                at the NEXT bar's open.
//  R8  Exits   = stop below/above sweep extreme + buffer; TP1 = CRT 50% (or
//                internal liquidity / R); TP2 = opposite CRT boundary (or
//                external liquidity / R). Stop is assumed first when a bar
//                touches both stop and target.
//  The rules above are MODEL A. MODEL C (15M double-range confirmation) is an
//  independent state machine further down — rules in docs/MODEL_C.md.
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────── INPUTS ─────────────────────────────
string G_DSP = "① Display"
string dispMode    = input.string("Clean", "Chart mode", options = ["Clean", "Detailed"], group = G_DSP)
string primaryTF   = input.string("Setup TF (1H)", "Clean-mode range", options = ["Setup TF (1H)", "Higher TF (4H)"], group = G_DSP)
bool   show4H      = input.bool(true, "Detailed: show higher-TF (4H) range", group = G_DSP)
bool   show1H      = input.bool(true, "Detailed: show setup-TF (1H) range", group = G_DSP)
bool   showHist    = input.bool(true, "Detailed: keep previous CRT ranges", group = G_DSP)
int    histCount   = input.int(3, "Previous ranges kept (per TF)", minval = 1, maxval = 10, group = G_DSP)
bool   showPD      = input.bool(false, "Premium / discount shading", group = G_DSP)
bool   showPools   = input.bool(true, "Detailed: show BSL / SSL liquidity levels", group = G_DSP)
bool   showMSS     = input.bool(true, "Detailed: show 15M MSS / CHoCH", group = G_DSP)
int    keepTrades  = input.int(2, "Trades kept on chart", minval = 1, maxval = 30, group = G_DSP)
bool   showDash    = input.bool(true, "Show dashboard", group = G_DSP)
string dashPosIn   = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DSP)
string dashSizeIn  = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_DSP)
bool   showSim     = input.bool(false, "Dashboard: simulated trade tally (R)", group = G_DSP, tooltip = "Counts only trades the indicator simulated on this chart. Not a backtest — use the companion strategy for measured results.")
bool   showDiag    = input.bool(false, "Diagnostic log: last 20 setup outcomes", group = G_DSP)
string diagPosIn   = input.string("Bottom left", "Diagnostic log position", options = ["Bottom left", "Bottom right", "Bottom center"], group = G_DSP)

string G_CRT = "② CRT reference candles"
string tfHigh      = input.timeframe("240", "Higher CRT timeframe (context)", group = G_CRT)
string tfLow       = input.timeframe("60", "Setup CRT timeframe", group = G_CRT)
string tfConf      = input.timeframe("15", "Confirmation timeframe", group = G_CRT)
float  minRangeATR = input.float(0.35, "Min reference range (× ref-TF ATR14)", minval = 0.0, step = 0.05, group = G_CRT)
float  maxRangeATR = input.float(3.0, "Max reference range (× ref-TF ATR14)", minval = 0.5, step = 0.1, group = G_CRT)
int    rangeMaxAge = input.int(2, "Keep last valid range through N failed candles", minval = 0, maxval = 10, group = G_CRT)
string setupSrc    = input.string("1H + 4H CRT", "Setups may originate from", options = ["1H + 4H CRT", "Setup TF (1H) only", "Higher TF (4H) only"], group = G_CRT)
bool   usePools    = input.bool(true, "Also accept CRT-aligned liquidity-pool sweeps", group = G_CRT, tooltip = "A swept SSL pool qualifies for a LONG only if it sits in the discount half (≤ 50%) of the active CRT range; a BSL pool qualifies for a SHORT only in the premium half. Targets still come from that CRT range.")

int    extLook     = input.int(2, "CRT boundary must be EXTERNAL to the previous N ref candles (0 = off)", minval = 0, maxval = 10, group = G_CRT, tooltip = "A CRT low only counts as sell-side liquidity if it is lower than the lows of the previous N reference candles (high: higher than their highs). If an earlier candle already traded beyond it, the boundary is internal and its sweep does not start a setup.")

string G_SWP = "③ Sweep / reclaim rules"
int    sweepTicks  = input.int(1, "Min penetration beyond level (ticks)", minval = 1, group = G_SWP)
string reclaimMode = input.string("15M candle close", "Reclaim confirmed by", options = ["15M candle close", "Reference-TF candle close (classic CRT)", "Chart candle close (v1 behaviour)"], group = G_SWP, tooltip = "SWEEP IN PROGRESS = level breached. SWEEP CONFIRMED & RECLAIMED only when a COMPLETED candle of this timeframe closes back inside the level. One 5M close back inside is shown as 'reclaim pending' but does not create a setup.")
int    reclaimWin15 = input.int(2, "15M closes allowed to reclaim (15M mode)", minval = 1, maxval = 8, group = G_SWP)
int    reclaimBars = input.int(6, "Chart mode: reclaim window (chart bars)", minval = 1, maxval = 50, group = G_SWP)
int    acceptBars  = input.int(3, "Chart mode: breakout = N consecutive closes beyond", minval = 1, maxval = 20, group = G_SWP)
float  maxSweepATR = input.float(3.0, "Max sweep depth for a setup (× chart ATR14)", minval = 0.1, step = 0.1, group = G_SWP)
bool   roomCheck   = input.bool(true, "Skip sweeps with no ≥ min-R:R target even from the best entry", group = G_SWP)

string G_CNF = "④ 15M confirmation"
string confMode    = input.string("MSS or Displacement", "Confirmation required", options = ["MSS / CHoCH", "MSS or Displacement", "MSS + Displacement"], group = G_CNF)
bool   reqChoch    = input.bool(false, "Require CHoCH (break against prior 15M structure)", group = G_CNF)
int    pivL15      = input.int(3, "15M swing: left bars", minval = 1, maxval = 20, group = G_CNF)
int    pivR15      = input.int(2, "15M swing: right bars (confirmation delay)", minval = 1, maxval = 20, group = G_CNF)
float  dispMult    = input.float(0.8, "Displacement: body ≥ × 15M ATR14", minval = 0.1, step = 0.1, group = G_CNF)
int    confExpiry  = input.int(48, "15M confirmation must arrive within (chart bars)", minval = 3, maxval = 500, group = G_CNF)
bool   conflictInval = input.bool(true, "Invalidate on an OPPOSITE 15M structure break after the reclaim", group = G_CNF)
bool   pairedConf  = input.bool(true, "Accept a 5M break that happened BEFORE the 15M confirmation", group = G_CNF, tooltip = "Timestamp-paired confirmation. The 5M structure break must occur after the sweep began and within N bars before the 15M confirmation candle closes. The entry is still taken only at the close of the bar where BOTH are complete, at that bar's price, with all risk filters re-checked. Nothing is back-dated.")
int    pairBars    = input.int(12, "Max bars between the 5M break and the 15M confirmation", minval = 1, maxval = 48, group = G_CNF)

string G_ENT = "⑤ 5M entry"
string trigMode    = input.string("Break or Retest", "Entry trigger", options = ["Break or Retest", "5M structure break", "Retest of 15M break", "Momentum candle"], group = G_ENT)
int    pivL5       = input.int(3, "Entry-TF swing: left bars", minval = 1, maxval = 20, group = G_ENT)
int    pivR5       = input.int(2, "Entry-TF swing: right bars", minval = 1, maxval = 20, group = G_ENT)
float  retestTol   = input.float(0.15, "Retest tolerance (× chart ATR14)", minval = 0.0, step = 0.05, group = G_ENT)
int    entryExpiry = input.int(24, "5M entry must arrive within (chart bars after 15M)", minval = 1, maxval = 500, group = G_ENT)
float  maxRiskATR  = input.float(4.0, "Anti-chase: max stop distance (× chart ATR14)", minval = 0.5, step = 0.25, group = G_ENT)
bool   reqDiscount = input.bool(true, "Longs only in discount / shorts only in premium", group = G_ENT)
bool   htfFilter   = input.bool(true, "Block setups against the 4H CRT bias", group = G_ENT)

string G_RSK = "⑥ Stops & targets"
float  stopBufATR  = input.float(0.10, "Stop buffer (× chart ATR14)", minval = 0.0, step = 0.05, group = G_RSK)
int    stopBufTk   = input.int(2, "Minimum stop buffer (ticks)", minval = 0, group = G_RSK)
float  minRR       = input.float(2.0, "Minimum reward:risk to TP2", minval = 0.5, step = 0.1, group = G_RSK)
string tp1Mode     = input.string("CRT 50%", "TP1 method", options = ["CRT 50%", "Internal liquidity", "R multiple"], group = G_RSK)
float  tp1MinR     = input.float(0.8, "TP1 minimum distance (R)", minval = 0.1, step = 0.1, group = G_RSK)
float  tp1R        = input.float(1.0, "TP1 R multiple (fallback / R mode)", minval = 0.1, step = 0.1, group = G_RSK)
string tp2Mode     = input.string("Opposite CRT / liquidity", "TP2 method", options = ["Opposite CRT / liquidity", "R multiple"], group = G_RSK)
float  tp2R        = input.float(2.0, "TP2 R multiple (R mode)", minval = 0.5, step = 0.1, group = G_RSK)
float  tp1Pct      = input.float(50, "Position closed at TP1 (%)", minval = 1, maxval = 100, group = G_RSK)
bool   useBE       = input.bool(false, "Move stop to breakeven after TP1 (untested — off by default)", group = G_RSK)
int    maxBars     = input.int(0, "Early exit after N bars in trade (0 = off)", minval = 0, group = G_RSK)
float  maxStopPts  = input.float(0, "Max stop distance in POINTS, any model (0 = off) — e.g. 40 for MNQ", minval = 0, step = 1, group = G_RSK)
float  tp2MaxR     = input.float(4.0, "Model A: cap TP2 at N R (0 = off)", minval = 0, step = 0.5, group = G_RSK)
bool   wickInval   = input.bool(true, "Invalidate pending setup on a WICK through the sweep extreme (off = close)", group = G_RSK)

string G_LIQ = "⑦ Liquidity engine"
bool   trackPD     = input.bool(true, "Previous day high / low", group = G_LIQ)
bool   trackPW     = input.bool(true, "Previous week high / low", group = G_LIQ)
bool   trackSess   = input.bool(true, "Session highs / lows (Asia, London, NY)", group = G_LIQ)
bool   trackSw     = input.bool(true, "Confirmed 15M swing highs / lows (+ equal highs/lows)", group = G_LIQ)
float  eqTolATR    = input.float(0.10, "Equal-level & merge tolerance (× chart ATR14)", minval = 0.0, step = 0.02, group = G_LIQ)
int    poolMax     = input.int(8, "Max untouched pools per side", minval = 2, maxval = 25, group = G_LIQ)
int    poolDays    = input.int(3, "Pool expiry in days (weekly levels × 3)", minval = 1, maxval = 30, group = G_LIQ)

string G_SES = "⑧ Sessions — IANA time zones (DST handled)"
string asiaSess    = input.session("0900-1500", "Asia / Tokyo", inline = "sa", group = G_SES)
string asiaTZ      = input.string("Asia/Tokyo", "", inline = "sa", group = G_SES)
string lonSess     = input.session("0800-1630", "London", inline = "sl", group = G_SES)
string lonTZ       = input.string("Europe/London", "", inline = "sl", group = G_SES)
string nySess      = input.session("0800-1600", "New York", inline = "sn", group = G_SES)
string nyTZ        = input.string("America/New_York", "", inline = "sn", group = G_SES)

string G_WIN = "⑨ Entry windows (tracking never stops)"
bool   usePresetWin = input.bool(true, "Use market preset windows", group = G_WIN, tooltip = "GOLD/FX: London 08:00-11:00 + NY 08:30-11:30. NQ/ES: NY 09:30-11:30. USD/JPY adds Tokyo 09:00-11:30. Research starting points only — not optimised.")
bool   winAsiaIn   = input.bool(false, "Asia window", inline = "wa", group = G_WIN)
string winAsiaS    = input.session("0900-1130", "", inline = "wa", group = G_WIN)
bool   winLonIn    = input.bool(true, "London window", inline = "wl", group = G_WIN)
string winLonS     = input.session("0800-1100", "", inline = "wl", group = G_WIN)
bool   winNyIn     = input.bool(true, "New York window", inline = "wn", group = G_WIN)
string winNyS      = input.session("0830-1130", "", inline = "wn", group = G_WIN)

string G_MKT = "⑩ Market"
string marketSel   = input.string("Auto-detect", "Market", options = ["Auto-detect", "GOLD", "NASDAQ", "S&P 500", "EUR/USD", "USD/JPY", "OTHER"], group = G_MKT)

string G_ALR = "⑪ Alerts  (create ONE alert: 'Any alert() function call')"
bool   alJSON      = input.bool(false, "JSON payloads (Telegram / webhook)", group = G_ALR)
bool   alSweep     = input.bool(true, "Sweeps & reclaims", group = G_ALR)
bool   alConf      = input.bool(true, "15M confirmation", group = G_ALR)
bool   alSig       = input.bool(true, "BUY / SELL & simulated fills", group = G_ALR)
bool   alMgmt      = input.bool(true, "TP / SL / early exit / invalidation", group = G_ALR)

string G_COL = "⑫ Colours"
color  cHi    = input.color(#FF3B3B, "CRT high / low / 50%", inline = "c1", group = G_COL)
color  cLo    = input.color(#22C55E, "", inline = "c1", group = G_COL)
color  cMid   = input.color(#FFC83D, "", inline = "c1", group = G_COL)
color  cBull  = input.color(#00C176, "Bull / Bear", inline = "c2", group = G_COL)
color  cBear  = input.color(#FF3D57, "", inline = "c2", group = G_COL)
color  cBSL   = input.color(#FF8A65, "BSL / SSL", inline = "c3", group = G_COL)
color  cSSL   = input.color(#4DD0E1, "", inline = "c3", group = G_COL)
color  cEntry = input.color(#2F80ED, "Entry / Targets / Stop", inline = "c4", group = G_COL)
color  cTP    = input.color(#00E676, "", inline = "c4", group = G_COL)
color  cSL    = input.color(#FF5252, "", inline = "c4", group = G_COL)

string G_MC = "⑭ Model C — 15M double-range confirmation"
bool   cOn        = input.bool(true, "Enable Model C", group = G_MC)
string cRefMode   = input.string("Session-opening pair", "Reference pair selection", options = ["Session-opening pair", "First pair after 15M structure event", "Rolling consecutive pair"], group = G_MC, tooltip = "Session-opening pair: the first two completed 15M candles of each enabled session open. Structure event: the two 15M candles that follow a confirmed 15M MSS/BOS. Rolling: consecutive pairs that never overlap a previously used pair or its ending candle.")
bool   cOpenAsia  = input.bool(false, "Asia open (Asia TZ)", inline = "co1", group = G_MC)
string cOpenAsiaT = input.string("0900", "", inline = "co1", group = G_MC)
bool   cOpenLon   = input.bool(true, "London open (London TZ)", inline = "co2", group = G_MC)
string cOpenLonT  = input.string("0800", "", inline = "co2", group = G_MC)
bool   cOpenNy    = input.bool(true, "New York open (NY TZ)", inline = "co3", group = G_MC)
string cOpenNyT   = input.string("0930", "", inline = "co3", group = G_MC)
int    cBufTk     = input.int(0, "Breakout buffer beyond the boundary (ticks)", minval = 0, group = G_MC)
string cSweepRule = input.string("Strict: any trade beyond", "Disqualifying opposite-boundary sweep", options = ["Strict: any trade beyond", "Sweep: trade beyond + 15M close back inside", "Off"], group = G_MC, tooltip = "For a SHORT: Strict = any 15M high above the upper boundary after the pair disqualifies the short side. Sweep = a high above the upper boundary followed (same or later 15M candle) by a 15M close back at/below it. Mirror rules for a LONG.")
int    cSweepWin  = input.int(0, "Sweep observation window (15M candles, 0 = whole setup life)", minval = 0, maxval = 48, group = G_MC)
int    cExpiry    = input.int(8, "Expire after N 15M candles without a breakout", minval = 1, maxval = 96, group = G_MC)
string cBiasMode  = input.string("4H + 1H", "Directional bias filter", options = ["Off", "4H only", "1H only", "4H + 1H"], group = G_MC)
string cConflict  = input.string("Block trade", "When 4H and 1H disagree", options = ["Block trade", "Follow 4H", "Follow 1H"], group = G_MC)
int    cEmaLen    = input.int(50, "Bias = last completed close vs EMA(N) of that TF", minval = 2, group = G_MC)
bool   cStructF   = input.bool(false, "Require 15M market structure in trade direction", group = G_MC)
bool   cSesAsia   = input.bool(true, "Confirm in session: Asia / London / New York", inline = "cs", group = G_MC)
bool   cSesLon    = input.bool(true, "", inline = "cs", group = G_MC)
bool   cSesNy     = input.bool(true, "", inline = "cs", group = G_MC)
bool   cSesAny    = input.bool(false, "Any time (no session filter — raw-model test)", group = G_MC)
float  cDispMin   = input.float(0.0, "Min breakout body (× 15M ATR14, 0 = off)", minval = 0.0, step = 0.1, group = G_MC)
float  cVolMult   = input.float(0.0, "Min breakout volume (× 20-candle avg, 0 = off)", minval = 0.0, step = 0.1, group = G_MC)
string cStopMode  = input.string("Opposite boundary", "Stop", options = ["Opposite boundary", "Smart: nearest structure, then ATR", "Recent confirmed 15M swing", "ATR"], group = G_MC, tooltip = "Opposite boundary (default) = the level that invalidates the breakout; too-wide stops are REJECTED (NOT TRADABLE) by the max-stop limits instead of being tightened. Tested in the replay: tighter stops (smart / 15M swing / ATR) cut the stop size roughly in half but lowered results on gold. Smart = the TIGHTEST of (breakout-candle high/low, last confirmed 15M swing, last confirmed chart-TF swing) that lies beyond the entry and is between the min and max stop distance. If none qualifies, an ATR stop is used. If that is also too wide the setup is NOT TRADABLE.")
float  cMinStopATR = input.float(1.0, "Smart stop: min distance (× 15M ATR14) — avoids noise stops", minval = 0.0, step = 0.1, group = G_MC)
float  cStopATR   = input.float(1.5, "ATR stop (× 15M ATR14)", minval = 0.2, step = 0.1, group = G_MC)
int    cStopTk    = input.int(2, "Stop buffer (ticks)", minval = 0, group = G_MC)
float  cMaxRiskATR = input.float(2.0, "Max stop distance (× 15M ATR14)", minval = 0.5, step = 0.25, group = G_MC)
float  cTp1R      = input.float(1.0, "TP1 (R)", minval = 0.2, step = 0.1, group = G_MC)
float  cTp2R      = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.1, group = G_MC)
string cTpMode    = input.string("R multiples", "Targets", options = ["R multiples", "Smart: liquidity + R (capped)", "Nearest liquidity (strict)"], group = G_MC, tooltip = "R multiples (default, tested): TP1/TP2 = N × the actual stop distance, so targets shrink automatically with tighter, capped stops. Smart: TP1 = nearest untouched liquidity ≥ TP1-min R (else TP1 R); TP2 = next liquidity ≥ min R:R and ≤ the TP2 cap (else TP2 R). Never beyond the cap. Strict: TP2 = nearest liquidity; if it is closer than min R:R the setup is NOT TRADABLE.")
float  cTp2MaxR   = input.float(3.0, "TP2 cap (R, 0 = off)", minval = 0.0, step = 0.5, group = G_MC)
bool   cNeedWin   = input.bool(true, "Actionable only inside the entry windows (same windows as Model A)", group = G_MC, tooltip = "A breakout confirmed while entries are OFF is shown as 'setup detected — NOT ACTIONABLE' and no BUY/SELL or trade levels are drawn.")
float  cMinRR     = input.float(1.5, "Minimum R:R to TP2", minval = 0.5, step = 0.1, group = G_MC)
float  cRiskCash  = input.float(500, "Risk budget per trade (sizing shown on dashboard)", minval = 1, group = G_MC)
bool   cShowBnd   = input.bool(true, "Show combined upper / lower boundaries", group = G_MC)
color  cCol       = input.color(#B388FF, "Model C colour", group = G_MC)

string G_FVG = "⑮ Fair Value Gaps (context overlay)"
bool   fvgOn       = input.bool(true, "Detect FVGs", group = G_FVG)
bool   fvgShow     = input.bool(true, "Show nearest FVG zones", group = G_FVG)
bool   fvgShowInv  = input.bool(true, "Show inverse FVGs (gap closed through → flipped)", group = G_FVG)
float  fvgMinATR   = input.float(0.15, "Min gap size (× chart ATR14)", minval = 0.0, step = 0.05, group = G_FVG)
float  fvgStrongATR = input.float(1.0, "Strong displacement: middle-candle body ≥ × ATR", minval = 0.1, step = 0.1, group = G_FVG)
bool   fvgStrongOnly = input.bool(false, "Show only strong-displacement gaps", group = G_FVG)
int    fvgShowN    = input.int(2, "Zones shown per side (above / below price)", minval = 1, maxval = 5, group = G_FVG)
float  fvgMaxDist  = input.float(8.0, "Only show zones within × ATR of price", minval = 1.0, step = 0.5, group = G_FVG)
int    fvgMaxAge   = input.int(288, "Forget gaps older than N chart bars", minval = 20, maxval = 3000, group = G_FVG)
color  fvgBullC    = input.color(color.new(#26A69A, 86), "FVG colours: bullish / bearish / inverse", inline = "fc", group = G_FVG)
