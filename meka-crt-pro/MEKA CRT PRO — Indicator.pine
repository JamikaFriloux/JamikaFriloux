color  fvgInvC     = input.color(color.new(#9E9E9E, 86), "", inline = "fc", group = G_FVG)

string G_SD = "⑯ Supply & Demand / order blocks (context overlay)"
bool   sdOn        = input.bool(true, "Detect supply & demand zones", group = G_SD)
bool   sdShow      = input.bool(true, "Show nearest zones", group = G_SD)
bool   sdShowDead  = input.bool(true, "Fade recently invalidated zones (last 2)", group = G_SD)
float  sdDispATR   = input.float(1.2, "Displacement candle: body ≥ × chart ATR14", minval = 0.3, step = 0.1, group = G_SD)
int    sdLook      = input.int(3, "Order-block search: candles before the displacement", minval = 1, maxval = 10, group = G_SD)
