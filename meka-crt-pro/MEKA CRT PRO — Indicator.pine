f_mkK1() =>
    CFG1.new(histCount, showPD, showPools, showMSS, keepTrades, showSim, minRangeATR, maxRangeATR, rangeMaxAge, usePools,
         extLook, reclaimWin15, reclaimBars, acceptBars, maxSweepATR, roomCheck, confMode, reqChoch, confExpiry,
         conflictInval, pairedConf, pairBars, trigMode, retestTol, entryExpiry, maxRiskATR, reqDiscount, htfFilter,
         stopBufATR, stopBufTk, minRR, tp1Mode, tp1MinR, tp1R, tp2Mode, tp2R, tp1Pct, useBE, maxBars, maxStopPts,
         tp2MaxR, wickInval, trackPD, trackPW, trackSess, trackSw, eqTolATR, poolMax, poolDays, asiaSess, asiaTZ,
         lonSess, lonTZ, nySess, nyTZ, alJSON, alSweep, alConf, alSig, alMgmt, cHi, cLo, cMid, cBull, cBear, cBSL, cSSL,
         cEntry, cTP, cSL)
var CFG1 K1 = f_mkK1()
f_mkK2() =>
    CFG2.new(cOn, cRefMode, cOpenAsia, cOpenAsiaT, cOpenLon, cOpenLonT, cOpenNy, cOpenNyT, cBufTk, cSweepRule, cSweepWin,
         cExpiry, cBiasMode, cConflict, cEmaLen, cStructF, cSesAsia, cSesLon, cSesNy, cSesAny, cDispMin, cVolMult,
         cStopMode, cMinStopATR, cStopATR, cStopTk, cMaxRiskATR, cTp1R, cTp2R, cTpMode, cTp2MaxR, cNeedWin, cMinRR,
         cRiskCash, cShowBnd, cCol, fvgOn, fvgShow, fvgShowInv, fvgMinATR, fvgStrongATR, fvgStrongOnly, fvgShowN,
         fvgMaxDist, fvgMaxAge, fvgBullC, fvgBearC, fvgInvC, sdOn, sdShow, sdShowDead, sdDispATR, sdLook, sdMaxTouch,
         sdShowN, sdMaxDist, sdMaxAge, sdDemC, sdSupC, msShow, liqAlways, amdOn, amdAccMode, amdAsiaH1, amdLen,
         amdRangeATR, amdCompress, amdAccExp, amdRclTF)
var CFG2 K2 = f_mkK2()
f_mkK3() =>
    CFG3.new(amdReclaim, amdAccept, amdMaxSweep, amdDistExp, amdDispATR, amdDistLvl, amdStruct, amdBias, amdStopMode,
         amdStopTk, amdCapMode, amdMaxRisk, amdTp1R, amdTp2R, amdMinRR, amdShowBox, amdShowMark, amdCol, cfMode,
         cfMinPro, cfMaxCon, cfReqBias, cfReqClear, cfModels,
         mkt, isDet, primHigh, vis4, vis1, keepHist, n4, n1, nC, nE, tfOK,
         src4, src1, minPen, w1, rcPool, rcCRT1, rcCRT4, c15Ms, c15Bars, labOff, dayMs, keepResolved, dashSz)
var CFG3 K3 = f_mkK3()



// ───────────────────────────── TYPES ─────────────────────────────
// A tracked liquidity level (CRT boundaries are liquidity levels too).
type Liq
    float  price
    int    side              // +1 buy-side (above price) · -1 sell-side (below price)
    string kind
    string tf = ""
    bool   isCRT = false
    bool   hiTF = false      // belongs to the higher (4H) CRT range
    float  rHi               // CRT range this level belongs to (CRT levels only)
    float  rLo
    int    state = 0         // 0 untouched · 1 breached (unconfirmed) · 2 swept (reclaimed) · 3 broken (breakout)
    int    breachBar
    int    breachTime
    float  ext               // sweep extreme
    int    beyond = 0
    int    resolvedBar
    int    created
    int    expires
    bool   retired = false
    bool   aligned = false
    bool   labeled = false
    bool   external = true     // CRT only: boundary lies beyond the previous N reference candles
    int    rcTF = 0            // timeframe whose completed close confirms the reclaim
    int    tfCnt = 0           // completed reclaim-TF candles that closed beyond the level
    bool   pend = false        // chart candle is back inside, waiting for the reclaim-TF close
    float  fav                 // best price toward the 50% since the breach
    int    rT0                 // reference candle open time (CRT levels)
    line   ln
    label  lb
    label  lbSweep

type CRTRange
    string tf
    float  hi
    float  lo
    float  mid
    int    t0
    int    age = 0
    bool   active = false
    bool   lastFail = false
    Liq    hiLiq
    Liq    loLiq
    line   lnHi
    line   lnLo
    line   lnMid
    label  lbHi
    label  lbLo
    label  lbMid
    box    bxP
    box    bxD

// Setup / trade state machine.
// 0 idle · 3 sweep confirmed & reclaimed (awaiting 15M) · 4 15M confirmed · 5 signal (fill pending)
// 6 position · 8 complete · 9 ended without a trade (cat = STRUCTURAL / CONFLICT / MISSED / EXPIRED / SESSION / REPLACED)
// Everything below is LOCKED at the reclaim and never re-read from the live ranges.
type Setup
    int    state = 0
    int    dir = 0
    string srcTF = ""
    string srcKind = ""
    bool   hiTF = false
    float  level
    float  ext
    float  invalLvl            // planned stop = sweep extreme ∓ buffer (locked)
    int    breachTime
    int    breachBar
    int    reclaimBar
    int    reclaimT
    int    rT0
    string cat = ""
    string cfTxt = ""          // confluence explanation captured at the signal
    line   plInv
    line   plMid
    label  pbInv
    label  pbMid
    float  rHi
    float  rLo
    float  rMid
    int    confBar
    string confText = ""
    float  rtLvl
    int    sigBar
    float  entryRef
    float  entry
    float  stop
    float  stopInit
    float  riskRef
    float  tp1
    float  tp2
    string tp1Src = ""
    string tp2Src = ""
    bool   tp1Done = false
    bool   beOn = false
    int    fillBar
    int    doneBar
    float  resultR
    string outcome = ""
    string reason = ""
    string reject = ""
    array<line>  lines
    array<label> labels
    array<box>   boxes

// Model C reference pair. Boundaries are frozen at lock and never move.
// state: 0 waiting · 1 first candle captured · 2 reference locked / watching
//        7 confirmed (trade issued) · 9 invalidated · 10 expired · 11 missed entry
type CRef
    int    state = 0
    string src = ""
    float  h1
    float  l1
    float  h2
    float  l2
    float  up
    float  lo
    int    t1
    int    t2
    int    nSeen = 0
    bool   upHit = false
    bool   dnHit = false
    bool   bearDQ = false
    bool   bullDQ = false
    string bearWhy = ""
    string bullWhy = ""
    string endWhy = ""
    int    endT
    array<line> lns
    label  lbU
    label  lbL

// Fair value gap. Created at the CLOSE of the third candle; never earlier.
// state: 0 fresh · 1 partially filled · 2 fully mitigated · 3 invalidated (inverse gap closed through)
type FVG
    int    dir             // +1 bullish (support) · -1 bearish (resistance); flips when inverted
    float  top
    float  bot
    int    t0              // open time of the middle (displacement) candle
    int    bar             // bar it became known
    float  disp            // middle-candle body ÷ ATR
    bool   strong = false
    bool   inv = false     // inverse FVG
    int    state = 0
    float  fill = 0.0      // deepest fill fraction 0..1

// Supply / demand zone = last opposite candle (order block) before a displacement candle.
// state: 0 active · 1 invalidated (closed through) · 2 retired (retested too often)
type Zone
    int    dir             // +1 demand · -1 supply
    float  top
    float  bot
    int    t0
    int    bar
    float  disp
    bool   bos = false     // displacement candle broke the last confirmed swing
    int    touches = 0
    bool   inside = false
    int    state = 0
    int    endBar

// AMD / Power of Three setup. Range frozen at lock; nothing is confirmed before its candle closes.
// state: 0 scanning · 1 accumulation locked · 2 manipulation in progress (breached, unconfirmed)
//        3 manipulation confirmed (awaiting distribution) · 7 distribution confirmed (trade)
//        9 invalidated · 10 expired · 11 not tradable
type AMD
    int    state = 0
    float  hi
    float  lo
    int    t0
    int    lockBar
    int    side = 0            // side that was swept: +1 above, -1 below
    int    dir = 0             // trade direction = -side
    float  mExt                // manipulation extreme
    int    mBar
    int    confBar
    int    outCnt = 0
    int    preOut = 0          // Asia mode: consecutive 15M closes outside the range BEFORE London / NY
    int    preSide = 0
    bool   preSwept = false    // traded outside before London but closed back inside (range kept)
    bool   structOK = false
    string why = ""
    int    endBar
    box    bx

// A liquidity level waiting to be added this bar (lets every source share one f_addPool call)
type PoolReq
    float  p
    int    side
    string kind
    int    expT
    int    x0
    bool   sw = false

// ───────────────────────────── LIQUIDITY HELPERS ─────────────────────────────
f_tag(Liq l) =>
    na(l) ? "" : l.state == 1 ? " · BREACHED" : l.state == 2 ? " · SWEPT ✓" : l.state == 3 ? " · BROKEN" : not l.external ? " · internal" : ""

f_poolName(Liq l) =>
    (l.side == 1 ? "BSL " : "SSL ") + l.kind + " " + f_p(l.price)

f_poolDraw(Liq l, int x0) =>
    color c = l.side == 1 ? K1.cBSL : K1.cSSL
    l.ln := line.new(x0, l.price, time, l.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(c, 35), style = line.style_dotted, width = 1)
    l.lb := label.new(time + K3.labOff, l.price, f_poolName(l), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = color.new(c, 10), size = size.tiny)

f_poolUndraw(Liq l) =>
    if not na(l.ln)
        line.delete(l.ln)
    if not na(l.lb)
        label.delete(l.lb)

f_trimPools(array<Liq> arr, int side) =>
    int cnt = 0
    for l in arr
        if not l.isCRT and l.state == 0 and l.side == side
            cnt += 1
    while cnt > K1.poolMax
        int oi = -1
        int ot = na
        for [i, l] in arr
            if not l.isCRT and l.state == 0 and l.side == side and (na(ot) or l.created < ot)
                oi := i
                ot := l.created
        if oi >= 0
            Liq o = arr.remove(oi)
            f_poolUndraw(o)
        cnt -= 1

// Add a pool, merging with an untouched pool on the same side within tolerance.
// Two 15M swings within tolerance become EQH / EQL.
f_addPool(array<Liq> arr, float p, int side, string kind, float tol, int expT, int x0, bool isSwing) =>
    bool done = false
    if not na(p) and arr.size() > 0
        for l in arr
            if not l.isCRT and l.state == 0 and l.side == side and math.abs(l.price - p) <= tol
                if isSwing and (str.contains(l.kind, "SWING") or str.startswith(l.kind, "EQ"))
                    l.kind := side == 1 ? "EQH" : "EQL"
                    l.price := side == 1 ? math.max(l.price, p) : math.min(l.price, p)
                else if not str.contains(l.kind, kind)
                    l.kind := l.kind + " + " + kind
                l.expires := math.max(l.expires, expT)
                if not na(l.ln)
                    line.set_y1(l.ln, l.price)
                    line.set_y2(l.ln, l.price)
                    label.set_y(l.lb, l.price)
                    label.set_text(l.lb, f_poolName(l))
                done := true
                break
    if not na(p) and not done
        Liq n = Liq.new(price = p, side = side, kind = kind, created = time, expires = expT, rcTF = K3.rcPool)
        if (K3.isDet or K2.liqAlways) and K1.showPools
            f_poolDraw(n, na(x0) ? time : x0)
        arr.push(n)
        f_trimPools(arr, side)
    done

// Sweep classifier — runs once per CLOSED chart bar. Returns 0 none · 1 breach · 2 swept & reclaimed · 3 broken.
// nw/cc/tc = "a reclaim-TF candle just completed" / its close / its close time, chosen by the caller
// from completed-candle data only (expr[1] + lookahead_on).
method process(Liq l, float pen, int rcl, int acc, bool nw, float cc, int tc) =>
    int ev = 0
    if l.state == 0
        bool br = l.side == 1 ? high - l.price >= pen - syminfo.mintick * 0.01 : l.price - low >= pen - syminfo.mintick * 0.01
        if br
            l.state := 1
            l.breachBar := bar_index
            l.breachTime := time
            l.ext := l.side == 1 ? high : low
            l.fav := l.side == 1 ? low : high
            l.beyond := 0
            l.tfCnt := 0
            ev := 1
    else if l.state == 1
        l.ext := l.side == 1 ? math.max(l.ext, high) : math.min(l.ext, low)
        l.fav := l.side == 1 ? math.min(l.fav, low) : math.max(l.fav, high)
    if l.state == 1 and l.rcTF != 0
        // Reclaim must be confirmed by a COMPLETED reclaim-TF candle that closed after the breach began
        l.pend := l.side == 1 ? close < l.price : close > l.price
        if nw and not na(tc) and tc > l.breachTime
            bool backTF = l.side == 1 ? cc < l.price : cc > l.price
            if backTF
                l.state := 2
                l.resolvedBar := bar_index
                ev := 2
            else
                l.tfCnt := l.tfCnt + 1
                if l.tfCnt >= (l.rcTF == 1 ? K1.reclaimWin15 : 1)
                    l.state := 3
                    l.resolvedBar := bar_index
                    ev := 3
    else if l.state == 1
        bool backIn = l.side == 1 ? close < l.price : close > l.price
        bool beyondNow = l.side == 1 ? close > l.price : close < l.price
        if backIn
            l.state := 2
            l.resolvedBar := bar_index
            ev := 2
        else
            if beyondNow
                l.beyond := l.beyond + 1
            if l.beyond >= acc or bar_index - l.breachBar + 1 >= rcl
                l.state := 3
                l.resolvedBar := bar_index
                ev := 3
    ev

// Nearest untouched level on `side`, at least `minDist` beyond `from`, not beyond `maxP`.
f_nearestLiq(array<Liq> arr, int side, float fromP, float minDist, float maxP) =>
    float best = na
    string bk = ""
    for l in arr
        if l.state == 0 and not l.retired and l.side == side
            float dist = side * (l.price - fromP)
            bool inCap = na(maxP) or side * (maxP - l.price) >= 0
            if dist >= minDist and inCap and (na(best) or dist < side * (best - fromP))
                best := l.price
                bk := l.kind
    [best, bk]

// ───────────────────────────── CRT RANGE METHODS ─────────────────────────────
method retire(CRTRange r, array<line> hist, bool keep) =>
    if not na(r.hiLiq)
        r.hiLiq.retired := true
    if not na(r.loLiq)
        r.loLiq.retired := true
    if not na(r.lnHi)
        if keep
            line.set_extend(r.lnHi, extend.none)
            line.set_extend(r.lnLo, extend.none)
            line.set_extend(r.lnMid, extend.none)
            line.set_x2(r.lnHi, time)
            line.set_x2(r.lnLo, time)
            line.set_x2(r.lnMid, time)
            line.set_color(r.lnHi, color.new(K1.cHi, 70))
            line.set_color(r.lnLo, color.new(K1.cLo, 70))
            line.set_color(r.lnMid, color.new(K1.cMid, 70))
            line.set_width(r.lnHi, 1)
            line.set_width(r.lnLo, 1)
            line.set_width(r.lnMid, 1)
            hist.push(r.lnHi)
            hist.push(r.lnLo)
            hist.push(r.lnMid)
            while hist.size() > K1.histCount * 3
                line.delete(hist.shift())
        else
            line.delete(r.lnHi)
            line.delete(r.lnLo)
            line.delete(r.lnMid)
    if not na(r.lbHi)
        label.delete(r.lbHi)
        label.delete(r.lbLo)
        label.delete(r.lbMid)
    if not na(r.bxP)
        box.delete(r.bxP)
        box.delete(r.bxD)
    r.lnHi := na
    r.lnLo := na
    r.lnMid := na
    r.lbHi := na
    r.lbLo := na
    r.lbMid := na
    r.bxP := na
    r.bxD := na

method drawNew(CRTRange r, bool primary, bool isHigh) =>
    int w = isHigh ? 2 : 1
    int tr = isHigh ? 0 : 15
    r.lnHi  := line.new(r.t0, r.hi, time, r.hi, xloc = xloc.bar_time, extend = extend.right, color = color.new(K1.cHi, tr), style = line.style_solid, width = w)
    r.lnLo  := line.new(r.t0, r.lo, time, r.lo, xloc = xloc.bar_time, extend = extend.right, color = color.new(K1.cLo, tr), style = line.style_solid, width = w)
    r.lnMid := line.new(r.t0, r.mid, time, r.mid, xloc = xloc.bar_time, extend = extend.right, color = color.new(K1.cMid, tr), style = line.style_dashed, width = w)
    int xl = time + K3.labOff * (isHigh ? 7 : 3)
    r.lbHi  := label.new(xl, r.hi, r.tf + " CRT HIGH " + f_p(r.hi), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = K1.cHi, size = size.small)
    r.lbLo  := label.new(xl, r.lo, r.tf + " CRT LOW " + f_p(r.lo), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = K1.cLo, size = size.small)
    r.lbMid := label.new(xl, r.mid, r.tf + " CRT 50% " + f_p(r.mid), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = K1.cMid, size = size.small)
    if K1.showPD and primary
        r.bxP := box.new(r.t0, r.hi, time, r.mid, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(K1.cHi, 93))
        r.bxD := box.new(r.t0, r.mid, time, r.lo, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(K1.cLo, 93))

// Called on the first chart bar after a reference candle completes.
method roll(CRTRange r, float hi, float lo, int t0, float atrH, array<Liq> arr, array<line> hist, bool vis, bool keep, bool primary, bool isHigh, float priorH, float priorL) =>
    float rng = hi - lo
    bool valid = not na(hi) and not na(lo) and not na(atrH) and rng > 0 and rng >= K1.minRangeATR * atrH and rng <= K1.maxRangeATR * atrH
    if valid
        if r.active
            r.retire(hist, keep)
        r.hi := hi
        r.lo := lo
        r.mid := (hi + lo) / 2
        r.t0 := t0
        r.age := 0
        r.active := true
        r.lastFail := false
        int rc = isHigh ? K3.rcCRT4 : K3.rcCRT1
        Liq lh = Liq.new(price = hi, side = 1, kind = r.tf + " CRT HIGH", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = K1.extLook == 0 or na(priorH) or hi > priorH)
        Liq ll = Liq.new(price = lo, side = -1, kind = r.tf + " CRT LOW", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = K1.extLook == 0 or na(priorL) or lo < priorL)
        r.hiLiq := lh
        r.loLiq := ll
        arr.push(lh)
        arr.push(ll)
        if vis
            r.drawNew(primary, isHigh)
    else
        r.lastFail := true
        r.age := r.age + 1
        if r.active and r.age > K1.rangeMaxAge
            r.retire(hist, keep)
            r.active := false
    valid

method refresh(CRTRange r, bool isLast, bool isHigh) =>
    if r.active and not na(r.lnHi)
        line.set_style(r.lnHi, r.hiLiq.state == 2 ? line.style_dotted : r.hiLiq.state == 3 ? line.style_dashed : line.style_solid)
        line.set_style(r.lnLo, r.loLiq.state == 2 ? line.style_dotted : r.loLiq.state == 3 ? line.style_dashed : line.style_solid)
        if isLast
            int xl = time + K3.labOff * (isHigh ? 7 : 3)
            label.set_x(r.lbHi, xl)
            label.set_x(r.lbLo, xl)
            label.set_x(r.lbMid, xl)
            label.set_text(r.lbHi, r.tf + " CRT HIGH " + f_p(r.hi) + f_tag(r.hiLiq))
            label.set_text(r.lbLo, r.tf + " CRT LOW " + f_p(r.lo) + f_tag(r.loLiq))

// ───────────────────────────── EVENT / TRADE DRAWING ─────────────────────────────
f_evLabel(array<label> q, int x, float y, string txt, color bg, color tc, string st, string sz, string tip, string yl) =>
    label lb = label.new(x, y, txt, xloc = xloc.bar_index, yloc = yl, color = bg, style = st, textcolor = tc, size = sz, tooltip = tip)
    q.push(lb)
    if q.size() > 250
        label.delete(q.shift())
    lb

f_sweepLabel(array<label> q, Liq l, bool star) =>
    bool bsl = l.side == 1
    string head = l.isCRT ? (l.tf + (bsl ? " CRT HIGH SWEPT" : " CRT LOW SWEPT")) : ((bsl ? "BSL SWEPT · " : "SSL SWEPT · ") + l.kind)
    string txt = head + (star ? " ★" : "") + "\n" + f_p(l.price)
    color bg = bsl ? color.new(K1.cBear, 20) : color.new(K1.cBull, 20)
    string tip = "Level " + f_p(l.price) + " | extreme " + f_p(l.ext) + " | breach→reclaim " + str.tostring(bar_index - l.breachBar + 1) + " bar(s)" + (star ? " | ★ aligned with active CRT setup" : "")
    l.lbSweep := f_evLabel(q, bar_index, l.ext, txt, bg, color.white, bsl ? label.style_label_down : label.style_label_up, size.small, tip, yloc.price)
    l.labeled := true

f_alert(string ev, int d, float lvl, float en, float sl, float t1, float t2, string note) =>
    // event names carry the model (no prefix = A, C_ / AMD_ / FVG_); prices are text, missing = "NaN"
    array<string> v = array.from(ev, d == 1 ? "LONG" : d == -1 ? "SHORT" : "NONE", syminfo.ticker, timeframe.period, note)
    for x in array.from(close, lvl, en, sl, t1, t2)
        v.push(str.tostring(x, format.mintick))
    string msg = ""
    for [n, x] in array.from("event", "direction", "symbol", "timeframe", "note", "close", "level", "entry", "sl", "tp1", "tp2")
        msg += K1.alJSON ? ",\"" + x + "\":\"" + v.get(n) + "\"" : " | " + x + " " + v.get(n)
    alert(K1.alJSON ? "{\"source\":\"MEKA CRT PRO\"" + msg + "}" : "MEKA CRT PRO" + msg, alert.freq_once_per_bar_close)

f_tradeDraw(Setup s, string tag) =>
    int x1 = bar_index
    int x2 = bar_index + 4
    line lE = line.new(x1, s.entryRef, x2, s.entryRef, color = K1.cEntry, width = 2)
    line lS = line.new(x1, s.stop, x2, s.stop, color = K1.cSL, width = 2)
    line lA = line.new(x1, s.tp1, x2, s.tp1, color = K1.cTP, width = 1, style = line.style_dashed)
    line lB = line.new(x1, s.tp2, x2, s.tp2, color = K1.cTP, width = 2)
    s.lines := array.from(lE, lS, lA, lB)
    label bE = label.new(x2, s.entryRef, tag + "ENTRY " + f_p(s.entryRef), style = label.style_label_left, color = C_CLEAR, textcolor = K1.cEntry, size = size.small)
    label bS = label.new(x2, s.stop, tag + "SL " + f_p(s.stop), style = label.style_label_left, color = C_CLEAR, textcolor = K1.cSL, size = size.small)
    label bA = label.new(x2, s.tp1, tag + "TP1 " + f_p(s.tp1), style = label.style_label_left, color = C_CLEAR, textcolor = K1.cTP, size = size.small)
    label bB = label.new(x2, s.tp2, tag + "TP2 " + f_p(s.tp2) + " · " + f_r(math.abs(s.tp2 - s.entryRef) / s.riskRef) + "R", style = label.style_label_left, color = C_CLEAR, textcolor = K1.cTP, size = size.small)
    s.labels := array.from(bE, bS, bA, bB)
    box zr = box.new(x1, math.max(s.entryRef, s.stop), x2, math.min(s.entryRef, s.stop), border_color = C_CLEAR, bgcolor = color.new(K1.cSL, 92))
    box zw = box.new(x1, math.max(s.entryRef, s.tp2), x2, math.min(s.entryRef, s.tp2), border_color = C_CLEAR, bgcolor = color.new(K1.cTP, 93))
    s.boxes := array.from(zr, zw)

f_tradeExtend(Setup s, int x2) =>
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, x2)
        for lb in s.labels
            label.set_x(lb, x2)
        for bx in s.boxes
            box.set_right(bx, x2)

f_tradeDelete(Setup s) =>
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        for lb in s.labels
            label.delete(lb)
        for bx in s.boxes
            box.delete(bx)

// Targets. d = +1 long / -1 short. Returns [tp1, tp2, tp1 source, tp2 source]; tp2 = na → no valid target.
f_targets(int d, float entry, float risk, float rHi, float rLo, float rMid, string rTF, array<Liq> arr) =>
    float opp = d == 1 ? rHi : rLo
    float tp2 = na
    string tp2s = ""
    if K1.tp2Mode == "R multiple"
        tp2 := entry + d * K1.tp2R * risk
        tp2s := str.tostring(K1.tp2R) + "R"
    else
        if d * (opp - entry) >= K1.minRR * risk
            tp2 := opp
            tp2s := rTF + (d == 1 ? " CRT HIGH" : " CRT LOW")
        else
            // external liquidity beyond the opposite boundary, capped at one extra range height
            [px, kx] = f_nearestLiq(arr, d, entry, K1.minRR * risk, opp + d * (rHi - rLo))
            if not na(px)
                tp2 := px
                tp2s := kx
    // Cap far structural targets (e.g. a 4H boundary hundreds of points away)
    if not na(tp2) and K1.tp2Mode != "R multiple" and K1.tp2MaxR > 0 and d * (tp2 - entry) > K1.tp2MaxR * risk
        [pc, kc] = f_nearestLiq(arr, d, entry, K1.minRR * risk, entry + d * K1.tp2MaxR * risk)
        tp2 := not na(pc) ? pc : entry + d * K1.tp2MaxR * risk
        tp2s := not na(pc) ? kc : "cap " + str.tostring(K1.tp2MaxR) + "R"
    float tp1 = na
    string tp1s = ""
    if not na(tp2)
        if K1.tp1Mode == "R multiple"
            tp1 := entry + d * K1.tp1R * risk
            tp1s := str.tostring(K1.tp1R) + "R"
        else
            if K1.tp1Mode == "CRT 50%" and d * (rMid - entry) >= K1.tp1MinR * risk and d * (tp2 - rMid) > 0
                tp1 := rMid
                tp1s := "CRT 50%"
            if na(tp1)
                [p1x, k1x] = f_nearestLiq(arr, d, entry, K1.tp1MinR * risk, tp2)
                if not na(p1x) and d * (tp2 - p1x) > 0
                    tp1 := p1x
                    tp1s := k1x
            if na(tp1)
                tp1 := entry + d * K1.tp1R * risk
                tp1s := str.tostring(K1.tp1R) + "R"
        if d * (tp2 - tp1) <= 0
            tp1 := entry + (tp2 - entry) * 0.5
            tp1s := "½ way to TP2"
    [tp1, tp2, tp1s, tp2s]

// ── Diagnostic log (last 20 setup outcomes). Arrays, so functions may append to them.
var array<string> diagT = array.new<string>()
var array<string> diagS = array.new<string>()
var array<string> diagC = array.new<string>()
var array<string> diagR = array.new<string>()

f_log(string what, string cat, string why) =>
    diagT.push(str.format_time(time, "MM-dd HH:mm", syminfo.timezone))
    diagS.push(what)
    diagC.push(cat)
    diagR.push(why)
    if diagT.size() > 20
        diagT.shift()
        diagS.shift()
        diagC.shift()
        diagR.shift()

f_desc(Setup s) =>
    (s.dir == 1 ? "LONG · " : "SHORT · ") + s.srcKind + " " + f_p(s.level)

f_pendDel(Setup s) =>
    if not na(s.plInv)
        line.delete(s.plInv)
        line.delete(s.plMid)
        label.delete(s.pbInv)
        label.delete(s.pbMid)
    s.plInv := na
    s.plMid := na
    s.pbInv := na
    s.pbMid := na

// Ends a pending setup WITHOUT a trade. cat: STRUCTURAL · CONFLICT · MISSED · EXPIRED · SESSION · REPLACED
f_invalidate(Setup s, string cat, string why, array<label> q) =>
    s.state := 9
    s.cat := cat
    s.reason := why
    s.doneBar := bar_index
    f_pendDel(s)
    string tag = cat == "STRUCTURAL" ? "✕ INVALIDATED" : cat == "CONFLICT" ? "✕ CONFLICT" : cat == "MISSED" ? "MISSED ENTRY" : cat == "SESSION" ? "SESSION CLOSED" : cat == "REPLACED" ? "REPLACED" : "EXPIRED"
    if K3.isDet
        f_evLabel(q, bar_index, s.dir == 1 ? low : high, tag, color.new(C_GREY, 15), color.white, s.dir == 1 ? label.style_label_up : label.style_label_down, size.tiny, why, s.dir == 1 ? yloc.belowbar : yloc.abovebar)
    f_log(f_desc(s), cat, why)
    if K1.alMgmt
        f_alert("SETUP_" + cat, s.dir, s.level, na, na, na, na, why)

// ── Shared trade lifecycle (Model A and Model C use the SAME fill + exit rules)
// mdl = "A" or "C". Event names for Model A are unchanged; Model C events get a "C_" prefix.
f_fill(Setup s, array<label> q, string mdl) =>
    string pfx = mdl == "A" ? "" : mdl + " "
    string epf = mdl == "A" ? "" : mdl + "_"
    s.entry := open
    s.fillBar := bar_index
    s.state := 6
    if not na(s.lines) and s.lines.size() > 0
        line.set_y1(s.lines.get(0), open)
        line.set_y2(s.lines.get(0), open)
        label.set_y(s.labels.get(0), open)
        label.set_text(s.labels.get(0), pfx + "ENTRY " + f_p(open))
        if s.dir == 1
            box.set_top(s.boxes.get(0), open)
            box.set_bottom(s.boxes.get(1), open)
        else
            box.set_bottom(s.boxes.get(0), open)
            box.set_top(s.boxes.get(1), open)
    if K3.isDet
        f_evLabel(q, bar_index, open, pfx + "FILL " + f_p(open), color.new(K1.cEntry, 25), color.white, label.style_label_left, size.tiny, "Simulated fill (next bar open)", yloc.price)
    if K1.alSig
        f_alert(epf + "ENTRY_FILLED_SIM", s.dir, na, open, s.stop, s.tp1, s.tp2, "Model " + mdl + " simulated fill at bar open")

// Conservative intrabar order: STOP first. Returns [outcome ("" while open), tp1 hit this bar, stop hit].
f_manage(Setup s, array<label> q, string mdl) =>
    string pfx = mdl == "A" ? "" : mdl + " "
    string epf = mdl == "A" ? "" : mdl + "_"
    int dP = s.dir
    string outc = ""
    bool hitT1 = false
    bool stopH = false
    bool hitStop = dP == 1 ? low <= s.stop : high >= s.stop
    if hitStop
        float xPx = dP == 1 ? math.min(open, s.stop) : math.max(open, s.stop)
        float rLeg = dP * (xPx - s.entry) / s.riskRef
        s.resultR := s.tp1Done ? s.resultR + (1 - K3.w1) * rLeg : rLeg
        outc := s.tp1Done and s.beOn ? "BE STOP" : "STOP HIT"
        stopH := true
    else
        hitT1 := not s.tp1Done and (dP == 1 ? high >= s.tp1 : low <= s.tp1)
        if hitT1
            s.tp1Done := true
            s.resultR := K3.w1 * dP * (s.tp1 - s.entry) / s.riskRef
            if not na(s.labels) and s.labels.size() > 2
                label.set_text(s.labels.get(2), pfx + "TP1 ✓ " + f_p(s.tp1))
            if K3.isDet
                f_evLabel(q, bar_index, s.tp1, pfx + "TP1 HIT", color.new(K1.cTP, 20), color.black, dP == 1 ? label.style_label_down : label.style_label_up, size.small, "Partial closed at TP1", yloc.price)
            if K1.alMgmt
                f_alert(epf + "TP1_HIT", dP, s.tp1, s.entry, s.stop, s.tp1, s.tp2, "")
            if K3.w1 >= 1.0
                outc := "TP1 HIT"
        if outc == "" and s.tp1Done and (dP == 1 ? high >= s.tp2 : low <= s.tp2)
            s.resultR := s.resultR + (1 - K3.w1) * dP * (s.tp2 - s.entry) / s.riskRef
            outc := "TP2 HIT"
        if outc == "" and K1.maxBars > 0 and bar_index - s.fillBar + 1 >= K1.maxBars
            float rE = dP * (close - s.entry) / s.riskRef
            s.resultR := s.tp1Done ? s.resultR + (1 - K3.w1) * rE : rE
            outc := "EARLY EXIT"
        if hitT1 and K1.useBE and outc == ""
            s.beOn := true
            s.stop := s.entry
            if not na(s.lines) and s.lines.size() > 1
                line.set_y1(s.lines.get(1), s.entry)
                line.set_y2(s.lines.get(1), s.entry)
                label.set_y(s.labels.get(1), s.entry)
                label.set_text(s.labels.get(1), pfx + "SL → BE " + f_p(s.entry))
    if outc != ""
        s.state := 8
        s.outcome := outc
        s.doneBar := bar_index
        f_tradeExtend(s, bar_index)
        bool isWin = s.resultR > 0
        float yO = outc == "STOP HIT" or outc == "BE STOP" ? s.stop : outc == "EARLY EXIT" ? close : outc == "TP1 HIT" ? s.tp1 : s.tp2
        bool towardTP = outc == "TP2 HIT" or outc == "TP1 HIT"
        string stO = (dP == 1) == towardTP ? label.style_label_down : label.style_label_up
        f_evLabel(q, bar_index, yO, pfx + outc + " " + (s.resultR >= 0 ? "+" : "") + f_r(s.resultR) + "R", color.new(isWin ? K1.cTP : outc == "BE STOP" ? C_GREY : K1.cSL, 15), isWin ? color.black : color.white, stO, size.small, "Simulated result", yloc.price)
        f_log(f_desc(s), "TRADE", outc + " " + (s.resultR >= 0 ? "+" : "") + f_r(s.resultR) + "R (simulated)")
        if K1.alMgmt
            f_alert(epf + (outc == "TP2 HIT" ? "TP2_HIT" : outc == "TP1 HIT" ? "TP1_FULL_EXIT" : outc == "EARLY EXIT" ? "EARLY_EXIT" : "STOP_HIT"), dP, yO, s.entry, s.stop, s.tp1, s.tp2, "result " + f_r(s.resultR) + "R")
    else
        f_tradeExtend(s, bar_index + 4)
    [outc, hitT1, stopH]

// Session high/low tracker (must be called on every bar).
f_sess(bool inS) =>
    var float sH = na
    var float sL = na
    var int   sT = na
    var float dH = na
    var float dL = na
    var int   dT = na
    bool ended = false
    if inS and not inS[1]
        sH := high
        sL := low
        sT := time
    else if inS
        sH := math.max(sH, high)
        sL := math.min(sL, low)
    if not inS and inS[1] and not na(sH)
        dH := sH
        dL := sL
        dT := sT
        ended := true
    [sH, sL, dH, dL, dT, ended]


// 15M market-structure engine. Runs INSIDE request.security on the confirmation TF.
// Every returned value is shifted [1] → with lookahead_on this yields only the last
// COMPLETED confirmation candle (no future leak, no repaint).
f_struct(int L, int R, float dm) =>
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    float a  = ta.atr(14)
    bool disp = math.abs(close - open) >= dm * a
    var float swH = na
    var float swL = na
    var int   swHT = na
    var int   swLT = na
    var bool  swHB = true
    var bool  swLB = true
    var int   trend = 0
    var int   bullT = na
    var float bullLvl = na
    var int   bullPT = na
    var bool  bullCh = false
    var bool  bullDs = false
    var int   bearT = na
    var float bearLvl = na
    var int   bearPT = na
    var bool  bearCh = false
    var bool  bearDs = false
    var int   bullDT = na
    var int   bearDT = na
    if not na(ph)
        swH := ph
        swHT := time[R]
        swHB := false
    if not na(pl)
        swL := pl
        swLT := time[R]
        swLB := false
    if not swHB and close > swH
        swHB := true
        bullCh := trend <= 0
        bullDs := disp and close > open
        trend := 1
        bullT := time_close
        bullLvl := swH
        bullPT := swHT
    if not swLB and close < swL
        swLB := true
        bearCh := trend >= 0
        bearDs := disp and close < open
        trend := -1
        bearT := time_close
        bearLvl := swL
        bearPT := swLT
    if close > open and disp and close > high[1]
        bullDT := time_close
    if close < open and disp and close < low[1]
        bearDT := time_close
    [bullT[1], bullLvl[1], bullPT[1], bullCh[1], bullDs[1], bullDT[1], bearT[1], bearLvl[1], bearPT[1], bearCh[1], bearDs[1], bearDT[1], trend[1], swH[1], swHB[1], swHT[1], swL[1], swLB[1], swLT[1]]

// ───────────────────────────── MULTI-TIMEFRAME DATA (non-repainting) ─────────────────────────────
// Pattern: expression[1] + lookahead_on = the last fully closed higher-TF candle,
// identical on historical and realtime bars.
// [2] = the candles BEFORE the reference candle (external-boundary rule)
[h4H, h4L, h4T, h4ATR, h4C, h4TC, h4PH, h4PL] = request.security(syminfo.tickerid, tfHigh, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[h1H, h1L, h1T, h1ATR, h1C, h1TC, h1PH, h1PL] = request.security(syminfo.tickerid, tfLow, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[c15BullT, c15BullLvl, c15BullPT, c15BullCh, c15BullDs, c15BullDT, c15BearT, c15BearLvl, c15BearPT, c15BearCh, c15BearDs, c15BearDT, c15Trend, c15SwH, c15SwHB, c15SwHT, c15SwL, c15SwLB, c15SwLT] = request.security(syminfo.tickerid, tfConf, f_struct(pivL15, pivR15, dispMult), lookahead = barmerge.lookahead_on)

[c15C, c15TC] = request.security(syminfo.tickerid, tfConf, [close[1], time_close[1]], lookahead = barmerge.lookahead_on)

// ── Model C: completed 15M candles. TWO deliberately different requests:
//  (a) lookahead_OFF, read ONLY on the confirmed chart bar whose close equals the 15M close
//      (time_close == time_close(tfConf)). At that instant the 15M candle is complete, so its
//      values are final on historical AND realtime bars → signal at the true 15M close.
//  (b) expr[1] + lookahead_on = the previous completed 15M candle. Used only as a fallback when
//      (a) was skipped (e.g. a missing chart bar). Each candle is processed exactly once (by time).
[q15O, q15H, q15L, q15C, q15T, q15V, q15ATR, q15VA] = request.security(syminfo.tickerid, tfConf, [open, high, low, close, time, volume, ta.atr(14), ta.sma(volume, 20)], lookahead = barmerge.lookahead_off)
[p15O, p15H, p15L, p15C, p15T, p15V, p15ATR, p15VA] = request.security(syminfo.tickerid, tfConf, [open[1], high[1], low[1], close[1], time[1], volume[1], ta.atr(14)[1], ta.sma(volume, 20)[1]], lookahead = barmerge.lookahead_on)
// Directional bias: last COMPLETED 4H / 1H close vs that TF's EMA (non-repainting)
[b4C, b4E] = request.security(syminfo.tickerid, tfHigh, [close[1], ta.ema(close, cEmaLen)[1]], lookahead = barmerge.lookahead_on)
[b1C, b1E] = request.security(syminfo.tickerid, tfLow, [close[1], ta.ema(close, cEmaLen)[1]], lookahead = barmerge.lookahead_on)
int  cBias4 = na(b4E) ? 0 : b4C > b4E ? 1 : b4C < b4E ? -1 : 0
int  cBias1 = na(b1E) ? 0 : b1C > b1E ? 1 : b1C < b1E ? -1 : 0
bool c15Last = time_close == time_close(tfConf)

bool h4New   = not na(h4T) and (na(h4T[1]) or h4T != h4T[1])
bool c15New  = not na(c15TC) and (na(c15TC[1]) or c15TC != c15TC[1])
bool h1New   = not na(h1T) and (na(h1T[1]) or h1T != h1T[1])
bool pdNew   = not na(pdT) and (na(pdT[1]) or pdT != pdT[1])
bool pwNew   = not na(pwT) and (na(pwT[1]) or pwT != pwT[1])
bool swHNew  = not na(c15SwHT) and (na(c15SwHT[1]) or c15SwHT != c15SwHT[1])
bool swLNew  = not na(c15SwLT) and (na(c15SwLT[1]) or c15SwLT != c15SwLT[1])
bool mBullNew = not na(c15BullT) and (na(c15BullT[1]) or c15BullT != c15BullT[1])
bool mBearNew = not na(c15BearT) and (na(c15BearT[1]) or c15BearT != c15BearT[1])

// ── Multi-timeframe values for this bar, as one object for the functions (same values, non-repainting)
type MTFV
    float h4H
    float h4L
    int h4T
    float h4ATR
    float h4C
    int h4TC
    float h4PH
    float h4PL
    float h1H
    float h1L
    int h1T
    float h1ATR
    float h1C
    int h1TC
    float h1PH
    float h1PL
    float pdH
    float pdL
    float pwH
    float pwL
    int c15BullT
    float c15BullLvl
    int c15BullPT
    bool c15BullCh
    bool c15BullDs
    int c15BullDT
    int c15BearT
    float c15BearLvl
    int c15BearPT
    bool c15BearCh
    bool c15BearDs
    int c15BearDT
    int c15Trend
    float c15SwH
    bool c15SwHB
    int c15SwHT
    float c15SwL
    bool c15SwLB
    int c15SwLT
    float c15C
    int c15TC
    float q15O
    float q15H
    float q15L
    float q15C
    int q15T
    float q15V
    float q15ATR
    float q15VA
    float p15O
    float p15H
    float p15L
    float p15C
    int p15T
    float p15V
    float p15ATR
    float p15VA
    bool h4New
    bool h1New
    bool pdNew
    bool pwNew
    bool swHNew
    bool swLNew
    bool mBullNew
    bool mBearNew
    bool c15New
    int cBias4
    int cBias1
    bool c15Last

MTFV Q = MTFV.new(h4H = h4H, h4L = h4L, h4T = h4T, h4ATR = h4ATR, h4C = h4C, h4TC = h4TC, h4PH = h4PH, h4PL = h4PL,
     h1H = h1H, h1L = h1L, h1T = h1T, h1ATR = h1ATR, h1C = h1C, h1TC = h1TC, h1PH = h1PH, h1PL = h1PL,
     pdH = pdH, pdL = pdL, pwH = pwH, pwL = pwL, c15BullT = c15BullT, c15BullLvl = c15BullLvl, c15BullPT = c15BullPT, c15BullCh = c15BullCh,
     c15BullDs = c15BullDs, c15BullDT = c15BullDT, c15BearT = c15BearT, c15BearLvl = c15BearLvl, c15BearPT = c15BearPT, c15BearCh = c15BearCh, c15BearDs = c15BearDs, c15BearDT = c15BearDT,
     c15Trend = c15Trend, c15SwH = c15SwH, c15SwHB = c15SwHB, c15SwHT = c15SwHT, c15SwL = c15SwL, c15SwLB = c15SwLB, c15SwLT = c15SwLT, c15C = c15C,
     c15TC = c15TC, q15O = q15O, q15H = q15H, q15L = q15L, q15C = q15C, q15T = q15T, q15V = q15V, q15ATR = q15ATR,
     q15VA = q15VA, p15O = p15O, p15H = p15H, p15L = p15L, p15C = p15C, p15T = p15T, p15V = p15V, p15ATR = p15ATR,
     p15VA = p15VA, h4New = h4New, h1New = h1New, pdNew = pdNew, pwNew = pwNew, swHNew = swHNew, swLNew = swLNew, mBullNew = mBullNew,
     mBearNew = mBearNew, c15New = c15New, cBias4 = cBias4, cBias1 = cBias1, c15Last = c15Last)


// ───────────────────────────── MODEL C HELPERS ─────────────────────────────
f_hhmm(int t, string tz) => hour(t, tz) * 100 + minute(t, tz)
f_fmtT(int t) => str.format_time(t, "MM-dd HH:mm", syminfo.timezone)

// Is open time `t` inside session "HHMM-HHMM" in time zone `tz`? (DST handled by the IANA zone)
f_inSessT(int t, string sess, string tz) =>
    int a = int(str.tonumber(str.substring(sess, 0, 4)))
    int b = int(str.tonumber(str.substring(sess, 5, 9)))
    int m = f_hhmm(t, tz)
    a < b ? (m >= a and m < b) : (m >= a or m < b)

// Name of the session whose OPEN candle starts at `t`, or "".
f_cOpen(int t) =>
    string nm = ""
    if K2.cOpenNy and f_hhmm(t, K1.nyTZ) == int(str.tonumber(K2.cOpenNyT))
        nm := "NY open"
    else if K2.cOpenLon and f_hhmm(t, K1.lonTZ) == int(str.tonumber(K2.cOpenLonT))
        nm := "London open"
    else if K2.cOpenAsia and f_hhmm(t, K1.asiaTZ) == int(str.tonumber(K2.cOpenAsiaT))
        nm := "Asia open"
    nm

// Effective bias for Model C after the conflict policy. Returns [bias, conflict, text].
f_cBias() =>
    bool conflict = Q.cBias4 != Q.cBias1
    int eff = K2.cBiasMode == "4H only" ? Q.cBias4 : K2.cBiasMode == "1H only" ? Q.cBias1 : not conflict ? Q.cBias4 : K2.cConflict == "Follow 4H" ? Q.cBias4 : K2.cConflict == "Follow 1H" ? Q.cBias1 : 0
    string a4 = Q.cBias4 == 1 ? "↑" : Q.cBias4 == -1 ? "↓" : "–"
    string a1 = Q.cBias1 == 1 ? "↑" : Q.cBias1 == -1 ? "↓" : "–"
    string txt = K2.cBiasMode == "Off" ? "bias filter OFF (" + K3.n4 + " " + a4 + " · " + K3.n1 + " " + a1 + ")" : K3.n4 + " " + a4 + " · " + K3.n1 + " " + a1 + (K2.cBiasMode == "4H + 1H" ? (conflict ? " → CONFLICT (" + K2.cConflict + ")" : " → aligned") : "")
    [eff, conflict, txt]

// Context filters for a confirmed breakout. Returns "" when it passes, else the plain-English reason.
f_cFilter(int d, int ct, float kO, float kC, float kAtr, float kV, float kVA) =>
    string why = ""
    bool inS = K2.cSesAny or (K2.cSesAsia and f_inSessT(ct, K1.asiaSess, K1.asiaTZ)) or (K2.cSesLon and f_inSessT(ct, K1.lonSess, K1.lonTZ)) or (K2.cSesNy and f_inSessT(ct, K1.nySess, K1.nyTZ))
    [eff, conflict, btxt] = f_cBias()
    if not inS
        why := "the breakout candle (" + f_fmtT(ct) + ") is outside the enabled sessions"
    else if K2.cBiasMode == "4H + 1H" and conflict and K2.cConflict == "Block trade"
        why := K3.n4 + " and " + K3.n1 + " bias disagree (" + btxt + ")"
    else if K2.cBiasMode != "Off" and eff != d
        why := "it is against the directional bias (" + btxt + ")"
    else if K2.cStructF and Q.c15Trend != d
        why := K3.nC + " market structure is not " + (d == 1 ? "bullish" : "bearish")
    else if K2.cDispMin > 0 and not na(kAtr) and math.abs(kC - kO) < K2.cDispMin * kAtr
        why := "breakout body " + f_r(math.abs(kC - kO) / kAtr) + " ATR < " + f_r(K2.cDispMin) + " ATR"
    else if K2.cVolMult > 0 and not na(kV) and not na(kVA) and kVA > 0 and kV < K2.cVolMult * kVA
        why := "breakout volume " + f_r(kV / kVA) + "× average < " + f_r(K2.cVolMult) + "×"
    why

// Model C targets. Returns [tp1, tp2, tp1 source, tp2 source, reason-if-not-tradable].
f_cTargets(int d, float e, float risk, array<Liq> arr) =>
    float t1 = na
    float t2 = na
    string s1 = str.tostring(K2.cTp1R) + "R"
    string s2 = str.tostring(K2.cTp2R) + "R"
    string miss = ""
    float capP = K2.cTp2MaxR > 0 ? e + d * K2.cTp2MaxR * risk : na
    if K2.cTpMode == "R multiples"
        t1 := e + d * K2.cTp1R * risk
        t2 := e + d * K2.cTp2R * risk
    else if K2.cTpMode == "Nearest liquidity (strict)"
        t1 := e + d * K2.cTp1R * risk
        t2 := e + d * K2.cTp2R * risk
        [pL, kLq] = f_nearestLiq(arr, d, e, 0.0, na)
        if not na(pL)
            if d * (pL - e) < K2.cMinRR * risk
                miss := "the nearest liquidity (" + kLq + " " + f_p(pL) + ") is only " + f_r(d * (pL - e) / risk) + "R away"
            else
                t2 := pL
                s2 := kLq
    else
        [p1, k1] = f_nearestLiq(arr, d, e, K1.tp1MinR * risk, capP)
        t1 := not na(p1) ? p1 : e + d * K2.cTp1R * risk
        s1 := not na(p1) ? k1 : s1
        [p2, k2] = f_nearestLiq(arr, d, e, math.max(K2.cMinRR * risk, d * (t1 - e) + syminfo.mintick), capP)
        t2 := not na(p2) ? p2 : e + d * K2.cTp2R * risk
        s2 := not na(p2) ? k2 : s2
    if not na(capP) and d * (t2 - capP) > 0
        t2 := capP
        s2 := "cap " + str.tostring(K2.cTp2MaxR) + "R"
    if d * (t2 - t1) <= 0
        t1 := e + (t2 - e) * 0.5
        s1 := "½ to TP2"
    if miss == "" and d * (t2 - e) / risk < K2.cMinRR
        miss := "TP2 offers only " + f_r(d * (t2 - e) / risk) + "R (< " + f_r(K2.cMinRR) + "R)"
    [t1, t2, s1, s2, miss]

method cLock(CRef r, float h2, float l2, int t2) =>
    r.h2 := h2
    r.l2 := l2
    r.t2 := t2
    r.up := math.max(r.h1, h2)
    r.lo := math.min(r.l1, l2)
    r.state := 2
    r.nSeen := 0
    color cl = color.new(K2.cCol, 10)
    if K3.isDet
        r.lns.push(line.new(r.t1, r.h1, r.t1 + K3.c15Ms, r.h1, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(r.t1, r.l1, r.t1 + K3.c15Ms, r.l1, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(t2, h2, t2 + K3.c15Ms, h2, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(t2, l2, t2 + K3.c15Ms, l2, xloc = xloc.bar_time, color = cl, width = 2))
    if K2.cShowBnd
        r.lns.push(line.new(r.t1, r.up, time + K3.labOff, r.up, xloc = xloc.bar_time, color = color.new(K2.cCol, 35), style = line.style_dashed, width = 1))
        r.lns.push(line.new(r.t1, r.lo, time + K3.labOff, r.lo, xloc = xloc.bar_time, color = color.new(K2.cCol, 35), style = line.style_dashed, width = 1))
        r.lbU := label.new(time + K3.labOff, r.up, "C UPPER " + f_p(r.up), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = K2.cCol, size = size.tiny)
        r.lbL := label.new(time + K3.labOff, r.lo, "C LOWER " + f_p(r.lo), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = K2.cCol, size = size.tiny)
    if K1.alMgmt
        f_alert("C_REFERENCE_LOCKED", 0, na, na, na, na, na, r.src + " pair " + f_fmtT(r.t1) + " + " + f_fmtT(t2) + " · upper " + f_p(r.up) + " · lower " + f_p(r.lo))

method cExtend(CRef r, int x2) =>
    int nL = r.lns.size()
    if nL >= 2 and not na(r.lbU)
        line.set_x2(r.lns.get(nL - 2), x2)
        line.set_x2(r.lns.get(nL - 1), x2)
        label.set_x(r.lbU, x2)
        label.set_x(r.lbL, x2)

method cErase(CRef r) =>
    if not na(r.lns)
        for ln in r.lns
            line.delete(ln)
    if not na(r.lbU)
        label.delete(r.lbU)
        label.delete(r.lbL)

// End a reference pair. st: 7 confirmed · 9 invalidated · 10 expired · 11 missed entry
method cEnd(CRef r, int st, string why, array<label> q) =>
    r.state := st
    r.endWhy := why
    r.endT := time
    r.cExtend(time)
    if st != 7
        string cat = st == 9 ? "INVALIDATED" : st == 10 ? "EXPIRED" : "NOT TRADABLE"
        if not K3.isDet
            r.cErase()
        else
            f_evLabel(q, bar_index, high, "C " + (st == 9 ? "✕ INVALID" : st == 10 ? "EXPIRED" : "NOT TRADABLE"), C_CLEAR, K2.cCol, label.style_label_down, size.tiny, why, yloc.abovebar)
        f_log("C · " + r.src + " U " + f_p(r.up) + " / L " + f_p(r.lo), cat, why)
        if K1.alMgmt
            f_alert(st == 9 ? "C_INVALIDATED" : st == 10 ? "C_EXPIRED" : "C_MISSED_ENTRY", 0, na, na, na, na, na, why)

// ───────────────────────────── CHART-TF SERIES ─────────────────────────────
float atrE = ta.atr(14)
float ph5  = ta.pivothigh(high, pivL5, pivR5)
float pl5  = ta.pivotlow(low, pivL5, pivR5)

bool inAsia = not na(time(timeframe.period, asiaSess, asiaTZ))
bool inLon  = not na(time(timeframe.period, lonSess, lonTZ))
bool inNy   = not na(time(timeframe.period, nySess, nyTZ))
[asH, asL, asDH, asDL, asDT, asEnd] = f_sess(inAsia)
[lnH, lnL, lnDH, lnDL, lnDT, lnEnd] = f_sess(inLon)
[nyH, nyL, nyDH, nyDL, nyDT, nyEnd] = f_sess(inNy)

bool winAsia = wAsiaOn and not na(time(timeframe.period, wAsiaS, asiaTZ))
bool winLon  = wLonOn and not na(time(timeframe.period, wLonS, lonTZ))
bool winNy   = wNyOn and not na(time(timeframe.period, wNyS, nyTZ))
bool entryAllowed = winAsia or winLon or winNy

// Per-bar event flags (set inside the engine functions; read by alerts, dashboard and strategy)
type EV
    bool evHiSwept = false
    bool evLoSwept = false
    bool evReclaim = false
    bool evConfBull = false
    bool evConfBear = false
    bool evBuy = false
    bool evSell = false
    bool evTP1 = false
    bool evTP2 = false
    bool evStop = false
    bool evEarly = false
    bool evInval = false
    bool evDone = false
    bool evCLock = false
    bool evCBuy = false
    bool evCSell = false
    bool evCInval = false
    bool evCExp = false
    bool evCMiss = false
    bool evCFill = false
    bool evCTP1 = false
    bool evCStop = false
    bool evCTP2 = false
    bool evCEarly = false
    bool evCDone = false
    bool evDLock = false
    bool evDManip = false
    bool evDBuy = false
    bool evDSell = false
    bool evDInval = false
    bool evDExp = false
    bool evDMiss = false
    bool evDFill = false
    bool evDTP1 = false
    bool evDStop = false
    bool evDTP2 = false
    bool evDEarly = false
    bool evDDone = false

// ───────────────────────────── STATE ─────────────────────────────
var array<Liq>   pools     = array.new<Liq>()
var array<line>  hist4     = array.new<line>()
var array<line>  hist1     = array.new<line>()
var array<label> evLabels  = array.new<label>()
var array<box>   zoneQ     = array.new<box>()
var array<line>  mssQ      = array.new<line>()
var array<Setup> tradeHist = array.new<Setup>()
var CRTRange r4 = CRTRange.new(tf = n4)
var CRTRange r1 = CRTRange.new(tf = n1)
var Setup S = Setup.new()
var AMD          AD       = AMD.new()
var Setup        TD       = Setup.new()
var array<Setup> dTrades  = array.new<Setup>()
var array<box>   amdBoxes = array.new<box>()
var int          amdLastEnd = na
var int    lastSSLBar = na     // last bar a sell-side level was swept & reclaimed (any tracked level)
var int    lastBSLBar = na
var int    h4Bias    = 0
var string lastLiq   = "No sweep yet"
var string lastBlock = ""
var float  sw5H  = na
var float  sw5L  = na
var bool   sw5HB = true
var bool   sw5LB = true
var int    lastBull5Bar = na
var int    lastBear5Bar = na
var int    simN  = 0
var int    simW  = 0
var float  simR  = 0.0

// Per-bar event flags (alertcondition + strategy layer)
bool bull5Brk   = false
bool bear5Brk   = false

// ═══════════════════════════════════════════════════════════════════════════════
//  ENGINE — runs once per CLOSED chart bar only (no intrabar signals, no repaint)
// ═══════════════════════════════════════════════════════════════════════════════
EV E = EV.new()

// ── Shared context, evaluated FIRST on every closed bar so every model sees the same state
if barstate.isconfirmed
    // ── 1. Entry-TF structure (pivot levels exist only after their right bars close)
    if not na(ph5)
        sw5H := ph5
        sw5HB := false
    if not na(pl5)
        sw5L := pl5
        sw5LB := false
    if not sw5HB and close > sw5H
        sw5HB := true
        bull5Brk := true
        lastBull5Bar := bar_index
    if not sw5LB and close < sw5L
        sw5LB := true
        bear5Brk := true
        lastBear5Bar := bar_index


// ═══════════════════════════════════════════════════════════════════════════════
//  FVG + SUPPLY / DEMAND ENGINES — context only (they never create trades by themselves).
//  Everything is evaluated on CLOSED chart bars; a gap / zone exists only from the bar on
//  which its last candle closed. Only the nearest zones are drawn, on the last bar.
// ═══════════════════════════════════════════════════════════════════════════════
var array<FVG>  fvgs   = array.new<FVG>()
var array<Zone> zones  = array.new<Zone>()
var array<box>  ctxBox = array.new<box>()

f_zRank(Zone z) =>
    (z.touches == 0 ? 2 : z.touches == 1 ? 1 : 0) + (z.bos ? 1 : 0) + (z.disp >= 2 * K2.sdDispATR ? 2 : 1)

f_blkContext(bool go) =>
    if go
        // ── FVG update (gaps created on an earlier bar only)
        if K2.fvgOn and fvgs.size() > 0
            for i = fvgs.size() - 1 to 0
                FVG g = fvgs.get(i)
                if g.bar < bar_index and g.state < 2
                    if g.dir == 1
                        if close < g.bot
                            if g.inv
                                g.state := 3
                            else
                                g.inv := true
                                g.dir := -1
                                g.state := 0
                                g.fill := 0.0
                                g.bar := bar_index
                        else if low <= g.bot
                            g.state := 2
                        else if low < g.top
                            g.state := 1
                            g.fill := math.max(g.fill, (g.top - low) / (g.top - g.bot))
                    else
                        if close > g.top
                            if g.inv
                                g.state := 3
                            else
                                g.inv := true
                                g.dir := 1
                                g.state := 0
                                g.fill := 0.0
                                g.bar := bar_index
                        else if high >= g.top
                            g.state := 2
                        else if high > g.bot
                            g.state := 1
                            g.fill := math.max(g.fill, (high - g.bot) / (g.top - g.bot))
                if g.state >= 2 or bar_index - g.bar > K2.fvgMaxAge
                    fvgs.remove(i)
        // ── FVG detection: three CLOSED candles [2], [1], [0]
        if K2.fvgOn and bar_index >= 2 and not na(atrE)
            float body1 = math.abs(close[1] - open[1])
            float gUp = low - high[2]
            float gDn = low[2] - high
            if gUp > 0 and gUp >= K2.fvgMinATR * atrE
                fvgs.push(FVG.new(dir = 1, top = low, bot = high[2], t0 = time[1], bar = bar_index, disp = body1 / atrE, strong = close[1] > open[1] and body1 >= K2.fvgStrongATR * atrE))
            if gDn > 0 and gDn >= K2.fvgMinATR * atrE
                fvgs.push(FVG.new(dir = -1, top = low[2], bot = high, t0 = time[1], bar = bar_index, disp = body1 / atrE, strong = close[1] < open[1] and body1 >= K2.fvgStrongATR * atrE))
            while fvgs.size() > 40
                fvgs.shift()

        // ── Supply / demand update
        if K2.sdOn and zones.size() > 0
            for i = zones.size() - 1 to 0
                Zone z = zones.get(i)
                if z.state == 0 and z.bar < bar_index
                    bool thru = z.dir == 1 ? close < z.bot : close > z.top
                    bool touch = z.dir == 1 ? low <= z.top : high >= z.bot
                    if thru
                        z.state := 1
                        z.endBar := bar_index
                    else if touch
                        if not z.inside
                            z.touches := z.touches + 1
                            z.inside := true
                            if z.touches > K2.sdMaxTouch
                                z.state := 2
                                z.endBar := bar_index
                    else
                        z.inside := false
                if bar_index - z.bar > K2.sdMaxAge or (z.state != 0 and bar_index - z.endBar > 48)
                    zones.remove(i)
        // ── Supply / demand detection: this CLOSED bar is a displacement candle
        if K2.sdOn and bar_index > K2.sdLook and not na(atrE)
            bool bullD = close > open and close - open >= K2.sdDispATR * atrE and close > high[1]
            bool bearD = close < open and open - close >= K2.sdDispATR * atrE and close < low[1]
            if bullD or bearD
                int dZ = bullD ? 1 : -1
                int k = 1
                for j = 1 to K2.sdLook
                    if dZ == 1 ? close[j] < open[j] : close[j] > open[j]
                        k := j
                        break
                float zt = high[k]
                float zb = low[k]
                bool zBos = dZ == 1 ? bull5Brk : bear5Brk
                float zDisp = math.abs(close - open) / atrE
                bool merged = false
                for z in zones
                    if z.state == 0 and z.dir == dZ and zb <= z.top and zt >= z.bot
                        z.disp := math.max(z.disp, zDisp)
                        z.bos := z.bos or zBos
                        merged := true
                        break
                if not merged
                    zones.push(Zone.new(dir = dZ, top = zt, bot = zb, t0 = time[k], bar = bar_index, disp = zDisp, bos = zBos))
                while zones.size() > 30
                    zones.shift()
    true

f_blkContext(barstate.isconfirmed)


// ═══════════════════════════════════════════════════════════════════════════════
//  CONFLUENCE ENGINE — counts objective factors at a model's signal bar.
//  It never replaces a model's entry rules, never requires every factor, and is not a
//  probability. Returns [aligned, opposing, explanation, bias aligned, path to TP1 clear].
//  mdl excludes the model's own trigger from the count (AMD does not count "AMD", FVG not "FVG").
// ═══════════════════════════════════════════════════════════════════════════════
f_cfAdd(string acc, string item) => acc == "" ? item : acc + ", " + item

f_conf(int d, float e, float t1, string mdl) =>
    int pro = 0
    int con = 0
    string ok = ""
    string no = ""
    bool biasOK = Q.cBias4 == d and Q.cBias1 == d
    if biasOK
        pro += 1
        ok := f_cfAdd(ok, K3.n4 + "/" + K3.n1 + " bias")
    else if Q.cBias4 == -d and Q.cBias1 == -d
        con += 1
        no := f_cfAdd(no, K3.n4 + "/" + K3.n1 + " bias")
    if Q.c15Trend == d
        pro += 1
        ok := f_cfAdd(ok, K3.nC + " structure")
    else if Q.c15Trend == -d
        con += 1
        no := f_cfAdd(no, K3.nC + " structure")
    if r1.active
        bool disc = e < r1.mid
        if (d == 1) == disc
            pro += 1
            ok := f_cfAdd(ok, K3.n1 + (disc ? " discount" : " premium"))
        else
            con += 1
            no := f_cfAdd(no, K3.n1 + (disc ? " discount" : " premium"))
    bool fSup = false
    bool fOpp = false
    for g in fvgs
        if g.state < 2
            if g.dir == d and (d == 1 ? g.bot <= e and e - g.top <= atrE : g.top >= e and g.bot - e <= atrE)
                fSup := true
            if g.dir == -d and (d == 1 ? g.bot > e and g.bot < t1 : g.top < e and g.top > t1)
                fOpp := true
    if fSup
        pro += 1
        ok := f_cfAdd(ok, "FVG support")
    if fOpp
        con += 1
        no := f_cfAdd(no, "FVG before TP1")
    bool zSup = false
    bool zOpp = false
    for z in zones
        if z.state == 0
            if z.dir == d and (d == 1 ? z.bot <= e and e - z.top <= atrE : z.top >= e and z.bot - e <= atrE)
                zSup := true
            if z.dir == -d and (d == 1 ? z.bot > e and z.bot < t1 : z.top < e and z.top > t1)
                zOpp := true
    if zSup
        pro += 1
        ok := f_cfAdd(ok, d == 1 ? "demand" : "supply")
    if zOpp
        con += 1
        no := f_cfAdd(no, (d == 1 ? "supply" : "demand") + " before TP1")
    if mdl != "AMD" and AD.state == 3
        if AD.dir == d
            pro += 1
            ok := f_cfAdd(ok, "AMD")
        else
            con += 1
            no := f_cfAdd(no, "AMD")
    int sw = d == 1 ? lastSSLBar : lastBSLBar
    if not na(sw) and bar_index - sw <= 12
        pro += 1
        ok := f_cfAdd(ok, d == 1 ? "SSL swept" : "BSL swept")
    string txt = "✓ " + str.tostring(pro) + (ok != "" ? " (" + ok + ")" : "") + " · ✕ " + str.tostring(con) + (no != "" ? " (" + no + ")" : "")
    [pro, con, txt, biasOK, not fOpp and not zOpp]

// Returns "" if the candidate passes the configured confluence rules, else the reason.
f_cfReject(int pro, int con, bool biasOK, bool clear, string mdl) =>
    bool applies = K3.cfModels == "All models" or (K3.cfModels == "Models A + C only" and (mdl == "A" or mdl == "C"))
    string r = ""
    if applies
        if K3.cfReqBias and not biasOK
            r := "4H and 1H bias are not both aligned (mandatory)"
        else if K3.cfReqClear and not clear
            r := "an opposing FVG / zone sits between entry and TP1 (mandatory)"
        else if K3.cfMode == "Filter — min aligned / max opposing" and pro < K3.cfMinPro
            r := "only " + str.tostring(pro) + " aligned factor(s), needs " + str.tostring(K3.cfMinPro)
        else if K3.cfMode == "Filter — min aligned / max opposing" and con > K3.cfMaxCon
            r := str.tostring(con) + " opposing factor(s), max " + str.tostring(K3.cfMaxCon)
    r

f_engA(bool go, EV e, Setup p_S, int p_h4Bias, int p_lastBSLBar, string p_lastBlock, string p_lastLiq, int p_lastSSLBar, int p_simN, float p_simR, int p_simW) =>
    Setup w_S = p_S
    int w_h4Bias = p_h4Bias
    int w_lastBSLBar = p_lastBSLBar
    string w_lastBlock = p_lastBlock
    string w_lastLiq = p_lastLiq
    int w_lastSSLBar = p_lastSSLBar
    int w_simN = p_simN
    float w_simR = p_simR
    int w_simW = p_simW
    if go
        // ── 2. Roll CRT reference ranges on completion of a 4H / 1H candle
        if Q.h4New
            r4.roll(Q.h4H, Q.h4L, Q.h4T, Q.h4ATR, pools, hist4, K3.vis4, K3.keepHist, K3.primHigh, true, Q.h4PH, Q.h4PL)
        if Q.h1New
            r1.roll(Q.h1H, Q.h1L, Q.h1T, Q.h1ATR, pools, hist1, K3.vis1, K3.keepHist, not K3.primHigh, false, Q.h1PH, Q.h1PL)
        CRTRange pr = K3.primHigh ? (r4.active ? r4 : r1) : (r1.active ? r1 : r4)

        // ── 3. Liquidity pools (built only from information that existed before this bar)
        float tol = K1.eqTolATR * atrE
        int expD = time + K1.poolDays * K3.dayMs
        int expW = time + K1.poolDays * 3 * K3.dayMs
        array<PoolReq> rq = array.new<PoolReq>()
        if K1.trackPD and Q.pdNew
            rq.push(PoolReq.new(Q.pdH, 1, "PDH", expD, na, false))
            rq.push(PoolReq.new(Q.pdL, -1, "PDL", expD, na, false))
        if K1.trackPW and Q.pwNew
            rq.push(PoolReq.new(Q.pwH, 1, "PWH", expW, na, false))
            rq.push(PoolReq.new(Q.pwL, -1, "PWL", expW, na, false))
        if K1.trackSess and asEnd
            rq.push(PoolReq.new(asDH, 1, "ASIA H", expD, asDT, false))
            rq.push(PoolReq.new(asDL, -1, "ASIA L", expD, asDT, false))
        if K1.trackSess and lnEnd
            rq.push(PoolReq.new(lnDH, 1, "LDN H", expD, lnDT, false))
            rq.push(PoolReq.new(lnDL, -1, "LDN L", expD, lnDT, false))
        if K1.trackSess and nyEnd
            rq.push(PoolReq.new(nyDH, 1, "NY H", expD, nyDT, false))
            rq.push(PoolReq.new(nyDL, -1, "NY L", expD, nyDT, false))
        if K1.trackSw and Q.swHNew and not na(Q.c15SwH)
            rq.push(PoolReq.new(Q.c15SwH, 1, K3.nC + " SWING H", expD, Q.c15SwHT, true))
        if K1.trackSw and Q.swLNew and not na(Q.c15SwL)
            rq.push(PoolReq.new(Q.c15SwL, -1, K3.nC + " SWING L", expD, Q.c15SwLT, true))
        for r in rq
            f_addPool(pools, r.p, r.side, r.kind, tol, r.expT, r.x0, r.sw)

        // ── 4. Sweep / breakout classification for every tracked level
        Liq best = na
        int bestScore = 0
        float bHi = na
        float bLo = na
        string bTF = ""
        int bT0 = na
        for l in pools
            if l.retired and l.state != 1
                continue
            bool  nwR = l.rcTF == 1 ? Q.c15New : l.rcTF == 2 ? Q.h1New : Q.h4New
            float ccR = l.rcTF == 1 ? Q.c15C : l.rcTF == 2 ? Q.h1C : Q.h4C
            int   tcR = l.rcTF == 1 ? Q.c15TC : l.rcTF == 2 ? Q.h1TC : Q.h4TC
            int ev = l.process(K3.minPen, K1.reclaimBars, K1.acceptBars, nwR, ccR, tcR)
            if ev == 2
                bool qual = false
                int score = 0
                float qHi = na
                float qLo = na
                string qTF = ""
                int qT0 = na
                if l.isCRT
                    if (l.hiTF ? K3.src4 : K3.src1) and not l.external
                        w_lastBlock := l.kind + " sweep ignored: internal boundary (an earlier " + l.tf + " candle already traded beyond it)"
                    if (l.hiTF ? K3.src4 : K3.src1) and l.external
                        qual := true
                        score := l.hiTF ? 3 : 2
                        qHi := l.rHi
                        qLo := l.rLo
                        qTF := l.tf
                        qT0 := l.rT0
                else if K1.usePools and pr.active
                    l.aligned := l.side == 1 ? l.price >= pr.mid : l.price <= pr.mid
                    if l.aligned
                        qual := true
                        score := 1
                        qHi := pr.hi
                        qLo := pr.lo
                        qTF := pr.tf
                        qT0 := pr.t0
                qual := qual and K3.tfOK and math.abs(l.ext - l.price) <= K1.maxSweepATR * atrE
                if K3.isDet
                    f_sweepLabel(evLabels, l, qual and not l.isCRT)
                    if K3.isDet
                        zoneQ.push(box.new(l.breachBar, math.max(l.price, l.ext), bar_index, math.min(l.price, l.ext), border_color = color.new(l.side == 1 ? K1.cBear : K1.cBull, 60), bgcolor = color.new(l.side == 1 ? K1.cBear : K1.cBull, 88)))
                        if zoneQ.size() > 40
                            box.delete(zoneQ.shift())
                if l.side == -1
                    w_lastSSLBar := bar_index
                else
                    w_lastBSLBar := bar_index
                w_lastLiq := (l.isCRT ? l.kind + " swept" : (l.side == 1 ? "BSL swept · " : "SSL swept · ") + l.kind) + " " + f_p(l.price)
                e.evReclaim := true
                if l.isCRT
                    if l.side == 1
                        e.evHiSwept := true
                    else
                        e.evLoSwept := true
                if K1.alSweep
                    f_alert(l.isCRT ? (l.side == 1 ? "CRT_HIGH_SWEPT" : "CRT_LOW_SWEPT") : "LIQUIDITY_RECLAIMED", -l.side, l.price, na, na, na, na, l.kind + " reclaimed, extreme " + f_p(l.ext))
                if qual and score > bestScore
                    best := l
                    bestScore := score
                    bHi := qHi
                    bLo := qLo
                    bTF := qTF
                    bT0 := qT0
            else if ev == 3 and K3.isDet
                f_evLabel(evLabels, bar_index, l.price, (l.isCRT ? l.kind + " BROKEN" : (l.side == 1 ? "BSL BREAK · " : "SSL BREAK · ") + l.kind), color.new(C_GREY, 30), color.white, l.side == 1 ? label.style_label_down : label.style_label_up, size.tiny, "Breakout, not a sweep", yloc.price)
            if (ev == 2 or ev == 3) and not na(l.ln)
                line.set_extend(l.ln, extend.none)
                line.set_x2(l.ln, time)
                line.set_color(l.ln, color.new(C_GREY, 40))
                label.set_x(l.lb, time)
                label.set_textcolor(l.lb, color.new(C_GREY, 20))
                label.set_text(l.lb, l.kind + (ev == 2 ? " ✓ swept" : " ✗ broken"))

        // ── 5. Higher-TF (4H) bias from the active 4H CRT range
        w_h4Bias := 0
        if r4.active
            bool bu = r4.loLiq.state == 2 or r4.hiLiq.state == 3
            bool bd = r4.hiLiq.state == 2 or r4.loLiq.state == 3
            w_h4Bias := bu and not bd ? 1 : bd and not bu ? -1 : 0

        // ── 6. Simulated fill (next bar open after the signal)
        if w_S.state == 5 and bar_index > w_S.sigBar
            f_fill(w_S, evLabels, "A")
            e.evFill := true

        // ── 7. Position management — conservative intrabar order: STOP first (shared with Model C)
        if w_S.state == 6
            [oA, t1A, stA] = f_manage(w_S, evLabels, "A")
            e.evTP1 := t1A
            e.evStop := stA
            e.evTP2 := oA == "TP2 HIT"
            e.evEarly := oA == "EARLY EXIT"
            if oA != ""
                e.evDone := true
                w_simN += 1
                w_simW += w_S.resultR > 0 ? 1 : 0
                w_simR += w_S.resultR

        // ── 8. Pending-setup checks. Each ending has ONE category and a plain-English reason.
        //    A new 4H / 1H candle opening never ends a setup: all levels below are LOCKED in S.
        if w_S.state == 3 or w_S.state == 4
            int dA = w_S.dir
            string cat = ""
            string why = ""
            // STRUCTURAL: price reached the planned stop (sweep extreme ∓ buffer) — the trade would have lost
            bool through = dA == 1 ? (K1.wickInval ? low <= w_S.invalLvl : close <= w_S.invalLvl) : (K1.wickInval ? high >= w_S.invalLvl : close >= w_S.invalLvl)
            // CONFLICT: the confirmation TF printed a structure break the OTHER way after the reclaim
            int oppT = dA == 1 ? Q.c15BearT : Q.c15BullT
            bool conflict = K1.conflictInval and w_S.state == 3 and not na(oppT) and oppT > w_S.reclaimT
            // MISSED: TP1 area reached before an entry existed (no chasing)
            bool ran = dA == 1 ? high >= w_S.rMid : low <= w_S.rMid
            if through
                cat := "STRUCTURAL"
                why := "Price " + (K1.wickInval ? "traded" : "closed") + " through the planned stop " + f_p(w_S.invalLvl) + " (sweep extreme " + f_p(w_S.ext) + " + buffer) before an entry — the sweep failed."
            else if conflict
                cat := "CONFLICT"
                why := K3.nC + " broke structure " + (dA == 1 ? "DOWN at " + f_p(Q.c15BearLvl) : "UP at " + f_p(Q.c15BullLvl)) + " after the reclaim — opposite confirmation, setup cancelled."
            else if ran
                cat := "MISSED"
                why := "Price reached the CRT 50% " + f_p(w_S.rMid) + " " + (w_S.state == 3 ? "before " + K3.nC + " confirmed" : "after " + K3.nC + " but before a valid " + K3.nE + " entry") + " — move missed, not chased."
            else if w_S.state == 3 and bar_index - w_S.reclaimBar > K1.confExpiry
                cat := "EXPIRED"
                why := "No " + K3.nC + " confirmation within " + str.tostring(K1.confExpiry) + " bars of the reclaim."
            else if w_S.state == 4 and bar_index - w_S.confBar > K1.entryExpiry
                bool sess = str.contains(w_S.reject, "entry window")
                cat := sess ? "SESSION" : "EXPIRED"
                why := sess ? "Valid " + K3.nE + " triggers appeared only while new entries were OFF (outside the entry windows); expired after " + str.tostring(K1.entryExpiry) + " bars." : "No valid " + K3.nE + " entry within " + str.tostring(K1.entryExpiry) + " bars of " + K3.nC + " confirmation" + (w_S.reject != "" ? " (last trigger rejected: " + w_S.reject + ")." : ".")
            if cat != ""
                f_invalidate(w_S, cat, why, evLabels)
                e.evInval := true

        // ── 9. New setup from the best qualifying sweep on this bar
        if not na(best)
            int dB = -best.side
            float bMid = (bHi + bLo) / 2
            float bufB = math.max(K1.stopBufTk * syminfo.mintick, K1.stopBufATR * atrE)
            float invB = dB == 1 ? best.ext - bufB : best.ext + bufB
            string block = ""
            bool logIt = true
            if K1.htfFilter and w_h4Bias == -dB and not best.hiTF
                block := "it is against the " + K3.n4 + " CRT bias"
            else if (dB == 1 ? high >= bMid : low <= bMid) or (dB == 1 ? best.fav >= bMid : best.fav <= bMid)
                block := "price already reached the CRT 50% before the reclaim was confirmed"
            else if w_S.state == 5 or w_S.state == 6
                block := "a trade is already active"
                logIt := false
            else if K1.roomCheck
                // Best plausible entry = a retest of the swept level. If even that has no ≥ min-R:R target,
                // the sweep can never become a trade → say so instead of showing SETUP FORMING.
                float rBest = dB * (best.price - invB)
                float t2B = na
                if rBest > 0
                    [x1, x2, x1s, x2s] = f_targets(dB, best.price, rBest, bHi, bLo, bMid, bTF, pools)
                    t2B := x2
                if na(t2B)
                    block := "there is no target ≥ " + f_r(K1.minRR) + "R even from a retest of the level"
            if block == ""
                if (w_S.state == 3 or w_S.state == 4) and w_S.dir != dB
                    f_invalidate(w_S, "REPLACED", "Replaced by an opposite qualifying sweep (" + best.kind + " " + f_p(best.price) + ").", evLabels)
                    e.evInval := true
                if w_S.state == 0 or w_S.state == 8 or w_S.state == 9
                    w_S := Setup.new(state = 3, dir = dB, srcTF = bTF, srcKind = best.kind, hiTF = best.hiTF, level = best.price, ext = best.ext, invalLvl = invB, breachTime = best.breachTime, breachBar = best.breachBar, reclaimBar = bar_index, reclaimT = time, rT0 = bT0, rHi = bHi, rLo = bLo, rMid = bMid, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                    w_lastBlock := ""
                    if not best.labeled
                        f_sweepLabel(evLabels, best, true)
                    label.set_text(best.lbSweep, label.get_text(best.lbSweep) + "\nRECLAIMED · WATCH " + (dB == 1 ? "LONG ↑" : "SHORT ↓"))
                    // Locked levels for the pending setup (independent of later range rolls)
                    int xs = bar_index
                    if K3.isDet
                        w_S.plInv := line.new(xs, invB, bar_index + 3, invB, color = color.new(K1.cSL, 35), style = line.style_dotted, width = 1)
                        w_S.plMid := line.new(xs, bMid, bar_index + 3, bMid, color = color.new(K1.cMid, 25), style = line.style_dotted, width = 1)
                        w_S.pbInv := label.new(bar_index + 3, invB, "INVALID " + (dB == 1 ? "≤ " : "≥ ") + f_p(invB), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(K1.cSL, 10), size = size.tiny)
                        w_S.pbMid := label.new(bar_index + 3, bMid, "LOCKED " + bTF + " 50% " + f_p(bMid), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(K1.cMid, 10), size = size.tiny)
                else
                    block := "a " + (w_S.dir == 1 ? "long" : "short") + " setup is already pending"
                    logIt := false
            if block != ""
                w_lastBlock := best.kind + " sweep reclaimed but not traded: " + block
                if logIt
                    f_log((dB == 1 ? "LONG · " : "SHORT · ") + best.kind + " " + f_p(best.price), "SKIPPED", "Sweep confirmed but not traded: " + block + ".")

        // ── 10. 15M confirmation (only candles that CLOSED after the breach began)
        if w_S.state == 3
            int dC = w_S.dir
            int   mT   = dC == 1 ? Q.c15BullT : Q.c15BearT
            bool  mCh  = dC == 1 ? Q.c15BullCh : Q.c15BearCh
            bool  mDs  = dC == 1 ? Q.c15BullDs : Q.c15BearDs
            float mLvl = dC == 1 ? Q.c15BullLvl : Q.c15BearLvl
            int   dT   = dC == 1 ? Q.c15BullDT : Q.c15BearDT
            bool mssOK  = not na(mT) and mT > w_S.breachTime and (not K1.reqChoch or mCh)
            bool dispOK = not na(dT) and dT > w_S.breachTime
            bool ok = switch K1.confMode
                "MSS / CHoCH"        => mssOK
                "MSS + Displacement" => mssOK and mDs
                => mssOK or dispOK
            if ok
                w_S.state := 4
                w_S.confBar := bar_index
                w_S.rtLvl := mssOK ? mLvl : w_S.level
                w_S.confText := mssOK ? ((mCh ? "CHoCH " : "BOS ") + (dC == 1 ? "↑ " : "↓ ") + f_p(mLvl) + (mDs ? " + displacement" : "")) : ("Displacement " + (dC == 1 ? "↑" : "↓"))
                if dC == 1
                    e.evConfBull := true
                else
                    e.evConfBear := true
                if K3.isDet
                    f_evLabel(evLabels, bar_index, dC == 1 ? low : high, K3.nC + " ✓", color.new(dC == 1 ? K1.cBull : K1.cBear, 45), color.white, dC == 1 ? label.style_label_up : label.style_label_down, size.tiny, w_S.confText, dC == 1 ? yloc.belowbar : yloc.abovebar)
                if K1.alConf
                    f_alert(dC == 1 ? "CONF_15M_BULLISH" : "CONF_15M_BEARISH", dC, w_S.rtLvl, na, na, na, na, w_S.confText)

        // ── 11. 5M entry trigger + risk/target qualification → SIGNAL
        if w_S.state == 4
            int dD = w_S.dir
            float tolR = K1.retestTol * atrE
            bool brk = dD == 1 ? bull5Brk : bear5Brk
            bool rt  = dD == 1 ? (low <= w_S.rtLvl + tolR and close > w_S.rtLvl and close > open) : (high >= w_S.rtLvl - tolR and close < w_S.rtLvl and close < open)
            bool mom = dD == 1 ? (close > open and close > high[1]) : (close < open and close < low[1])
            // Timestamp-paired: on the bar the 15M confirmation becomes known, a 5M break that already
            // happened after the breach (and ≤ pairBars ago) completes the 5M side. Entry = THIS bar's close.
            int l5 = dD == 1 ? lastBull5Bar : lastBear5Bar
            bool paired = K1.pairedConf and w_S.confBar == bar_index and not na(l5) and l5 >= w_S.breachBar and bar_index - l5 <= K1.pairBars
            bool trig = switch K1.trigMode
                "5M structure break"  => brk or paired
                "Retest of 15M break" => rt
                "Momentum candle"     => mom
                => brk or rt or paired
            if trig
                float eRef = close
                float stp  = w_S.invalLvl
                float risk = dD * (eRef - stp)
                string rej = ""
                float t1 = na
                float t2 = na
                string t1s = ""
                string t2s = ""
                if risk <= 0
                    rej := "entry beyond stop"
                else if risk > K1.maxRiskATR * atrE
                    rej := "too far from stop (" + f_r(risk / atrE) + " ATR > " + f_r(K1.maxRiskATR) + ")"
                else if K1.maxStopPts > 0 and risk > K1.maxStopPts
                    rej := "stop " + f_p(risk) + " pts > max " + f_p(K1.maxStopPts) + " pts"
                else if K1.reqDiscount and (dD == 1 ? eRef >= w_S.rMid : eRef <= w_S.rMid)
                    rej := dD == 1 ? "entry not in discount" : "entry not in premium"
                else if not entryAllowed
                    rej := "outside entry window"
                else if K1.htfFilter and w_h4Bias == -dD and not w_S.hiTF
                    rej := "against " + K3.n4 + " CRT bias"
                else
                    [a1, a2, a1s, a2s] = f_targets(dD, eRef, risk, w_S.rHi, w_S.rLo, w_S.rMid, w_S.srcTF, pools)
                    t1 := a1
                    t2 := a2
                    t1s := a1s
                    t2s := a2s
                    if na(t2)
                        rej := "no target with ≥ " + f_r(K1.minRR) + "R"
                    else if dD * (t2 - eRef) / risk < K1.minRR
                        rej := "R:R " + f_r(dD * (t2 - eRef) / risk) + " < " + f_r(K1.minRR)
                string cfA = ""
                if rej == ""
                    [cPa, cNa, cTa, cBa, cCa] = f_conf(dD, eRef, t1, "A")
                    cfA := cTa
                    string cra = f_cfReject(cPa, cNa, cBa, cCa, "A")
                    if cra != ""
                        rej := "confluence: " + cra
                if rej == ""
                    w_S.state := 5
                    w_S.cfTxt := cfA
                    w_S.sigBar := bar_index
                    w_S.entryRef := eRef
                    w_S.stop := stp
                    w_S.stopInit := stp
                    w_S.riskRef := risk
                    w_S.tp1 := t1
                    w_S.tp2 := t2
                    w_S.tp1Src := t1s
                    w_S.tp2Src := t2s
                    w_S.reject := ""
                    if dD == 1
                        e.evBuy := true
                    else
                        e.evSell := true
                    string tipS = w_S.srcKind + " · confluence " + cfA
                    f_log(f_desc(w_S), "SIGNAL", "CRT qualifies · confluence " + cfA)
                    f_evLabel(evLabels, bar_index, dD == 1 ? low : high, (dD == 1 ? "A · BUY\n" : "A · SELL\n") + f_p(eRef), dD == 1 ? K1.cBull : K1.cBear, color.white, dD == 1 ? label.style_label_up : label.style_label_down, size.normal, tipS, dD == 1 ? yloc.belowbar : yloc.abovebar)
                    f_pendDel(w_S)
                    f_tradeDraw(w_S, "A ")
                    tradeHist.push(w_S)
                    if tradeHist.size() > K1.keepTrades
                        f_tradeDelete(tradeHist.shift())
                    if K1.alSig
                        f_alert(dD == 1 ? "BUY_CONFIRMED" : "SELL_CONFIRMED", dD, w_S.level, eRef, stp, t1, t2, "fill assumed at next bar open")
                else
                    w_S.reject := rej

        // Keep the locked pending levels at the right edge
        if (w_S.state == 3 or w_S.state == 4) and not na(w_S.plInv)
            line.set_x2(w_S.plInv, bar_index + 3)
            line.set_x2(w_S.plMid, bar_index + 3)
            label.set_x(w_S.pbInv, bar_index + 3)
            label.set_x(w_S.pbMid, bar_index + 3)

        // ── 12. Housekeeping: drop expired / resolved / retired levels
        if pools.size() > 0
            for i = pools.size() - 1 to 0
                Liq l = pools.get(i)
                bool rm = l.isCRT ? (l.retired and l.state != 1) : ((l.state == 0 and time > l.expires) or ((l.state == 2 or l.state == 3) and bar_index - l.resolvedBar > K3.keepResolved))
                if rm
                    f_poolUndraw(l)
                    pools.remove(i)

        // ── 13. Detailed-mode 15M structure markers
        if K2.msShow == "Always" or (K2.msShow == "Detailed mode only" and K3.isDet and K1.showMSS)
            if Q.mBullNew and not na(Q.c15BullPT)
                mssQ.push(line.new(Q.c15BullPT, Q.c15BullLvl, time, Q.c15BullLvl, xloc = xloc.bar_time, color = color.new(K1.cBull, 30), style = line.style_dashed, width = 1))
                f_evLabel(evLabels, bar_index, Q.c15BullLvl, K3.nC + (Q.c15BullCh and Q.c15BullDs ? " MSS ↑" : Q.c15BullCh ? " CHoCH ↑" : " BOS ↑"), C_CLEAR, color.new(K1.cBull, 0), label.style_label_down, size.tiny, "Confirmed on a closed " + K3.nC + " candle", yloc.price)
            if Q.mBearNew and not na(Q.c15BearPT)
                mssQ.push(line.new(Q.c15BearPT, Q.c15BearLvl, time, Q.c15BearLvl, xloc = xloc.bar_time, color = color.new(K1.cBear, 30), style = line.style_dashed, width = 1))
                f_evLabel(evLabels, bar_index, Q.c15BearLvl, K3.nC + (Q.c15BearCh and Q.c15BearDs ? " MSS ↓" : Q.c15BearCh ? " CHoCH ↓" : " BOS ↓"), C_CLEAR, color.new(K1.cBear, 0), label.style_label_up, size.tiny, "Confirmed on a closed " + K3.nC + " candle", yloc.price)
            while mssQ.size() > 30
                line.delete(mssQ.shift())

        // ── 14. Range styling
        r4.refresh(barstate.islast, true)
        r1.refresh(barstate.islast, false)
    [w_S, w_h4Bias, w_lastBSLBar, w_lastBlock, w_lastLiq, w_lastSSLBar, w_simN, w_simR, w_simW]

[r_S, r_h4Bias, r_lastBSLBar, r_lastBlock, r_lastLiq, r_lastSSLBar, r_simN, r_simR, r_simW] = f_engA(barstate.isconfirmed, E, S, h4Bias, lastBSLBar, lastBlock, lastLiq, lastSSLBar, simN, simR, simW)
S := r_S
h4Bias := r_h4Bias
lastBSLBar := r_lastBSLBar
lastBlock := r_lastBlock
lastLiq := r_lastLiq
lastSSLBar := r_lastSSLBar
simN := r_simN
simR := r_simR
simW := r_simW

// ═══════════════════════════════════════════════════════════════════════════════
//  MODEL C — 15M DOUBLE-RANGE CONFIRMATION (independent of Model A)
//  Runs on CLOSED chart bars. Each completed 15M candle is processed exactly once,
//  on the chart bar whose close coincides with the 15M close (or, if that bar is
//  missing, on the next chart bar — flagged "late"). Fill = NEXT chart bar open.
// ═══════════════════════════════════════════════════════════════════════════════
var CRef         CR        = CRef.new(lns = array.new<line>())
var array<CRef>  cHist     = array.new<CRef>()
var Setup        TC        = Setup.new()
var array<Setup> cTrades   = array.new<Setup>()
var int    cLastT      = na
var int    cLastPairT2 = na
var bool   cArmed      = false
var int    cArmT       = na
var float  cPrevH      = na
var float  cPrevL      = na
var int    cPrevT      = na
var int    cSimN       = 0
var int    cSimW       = 0
var float  cSimR       = 0.0


f_engC(bool go, EV e, CRef p_CR, Setup p_TC, int p_cArmT, bool p_cArmed, int p_cLastPairT2, int p_cLastT, float p_cPrevH, float p_cPrevL, int p_cPrevT, int p_cSimN, float p_cSimR, int p_cSimW) =>
    CRef w_CR = p_CR
    Setup w_TC = p_TC
    int w_cArmT = p_cArmT
    bool w_cArmed = p_cArmed
    int w_cLastPairT2 = p_cLastPairT2
    int w_cLastT = p_cLastT
    float w_cPrevH = p_cPrevH
    float w_cPrevL = p_cPrevL
    int w_cPrevT = p_cPrevT
    int w_cSimN = p_cSimN
    float w_cSimR = p_cSimR
    int w_cSimW = p_cSimW
    if go
        // ── C1. Trade lifecycle (shared rules with Model A)
        if w_TC.state == 5 and bar_index > w_TC.sigBar
            f_fill(w_TC, evLabels, "C")
            e.evCFill := true
        if w_TC.state == 6
            [oC, t1C, stC] = f_manage(w_TC, evLabels, "C")
            e.evCTP1 := t1C
            e.evCStop := stC
            e.evCTP2 := oC == "TP2 HIT"
            e.evCEarly := oC == "EARLY EXIT"
            if oC != ""
                e.evCDone := true
                if not K3.isDet and w_CR.state == 7
                    w_CR.cErase()
                w_cSimN += 1
                w_cSimW += w_TC.resultR > 0 ? 1 : 0
                w_cSimR += w_TC.resultR

        // ── C2. Structure-event arming (event known only after its 15M candle closed)
        if K2.cRefMode == "First pair after 15M structure event" and (Q.mBullNew or Q.mBearNew)
            w_cArmed := true
            w_cArmT := math.max(nz(Q.c15BullT), nz(Q.c15BearT))

        // ── C3. Pick at most one completed, not-yet-processed 15M candle
        bool  haveC = false
        bool  late  = false
        float kO = na
        float kH = na
        float kL = na
        float kC = na
        int   kT = na
        float kV = na
        float kA = na
        float kVA = na
        if not na(Q.p15T) and (na(w_cLastT) or Q.p15T > w_cLastT)
            haveC := true
            late := not na(w_cLastT)
            kO := Q.p15O
            kH := Q.p15H
            kL := Q.p15L
            kC := Q.p15C
            kT := Q.p15T
            kV := Q.p15V
            kA := Q.p15ATR
            kVA := Q.p15VA
        else if Q.c15Last and not na(Q.q15T) and (na(w_cLastT) or Q.q15T > w_cLastT)
            haveC := true
            kO := Q.q15O
            kH := Q.q15H
            kL := Q.q15L
            kC := Q.q15C
            kT := Q.q15T
            kV := Q.q15V
            kA := Q.q15ATR
            kVA := Q.q15VA

        if haveC
            w_cLastT := kT
            string openNm = K2.cRefMode == "Session-opening pair" ? f_cOpen(kT) : ""
            float cBuf = K2.cBufTk * syminfo.mintick
            bool strictR = K2.cSweepRule == "Strict: any trade beyond"
            bool sweepR  = K2.cSweepRule == "Sweep: trade beyond + 15M close back inside"

            // A new session-opening candle supersedes a pair that is still waiting
            if w_CR.state == 2 and openNm != ""
                w_CR.cEnd(10, "Superseded by the " + openNm + " reference pair before any breakout.", evLabels)
                e.evCExp := true

            // ── C4. Watch a locked pair (only candles strictly AFTER the second reference candle)
            if w_CR.state == 2 and kT > w_CR.t2
                w_CR.nSeen := w_CR.nSeen + 1
                bool inWin = K2.cSweepWin == 0 or w_CR.nSeen <= K2.cSweepWin
                if inWin and (strictR or sweepR)
                    if kH > w_CR.up
                        w_CR.upHit := true
                        if strictR and not w_CR.bearDQ
                            w_CR.bearDQ := true
                            w_CR.bearWhy := "a 15M high (" + f_p(kH) + " at " + f_fmtT(kT) + ") traded above the upper boundary " + f_p(w_CR.up)
                    if kL < w_CR.lo
                        w_CR.dnHit := true
                        if strictR and not w_CR.bullDQ
                            w_CR.bullDQ := true
                            w_CR.bullWhy := "a 15M low (" + f_p(kL) + " at " + f_fmtT(kT) + ") traded below the lower boundary " + f_p(w_CR.lo)
                    if sweepR and w_CR.upHit and kC <= w_CR.up and not w_CR.bearDQ
                        w_CR.bearDQ := true
                        w_CR.bearWhy := "the upper boundary " + f_p(w_CR.up) + " was swept and a 15M candle closed back inside (" + f_fmtT(kT) + ")"
                    if sweepR and w_CR.dnHit and kC >= w_CR.lo and not w_CR.bullDQ
                        w_CR.bullDQ := true
                        w_CR.bullWhy := "the lower boundary " + f_p(w_CR.lo) + " was swept and a 15M candle closed back inside (" + f_fmtT(kT) + ")"
                bool bearC = kC < w_CR.lo - cBuf
                bool bullC = kC > w_CR.up + cBuf
                if bearC or bullC
                    int dK = bullC ? 1 : -1
                    string side = dK == 1 ? "above the upper" : "below the lower"
                    string bnd = f_p(dK == 1 ? w_CR.up : w_CR.lo)
                    if (dK == 1 ? w_CR.bullDQ : w_CR.bearDQ)
                        w_CR.cEnd(9, "15M closed " + side + " boundary " + bnd + " but the " + (dK == 1 ? "long" : "short") + " side was disqualified: " + (dK == 1 ? w_CR.bullWhy : w_CR.bearWhy) + ".", evLabels)
                        e.evCInval := true
                    else
                        string flt = f_cFilter(dK, kT, kO, kC, kA, kV, kVA)
                        if flt != ""
                            w_CR.cEnd(9, "Confirmed close " + side + " boundary " + bnd + " filtered out: " + flt + ".", evLabels)
                            e.evCInval := true
                        else if w_TC.state == 5 or w_TC.state == 6
                            w_CR.cEnd(11, "Confirmed close " + side + " boundary " + bnd + ", but a Model C trade is already open.", evLabels)
                            e.evCMiss := true
                        else if K2.cNeedWin and not entryAllowed
                            w_CR.cEnd(11, "Setup detected (15M closed " + side + " boundary " + bnd + ") but NOT ACTIONABLE: entries are OFF outside the entry windows.", evLabels)
                            e.evCMiss := true
                        else
                            // Risk plan from the signal-time price (this bar's close = the 15M close when on time)
                            float eRef = close
                            float sbuf = K2.cStopTk * syminfo.mintick
                            float capR = math.min(na(kA) ? 1e12 : K2.cMaxRiskATR * kA, K1.maxStopPts > 0 ? K1.maxStopPts : 1e12)
                            float minR = na(kA) ? 0.0 : K2.cMinStopATR * kA
                            float stp = na
                            string stpTxt = "opposite boundary"
                            if K2.cStopMode == "Smart: nearest structure, then ATR"
                                array<float> cand = array.from(dK == 1 ? kL - sbuf : kH + sbuf, dK == 1 ? Q.c15SwL - sbuf : Q.c15SwH + sbuf, dK == 1 ? sw5L - sbuf : sw5H + sbuf)
                                array<string> cnm = array.from("breakout candle", K3.nC + " swing", K3.nE + " swing")
                                float bestR = na
                                for [ix, cv] in cand
                                    if not na(cv)
                                        float rr = dK * (eRef - cv)
                                        if rr >= minR and rr <= capR and (na(bestR) or rr < bestR)
                                            bestR := rr
                                            stp := cv
                                            stpTxt := cnm.get(ix)
                                if na(stp) and not na(kA)
                                    float ra = math.max(K2.cStopATR * kA, minR)
                                    if ra <= capR
                                        stp := eRef - dK * ra
                                        stpTxt := f_r(K2.cStopATR) + " ATR"
                            else
                                if K2.cStopMode == "Recent confirmed 15M swing"
                                    float sw = dK == 1 ? Q.c15SwL : Q.c15SwH
                                    if not na(sw) and dK * (eRef - sw) > 0
                                        stp := sw - dK * sbuf
                                        stpTxt := K3.nC + " swing"
                                else if K2.cStopMode == "ATR" and not na(kA)
                                    stp := eRef - dK * K2.cStopATR * kA
                                    stpTxt := f_r(K2.cStopATR) + " ATR"
                                if na(stp)
                                    stp := dK == 1 ? w_CR.lo - sbuf : w_CR.up + sbuf
                            float risk = na(stp) ? na : dK * (eRef - stp)
                            float t1 = na
                            float t2 = na
                            string t1s = ""
                            string t2s = ""
                            string miss = ""
                            if na(stp)
                                miss := "no stop fits the limits (structure and ATR stops are all wider than " + f_p(capR) + " pts or tighter than " + f_p(minR) + " pts)"
                            else if risk <= 0
                                miss := "price is already beyond the planned stop"
                            else if risk > capR
                                miss := "stop " + f_p(risk) + " pts (" + stpTxt + ") is wider than the " + f_p(capR) + " pts maximum"
                            else
                                [x1, x2, x1s, x2s, xm] = f_cTargets(dK, eRef, risk, pools)
                                t1 := x1
                                t2 := x2
                                t1s := x1s
                                t2s := x2s
                                miss := xm
                            string cfTc = ""
                            if miss == ""
                                [cPc, cNc, cTc, cBc, cCc] = f_conf(dK, eRef, t1, "C")
                                cfTc := cTc
                                string crc = f_cfReject(cPc, cNc, cBc, cCc, "C")
                                if crc != ""
                                    miss := "confluence: " + crc
                            if miss != ""
                                w_CR.cEnd(11, "Setup detected (15M closed " + side + " boundary " + bnd + ") but NOT TRADABLE: " + miss + ".", evLabels)
                                e.evCMiss := true
                            else
                                w_TC := Setup.new(state = 5, dir = dK, srcTF = K3.nC, srcKind = "C " + w_CR.src, level = dK == 1 ? w_CR.up : w_CR.lo, sigBar = bar_index, entryRef = eRef, stop = stp, stopInit = stp, riskRef = risk, tp1 = t1, tp2 = t2, tp1Src = t1s, tp2Src = t2s, cfTxt = cfTc, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                                f_tradeDraw(w_TC, "C ")
                                f_log(f_desc(w_TC), "SIGNAL", "RANGE BREAK qualifies · confluence " + cfTc)
                                cTrades.push(w_TC)
                                if cTrades.size() > K1.keepTrades
                                    f_tradeDelete(cTrades.shift())
                                string tipC = "C · " + w_CR.src + (late ? " (late)" : "") + " · confluence " + cfTc
                                f_evLabel(evLabels, bar_index, dK == 1 ? low : high, (dK == 1 ? "C · BUY\n" : "C · SELL\n") + f_p(eRef), color.new(dK == 1 ? K1.cBull : K1.cBear, 0), color.white, dK == 1 ? label.style_label_up : label.style_label_down, size.small, tipC, dK == 1 ? yloc.belowbar : yloc.abovebar)
                                w_CR.cEnd(7, "Confirmed " + (dK == 1 ? "LONG" : "SHORT") + ": 15M closed " + side + " boundary " + bnd + ".", evLabels)
                                if dK == 1
                                    e.evCBuy := true
                                else
                                    e.evCSell := true
                                if K1.alSig
                                    f_alert(dK == 1 ? "C_BUY_CONFIRMED" : "C_SELL_CONFIRMED", dK, dK == 1 ? w_CR.up : w_CR.lo, eRef, stp, t1, t2, "Model C " + w_CR.src + " · fill assumed at next bar open")
                else if w_CR.bullDQ and w_CR.bearDQ
                    w_CR.cEnd(9, "Both sides disqualified before any breakout: short — " + w_CR.bearWhy + "; long — " + w_CR.bullWhy + ".", evLabels)
                    e.evCInval := true
                else if w_CR.nSeen >= K2.cExpiry
                    w_CR.cEnd(10, "No 15M close beyond either boundary within " + str.tostring(K2.cExpiry) + " candles.", evLabels)
                    e.evCExp := true
                else
                    w_CR.cExtend(time + K3.labOff)

            // ── C5. Second reference candle → lock (must be the very next 15M candle)
            if w_CR.state == 1
                if kT == w_CR.t1 + K3.c15Ms
                    w_CR.cLock(kH, kL, kT)
                    w_cLastPairT2 := kT
                    e.evCLock := true
                else
                    w_CR.state := 0

            // ── C6. First reference candle (never reuses a candle from a previous pair or its ending candle)
            if w_CR.state != 1 and w_CR.state != 2
                bool fresh = na(w_cLastPairT2) or kT > w_cLastPairT2
                int endT = w_CR.state >= 7 ? w_CR.endT : na
                string nmNew = ""
                if K2.cRefMode == "Session-opening pair" and openNm != ""
                    nmNew := openNm
                else if K2.cRefMode == "First pair after 15M structure event" and w_cArmed and kT >= w_cArmT
                    nmNew := "after " + K3.nC + " structure"
                    w_cArmed := false
                else if K2.cRefMode == "Rolling consecutive pair" and not na(w_cPrevT) and kT == w_cPrevT + K3.c15Ms and w_cPrevT > nz(w_cLastPairT2) and (na(endT) or w_cPrevT >= endT)
                    nmNew := "rolling"
                if nmNew != "" and fresh
                    if w_CR.state != 0
                        cHist.push(w_CR)
                        if cHist.size() > 3
                            CRef oldC = cHist.shift()
                            oldC.cErase()
                    else
                        w_CR.cErase()
                    if nmNew == "rolling"
                        w_CR := CRef.new(state = 1, src = nmNew, h1 = w_cPrevH, l1 = w_cPrevL, t1 = w_cPrevT, lns = array.new<line>())
                        w_CR.cLock(kH, kL, kT)
                        w_cLastPairT2 := kT
                        e.evCLock := true
                    else
                        w_CR := CRef.new(state = 1, src = nmNew, h1 = kH, l1 = kL, t1 = kT, lns = array.new<line>())
            w_cPrevH := kH
            w_cPrevL := kL
            w_cPrevT := kT
    [w_CR, w_TC, w_cArmT, w_cArmed, w_cLastPairT2, w_cLastT, w_cPrevH, w_cPrevL, w_cPrevT, w_cSimN, w_cSimR, w_cSimW]

[r_CR, r_TC, r_cArmT, r_cArmed, r_cLastPairT2, r_cLastT, r_cPrevH, r_cPrevL, r_cPrevT, r_cSimN, r_cSimR, r_cSimW] = f_engC(barstate.isconfirmed and cOn and tfOK, E, CR, TC, cArmT, cArmed, cLastPairT2, cLastT, cPrevH, cPrevL, cPrevT, cSimN, cSimR, cSimW)
CR := r_CR
TC := r_TC
cArmT := r_cArmT
cArmed := r_cArmed
cLastPairT2 := r_cLastPairT2
cLastT := r_cLastT
cPrevH := r_cPrevH
cPrevL := r_cPrevL
cPrevT := r_cPrevT
cSimN := r_cSimN
cSimR := r_cSimR
cSimW := r_cSimW

// ── Draw only the nearest relevant zones (redrawn on the last bar; no history clutter)
f_blkZonesDraw(bool go) =>
    if go
        for b in ctxBox
            box.delete(b)
        ctxBox.clear()
        int xR = time + K3.labOff * 2
        if K2.fvgOn and K2.fvgShow and fvgs.size() > 0
            for side in array.from(1, -1)
                array<int> used = array.new<int>()
                for n = 1 to K2.fvgShowN
                    int bi = -1
                    float bd = na
                    bool bs = false
                    for [i, g] in fvgs
                        bool okSide = side == 1 ? g.bot < close : g.top > close
                        if g.dir == side and okSide and (K2.fvgShowInv or not g.inv) and (not K2.fvgStrongOnly or g.strong or g.inv) and not used.includes(i)
                            float dist = math.max(0.0, side == 1 ? close - g.top : g.bot - close)
                            if dist <= K2.fvgMaxDist * atrE and (bi < 0 or (g.strong and not bs) or (g.strong == bs and dist < bd))
                                bi := i
                                bd := dist
                                bs := g.strong
                    if bi >= 0
                        used.push(bi)
                        FVG g = fvgs.get(bi)
                        string tx = (g.inv ? "IFVG" : "FVG") + (g.strong ? " ★" : "") + (g.state == 1 ? " ◐" : "")
                        ctxBox.push(box.new(g.t0, g.top, xR, g.bot, xloc = xloc.bar_time, border_color = g.inv ? color.new(#9E9E9E, 40) : C_CLEAR, border_style = line.style_dashed, bgcolor = g.inv ? K2.fvgInvC : side == 1 ? K2.fvgBullC : K2.fvgBearC, text = tx, text_size = size.tiny, text_color = color.new(#B0BEC5, 10), text_halign = text.align_right))
        if K2.sdOn and K2.sdShow and zones.size() > 0
            for side in array.from(1, -1)
                array<int> used = array.new<int>()
                for n = 1 to K2.sdShowN
                    int bi = -1
                    float bd = na
                    for [i, z] in zones
                        bool okSide = side == 1 ? z.bot < close : z.top > close
                        if z.state == 0 and z.dir == side and okSide and not used.includes(i)
                            float dist = math.max(0.0, side == 1 ? close - z.top : z.bot - close)
                            if dist <= K2.sdMaxDist * atrE and (bi < 0 or dist < bd)
                                bi := i
                                bd := dist
                    if bi >= 0
                        used.push(bi)
                        Zone z = zones.get(bi)
                        ctxBox.push(box.new(z.t0, z.top, xR, z.bot, xloc = xloc.bar_time, border_color = color.new(side == 1 ? K2.sdDemC : K2.sdSupC, 40), border_width = 1, bgcolor = side == 1 ? K2.sdDemC : K2.sdSupC, text = (side == 1 ? "DEMAND " : "SUPPLY ") + str.tostring(f_zRank(z)) + "/5" + (z.bos ? " · BOS" : ""), text_size = size.tiny, text_color = color.new(#B0BEC5, 10), text_halign = text.align_left))
            if K2.sdShowDead
                int nDead = 0
                if zones.size() > 0
                    for i = zones.size() - 1 to 0
                        Zone z = zones.get(i)
                        if z.state == 1 and nDead < 2 and math.abs((z.top + z.bot) / 2 - close) <= K2.sdMaxDist * atrE
                            nDead += 1
                            ctxBox.push(box.new(z.t0, z.top, time + K3.labOff, z.bot, xloc = xloc.bar_time, border_color = color.new(#607D8B, 70), border_style = line.style_dotted, bgcolor = color.new(#607D8B, 95), text = (z.dir == 1 ? "demand" : "supply") + " invalid", text_size = size.tiny, text_color = color.new(#607D8B, 30), text_halign = text.align_left))
    true

f_blkZonesDraw(barstate.islast)

// ═══════════════════════════════════════════════════════════════════════════════
//  MODEL AMD — ACCUMULATION → MANIPULATION → DISTRIBUTION (independent, optional)
//  All decisions on CLOSED chart bars. Signal at the distribution candle close,
//  simulated fill at the next bar open (shared trade routine with Models A and C).
// ═══════════════════════════════════════════════════════════════════════════════
float atrSlow = ta.atr(100)
float amdHiN  = ta.highest(high, amdLen)
float amdLoN  = ta.lowest(low, amdLen)



f_amdEnd(AMD a, int st, string why, array<label> q) =>
    a.state := st
    a.why := why
    a.endBar := bar_index
    if not na(a.bx)
        box.set_right(a.bx, time)
        if st != 7
            box.set_border_color(a.bx, color.new(K3.amdCol, 75))
    if st != 7
        string cat = st == 9 ? "INVALIDATED" : st == 10 ? "EXPIRED" : "NOT TRADABLE"
        f_log("AMD · range " + f_p(a.lo) + " – " + f_p(a.hi) + (a.dir != 0 ? (a.dir == 1 ? " → LONG" : " → SHORT") : ""), cat, why)
        if K1.alMgmt
            f_alert(st == 9 ? "AMD_INVALIDATED" : st == 10 ? "AMD_EXPIRED" : "AMD_NOT_TRADABLE", a.dir, na, na, na, na, na, why)

f_engAMD(bool go, EV e, AMD p_AD, Setup p_TD, int p_amdLastEnd) =>
    AMD w_AD = p_AD
    Setup w_TD = p_TD
    int w_amdLastEnd = p_amdLastEnd
    if go
        // ── D1. Trade lifecycle (shared rules)
        if w_TD.state == 5 and bar_index > w_TD.sigBar
            f_fill(w_TD, evLabels, "AMD")
            e.evDFill := true
        if w_TD.state == 6
            [oD, t1D, stD] = f_manage(w_TD, evLabels, "AMD")
            e.evDTP1 := t1D
            e.evDStop := stD
            e.evDTP2 := oD == "TP2 HIT"
            e.evDEarly := oD == "EARLY EXIT"
            if oD != ""
                e.evDDone := true

        float bufD = K3.amdStopTk * syminfo.mintick
        // ── D2. Manipulation watch on a locked accumulation range
        bool asiaMode = K2.amdAccMode == "Asia range → London / New York"
        bool manipSess = not asiaMode or inLon or inNy
        if w_AD.state >= 1 and w_AD.state <= 3 and asiaMode and nyEnd
            f_amdEnd(w_AD, 10, "The New York session ended — the Asia range is not carried into the next day.", evLabels)
            e.evDExp := true
        // Before London / NY the range is carried forward. Three outcomes, judged on completed candles:
        //  intact · swept & reclaimed (kept, noted) · accepted breakout / expansion (invalidated)
        if w_AD.state == 1 and bar_index > w_AD.lockBar and asiaMode and not manipSess
            float exMax = math.max(high - w_AD.hi, w_AD.lo - low)
            if exMax > K3.amdMaxSweep * atrE
                f_amdEnd(w_AD, 9, "Before London, price moved " + f_r(exMax / atrE) + " ATR beyond the Asia range — expansion, not accumulation.", evLabels)
                e.evDInval := true
            else
                if exMax > 0
                    w_AD.preSwept := true
                if Q.c15Last
                    int sideNow = close > w_AD.hi ? 1 : close < w_AD.lo ? -1 : 0
                    if sideNow != 0
                        w_AD.preOut := sideNow == w_AD.preSide ? w_AD.preOut + 1 : 1
                        w_AD.preSide := sideNow
                        if w_AD.preOut >= K3.amdAccept
                            f_amdEnd(w_AD, 9, "Accepted breakout before London: " + str.tostring(w_AD.preOut) + " consecutive 15M closes " + (sideNow == 1 ? "above " + f_p(w_AD.hi) : "below " + f_p(w_AD.lo)) + ".", evLabels)
                            e.evDInval := true
                    else
                        w_AD.preOut := 0
                        w_AD.preSide := 0
        if w_AD.state == 1 and bar_index > w_AD.lockBar and manipSess
            bool upB = high - w_AD.hi >= K3.minPen
            bool dnB = w_AD.lo - low >= K3.minPen
            if upB and dnB
                f_amdEnd(w_AD, 9, "Both sides of the accumulation range were broken on the same candle — no clear manipulation.", evLabels)
                e.evDInval := true
            else if upB or dnB
                w_AD.state := 2
                w_AD.side := upB ? 1 : -1
                w_AD.mExt := upB ? high : low
                w_AD.mBar := bar_index
                w_AD.outCnt := 0
            else if not asiaMode and bar_index - w_AD.lockBar > K2.amdAccExp
                f_amdEnd(w_AD, 10, "No manipulation within " + str.tostring(K2.amdAccExp) + " bars of the accumulation lock.", evLabels)
                e.evDExp := true
        if w_AD.state == 2
            w_AD.mExt := w_AD.side == 1 ? math.max(w_AD.mExt, high) : math.min(w_AD.mExt, low)
            float depth = w_AD.side == 1 ? w_AD.mExt - w_AD.hi : w_AD.lo - w_AD.mExt
            // 15M mode: judge the reclaim only on the chart bar whose close IS the completed 15M close
            bool evalNow = K2.amdRclTF == "Chart candle close" or Q.c15Last
            int  rclWin = K2.amdRclTF == "Chart candle close" ? K3.amdReclaim : K3.amdReclaim * K3.c15Bars
            bool backIn = evalNow and (w_AD.side == 1 ? close < w_AD.hi : close > w_AD.lo)
            bool outC = evalNow and (w_AD.side == 1 ? close > w_AD.hi : close < w_AD.lo)
            if depth > K3.amdMaxSweep * atrE
                f_amdEnd(w_AD, 9, "Move beyond the range was " + f_r(depth / atrE) + " ATR deep — expansion, not a manipulation sweep.", evLabels)
                e.evDInval := true
            else if backIn
                w_AD.state := 3
                w_AD.dir := -w_AD.side
                w_AD.confBar := bar_index
                w_AD.structOK := false
                e.evDManip := true
                if K3.amdShowMark
                    f_evLabel(evLabels, bar_index, w_AD.mExt, "M", color.new(K3.amdCol, 20), color.black, w_AD.side == 1 ? label.style_triangledown : label.style_triangleup, size.tiny, "Manipulation confirmed (15M close back inside)", w_AD.side == 1 ? yloc.abovebar : yloc.belowbar)
                if K1.alSweep
                    f_alert("AMD_MANIPULATION_CONFIRMED", w_AD.dir, w_AD.side == 1 ? w_AD.hi : w_AD.lo, na, na, na, na, "range " + f_p(w_AD.lo) + " – " + f_p(w_AD.hi) + ", extreme " + f_p(w_AD.mExt))
            else
                if outC
                    w_AD.outCnt := w_AD.outCnt + 1
                if w_AD.outCnt >= K3.amdAccept or bar_index - w_AD.mBar + 1 >= rclWin
                    f_amdEnd(w_AD, 9, "Price " + (w_AD.outCnt >= K3.amdAccept ? "accepted outside the range (" + str.tostring(w_AD.outCnt) + " closes)" : "did not close back inside within " + str.tostring(K3.amdReclaim) + (K2.amdRclTF == "Chart candle close" ? " bars" : " " + K3.nC + " candles")) + " — breakout, not manipulation.", evLabels)
                    e.evDInval := true
        // ── D3. Distribution
        if w_AD.state == 3 and bar_index > w_AD.confBar
            int d = w_AD.dir
            float mid = (w_AD.hi + w_AD.lo) / 2
            if d == 1 ? bull5Brk : bear5Brk
                w_AD.structOK := true
            bool lost = d == 1 ? low < w_AD.mExt : high > w_AD.mExt
            bool dispC = d == 1 ? (close > open and close - open >= K3.amdDispATR * atrE) : (close < open and open - close >= K3.amdDispATR * atrE)
            float lvl = K3.amdDistLvl == "Range midpoint" ? mid : d == 1 ? w_AD.hi : w_AD.lo
            bool beyond = d == 1 ? close > lvl : close < lvl
            if lost
                f_amdEnd(w_AD, 9, "Price broke the manipulation extreme " + f_p(w_AD.mExt) + " before distribution.", evLabels)
                e.evDInval := true
            else if dispC and beyond and (not K3.amdStruct or w_AD.structOK)
                if K3.amdShowMark
                    f_evLabel(evLabels, bar_index, d == 1 ? low : high, "D", color.new(d == 1 ? K1.cBull : K1.cBear, 30), color.white, d == 1 ? label.style_triangleup : label.style_triangledown, size.tiny, "Distribution confirmed", d == 1 ? yloc.belowbar : yloc.abovebar)
                [effD, cnfD, btD] = f_cBias()
                string why = ""
                if K3.amdBias != "Off" and K2.cBiasMode != "Off" and ((K2.cBiasMode == "4H + 1H" and cnfD and K2.cConflict == "Block trade") or effD != d)
                    why := "against the directional bias (" + btD + ")"
                else if not entryAllowed
                    why := "entries are OFF outside the entry windows"
                else if w_TD.state == 5 or w_TD.state == 6
                    why := "an AMD trade is already open"
                float eRef = close
                float stp = K3.amdStopMode == "Range midpoint" ? mid - d * bufD : K3.amdStopMode == "Displacement candle" ? (d == 1 ? low - bufD : high + bufD) : (d == 1 ? w_AD.mExt - bufD : w_AD.mExt + bufD)
                float risk = d * (eRef - stp)
                float capD = math.min(K3.amdCapMode == "Range-based" ? (w_AD.hi - w_AD.lo) + K3.amdMaxSweep * atrE + bufD : K3.amdMaxRisk * atrE, K1.maxStopPts > 0 ? K1.maxStopPts : 1e12)
                if why == "" and risk <= 0
                    why := "price is already beyond the planned stop"
                else if why == "" and risk > capD
                    why := "stop " + f_p(risk) + " pts is wider than the " + f_p(capD) + " pts maximum"
                else if why == "" and K3.amdTp2R < K3.amdMinRR
                    why := "TP2 " + f_r(K3.amdTp2R) + "R is below the minimum R:R"
                string cfTd = ""
                if why == ""
                    [cPd, cNd, cTd, cBd, cCd] = f_conf(d, eRef, eRef + d * K3.amdTp1R * risk, "AMD")
                    cfTd := cTd
                    string crd = f_cfReject(cPd, cNd, cBd, cCd, "AMD")
                    if crd != ""
                        why := "confluence: " + crd
                if why != ""
                    f_amdEnd(w_AD, 11, "Distribution confirmed but NOT TRADABLE: " + why + ".", evLabels)
                    e.evDMiss := true
                else
                    float t1 = eRef + d * K3.amdTp1R * risk
                    float t2 = eRef + d * K3.amdTp2R * risk
                    w_TD := Setup.new(state = 5, dir = d, srcTF = K3.nE, srcKind = "AMD range " + f_p(w_AD.lo) + "–" + f_p(w_AD.hi), level = d == 1 ? w_AD.lo : w_AD.hi, ext = w_AD.mExt, sigBar = bar_index, entryRef = eRef, stop = stp, stopInit = stp, riskRef = risk, tp1 = t1, tp2 = t2, tp1Src = str.tostring(K3.amdTp1R) + "R", tp2Src = str.tostring(K3.amdTp2R) + "R", cfTxt = cfTd, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                    f_tradeDraw(w_TD, "AMD ")
                    f_log(f_desc(w_TD), "SIGNAL", "AMD qualifies · confluence " + cfTd)
                    dTrades.push(w_TD)
                    if dTrades.size() > K1.keepTrades
                        f_tradeDelete(dTrades.shift())
                    f_evLabel(evLabels, bar_index, d == 1 ? low : high, (d == 1 ? "AMD · BUY\n" : "AMD · SELL\n") + f_p(eRef), d == 1 ? K1.cBull : K1.cBear, color.white, d == 1 ? label.style_label_up : label.style_label_down, size.small, "AMD · confluence " + cfTd, d == 1 ? yloc.belowbar : yloc.abovebar)
                    f_amdEnd(w_AD, 7, "Distribution confirmed → " + (d == 1 ? "LONG" : "SHORT") + ".", evLabels)
                    if d == 1
                        e.evDBuy := true
                    else
                        e.evDSell := true
                    if K1.alSig
                        f_alert(d == 1 ? "AMD_BUY_CONFIRMED" : "AMD_SELL_CONFIRMED", d, lvl, eRef, stp, t1, t2, "fill assumed at next bar open")
            else if bar_index - w_AD.confBar > K3.amdDistExp
                f_amdEnd(w_AD, 10, "No distribution within " + str.tostring(K3.amdDistExp) + " bars of the manipulation.", evLabels)
                e.evDExp := true
        // ── D4. Accumulation detection (never overlaps the previous AMD range)
        if w_AD.state == 0 or w_AD.state >= 7
            int wStart = bar_index - K2.amdLen + 1
            bool fresh = (na(w_amdLastEnd) or wStart > w_amdLastEnd) and (w_AD.state < 7 or wStart > w_AD.endBar)
            bool okRoll = not asiaMode and fresh and not na(atrSlow) and amdHiN - amdLoN <= K2.amdRangeATR * atrSlow and atrE <= K2.amdCompress * atrSlow
            // Asia mode: lock the COMPLETED Asia range on the first bar after Asia ends
            bool okAsia = asiaMode and asEnd and not na(asDH) and not na(Q.h1ATR) and asDH - asDL <= K2.amdAsiaH1 * Q.h1ATR and asDH > asDL
            if asiaMode and asEnd and not na(asDH) and not okAsia and not na(Q.h1ATR)
                f_log("AMD · Asia " + f_p(asDL) + " – " + f_p(asDH), "SKIPPED", "Asia range " + f_r((asDH - asDL) / Q.h1ATR) + " × 1H ATR is wider than " + f_r(K2.amdAsiaH1) + " — not a consolidation.")
            if okRoll or okAsia
                w_AD := okAsia ? AMD.new(state = 1, hi = asDH, lo = asDL, t0 = asDT, lockBar = bar_index) : AMD.new(state = 1, hi = amdHiN, lo = amdLoN, t0 = time[K2.amdLen - 1], lockBar = bar_index)
                w_amdLastEnd := bar_index
                if K3.amdShowBox
                    w_AD.bx := box.new(w_AD.t0, w_AD.hi, time, w_AD.lo, xloc = xloc.bar_time, border_color = color.new(K3.amdCol, 30), border_width = 1, bgcolor = color.new(K3.amdCol, 96), text = asiaMode ? "ASIA ACCUMULATION" : "ACCUMULATION", text_size = size.tiny, text_color = color.new(K3.amdCol, 30), text_halign = text.align_left, text_valign = text.align_top)
                    amdBoxes.push(w_AD.bx)
                    if amdBoxes.size() > 3
                        box.delete(amdBoxes.shift())
                e.evDLock := true
                if K1.alMgmt
                    f_alert("AMD_ACCUMULATION_LOCKED", 0, na, na, na, na, na, "range " + f_p(w_AD.lo) + " – " + f_p(w_AD.hi))
        if w_AD.state >= 1 and w_AD.state <= 3 and not na(w_AD.bx)
            box.set_right(w_AD.bx, time)
        if w_AD.state >= 7 and not na(w_AD.endBar)
            w_amdLastEnd := math.max(nz(w_amdLastEnd), w_AD.endBar)
    [w_AD, w_TD, w_amdLastEnd]

[r_AD, r_TD, r_amdLastEnd] = f_engAMD(barstate.isconfirmed and amdOn and tfOK, E, AD, TD, amdLastEnd)
AD := r_AD
TD := r_TD
amdLastEnd := r_amdLastEnd



// Keep labels of untouched pools at the right edge
if barstate.islast and pools.size() > 0
    for l in pools
        if l.state == 0 and not na(l.lb)
            label.set_x(l.lb, time + labOff)

// ═══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
string dashPos = switch dashPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right

// ═══════════════════════════════════════════════════════════════════════════════
//  COMPACT DASHBOARD — what to do now. All engines keep running underneath.
//  BUY / SELL is shown ONLY for an actionable trade (signal issued inside the entry
//  windows). A setup that was detected but not actionable is shown as such.
// ═══════════════════════════════════════════════════════════════════════════════
var table dashC = table.new(dashPos, 2, 9, bgcolor = color.new(#0B0F17, 4), frame_color = color.new(C_GOLD, 55), frame_width = 1, border_color = color.new(#0B0F17, 0), border_width = 2)

f_cRow(table t, int rw, string k, string v, color vc, string tip) =>
    table.cell(t, 0, rw, k, text_color = C_MUTED, text_halign = text.align_left, text_size = K3.dashSz)
    table.cell(t, 1, rw, v, text_color = vc, text_halign = text.align_right, text_size = K3.dashSz, tooltip = tip)

f_blkDashCompact(bool go) =>
    if go
        table.cell(dashC, 0, 0, "MEKA CRT PRO", text_color = C_GOLD, text_halign = text.align_left, text_size = K3.dashSz)
        table.cell(dashC, 1, 0, syminfo.ticker + " · " + K3.nE, text_color = C_MUTED, text_halign = text.align_right, text_size = K3.dashSz)
        bool aLive = S.state == 5 or S.state == 6
        bool cLive = K2.cOn and (TC.state == 5 or TC.state == 6)
        bool dLive = K2.amdOn and (TD.state == 5 or TD.state == 6)
        // newest actionable trade wins the panel
        int sA = aLive ? S.sigBar : -1
        int sC = cLive ? TC.sigBar : -1
        int sD = dLive ? TD.sigBar : -1
        int sMax = math.max(math.max(sA, sC), sD)
        int  pick  = sD == sMax and dLive ? 3 : sC == sMax and cLive ? 2 : 1
        bool useCt = pick == 2
        bool live  = aLive or cLive or dLive
        Setup Ts   = pick == 3 ? TD : useCt ? TC : S
        string mdl = pick == 3 ? "AMD" : useCt ? "C" : "A"
        // 1 · Bias (last completed 4H / 1H close vs EMA)
        string a4 = Q.cBias4 == 1 ? "↑" : Q.cBias4 == -1 ? "↓" : "–"
        string a1 = Q.cBias1 == 1 ? "↑" : Q.cBias1 == -1 ? "↓" : "–"
        bool bConf = Q.cBias4 != Q.cBias1
        string biasTxt = not bConf and Q.cBias4 == 1 ? "BULLISH" : not bConf and Q.cBias4 == -1 ? "BEARISH" : "NEUTRAL"
        f_cRow(dashC, 1, "BIAS", biasTxt, biasTxt == "BULLISH" ? K1.cBull : biasTxt == "BEARISH" ? K1.cBear : C_GOLD, K3.n4 + " " + a4 + " · " + K3.n1 + " " + a1)
        // 2 · Current setup
        string stp = "No active setup"
        color stpc = C_MUTED
        if live
            stp := (mdl == "AMD" ? "AMD" : mdl == "C" ? "RANGE BREAK" : "CRT") + " · " + (Ts.dir == 1 ? "LONG" : "SHORT")
            stpc := color.white
        else if S.state == 3 or S.state == 4
            stp := "CRT · " + (S.dir == 1 ? "LONG" : "SHORT") + " forming"
            stpc := S.dir == 1 ? K1.cBull : K1.cBear
        else if K2.amdOn and AD.state == 3
            stp := "AMD · " + (AD.dir == 1 ? "LONG" : "SHORT") + " forming"
            stpc := AD.dir == 1 ? K1.cBull : K1.cBear
        else if K2.cOn and CR.state == 2
            stp := "RANGE BREAK · watching"
            stpc := K2.cCol
        else if K2.cOn and CR.state == 1
            stp := "RANGE BREAK · forming"
            stpc := K2.cCol
        else if K2.amdOn and (AD.state == 1 or AD.state == 2)
            stp := AD.state == 1 ? "AMD · accumulation" : "AMD · sweep in progress"
            stpc := K3.amdCol
        string stpTip = live ? Ts.srcKind + " · " + Ts.cfTxt : S.state == 3 or S.state == 4 ? S.srcKind : ""
        f_cRow(dashC, 2, "SETUP", stp == "No active setup" ? "—" : stp, stpc, stpTip)
        // 3 · Signal: BUY / SELL only when actionable
        string sig = "WAIT"
        color sigc = C_MUTED
        string sigTip = ""
        bool dRecentNA = K2.amdOn and AD.state == 11 and bar_index - AD.endBar <= 3
        bool cRecentNA = (K2.cOn and CR.state == 11 and time - CR.endT <= 2 * K3.c15Ms) or dRecentNA
        bool doneRecent = (S.state == 8 and bar_index - S.doneBar <= 6) or (TC.state == 8 and bar_index - TC.doneBar <= 6) or (TD.state == 8 and bar_index - TD.doneBar <= 6)
        if live
            string dw = Ts.dir == 1 ? "BUY" : "SELL"
            sig := Ts.state == 5 ? dw + " · fill next open" : Ts.tp1Done ? dw + " ACTIVE · TP1 ✓" : dw + " ACTIVE"
            sigc := Ts.dir == 1 ? K1.cBull : K1.cBear
        else if cRecentNA
            sig := "WAIT · not tradable"
            sigc := C_GOLD
            sigTip := dRecentNA ? AD.why : CR.endWhy
        else if doneRecent
            int dbA = S.state == 8 ? S.doneBar : -1
            int dbC = TC.state == 8 ? TC.doneBar : -1
            int dbD = TD.state == 8 ? TD.doneBar : -1
            Setup Td = dbD >= dbC and dbD >= dbA ? TD : dbC >= dbA ? TC : S
            sig := Td.outcome + " " + (Td.resultR >= 0 ? "+" : "") + f_r(Td.resultR) + "R"
            sigc := Td.resultR > 0 ? K1.cTP : K1.cSL
        else if (S.state == 3 or S.state == 4) and not entryAllowed
            sig := "WAIT · entries off"
        else if S.state == 4
            sig := "WAIT · " + K3.nE + " trigger"
            sigTip := S.reject != "" ? "Last trigger rejected: " + S.reject : ""
        f_cRow(dashC, 3, "SIGNAL", sig, sigc, sigTip)
        // 4–7 · Levels (actual values of the actionable trade only)
        float ent = live ? (Ts.state == 6 ? Ts.entry : Ts.entryRef) : na
        float rk  = live ? math.abs(ent - Ts.stop) : na
        f_cRow(dashC, 4, "ENTRY", live ? f_p(ent) + (Ts.state == 5 ? " (signal)" : "") : "—", live ? K1.cEntry : C_MUTED, "")
        f_cRow(dashC, 5, "SL", live ? f_p(Ts.stop) + "  (" + f_p(rk) + " pts)" : "—", live ? K1.cSL : C_MUTED, live ? "Initial risk " + f_p(Ts.riskRef) + " pts" : "")
        f_cRow(dashC, 6, "TP1", live ? f_p(Ts.tp1) + (Ts.tp1Done ? " ✓" : "") : "—", live ? K1.cTP : C_MUTED, live ? Ts.tp1Src : "")
        f_cRow(dashC, 7, "TP2", live ? f_p(Ts.tp2) + "  (" + f_r(math.abs(Ts.tp2 - Ts.entryRef) / Ts.riskRef) + "R)" : "—", live ? K1.cTP : C_MUTED, live ? Ts.tp2Src : "")
        // 8 · Session
        string sn = inNy ? "New York" : inLon ? "London" : inAsia ? "Asia" : "Off-session"
        f_cRow(dashC, 8, "SESSION", sn + " · " + (entryAllowed ? "entries ON" : live ? "entries OFF · managing trade" : "entries OFF"), entryAllowed ? K1.cBull : C_MUTED, "")
    true

f_blkDashCompact(barstate.islast and showDash)

// ═══════════════════════════════════════════════════════════════════════════════
//  DIAGNOSTIC LOG — last 20 setup outcomes (tiny, bottom of chart, optional)
// ═══════════════════════════════════════════════════════════════════════════════
string diagPos = diagPosIn == "Bottom right" ? position.bottom_right : diagPosIn == "Bottom center" ? position.bottom_center : position.bottom_left
var table diag = table.new(diagPos, 4, 22, bgcolor = color.new(#0B0F17, 15), frame_color = color.new(C_GREY, 60), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)
f_blkDiag(bool go) =>
    if go
        table.clear(diag, 0, 0, 3, 21)
        table.cell(diag, 0, 0, "MEKA DIAGNOSTICS", text_color = C_GOLD, text_size = size.tiny, text_halign = text.align_left)
        table.cell(diag, 1, 0, "last " + str.tostring(diagT.size()) + " setups · newest first", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
        table.cell(diag, 2, 0, "OUTCOME", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
        table.cell(diag, 3, 0, "REASON", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
        int nD = diagT.size()
        if nD > 0
            for k = 0 to nD - 1
                int src = nD - 1 - k
                string cg = diagC.get(src)
                color cc = cg == "TRADE" or cg == "SIGNAL" ? K1.cTP : cg == "STRUCTURAL" or cg == "CONFLICT" ? K1.cSL : cg == "SKIPPED" ? C_MUTED : C_GOLD
                table.cell(diag, 0, k + 1, diagT.get(src), text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
                table.cell(diag, 1, k + 1, diagS.get(src), text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
                table.cell(diag, 2, k + 1, cg, text_color = cc, text_size = size.tiny, text_halign = text.align_left)
                table.cell(diag, 3, k + 1, diagR.get(src), text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
    true

f_blkDiag(barstate.islast and showDiag)

// ═══════════════════════════════════════════════════════════════════════════════
//  DATA WINDOW
// ═══════════════════════════════════════════════════════════════════════════════
bool liveTrade = S.state == 5 or S.state == 6
plot(liveTrade ? (S.state == 6 ? S.entry : S.entryRef) : na, "Entry", color = cEntry, display = display.data_window)
plot(liveTrade ? S.stop : na, "Stop", color = cSL, display = display.data_window)
plot(liveTrade ? S.tp1 : na, "TP1", color = cTP, display = display.data_window)
plot(liveTrade ? S.tp2 : na, "TP2", color = cTP, display = display.data_window)

// #ALERTCONDITIONS_BEGIN
// ═══════════════════════════════════════════════════════════════════════════════
//  ALERT CONDITIONS (alternative to the single alert() alert)
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(E.evHiSwept, "MEKA · CRT high swept", "MEKA CRT PRO | {{ticker}} {{interval}} | CRT HIGH SWEPT | close {{close}}")
alertcondition(E.evLoSwept, "MEKA · CRT low swept", "MEKA CRT PRO | {{ticker}} {{interval}} | CRT LOW SWEPT | close {{close}}")
alertcondition(E.evReclaim, "MEKA · Liquidity reclaimed", "MEKA CRT PRO | {{ticker}} {{interval}} | LIQUIDITY RECLAIMED | close {{close}}")
alertcondition(E.evConfBull or E.evConfBear, "MEKA · 15M confirmation", "MEKA CRT PRO | {{ticker}} {{interval}} | 15M DIRECTIONAL CONFIRMATION | close {{close}}")
alertcondition(E.evBuy, "MEKA · BUY confirmed", "MEKA CRT PRO | {{ticker}} {{interval}} | BUY CONFIRMED | close {{close}}")
alertcondition(E.evSell, "MEKA · SELL confirmed", "MEKA CRT PRO | {{ticker}} {{interval}} | SELL CONFIRMED | close {{close}}")
alertcondition(E.evTP1, "MEKA · TP1 reached", "MEKA CRT PRO | {{ticker}} {{interval}} | TP1 HIT")
alertcondition(E.evTP2, "MEKA · TP2 reached", "MEKA CRT PRO | {{ticker}} {{interval}} | TP2 HIT")
alertcondition(E.evStop, "MEKA · Stop loss hit", "MEKA CRT PRO | {{ticker}} {{interval}} | STOP HIT")
alertcondition(E.evInval, "MEKA · Setup invalidated", "MEKA CRT PRO | {{ticker}} {{interval}} | SETUP INVALIDATED")
alertcondition(E.evCLock, "MEKA C · Reference locked", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | 15M REFERENCE PAIR LOCKED")
alertcondition(E.evCBuy, "MEKA C · BUY confirmed", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | BUY CONFIRMED on 15M close | close {{close}}")
alertcondition(E.evCSell, "MEKA C · SELL confirmed", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | SELL CONFIRMED on 15M close | close {{close}}")
alertcondition(E.evCInval, "MEKA C · Invalidated", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | SETUP INVALIDATED")
alertcondition(E.evCExp, "MEKA C · Expired", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | SETUP EXPIRED")
alertcondition(E.evDLock, "MEKA AMD · Accumulation locked", "MEKA CRT PRO [AMD] | {{ticker}} {{interval}} | ACCUMULATION RANGE LOCKED")
alertcondition(E.evDManip, "MEKA AMD · Manipulation confirmed", "MEKA CRT PRO [AMD] | {{ticker}} {{interval}} | MANIPULATION SWEEP CONFIRMED")
alertcondition(E.evDBuy, "MEKA AMD · BUY confirmed", "MEKA CRT PRO [AMD] | {{ticker}} {{interval}} | DISTRIBUTION · BUY CONFIRMED | close {{close}}")
alertcondition(E.evDSell, "MEKA AMD · SELL confirmed", "MEKA CRT PRO [AMD] | {{ticker}} {{interval}} | DISTRIBUTION · SELL CONFIRMED | close {{close}}")
alertcondition(E.evDInval or E.evDExp or E.evDMiss, "MEKA AMD · Setup ended", "MEKA CRT PRO [AMD] | {{ticker}} {{interval}} | AMD SETUP INVALIDATED / EXPIRED / NOT TRADABLE")
alertcondition(E.evCMiss, "MEKA C · Missed entry", "MEKA CRT PRO [C] | {{ticker}} {{interval}} | MISSED ENTRY (risk / target rule)")
// #ALERTCONDITIONS_END

// #STRATEGY_HOOK
