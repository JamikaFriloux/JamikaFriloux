int    cSweepWin  = input.int(0, "Sweep observation window (15M candles, 0 = whole setup life)", minval = 0, maxval = 48, group = G_MC)
int    cExpiry    = input.int(8, "Expire after N 15M candles without a breakout", minval = 1, maxval = 96, group = G_MC)
string cBiasMode  = input.string("4H + 1H", "Directional bias filter", options = ["Off", "4H only", "1H only", "4H + 1H"], group = G_MC)
string cConflict  = input.string("Block trade", "When 4H and 1H disagree", options = ["Block trade", "Follow 4H", "Follow 1H"], group = G_MC)
int    cEmaLen    = input.int(50, "Bias = last completed close vs EMA(N) of that TF", minval = 2, group = G_MC)
bool   cStructF   = input.bool(false, "Require 15M market structure in trade direction", group = G_MC)
bool   cSesAsia   = input.bool(true, "Confirm in session: Asia / London / New York", inline = "cs", group = G_MC)
bool   cSesLon    = input.bool(true, "", inline = "cs", group = G_MC)
bool   cSesNy     = input.bool(true, "", inline = "cs", group = G_MC)
bool   cSesAny    = input.bool(false, "Any time (no session filter — raw-model test)", group = G_MC)
float  cDispMin   = input.float(0.0, "Min breakout body (× 15M ATR14, 0 = off)", minval = 0.0, step = 0.1, group = G_MC)
float  cVolMult   = input.float(0.0, "Min breakout volume (× 20-candle avg, 0 = off)", minval = 0.0, step = 0.1, group = G_MC)
string cStopMode  = input.string("Opposite boundary", "Stop", options = ["Opposite boundary", "Smart: nearest structure, then ATR", "Recent confirmed 15M swing", "ATR"], group = G_MC, tooltip = "Opposite boundary (default) = the level that invalidates the breakout; too-wide stops are REJECTED (NOT TRADABLE) by the max-stop limits instead of being tightened. Tested in the replay: tighter stops (smart / 15M swing / ATR) cut the stop size roughly in half but lowered results on gold. Smart = the TIGHTEST of (breakout-candle high/low, last confirmed 15M swing, last confirmed chart-TF swing) that lies beyond the entry and is between the min and max stop distance. If none qualifies, an ATR stop is used. If that is also too wide the setup is NOT TRADABLE.")
float  cMinStopATR = input.float(1.0, "Smart stop: min distance (× 15M ATR14) — avoids noise stops", minval = 0.0, step = 0.1, group = G_MC)
float  cStopATR   = input.float(1.5, "ATR stop (× 15M ATR14)", minval = 0.2, step = 0.1, group = G_MC)
int    cStopTk    = input.int(2, "Stop buffer (ticks)", minval = 0, group = G_MC)
float  cMaxRiskATR = input.float(2.0, "Max stop distance (× 15M ATR14)", minval = 0.5, step = 0.25, group = G_MC)
float  cTp1R      = input.float(1.0, "TP1 (R)", minval = 0.2, step = 0.1, group = G_MC)
float  cTp2R      = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.1, group = G_MC)
string cTpMode    = input.string("R multiples", "Targets", options = ["R multiples", "Smart: liquidity + R (capped)", "Nearest liquidity (strict)"], group = G_MC, tooltip = "R multiples (default, tested): TP1/TP2 = N × the actual stop distance, so targets shrink automatically with tighter, capped stops. Smart: TP1 = nearest untouched liquidity ≥ TP1-min R (else TP1 R); TP2 = next liquidity ≥ min R:R and ≤ the TP2 cap (else TP2 R). Never beyond the cap. Strict: TP2 = nearest liquidity; if it is closer than min R:R the setup is NOT TRADABLE.")
float  cTp2MaxR   = input.float(3.0, "TP2 cap (R, 0 = off)", minval = 0.0, step = 0.5, group = G_MC)
bool   cNeedWin   = input.bool(true, "Actionable only inside the entry windows (same windows as Model A)", group = G_MC, tooltip = "A breakout confirmed while entries are OFF is shown as 'setup detected — NOT ACTIONABLE' and no BUY/SELL or trade levels are drawn.")
float  cMinRR     = input.float(1.5, "Minimum R:R to TP2", minval = 0.5, step = 0.1, group = G_MC)
float  cRiskCash  = input.float(500, "Risk budget per trade (sizing shown on dashboard)", minval = 1, group = G_MC)
bool   cShowBnd   = input.bool(true, "Show combined upper / lower boundaries", group = G_MC)
color  cCol       = input.color(#B388FF, "Model C colour", group = G_MC)

