float  sdMaxDist   = input.float(10.0, "Only show zones within × ATR of price", minval = 1.0, step = 0.5, group = G_SD)
int    sdMaxAge    = input.int(576, "Forget zones older than N chart bars", minval = 20, maxval = 5000, group = G_SD)
color  sdDemC      = input.color(color.new(#00C176, 88), "Zone colours: demand / supply", inline = "sc", group = G_SD)
color  sdSupC      = input.color(color.new(#FF3D57, 88), "", inline = "sc", group = G_SD)

string G_MS = "⑰ Structure & liquidity overlays"
string msShow      = input.string("Detailed mode only", "15M BOS / CHoCH / MSS markers", options = ["Detailed mode only", "Always", "Off"], group = G_MS, tooltip = "BOS = break in the direction of the prior 15M structure. CHoCH = first break against it. MSS = a CHoCH whose breaking candle is a displacement candle. All are drawn only after the breaking 15M candle has closed.")
bool   liqAlways   = input.bool(false, "Show liquidity levels (PDH/PDL, sessions, swings) in Clean mode too", group = G_MS)

string G_AMD = "⑱ Model AMD — Power of Three (optional setup model)"
bool   amdOn       = input.bool(true, "Enable AMD model", group = G_AMD)
string amdAccMode  = input.string("Asia range → London / New York", "Accumulation source", options = ["Asia range → London / New York", "Rolling compression (any time)"], group = G_AMD, tooltip = "Asia mode: the completed Asia session range is locked when Asia ends (if it qualifies as consolidation). Manipulation counts only in the London or New York session, entries only inside the entry windows. A 15M close outside the range before London invalidates it. The setup expires when the New York session ends. Rolling mode: the original any-time compression detector.")
float  amdAsiaH1   = input.float(2.5, "Asia mode: Asia range ≤ × 1H ATR(14)", minval = 0.5, step = 0.25, group = G_AMD)
int    amdLen      = input.int(24, "Rolling mode: accumulation window (chart bars)", minval = 8, maxval = 200, group = G_AMD)
float  amdRangeATR = input.float(3.0, "Accumulation: range ≤ × slow ATR(100)", minval = 0.5, step = 0.25, group = G_AMD)
float  amdCompress = input.float(0.8, "Accumulation: ATR(14) ≤ × slow ATR(100) (compression)", minval = 0.2, maxval = 1.5, step = 0.05, group = G_AMD)
int    amdAccExp   = input.int(48, "Accumulation expires after N bars without manipulation", minval = 4, maxval = 500, group = G_AMD)
string amdRclTF    = input.string("15M candle close", "Manipulation reclaim confirmed by", options = ["15M candle close", "Chart candle close"], group = G_AMD, tooltip = "15M (default): the sweep counts only when a COMPLETED 15M candle closes back inside the range. In the replay, the chart-close version saw price break the manipulation extreme again 81% of the time.")
int    amdReclaim  = input.int(2, "Manipulation: close back inside within N candles (of the reclaim TF)", minval = 1, maxval = 20, group = G_AMD)
int    amdAccept   = input.int(2, "Accepted breakout: N consecutive reclaim-TF closes outside", minval = 1, maxval = 20, group = G_AMD)
float  amdMaxSweep = input.float(2.0, "Max sweep depth beyond the range (× ATR14)", minval = 0.2, step = 0.1, group = G_AMD)
int    amdDistExp  = input.int(24, "Distribution must confirm within N bars of manipulation", minval = 2, maxval = 300, group = G_AMD)
float  amdDispATR  = input.float(1.0, "Distribution displacement: body ≥ × ATR14", minval = 0.2, step = 0.1, group = G_AMD)
string amdDistLvl  = input.string("Opposite range boundary", "Distribution candle must close beyond", options = ["Opposite range boundary", "Range midpoint"], group = G_AMD)
bool   amdStruct   = input.bool(false, "Require market-structure confirmation (chart-TF swing break after manipulation)", group = G_AMD)
string amdBias     = input.string("Off", "Directional bias filter", options = ["Off", "Use Model C bias settings"], group = G_AMD)
string amdStopMode = input.string("Manipulation extreme", "Stop", options = ["Manipulation extreme", "Range midpoint", "Displacement candle"], group = G_AMD)
int    amdStopTk   = input.int(2, "Stop buffer (ticks)", minval = 0, group = G_AMD)
string amdCapMode  = input.string("Range-based", "Max stop distance rule", options = ["Range-based", "ATR multiple"], group = G_AMD, tooltip = "Range-based (default): the stop may be at most range height + max sweep depth + buffer. That is the distance a manipulation-extreme stop can legitimately need. ATR multiple: at most N × ATR14. Wider = NOT TRADABLE. The global max-stop-in-points limit always applies too.")
float  amdMaxRisk  = input.float(4.0, "ATR-multiple rule: max stop (× ATR14)", minval = 0.5, step = 0.25, group = G_AMD)
float  amdTp1R     = input.float(1.0, "TP1 (R)", minval = 0.2, step = 0.1, group = G_AMD)
float  amdTp2R     = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.1, group = G_AMD)
float  amdMinRR    = input.float(1.5, "Minimum R:R to TP2", minval = 0.5, step = 0.1, group = G_AMD)
bool   amdShowBox  = input.bool(true, "Show accumulation ranges (thin outline)", group = G_AMD)
bool   amdShowMark = input.bool(true, "Show manipulation / distribution markers", group = G_AMD)
color  amdCol      = input.color(#FFB74D, "AMD colour", group = G_AMD)

string G_CF = "⑲ Confluence engine (optional filter / ranking)"
string cfMode      = input.string("Info only — explain, never block", "Confluence use", options = ["Info only — explain, never block", "Filter — min aligned / max opposing"], group = G_CF, tooltip = "Each model keeps its own entry rules. Confluence COUNTS objective factors at the signal: 4H/1H bias, 15M structure, 1H CRT premium/discount, FVG support / FVG before TP1, demand / supply before TP1, AMD, recent opposite-side liquidity sweep. It never requires all of them, and it is NOT a probability.")
int    cfMinPro    = input.int(2, "Filter: minimum aligned factors", minval = 0, maxval = 7, group = G_CF)
int    cfMaxCon    = input.int(1, "Filter: maximum opposing factors", minval = 0, maxval = 7, group = G_CF)
bool   cfReqBias   = input.bool(false, "Mandatory: 4H and 1H bias both aligned", group = G_CF)
bool   cfReqClear  = input.bool(false, "Mandatory: no opposing FVG / zone between entry and TP1", group = G_CF)
string cfModels    = input.string("All models", "Apply the filter to", options = ["All models", "FVG model only", "Models A + C only"], group = G_CF)

string G_FM = "⑳ Model FVG — displacement gap retest (optional setup model)"
bool   fmOn        = input.bool(false, "Enable FVG model signals (research — negative in validation so far)", group = G_FM, tooltip = "Off by default. FVG gaps are still detected, drawn and used by the confluence engine; only the standalone FVG BUY/SELL signals are disabled.")
bool   fmStrong    = input.bool(true, "Only strong-displacement gaps (★)", group = G_FM)
bool   fmBos       = input.bool(true, "Gap must come with a chart-TF swing break (BOS)", group = G_FM)
int    fmMaxWait   = input.int(36, "First retest must start within N bars of the gap", minval = 1, maxval = 300, group = G_FM)
int    fmTrigWin   = input.int(3, "Rejection close within N bars of the first retest", minval = 1, maxval = 20, group = G_FM)
int    fmStopTk    = input.int(2, "Stop buffer beyond the gap (ticks)", minval = 0, group = G_FM)
float  fmMaxRisk   = input.float(2.0, "Max stop distance (× ATR14) — wider = NOT TRADABLE", minval = 0.3, step = 0.1, group = G_FM)
float  fmTp1R      = input.float(1.0, "TP1 (R)", minval = 0.2, step = 0.1, group = G_FM)
float  fmTp2R      = input.float(2.0, "TP2 (R)", minval = 0.5, step = 0.1, group = G_FM)
float  fmMinRR     = input.float(1.5, "Minimum R:R to TP2", minval = 0.5, step = 0.1, group = G_FM)
string fmBias      = input.string("Off", "Directional bias filter", options = ["Off", "Use Model C bias settings"], group = G_FM)

color C_CLEAR = color.new(color.black, 100)
color C_GOLD  = #E6B422
color C_MUTED = #8B95A5
color C_GREY  = #607D8B

// ───────────────────────────── HELPERS ─────────────────────────────
f_p(float x) => na(x) ? "—" : str.tostring(x, format.mintick)
f_r(float x) => na(x) ? "—" : str.tostring(x, "#.##")

f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec >= 86400 ? str.tostring(sec / 86400) + "D" : sec >= 3600 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "M"

f_market() =>
    string t = str.upper(syminfo.ticker)
    string r = str.upper(syminfo.root)
    if str.contains(t, "XAU") or r == "GC" or r == "MGC" or str.contains(t, "GOLD")
        "GOLD"
    else if r == "NQ" or r == "MNQ" or str.contains(t, "NAS100") or str.contains(t, "US100") or str.contains(t, "NDX") or str.contains(t, "USTEC")
        "NASDAQ"
    else if r == "ES" or r == "MES" or str.contains(t, "SPX") or str.contains(t, "US500") or str.contains(t, "SP500")
        "S&P 500"
    else if str.contains(t, "EURUSD") or r == "6E" or r == "M6E"
        "EUR/USD"
    else if str.contains(t, "USDJPY") or r == "6J"
        "USD/JPY"
    else
        "OTHER"

// ───────────────────────────── DERIVED SETTINGS ─────────────────────────────
string mkt     = marketSel == "Auto-detect" ? f_market() : marketSel
bool   isIdx   = mkt == "NASDAQ" or mkt == "S&P 500"
bool   wAsiaOn = usePresetWin ? mkt == "USD/JPY" : winAsiaIn
bool   wLonOn  = usePresetWin ? not isIdx : winLonIn
bool   wNyOn   = usePresetWin ? true : winNyIn
string wAsiaS  = usePresetWin ? "0900-1130" : winAsiaS
string wLonS   = usePresetWin ? "0800-1100" : winLonS
string wNyS    = usePresetWin ? (isIdx ? "0930-1130" : "0830-1130") : winNyS

bool   isDet     = dispMode == "Detailed"
bool   primHigh  = primaryTF == "Higher TF (4H)"
bool   vis4      = isDet ? show4H : primHigh
bool   vis1      = isDet ? show1H : not primHigh
bool   keepHist  = isDet and showHist
string n4        = f_tfName(tfHigh)
string n1        = f_tfName(tfLow)
string nC        = f_tfName(tfConf)
string nE        = f_tfName(timeframe.period)
bool   tfOK      = timeframe.in_seconds() <= timeframe.in_seconds(tfConf) and timeframe.in_seconds(tfConf) < timeframe.in_seconds(tfLow) and timeframe.in_seconds(tfLow) < timeframe.in_seconds(tfHigh)
bool   src4      = setupSrc != "Setup TF (1H) only"
bool   src1      = setupSrc != "Higher TF (4H) only"
float  minPen    = sweepTicks * syminfo.mintick
float  w1        = tp1Pct / 100.0
// Reclaim timeframe code per level: 0 chart · 1 confirmation TF (15M) · 2 setup TF (1H) · 3 higher TF (4H)
int    rcPool    = reclaimMode == "Chart candle close (v1 behaviour)" ? 0 : 1
int    rcCRT1    = reclaimMode == "Reference-TF candle close (classic CRT)" ? 2 : rcPool
int    rcCRT4    = reclaimMode == "Reference-TF candle close (classic CRT)" ? 3 : rcPool
int    extK      = math.max(extLook, 1)
int    c15Ms     = timeframe.in_seconds(tfConf) * 1000
int    labOff    = 3 * timeframe.in_seconds() * 1000
int    dayMs     = 86400000
int    keepResolved = 144
string dashSz    = dashSizeIn == "Tiny" ? size.tiny : dashSizeIn == "Normal" ? size.normal : size.small

// ───────────────────────────── TYPES ─────────────────────────────
// A tracked liquidity level (CRT boundaries are liquidity levels too).
type Liq
    float  price
    int    side              // +1 buy-side (above price) · -1 sell-side (below price)
    string kind
    string tf = ""
    bool   isCRT = false
    bool   hiTF = false      // belongs to the higher (4H) CRT range
    float  rHi               // CRT range this level belongs to (CRT levels only)
    float  rLo
    int    state = 0         // 0 untouched · 1 breached (unconfirmed) · 2 swept (reclaimed) · 3 broken (breakout)
    int    breachBar
    int    breachTime
    float  ext               // sweep extreme
    int    beyond = 0
    int    resolvedBar
    int    created
    int    expires
    bool   retired = false
    bool   aligned = false
    bool   labeled = false
    bool   external = true     // CRT only: boundary lies beyond the previous N reference candles
    int    rcTF = 0            // timeframe whose completed close confirms the reclaim
    int    tfCnt = 0           // completed reclaim-TF candles that closed beyond the level
    bool   pend = false        // chart candle is back inside, waiting for the reclaim-TF close
    float  fav                 // best price toward the 50% since the breach
    int    rT0                 // reference candle open time (CRT levels)
    line   ln
    label  lb
    label  lbSweep

type CRTRange
    string tf
    float  hi
    float  lo
    float  mid
    int    t0
    int    age = 0
    bool   active = false
    bool   lastFail = false
    Liq    hiLiq
    Liq    loLiq
    line   lnHi
    line   lnLo
    line   lnMid
    label  lbHi
    label  lbLo
    label  lbMid
    box    bxP
    box    bxD

// Setup / trade state machine.
// 0 idle · 3 sweep confirmed & reclaimed (awaiting 15M) · 4 15M confirmed · 5 signal (fill pending)
// 6 position · 8 complete · 9 ended without a trade (cat = STRUCTURAL / CONFLICT / MISSED / EXPIRED / SESSION / REPLACED)
// Everything below is LOCKED at the reclaim and never re-read from the live ranges.
type Setup
    int    state = 0
    int    dir = 0
    string srcTF = ""
    string srcKind = ""
    bool   hiTF = false
    float  level
    float  ext
    float  invalLvl            // planned stop = sweep extreme ∓ buffer (locked)
    int    breachTime
    int    breachBar
    int    reclaimBar
    int    reclaimT
    int    rT0
    string cat = ""
    string cfTxt = ""          // confluence explanation captured at the signal
    line   plInv
    line   plMid
    label  pbInv
    label  pbMid
    float  rHi
    float  rLo
    float  rMid
    int    confBar
    string confText = ""
    float  rtLvl
    int    sigBar
    float  entryRef
    float  entry
    float  stop
    float  stopInit
    float  riskRef
    float  tp1
    float  tp2
    string tp1Src = ""
    string tp2Src = ""
    bool   tp1Done = false
    bool   beOn = false
    int    fillBar
    int    doneBar
    float  resultR
    string outcome = ""
    string reason = ""
    string reject = ""
    array<line>  lines
    array<label> labels
    array<box>   boxes

// Model C reference pair. Boundaries are frozen at lock and never move.
// state: 0 waiting · 1 first candle captured · 2 reference locked / watching
//        7 confirmed (trade issued) · 9 invalidated · 10 expired · 11 missed entry
type CRef
    int    state = 0
    string src = ""
    float  h1
    float  l1
    float  h2
    float  l2
    float  up
    float  lo
    int    t1
    int    t2
    int    nSeen = 0
    bool   upHit = false
    bool   dnHit = false
    bool   bearDQ = false
    bool   bullDQ = false
    string bearWhy = ""
    string bullWhy = ""
    string endWhy = ""
    int    endT
    array<line> lns
    label  lbU
    label  lbL

// Fair value gap. Created at the CLOSE of the third candle; never earlier.
// state: 0 fresh · 1 partially filled · 2 fully mitigated · 3 invalidated (inverse gap closed through)
type FVG
    int    dir             // +1 bullish (support) · -1 bearish (resistance); flips when inverted
    float  top
    float  bot
    int    t0              // open time of the middle (displacement) candle
    int    bar             // bar it became known
    float  disp            // middle-candle body ÷ ATR
    bool   strong = false
    bool   inv = false     // inverse FVG
    int    state = 0
    float  fill = 0.0      // deepest fill fraction 0..1
    bool   bos = false     // a chart-TF swing break happened on candle 2 or 3 (same direction)
    int    tapBar          // first bar that traded back into the gap
    bool   used = false    // already produced an FVG-model candidate (one per gap)

// Supply / demand zone = last opposite candle (order block) before a displacement candle.
// state: 0 active · 1 invalidated (closed through) · 2 retired (retested too often)
type Zone
    int    dir             // +1 demand · -1 supply
    float  top
    float  bot
    int    t0
    int    bar
    float  disp
    bool   bos = false     // displacement candle broke the last confirmed swing
    int    touches = 0
    bool   inside = false
    int    state = 0
    int    endBar

// AMD / Power of Three setup. Range frozen at lock; nothing is confirmed before its candle closes.
// state: 0 scanning · 1 accumulation locked · 2 manipulation in progress (breached, unconfirmed)
//        3 manipulation confirmed (awaiting distribution) · 7 distribution confirmed (trade)
//        9 invalidated · 10 expired · 11 not tradable
type AMD
    int    state = 0
    float  hi
    float  lo
    int    t0
    int    lockBar
    int    side = 0            // side that was swept: +1 above, -1 below
    int    dir = 0             // trade direction = -side
    float  mExt                // manipulation extreme
    int    mBar
    int    confBar
    int    outCnt = 0
    int    preOut = 0          // Asia mode: consecutive 15M closes outside the range BEFORE London / NY
    int    preSide = 0
    bool   preSwept = false    // traded outside before London but closed back inside (range kept)
    bool   structOK = false
    string why = ""
    int    endBar
    box    bx

// ───────────────────────────── LIQUIDITY HELPERS ─────────────────────────────
f_tag(Liq l) =>
    na(l) ? "" : l.state == 1 ? " · BREACHED" : l.state == 2 ? " · SWEPT ✓" : l.state == 3 ? " · BROKEN" : not l.external ? " · internal" : ""

f_poolName(Liq l) =>
    (l.side == 1 ? "BSL " : "SSL ") + l.kind + " " + f_p(l.price)

f_poolDraw(Liq l, int x0) =>
    color c = l.side == 1 ? cBSL : cSSL
    l.ln := line.new(x0, l.price, time, l.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(c, 35), style = line.style_dotted, width = 1)
    l.lb := label.new(time + labOff, l.price, f_poolName(l), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = color.new(c, 10), size = size.tiny)

f_poolUndraw(Liq l) =>
    if not na(l.ln)
        line.delete(l.ln)
    if not na(l.lb)
        label.delete(l.lb)

f_trimPools(array<Liq> arr, int side) =>
    int cnt = 0
    for l in arr
        if not l.isCRT and l.state == 0 and l.side == side
            cnt += 1
    while cnt > poolMax
        int oi = -1
        int ot = na
        for [i, l] in arr
            if not l.isCRT and l.state == 0 and l.side == side and (na(ot) or l.created < ot)
                oi := i
                ot := l.created
        if oi >= 0
            Liq o = arr.remove(oi)
            f_poolUndraw(o)
        cnt -= 1

// Add a pool, merging with an untouched pool on the same side within tolerance.
// Two 15M swings within tolerance become EQH / EQL.
f_addPool(array<Liq> arr, float p, int side, string kind, float tol, int expT, int x0, bool isSwing) =>
    bool done = false
    if not na(p) and arr.size() > 0
        for l in arr
            if not l.isCRT and l.state == 0 and l.side == side and math.abs(l.price - p) <= tol
                if isSwing and (str.contains(l.kind, "SWING") or str.startswith(l.kind, "EQ"))
                    l.kind := side == 1 ? "EQH" : "EQL"
                    l.price := side == 1 ? math.max(l.price, p) : math.min(l.price, p)
                else if not str.contains(l.kind, kind)
                    l.kind := l.kind + " + " + kind
                l.expires := math.max(l.expires, expT)
                if not na(l.ln)
                    line.set_y1(l.ln, l.price)
                    line.set_y2(l.ln, l.price)
                    label.set_y(l.lb, l.price)
                    label.set_text(l.lb, f_poolName(l))
                done := true
                break
    if not na(p) and not done
        Liq n = Liq.new(price = p, side = side, kind = kind, created = time, expires = expT, rcTF = rcPool)
        if (isDet or liqAlways) and showPools
            f_poolDraw(n, na(x0) ? time : x0)
        arr.push(n)
        f_trimPools(arr, side)
    done

// Sweep classifier — runs once per CLOSED chart bar. Returns 0 none · 1 breach · 2 swept & reclaimed · 3 broken.
// nw/cc/tc = "a reclaim-TF candle just completed" / its close / its close time, chosen by the caller
// from completed-candle data only (expr[1] + lookahead_on).
method process(Liq l, float pen, int rcl, int acc, bool nw, float cc, int tc) =>
    int ev = 0
    if l.state == 0
        bool br = l.side == 1 ? high - l.price >= pen - syminfo.mintick * 0.01 : l.price - low >= pen - syminfo.mintick * 0.01
        if br
            l.state := 1
            l.breachBar := bar_index
            l.breachTime := time
            l.ext := l.side == 1 ? high : low
            l.fav := l.side == 1 ? low : high
            l.beyond := 0
            l.tfCnt := 0
            ev := 1
    else if l.state == 1
        l.ext := l.side == 1 ? math.max(l.ext, high) : math.min(l.ext, low)
        l.fav := l.side == 1 ? math.min(l.fav, low) : math.max(l.fav, high)
    if l.state == 1 and l.rcTF != 0
        // Reclaim must be confirmed by a COMPLETED reclaim-TF candle that closed after the breach began
        l.pend := l.side == 1 ? close < l.price : close > l.price
        if nw and not na(tc) and tc > l.breachTime
            bool backTF = l.side == 1 ? cc < l.price : cc > l.price
            if backTF
                l.state := 2
                l.resolvedBar := bar_index
                ev := 2
            else
                l.tfCnt := l.tfCnt + 1
                if l.tfCnt >= (l.rcTF == 1 ? reclaimWin15 : 1)
                    l.state := 3
                    l.resolvedBar := bar_index
                    ev := 3
    else if l.state == 1
        bool backIn = l.side == 1 ? close < l.price : close > l.price
        bool beyondNow = l.side == 1 ? close > l.price : close < l.price
        if backIn
            l.state := 2
            l.resolvedBar := bar_index
            ev := 2
        else
            if beyondNow
                l.beyond := l.beyond + 1
            if l.beyond >= acc or bar_index - l.breachBar + 1 >= rcl
                l.state := 3
                l.resolvedBar := bar_index
                ev := 3
    ev

// Nearest untouched level on `side`, at least `minDist` beyond `from`, not beyond `maxP`.
f_nearestLiq(array<Liq> arr, int side, float fromP, float minDist, float maxP) =>
    float best = na
    string bk = ""
    for l in arr
        if l.state == 0 and not l.retired and l.side == side
            float dist = side * (l.price - fromP)
            bool inCap = na(maxP) or side * (maxP - l.price) >= 0
            if dist >= minDist and inCap and (na(best) or dist < side * (best - fromP))
                best := l.price
                bk := l.kind
    [best, bk]

// ───────────────────────────── CRT RANGE METHODS ─────────────────────────────
method retire(CRTRange r, array<line> hist, bool keep) =>
    if not na(r.hiLiq)
        r.hiLiq.retired := true
    if not na(r.loLiq)
        r.loLiq.retired := true
    if not na(r.lnHi)
        if keep
            line.set_extend(r.lnHi, extend.none)
            line.set_extend(r.lnLo, extend.none)
            line.set_extend(r.lnMid, extend.none)
            line.set_x2(r.lnHi, time)
            line.set_x2(r.lnLo, time)
            line.set_x2(r.lnMid, time)
            line.set_color(r.lnHi, color.new(cHi, 70))
            line.set_color(r.lnLo, color.new(cLo, 70))
            line.set_color(r.lnMid, color.new(cMid, 70))
            line.set_width(r.lnHi, 1)
            line.set_width(r.lnLo, 1)
            line.set_width(r.lnMid, 1)
            hist.push(r.lnHi)
            hist.push(r.lnLo)
            hist.push(r.lnMid)
            while hist.size() > histCount * 3
                line.delete(hist.shift())
        else
            line.delete(r.lnHi)
            line.delete(r.lnLo)
            line.delete(r.lnMid)
    if not na(r.lbHi)
        label.delete(r.lbHi)
        label.delete(r.lbLo)
        label.delete(r.lbMid)
    if not na(r.bxP)
        box.delete(r.bxP)
        box.delete(r.bxD)
    r.lnHi := na
    r.lnLo := na
    r.lnMid := na
    r.lbHi := na
    r.lbLo := na
    r.lbMid := na
    r.bxP := na
    r.bxD := na

method drawNew(CRTRange r, bool primary, bool isHigh) =>
    int w = isHigh ? 2 : 1
    int tr = isHigh ? 0 : 15
    r.lnHi  := line.new(r.t0, r.hi, time, r.hi, xloc = xloc.bar_time, extend = extend.right, color = color.new(cHi, tr), style = line.style_solid, width = w)
    r.lnLo  := line.new(r.t0, r.lo, time, r.lo, xloc = xloc.bar_time, extend = extend.right, color = color.new(cLo, tr), style = line.style_solid, width = w)
    r.lnMid := line.new(r.t0, r.mid, time, r.mid, xloc = xloc.bar_time, extend = extend.right, color = color.new(cMid, tr), style = line.style_dashed, width = w)
    int xl = time + labOff * (isHigh ? 7 : 3)
    r.lbHi  := label.new(xl, r.hi, r.tf + " CRT HIGH " + f_p(r.hi), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cHi, size = size.small)
    r.lbLo  := label.new(xl, r.lo, r.tf + " CRT LOW " + f_p(r.lo), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cLo, size = size.small)
    r.lbMid := label.new(xl, r.mid, r.tf + " CRT 50% " + f_p(r.mid), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cMid, size = size.small)
    if showPD and primary
        r.bxP := box.new(r.t0, r.hi, time, r.mid, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(cHi, 93))
        r.bxD := box.new(r.t0, r.mid, time, r.lo, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(cLo, 93))

// Called on the first chart bar after a reference candle completes.
method roll(CRTRange r, float hi, float lo, int t0, float atrH, array<Liq> arr, array<line> hist, bool vis, bool keep, bool primary, bool isHigh, float priorH, float priorL) =>
    float rng = hi - lo
    bool valid = not na(hi) and not na(lo) and not na(atrH) and rng > 0 and rng >= minRangeATR * atrH and rng <= maxRangeATR * atrH
    if valid
        if r.active
            r.retire(hist, keep)
        r.hi := hi
        r.lo := lo
        r.mid := (hi + lo) / 2
        r.t0 := t0
        r.age := 0
        r.active := true
        r.lastFail := false
        int rc = isHigh ? rcCRT4 : rcCRT1
        Liq lh = Liq.new(price = hi, side = 1, kind = r.tf + " CRT HIGH", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = extLook == 0 or na(priorH) or hi > priorH)
        Liq ll = Liq.new(price = lo, side = -1, kind = r.tf + " CRT LOW", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = extLook == 0 or na(priorL) or lo < priorL)
        r.hiLiq := lh
        r.loLiq := ll
        arr.push(lh)
        arr.push(ll)
        if vis
            r.drawNew(primary, isHigh)
    else
        r.lastFail := true
        r.age := r.age + 1
        if r.active and r.age > rangeMaxAge
            r.retire(hist, keep)
            r.active := false
    valid

method refresh(CRTRange r, bool isLast, bool isHigh) =>
    if r.active and not na(r.lnHi)
        line.set_style(r.lnHi, r.hiLiq.state == 2 ? line.style_dotted : r.hiLiq.state == 3 ? line.style_dashed : line.style_solid)
        line.set_style(r.lnLo, r.loLiq.state == 2 ? line.style_dotted : r.loLiq.state == 3 ? line.style_dashed : line.style_solid)
        if isLast
            int xl = time + labOff * (isHigh ? 7 : 3)
            label.set_x(r.lbHi, xl)
            label.set_x(r.lbLo, xl)
            label.set_x(r.lbMid, xl)
            label.set_text(r.lbHi, r.tf + " CRT HIGH " + f_p(r.hi) + f_tag(r.hiLiq))
            label.set_text(r.lbLo, r.tf + " CRT LOW " + f_p(r.lo) + f_tag(r.loLiq))

f_rangeRow(CRTRange r, string name) =>
    string s = ""
    if not r.active
        s := r.lastFail ? "No valid range (last " + name + " candle failed size filter)" : "Waiting for a completed " + name + " candle"
    else
        Liq h = r.hiLiq
        Liq lo = r.loLiq
        bool hiEv = h.state > 0
        bool loEv = lo.state > 0
        if hiEv or loEv
            Liq e = hiEv and loEv ? (h.breachTime >= lo.breachTime ? h : lo) : hiEv ? h : lo
            bool isH = e.side == 1
            s := e.state == 1 ? (isH ? "High breached — awaiting reclaim" : "Low breached — awaiting reclaim") : e.state == 2 ? (isH ? "High swept & reclaimed → bearish" : "Low swept & reclaimed → bullish") : (isH ? "Broke above high (accepted)" : "Broke below low (accepted)")
        else
            s := close >= r.mid ? "Inside range · PREMIUM" : "Inside range · DISCOUNT"
        s := s + "\nH " + f_p(r.hi) + " · 50% " + f_p(r.mid) + " · L " + f_p(r.lo)
    s

// ───────────────────────────── EVENT / TRADE DRAWING ─────────────────────────────
f_evLabel(array<label> q, int x, float y, string txt, color bg, color tc, string st, string sz, string tip, string yl) =>
    label lb = label.new(x, y, txt, xloc = xloc.bar_index, yloc = yl, color = bg, style = st, textcolor = tc, size = sz, tooltip = tip)
    q.push(lb)
    if q.size() > 250
        label.delete(q.shift())
    lb

f_sweepLabel(array<label> q, Liq l, bool star) =>
    bool bsl = l.side == 1
    string head = l.isCRT ? (l.tf + (bsl ? " CRT HIGH SWEPT" : " CRT LOW SWEPT")) : ((bsl ? "BSL SWEPT · " : "SSL SWEPT · ") + l.kind)
    string txt = head + (star ? " ★" : "") + "\n" + f_p(l.price)
    color bg = bsl ? color.new(cBear, 20) : color.new(cBull, 20)
    string tip = "Level " + f_p(l.price) + " | extreme " + f_p(l.ext) + " | breach→reclaim " + str.tostring(bar_index - l.breachBar + 1) + " bar(s)" + (star ? " | ★ aligned with active CRT setup" : "")
    l.lbSweep := f_evLabel(q, bar_index, l.ext, txt, bg, color.white, bsl ? label.style_label_down : label.style_label_up, size.small, tip, yloc.price)
    l.labeled := true

f_alert(string ev, int d, float lvl, float en, float sl, float t1, float t2, string note) =>
    string ds = d == 1 ? "LONG" : d == -1 ? "SHORT" : "NONE"
    string mdl = str.startswith(ev, "C_") ? "C" : str.startswith(ev, "AMD_") ? "AMD" : str.startswith(ev, "FVG_") ? "FVG" : "A"
    string msg = ""
    if alJSON
        msg := "{\"source\":\"MEKA CRT PRO\",\"symbol\":\"" + syminfo.ticker + "\",\"exchange\":\"" + syminfo.prefix + "\",\"timeframe\":\"" + timeframe.period + "\",\"model\":\"" + mdl + "\",\"event\":\"" + ev + "\",\"direction\":\"" + ds + "\",\"close\":" + str.tostring(close, format.mintick) + ",\"level\":" + (na(lvl) ? "null" : str.tostring(lvl, format.mintick)) + ",\"entry\":" + (na(en) ? "null" : str.tostring(en, format.mintick)) + ",\"sl\":" + (na(sl) ? "null" : str.tostring(sl, format.mintick)) + ",\"tp1\":" + (na(t1) ? "null" : str.tostring(t1, format.mintick)) + ",\"tp2\":" + (na(t2) ? "null" : str.tostring(t2, format.mintick)) + ",\"note\":\"" + note + "\",\"bar_time\":" + str.tostring(time) + "}"
    else
        msg := "MEKA CRT PRO [" + mdl + "] | " + syminfo.ticker + " " + timeframe.period + " | " + ev + " " + ds + " | close " + f_p(close) + (na(lvl) ? "" : " | level " + f_p(lvl)) + (na(en) ? "" : " | entry " + f_p(en)) + (na(sl) ? "" : " | SL " + f_p(sl)) + (na(t1) ? "" : " | TP1 " + f_p(t1)) + (na(t2) ? "" : " | TP2 " + f_p(t2)) + (note == "" ? "" : " | " + note)
    alert(msg, alert.freq_once_per_bar_close)

f_tradeDraw(Setup s, string tag) =>
    int x1 = bar_index
    int x2 = bar_index + 4
    line lE = line.new(x1, s.entryRef, x2, s.entryRef, color = cEntry, width = 2)
    line lS = line.new(x1, s.stop, x2, s.stop, color = cSL, width = 2)
    line lA = line.new(x1, s.tp1, x2, s.tp1, color = cTP, width = 1, style = line.style_dashed)
    line lB = line.new(x1, s.tp2, x2, s.tp2, color = cTP, width = 2)
    s.lines := array.from(lE, lS, lA, lB)
    label bE = label.new(x2, s.entryRef, tag + "ENTRY " + f_p(s.entryRef), style = label.style_label_left, color = C_CLEAR, textcolor = cEntry, size = size.small)
    label bS = label.new(x2, s.stop, tag + "SL " + f_p(s.stop), style = label.style_label_left, color = C_CLEAR, textcolor = cSL, size = size.small)
    label bA = label.new(x2, s.tp1, tag + "TP1 " + f_p(s.tp1), style = label.style_label_left, color = C_CLEAR, textcolor = cTP, size = size.small)
    label bB = label.new(x2, s.tp2, tag + "TP2 " + f_p(s.tp2) + " · " + f_r(math.abs(s.tp2 - s.entryRef) / s.riskRef) + "R", style = label.style_label_left, color = C_CLEAR, textcolor = cTP, size = size.small)
    s.labels := array.from(bE, bS, bA, bB)
    box zr = box.new(x1, math.max(s.entryRef, s.stop), x2, math.min(s.entryRef, s.stop), border_color = C_CLEAR, bgcolor = color.new(cSL, 92))
    box zw = box.new(x1, math.max(s.entryRef, s.tp2), x2, math.min(s.entryRef, s.tp2), border_color = C_CLEAR, bgcolor = color.new(cTP, 93))
    s.boxes := array.from(zr, zw)

f_tradeExtend(Setup s, int x2) =>
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, x2)
        for lb in s.labels
            label.set_x(lb, x2)
        for bx in s.boxes
            box.set_right(bx, x2)

f_tradeDelete(Setup s) =>
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        for lb in s.labels
            label.delete(lb)
        for bx in s.boxes
            box.delete(bx)

// Targets. d = +1 long / -1 short. Returns [tp1, tp2, tp1 source, tp2 source]; tp2 = na → no valid target.
f_targets(int d, float entry, float risk, float rHi, float rLo, float rMid, string rTF, array<Liq> arr) =>
    float opp = d == 1 ? rHi : rLo
    float tp2 = na
    string tp2s = ""
    if tp2Mode == "R multiple"
        tp2 := entry + d * tp2R * risk
        tp2s := str.tostring(tp2R) + "R"
    else
        if d * (opp - entry) >= minRR * risk
            tp2 := opp
            tp2s := rTF + (d == 1 ? " CRT HIGH" : " CRT LOW")
        else
            // external liquidity beyond the opposite boundary, capped at one extra range height
            [px, kx] = f_nearestLiq(arr, d, entry, minRR * risk, opp + d * (rHi - rLo))
            if not na(px)
                tp2 := px
                tp2s := kx
    // Cap far structural targets (e.g. a 4H boundary hundreds of points away)
    if not na(tp2) and tp2Mode != "R multiple" and tp2MaxR > 0 and d * (tp2 - entry) > tp2MaxR * risk
        [pc, kc] = f_nearestLiq(arr, d, entry, minRR * risk, entry + d * tp2MaxR * risk)
        tp2 := not na(pc) ? pc : entry + d * tp2MaxR * risk
        tp2s := not na(pc) ? kc : "cap " + str.tostring(tp2MaxR) + "R"
    float tp1 = na
    string tp1s = ""
    if not na(tp2)
        if tp1Mode == "R multiple"
            tp1 := entry + d * tp1R * risk
            tp1s := str.tostring(tp1R) + "R"
        else
            if tp1Mode == "CRT 50%" and d * (rMid - entry) >= tp1MinR * risk and d * (tp2 - rMid) > 0
                tp1 := rMid
                tp1s := "CRT 50%"
            if na(tp1)
                [p1x, k1x] = f_nearestLiq(arr, d, entry, tp1MinR * risk, tp2)
                if not na(p1x) and d * (tp2 - p1x) > 0
                    tp1 := p1x
                    tp1s := k1x
            if na(tp1)
                tp1 := entry + d * tp1R * risk
                tp1s := str.tostring(tp1R) + "R"
        if d * (tp2 - tp1) <= 0
            tp1 := entry + (tp2 - entry) * 0.5
            tp1s := "½ way to TP2"
    [tp1, tp2, tp1s, tp2s]

// ── Diagnostic log (last 20 setup outcomes). Arrays, so functions may append to them.
var array<string> diagT = array.new<string>()
var array<string> diagS = array.new<string>()
var array<string> diagC = array.new<string>()
var array<string> diagR = array.new<string>()

f_log(string what, string cat, string why) =>
    diagT.push(str.format_time(time, "MM-dd HH:mm", syminfo.timezone))
    diagS.push(what)
    diagC.push(cat)
    diagR.push(why)
    if diagT.size() > 20
        diagT.shift()
        diagS.shift()
        diagC.shift()
        diagR.shift()

f_desc(Setup s) =>
    (s.dir == 1 ? "LONG · " : "SHORT · ") + s.srcKind + " " + f_p(s.level)

f_pendDel(Setup s) =>
    if not na(s.plInv)
        line.delete(s.plInv)
        line.delete(s.plMid)
        label.delete(s.pbInv)
        label.delete(s.pbMid)
    s.plInv := na
    s.plMid := na
    s.pbInv := na
    s.pbMid := na

// Ends a pending setup WITHOUT a trade. cat: STRUCTURAL · CONFLICT · MISSED · EXPIRED · SESSION · REPLACED
f_invalidate(Setup s, string cat, string why, array<label> q) =>
    s.state := 9
    s.cat := cat
    s.reason := why
    s.doneBar := bar_index
    f_pendDel(s)
    string tag = cat == "STRUCTURAL" ? "✕ INVALIDATED" : cat == "CONFLICT" ? "✕ CONFLICT" : cat == "MISSED" ? "MISSED ENTRY" : cat == "SESSION" ? "SESSION CLOSED" : cat == "REPLACED" ? "REPLACED" : "EXPIRED"
    if isDet
        f_evLabel(q, bar_index, s.dir == 1 ? low : high, tag, color.new(C_GREY, 15), color.white, s.dir == 1 ? label.style_label_up : label.style_label_down, size.tiny, why, s.dir == 1 ? yloc.belowbar : yloc.abovebar)
    f_log(f_desc(s), cat, why)
    if alMgmt
        f_alert("SETUP_" + cat, s.dir, s.level, na, na, na, na, why)

// ── Shared trade lifecycle (Model A and Model C use the SAME fill + exit rules)
// mdl = "A" or "C". Event names for Model A are unchanged; Model C events get a "C_" prefix.
f_fill(Setup s, array<label> q, string mdl) =>
    string pfx = mdl == "A" ? "" : mdl + " "
    string epf = mdl == "A" ? "" : mdl + "_"
    s.entry := open
    s.fillBar := bar_index
    s.state := 6
    if not na(s.lines) and s.lines.size() > 0
        line.set_y1(s.lines.get(0), open)
        line.set_y2(s.lines.get(0), open)
        label.set_y(s.labels.get(0), open)
        label.set_text(s.labels.get(0), pfx + "ENTRY " + f_p(open))
        if s.dir == 1
            box.set_top(s.boxes.get(0), open)
            box.set_bottom(s.boxes.get(1), open)
        else
            box.set_bottom(s.boxes.get(0), open)
            box.set_top(s.boxes.get(1), open)
    if isDet
        f_evLabel(q, bar_index, open, pfx + "FILL " + f_p(open), color.new(cEntry, 25), color.white, label.style_label_left, size.tiny, "Simulated fill at this bar's open (signal was on the previous closed bar)", yloc.price)
    if alSig
        f_alert(epf + "ENTRY_FILLED_SIM", s.dir, na, open, s.stop, s.tp1, s.tp2, "Model " + mdl + " simulated fill at bar open")

// Conservative intrabar order: STOP first. Returns [outcome ("" while open), tp1 hit this bar, stop hit].
f_manage(Setup s, array<label> q, string mdl) =>
    string pfx = mdl == "A" ? "" : mdl + " "
    string epf = mdl == "A" ? "" : mdl + "_"
    int dP = s.dir
    string outc = ""
    bool hitT1 = false
    bool stopH = false
    bool hitStop = dP == 1 ? low <= s.stop : high >= s.stop
    if hitStop
        float xPx = dP == 1 ? math.min(open, s.stop) : math.max(open, s.stop)
        float rLeg = dP * (xPx - s.entry) / s.riskRef
        s.resultR := s.tp1Done ? s.resultR + (1 - w1) * rLeg : rLeg
        outc := s.tp1Done and s.beOn ? "BE STOP" : "STOP HIT"
        stopH := true
    else
        hitT1 := not s.tp1Done and (dP == 1 ? high >= s.tp1 : low <= s.tp1)
        if hitT1
            s.tp1Done := true
            s.resultR := w1 * dP * (s.tp1 - s.entry) / s.riskRef
            if not na(s.labels) and s.labels.size() > 2
                label.set_text(s.labels.get(2), pfx + "TP1 ✓ " + f_p(s.tp1))
            if isDet
                f_evLabel(q, bar_index, s.tp1, pfx + "TP1 HIT", color.new(cTP, 20), color.black, dP == 1 ? label.style_label_down : label.style_label_up, size.small, "Partial " + str.tostring(tp1Pct) + "% closed at " + f_p(s.tp1), yloc.price)
            if alMgmt
                f_alert(epf + "TP1_HIT", dP, s.tp1, s.entry, s.stop, s.tp1, s.tp2, "")
            if w1 >= 1.0
                outc := "TP1 HIT"
        if outc == "" and s.tp1Done and (dP == 1 ? high >= s.tp2 : low <= s.tp2)
            s.resultR := s.resultR + (1 - w1) * dP * (s.tp2 - s.entry) / s.riskRef
            outc := "TP2 HIT"
        if outc == "" and maxBars > 0 and bar_index - s.fillBar + 1 >= maxBars
            float rE = dP * (close - s.entry) / s.riskRef
            s.resultR := s.tp1Done ? s.resultR + (1 - w1) * rE : rE
            outc := "EARLY EXIT"
        if hitT1 and useBE and outc == ""
            s.beOn := true
            s.stop := s.entry
            if not na(s.lines) and s.lines.size() > 1
                line.set_y1(s.lines.get(1), s.entry)
                line.set_y2(s.lines.get(1), s.entry)
                label.set_y(s.labels.get(1), s.entry)
                label.set_text(s.labels.get(1), pfx + "SL → BE " + f_p(s.entry))
    if outc != ""
        s.state := 8
        s.outcome := outc
        s.doneBar := bar_index
        f_tradeExtend(s, bar_index)
        bool isWin = s.resultR > 0
        float yO = outc == "STOP HIT" or outc == "BE STOP" ? s.stop : outc == "EARLY EXIT" ? close : outc == "TP1 HIT" ? s.tp1 : s.tp2
        bool towardTP = outc == "TP2 HIT" or outc == "TP1 HIT"
        string stO = (dP == 1) == towardTP ? label.style_label_down : label.style_label_up
        f_evLabel(q, bar_index, yO, pfx + outc + " " + (s.resultR >= 0 ? "+" : "") + f_r(s.resultR) + "R", color.new(isWin ? cTP : outc == "BE STOP" ? C_GREY : cSL, 15), isWin ? color.black : color.white, stO, size.small, "Simulated result incl. " + str.tostring(tp1Pct) + "% partial at TP1", yloc.price)
        f_log(f_desc(s), "TRADE", outc + " " + (s.resultR >= 0 ? "+" : "") + f_r(s.resultR) + "R (simulated)")
        if alMgmt
            f_alert(epf + (outc == "TP2 HIT" ? "TP2_HIT" : outc == "TP1 HIT" ? "TP1_FULL_EXIT" : outc == "EARLY EXIT" ? "EARLY_EXIT" : "STOP_HIT"), dP, yO, s.entry, s.stop, s.tp1, s.tp2, "result " + f_r(s.resultR) + "R")
    else
        f_tradeExtend(s, bar_index + 4)
    [outc, hitT1, stopH]

// Session high/low tracker (must be called on every bar).
f_sess(bool inS) =>
    var float sH = na
    var float sL = na
    var int   sT = na
    var float dH = na
    var float dL = na
    var int   dT = na
    bool ended = false
    if inS and not inS[1]
        sH := high
        sL := low
        sT := time
    else if inS
        sH := math.max(sH, high)
        sL := math.min(sL, low)
    if not inS and inS[1] and not na(sH)
        dH := sH
        dL := sL
        dT := sT
        ended := true
    [sH, sL, dH, dL, dT, ended]


// 15M market-structure engine. Runs INSIDE request.security on the confirmation TF.
// Every returned value is shifted [1] → with lookahead_on this yields only the last
// COMPLETED confirmation candle (no future leak, no repaint).
f_struct(int L, int R, float dm) =>
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    float a  = ta.atr(14)
    bool disp = math.abs(close - open) >= dm * a
    var float swH = na
    var float swL = na
    var int   swHT = na
    var int   swLT = na
    var bool  swHB = true
    var bool  swLB = true
    var int   trend = 0
    var int   bullT = na
    var float bullLvl = na
    var int   bullPT = na
    var bool  bullCh = false
    var bool  bullDs = false
    var int   bearT = na
    var float bearLvl = na
    var int   bearPT = na
    var bool  bearCh = false
    var bool  bearDs = false
    var int   bullDT = na
    var int   bearDT = na
    if not na(ph)
        swH := ph
        swHT := time[R]
        swHB := false
    if not na(pl)
        swL := pl
        swLT := time[R]
        swLB := false
    if not swHB and close > swH
        swHB := true
        bullCh := trend <= 0
        bullDs := disp and close > open
        trend := 1
        bullT := time_close
        bullLvl := swH
        bullPT := swHT
    if not swLB and close < swL
        swLB := true
        bearCh := trend >= 0
        bearDs := disp and close < open
        trend := -1
        bearT := time_close
        bearLvl := swL
        bearPT := swLT
    if close > open and disp and close > high[1]
        bullDT := time_close
    if close < open and disp and close < low[1]
        bearDT := time_close
    [bullT[1], bullLvl[1], bullPT[1], bullCh[1], bullDs[1], bullDT[1], bearT[1], bearLvl[1], bearPT[1], bearCh[1], bearDs[1], bearDT[1], trend[1], swH[1], swHB[1], swHT[1], swL[1], swLB[1], swLT[1]]

// ───────────────────────────── MULTI-TIMEFRAME DATA (non-repainting) ─────────────────────────────
// Pattern: expression[1] + lookahead_on = the last fully closed higher-TF candle,
// identical on historical and realtime bars.
// [2] = the candles BEFORE the reference candle (external-boundary rule)
[h4H, h4L, h4T, h4ATR, h4C, h4TC, h4PH, h4PL] = request.security(syminfo.tickerid, tfHigh, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[h1H, h1L, h1T, h1ATR, h1C, h1TC, h1PH, h1PL] = request.security(syminfo.tickerid, tfLow, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[c15BullT, c15BullLvl, c15BullPT, c15BullCh, c15BullDs, c15BullDT, c15BearT, c15BearLvl, c15BearPT, c15BearCh, c15BearDs, c15BearDT, c15Trend, c15SwH, c15SwHB, c15SwHT, c15SwL, c15SwLB, c15SwLT] = request.security(syminfo.tickerid, tfConf, f_struct(pivL15, pivR15, dispMult), lookahead = barmerge.lookahead_on)

[c15C, c15TC] = request.security(syminfo.tickerid, tfConf, [close[1], time_close[1]], lookahead = barmerge.lookahead_on)

// ── Model C: completed 15M candles. TWO deliberately different requests:
//  (a) lookahead_OFF, read ONLY on the confirmed chart bar whose close equals the 15M close
//      (time_close == time_close(tfConf)). At that instant the 15M candle is complete, so its
//      values are final on historical AND realtime bars → signal at the true 15M close.
//  (b) expr[1] + lookahead_on = the previous completed 15M candle. Used only as a fallback when
//      (a) was skipped (e.g. a missing chart bar). Each candle is processed exactly once (by time).
[q15O, q15H, q15L, q15C, q15T, q15V, q15ATR, q15VA] = request.security(syminfo.tickerid, tfConf, [open, high, low, close, time, volume, ta.atr(14), ta.sma(volume, 20)], lookahead = barmerge.lookahead_off)
[p15O, p15H, p15L, p15C, p15T, p15V, p15ATR, p15VA] = request.security(syminfo.tickerid, tfConf, [open[1], high[1], low[1], close[1], time[1], volume[1], ta.atr(14)[1], ta.sma(volume, 20)[1]], lookahead = barmerge.lookahead_on)
// Directional bias: last COMPLETED 4H / 1H close vs that TF's EMA (non-repainting)
[b4C, b4E] = request.security(syminfo.tickerid, tfHigh, [close[1], ta.ema(close, cEmaLen)[1]], lookahead = barmerge.lookahead_on)
[b1C, b1E] = request.security(syminfo.tickerid, tfLow, [close[1], ta.ema(close, cEmaLen)[1]], lookahead = barmerge.lookahead_on)
int  cBias4 = na(b4E) ? 0 : b4C > b4E ? 1 : b4C < b4E ? -1 : 0
int  cBias1 = na(b1E) ? 0 : b1C > b1E ? 1 : b1C < b1E ? -1 : 0
bool c15Last = time_close == time_close(tfConf)

bool h4New   = not na(h4T) and (na(h4T[1]) or h4T != h4T[1])
bool c15New  = not na(c15TC) and (na(c15TC[1]) or c15TC != c15TC[1])
bool h1New   = not na(h1T) and (na(h1T[1]) or h1T != h1T[1])
bool pdNew   = not na(pdT) and (na(pdT[1]) or pdT != pdT[1])
bool pwNew   = not na(pwT) and (na(pwT[1]) or pwT != pwT[1])
bool swHNew  = not na(c15SwHT) and (na(c15SwHT[1]) or c15SwHT != c15SwHT[1])
bool swLNew  = not na(c15SwLT) and (na(c15SwLT[1]) or c15SwLT != c15SwLT[1])
bool mBullNew = not na(c15BullT) and (na(c15BullT[1]) or c15BullT != c15BullT[1])
bool mBearNew = not na(c15BearT) and (na(c15BearT[1]) or c15BearT != c15BearT[1])

// ───────────────────────────── MODEL C HELPERS ─────────────────────────────
f_hhmm(int t, string tz) => hour(t, tz) * 100 + minute(t, tz)
f_fmtT(int t) => str.format_time(t, "MM-dd HH:mm", syminfo.timezone)

// Is open time `t` inside session "HHMM-HHMM" in time zone `tz`? (DST handled by the IANA zone)
f_inSessT(int t, string sess, string tz) =>
    int a = int(str.tonumber(str.substring(sess, 0, 4)))
    int b = int(str.tonumber(str.substring(sess, 5, 9)))
    int m = f_hhmm(t, tz)
    a < b ? (m >= a and m < b) : (m >= a or m < b)

// Name of the session whose OPEN candle starts at `t`, or "".
f_cOpen(int t) =>
    string nm = ""
    if cOpenNy and f_hhmm(t, nyTZ) == int(str.tonumber(cOpenNyT))
        nm := "NY open"
    else if cOpenLon and f_hhmm(t, lonTZ) == int(str.tonumber(cOpenLonT))
        nm := "London open"
    else if cOpenAsia and f_hhmm(t, asiaTZ) == int(str.tonumber(cOpenAsiaT))
        nm := "Asia open"
    nm

// Effective bias for Model C after the conflict policy. Returns [bias, conflict, text].
f_cBias() =>
    bool conflict = cBias4 != cBias1
    int eff = cBiasMode == "4H only" ? cBias4 : cBiasMode == "1H only" ? cBias1 : not conflict ? cBias4 : cConflict == "Follow 4H" ? cBias4 : cConflict == "Follow 1H" ? cBias1 : 0
    string a4 = cBias4 == 1 ? "↑" : cBias4 == -1 ? "↓" : "–"
    string a1 = cBias1 == 1 ? "↑" : cBias1 == -1 ? "↓" : "–"
    string txt = cBiasMode == "Off" ? "bias filter OFF (" + n4 + " " + a4 + " · " + n1 + " " + a1 + ")" : n4 + " " + a4 + " · " + n1 + " " + a1 + (cBiasMode == "4H + 1H" ? (conflict ? " → CONFLICT (" + cConflict + ")" : " → aligned") : "")
    [eff, conflict, txt]

// Context filters for a confirmed breakout. Returns "" when it passes, else the plain-English reason.
f_cFilter(int d, int ct, float kO, float kC, float kAtr, float kV, float kVA) =>
    string why = ""
    bool inS = cSesAny or (cSesAsia and f_inSessT(ct, asiaSess, asiaTZ)) or (cSesLon and f_inSessT(ct, lonSess, lonTZ)) or (cSesNy and f_inSessT(ct, nySess, nyTZ))
    [eff, conflict, btxt] = f_cBias()
    if not inS
        why := "the breakout candle (" + f_fmtT(ct) + ") is outside the enabled sessions"
    else if cBiasMode == "4H + 1H" and conflict and cConflict == "Block trade"
        why := n4 + " and " + n1 + " bias disagree (" + btxt + ")"
    else if cBiasMode != "Off" and eff != d
        why := "it is against the directional bias (" + btxt + ")"
    else if cStructF and c15Trend != d
        why := nC + " market structure is not " + (d == 1 ? "bullish" : "bearish")
    else if cDispMin > 0 and not na(kAtr) and math.abs(kC - kO) < cDispMin * kAtr
        why := "breakout body " + f_r(math.abs(kC - kO) / kAtr) + " ATR < " + f_r(cDispMin) + " ATR"
    else if cVolMult > 0 and not na(kV) and not na(kVA) and kVA > 0 and kV < cVolMult * kVA
        why := "breakout volume " + f_r(kV / kVA) + "× average < " + f_r(cVolMult) + "×"
    why

// Model C targets. Returns [tp1, tp2, tp1 source, tp2 source, reason-if-not-tradable].
f_cTargets(int d, float e, float risk, array<Liq> arr) =>
    float t1 = na
    float t2 = na
    string s1 = str.tostring(cTp1R) + "R"
    string s2 = str.tostring(cTp2R) + "R"
    string miss = ""
    float capP = cTp2MaxR > 0 ? e + d * cTp2MaxR * risk : na
    if cTpMode == "R multiples"
        t1 := e + d * cTp1R * risk
        t2 := e + d * cTp2R * risk
    else if cTpMode == "Nearest liquidity (strict)"
        t1 := e + d * cTp1R * risk
        t2 := e + d * cTp2R * risk
        [pL, kLq] = f_nearestLiq(arr, d, e, 0.0, na)
        if not na(pL)
            if d * (pL - e) < cMinRR * risk
                miss := "the nearest liquidity (" + kLq + " " + f_p(pL) + ") is only " + f_r(d * (pL - e) / risk) + "R away"
            else
                t2 := pL
                s2 := kLq
    else
        [p1, k1] = f_nearestLiq(arr, d, e, tp1MinR * risk, capP)
        t1 := not na(p1) ? p1 : e + d * cTp1R * risk
        s1 := not na(p1) ? k1 : s1
        [p2, k2] = f_nearestLiq(arr, d, e, math.max(cMinRR * risk, d * (t1 - e) + syminfo.mintick), capP)
        t2 := not na(p2) ? p2 : e + d * cTp2R * risk
        s2 := not na(p2) ? k2 : s2
    if not na(capP) and d * (t2 - capP) > 0
        t2 := capP
        s2 := "cap " + str.tostring(cTp2MaxR) + "R"
    if d * (t2 - t1) <= 0
        t1 := e + (t2 - e) * 0.5
        s1 := "½ to TP2"
    if miss == "" and d * (t2 - e) / risk < cMinRR
        miss := "TP2 offers only " + f_r(d * (t2 - e) / risk) + "R (< " + f_r(cMinRR) + "R)"
    [t1, t2, s1, s2, miss]

method cLock(CRef r, float h2, float l2, int t2) =>
    r.h2 := h2
    r.l2 := l2
    r.t2 := t2
    r.up := math.max(r.h1, h2)
    r.lo := math.min(r.l1, l2)
    r.state := 2
    r.nSeen := 0
    color cl = color.new(cCol, 10)
    if isDet
        r.lns.push(line.new(r.t1, r.h1, r.t1 + c15Ms, r.h1, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(r.t1, r.l1, r.t1 + c15Ms, r.l1, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(t2, h2, t2 + c15Ms, h2, xloc = xloc.bar_time, color = cl, width = 2))
        r.lns.push(line.new(t2, l2, t2 + c15Ms, l2, xloc = xloc.bar_time, color = cl, width = 2))
    if cShowBnd
        r.lns.push(line.new(r.t1, r.up, time + labOff, r.up, xloc = xloc.bar_time, color = color.new(cCol, 35), style = line.style_dashed, width = 1))
        r.lns.push(line.new(r.t1, r.lo, time + labOff, r.lo, xloc = xloc.bar_time, color = color.new(cCol, 35), style = line.style_dashed, width = 1))
        r.lbU := label.new(time + labOff, r.up, "C UPPER " + f_p(r.up), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cCol, size = size.tiny)
        r.lbL := label.new(time + labOff, r.lo, "C LOWER " + f_p(r.lo), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cCol, size = size.tiny)
    if alMgmt
        f_alert("C_REFERENCE_LOCKED", 0, na, na, na, na, na, r.src + " pair " + f_fmtT(r.t1) + " + " + f_fmtT(t2) + " · upper " + f_p(r.up) + " · lower " + f_p(r.lo))

method cExtend(CRef r, int x2) =>
    int nL = r.lns.size()
    if nL >= 2 and not na(r.lbU)
        line.set_x2(r.lns.get(nL - 2), x2)
        line.set_x2(r.lns.get(nL - 1), x2)
        label.set_x(r.lbU, x2)
        label.set_x(r.lbL, x2)

method cErase(CRef r) =>
    if not na(r.lns)
        for ln in r.lns
            line.delete(ln)
    if not na(r.lbU)
        label.delete(r.lbU)
        label.delete(r.lbL)

// End a reference pair. st: 7 confirmed · 9 invalidated · 10 expired · 11 missed entry
method cEnd(CRef r, int st, string why, array<label> q) =>
    r.state := st
    r.endWhy := why
    r.endT := time
    r.cExtend(time)
    if st != 7
        string cat = st == 9 ? "INVALIDATED" : st == 10 ? "EXPIRED" : "NOT TRADABLE"
        if not isDet
            r.cErase()
        else
            f_evLabel(q, bar_index, high, "C " + (st == 9 ? "✕ INVALID" : st == 10 ? "EXPIRED" : "NOT TRADABLE"), C_CLEAR, cCol, label.style_label_down, size.tiny, why, yloc.abovebar)
        f_log("C · " + r.src + " U " + f_p(r.up) + " / L " + f_p(r.lo), cat, why)
        if alMgmt
            f_alert(st == 9 ? "C_INVALIDATED" : st == 10 ? "C_EXPIRED" : "C_MISSED_ENTRY", 0, na, na, na, na, na, why)

// ───────────────────────────── CHART-TF SERIES ─────────────────────────────
float atrE = ta.atr(14)
float ph5  = ta.pivothigh(high, pivL5, pivR5)
float pl5  = ta.pivotlow(low, pivL5, pivR5)

bool inAsia = not na(time(timeframe.period, asiaSess, asiaTZ))
bool inLon  = not na(time(timeframe.period, lonSess, lonTZ))
bool inNy   = not na(time(timeframe.period, nySess, nyTZ))
[asH, asL, asDH, asDL, asDT, asEnd] = f_sess(inAsia)
[lnH, lnL, lnDH, lnDL, lnDT, lnEnd] = f_sess(inLon)
[nyH, nyL, nyDH, nyDL, nyDT, nyEnd] = f_sess(inNy)

bool winAsia = wAsiaOn and not na(time(timeframe.period, wAsiaS, asiaTZ))
bool winLon  = wLonOn and not na(time(timeframe.period, wLonS, lonTZ))
bool winNy   = wNyOn and not na(time(timeframe.period, wNyS, nyTZ))
bool entryAllowed = winAsia or winLon or winNy

// Per-bar event flags (set inside the engine functions; read by alerts, dashboard and strategy)
type EV
    bool evHiSwept = false
    bool evLoSwept = false
    bool evReclaim = false
    bool evConfBull = false
    bool evConfBear = false
    bool evBuy = false
    bool evSell = false
    bool evFill = false
    bool evTP1 = false
    bool evTP2 = false
    bool evStop = false
    bool evEarly = false
    bool evInval = false
    bool evDone = false
    bool evCLock = false
    bool evCBuy = false
    bool evCSell = false
    bool evCInval = false
    bool evCExp = false
    bool evCMiss = false
    bool evCFill = false
    bool evCTP1 = false
    bool evCStop = false
    bool evCTP2 = false
    bool evCEarly = false
    bool evCDone = false
    bool evDLock = false
    bool evDManip = false
    bool evDBuy = false
    bool evDSell = false
    bool evDInval = false
    bool evDExp = false
    bool evDMiss = false
    bool evDFill = false
    bool evDTP1 = false
    bool evDStop = false
    bool evDTP2 = false
    bool evDEarly = false
    bool evDDone = false
    bool evFBuy = false
    bool evFSell = false
    bool evFMiss = false
    bool evFFill = false
    bool evFTP1 = false
    bool evFStop = false
    bool evFTP2 = false
    bool evFEarly = false
    bool evFDone = false

// ───────────────────────────── STATE ─────────────────────────────
var array<Liq>   pools     = array.new<Liq>()
var array<line>  hist4     = array.new<line>()
var array<line>  hist1     = array.new<line>()
var array<label> evLabels  = array.new<label>()
var array<box>   zoneQ     = array.new<box>()
var array<line>  mssQ      = array.new<line>()
var array<Setup> tradeHist = array.new<Setup>()
var CRTRange r4 = CRTRange.new(tf = n4)
var CRTRange r1 = CRTRange.new(tf = n1)
var Setup S = Setup.new()
var AMD          AD       = AMD.new()
var Setup        TD       = Setup.new()
var array<Setup> dTrades  = array.new<Setup>()
var array<box>   amdBoxes = array.new<box>()
var int          amdLastEnd = na
var Setup        TF       = Setup.new()
var array<Setup> fTrades  = array.new<Setup>()
var int    lastSSLBar = na     // last bar a sell-side level was swept & reclaimed (any tracked level)
var int    lastBSLBar = na
var int    h4Bias    = 0
var string lastLiq   = "No sweep yet"
var string lastBlock = ""
var float  sw5H  = na
var float  sw5L  = na
var bool   sw5HB = true
var bool   sw5LB = true
var int    lastBull5Bar = na
var int    lastBear5Bar = na
var int    simN  = 0
var int    simW  = 0
var float  simR  = 0.0

// Per-bar event flags (alertcondition + strategy layer)
bool bull5Brk   = false
bool bear5Brk   = false

// ═══════════════════════════════════════════════════════════════════════════════
//  ENGINE — runs once per CLOSED chart bar only (no intrabar signals, no repaint)
// ═══════════════════════════════════════════════════════════════════════════════
EV E = EV.new()

// ── Shared context, evaluated FIRST on every closed bar so every model sees the same state
if barstate.isconfirmed
    // ── 1. Entry-TF structure (pivot levels exist only after their right bars close)
    if not na(ph5)
        sw5H := ph5
        sw5HB := false
    if not na(pl5)
        sw5L := pl5
        sw5LB := false
    if not sw5HB and close > sw5H
        sw5HB := true
        bull5Brk := true
        lastBull5Bar := bar_index
    if not sw5LB and close < sw5L
        sw5LB := true
        bear5Brk := true
        lastBear5Bar := bar_index


// ═══════════════════════════════════════════════════════════════════════════════
//  FVG + SUPPLY / DEMAND ENGINES — context only (they never create trades by themselves).
//  Everything is evaluated on CLOSED chart bars; a gap / zone exists only from the bar on
//  which its last candle closed. Only the nearest zones are drawn, on the last bar.
// ═══════════════════════════════════════════════════════════════════════════════
var array<FVG>  fvgs   = array.new<FVG>()
var array<Zone> zones  = array.new<Zone>()
var array<box>  ctxBox = array.new<box>()

f_zRank(Zone z) =>
    (z.touches == 0 ? 2 : z.touches == 1 ? 1 : 0) + (z.bos ? 1 : 0) + (z.disp >= 2 * sdDispATR ? 2 : 1)

f_blkContext() =>
    // ── FVG update (gaps created on an earlier bar only)
    if fvgOn and fvgs.size() > 0
        for i = fvgs.size() - 1 to 0
            FVG g = fvgs.get(i)
            if g.bar < bar_index and g.state < 2
                if g.dir == 1
                    if close < g.bot
                        if g.inv
                            g.state := 3
                        else
                            g.inv := true
                            g.dir := -1
                            g.state := 0
                            g.fill := 0.0
                            g.bar := bar_index
                            g.used := true
                    else if low <= g.bot
                        g.state := 2
                    else if low < g.top
                        g.state := 1
                        g.tapBar := na(g.tapBar) ? bar_index : g.tapBar
                        g.fill := math.max(g.fill, (g.top - low) / (g.top - g.bot))
                else
                    if close > g.top
                        if g.inv
                            g.state := 3
                        else
                            g.inv := true
                            g.dir := 1
                            g.state := 0
                            g.fill := 0.0
                            g.bar := bar_index
                            g.used := true
                    else if high >= g.top
                        g.state := 2
                    else if high > g.bot
                        g.state := 1
                        g.tapBar := na(g.tapBar) ? bar_index : g.tapBar
                        g.fill := math.max(g.fill, (high - g.bot) / (g.top - g.bot))
            if g.state >= 2 or bar_index - g.bar > fvgMaxAge
                fvgs.remove(i)
    // ── FVG detection: three CLOSED candles [2], [1], [0]
    if fvgOn and bar_index >= 2 and not na(atrE)
        float body1 = math.abs(close[1] - open[1])
        float gUp = low - high[2]
        float gDn = low[2] - high
        if gUp > 0 and gUp >= fvgMinATR * atrE
            fvgs.push(FVG.new(dir = 1, top = low, bot = high[2], t0 = time[1], bar = bar_index, disp = body1 / atrE, strong = close[1] > open[1] and body1 >= fvgStrongATR * atrE, bos = not na(lastBull5Bar) and lastBull5Bar >= bar_index - 1))
        if gDn > 0 and gDn >= fvgMinATR * atrE
            fvgs.push(FVG.new(dir = -1, top = low[2], bot = high, t0 = time[1], bar = bar_index, disp = body1 / atrE, strong = close[1] < open[1] and body1 >= fvgStrongATR * atrE, bos = not na(lastBear5Bar) and lastBear5Bar >= bar_index - 1))
        while fvgs.size() > 40
            fvgs.shift()

    // ── Supply / demand update
    if sdOn and zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.state == 0 and z.bar < bar_index
                bool thru = z.dir == 1 ? close < z.bot : close > z.top
                bool touch = z.dir == 1 ? low <= z.top : high >= z.bot
                if thru
                    z.state := 1
                    z.endBar := bar_index
                else if touch
                    if not z.inside
                        z.touches := z.touches + 1
                        z.inside := true
                        if z.touches > sdMaxTouch
                            z.state := 2
                            z.endBar := bar_index
                else
                    z.inside := false
            if bar_index - z.bar > sdMaxAge or (z.state != 0 and bar_index - z.endBar > 48)
                zones.remove(i)
    // ── Supply / demand detection: this CLOSED bar is a displacement candle
    if sdOn and bar_index > sdLook and not na(atrE)
        bool bullD = close > open and close - open >= sdDispATR * atrE and close > high[1]
        bool bearD = close < open and open - close >= sdDispATR * atrE and close < low[1]
        if bullD or bearD
            int dZ = bullD ? 1 : -1
            int k = 1
            for j = 1 to sdLook
                if dZ == 1 ? close[j] < open[j] : close[j] > open[j]
                    k := j
                    break
            float zt = high[k]
            float zb = low[k]
            bool zBos = dZ == 1 ? bull5Brk : bear5Brk
            float zDisp = math.abs(close - open) / atrE
            bool merged = false
            for z in zones
                if z.state == 0 and z.dir == dZ and zb <= z.top and zt >= z.bot
                    z.disp := math.max(z.disp, zDisp)
                    z.bos := z.bos or zBos
                    merged := true
                    break
            if not merged
                zones.push(Zone.new(dir = dZ, top = zt, bot = zb, t0 = time[k], bar = bar_index, disp = zDisp, bos = zBos))
            while zones.size() > 30
                zones.shift()
    true

if barstate.isconfirmed
    f_blkContext()


// ═══════════════════════════════════════════════════════════════════════════════
//  CONFLUENCE ENGINE — counts objective factors at a model's signal bar.
//  It never replaces a model's entry rules, never requires every factor, and is not a
//  probability. Returns [aligned, opposing, explanation, bias aligned, path to TP1 clear].
//  mdl excludes the model's own trigger from the count (AMD does not count "AMD", FVG not "FVG").
// ═══════════════════════════════════════════════════════════════════════════════
f_cfAdd(string acc, string item) => acc == "" ? item : acc + ", " + item

f_conf(int d, float e, float t1, string mdl) =>
    int pro = 0
    int con = 0
    string ok = ""
    string no = ""
    bool biasOK = cBias4 == d and cBias1 == d
    if biasOK
        pro += 1
        ok := f_cfAdd(ok, n4 + "/" + n1 + " bias")
    else if cBias4 == -d and cBias1 == -d
        con += 1
        no := f_cfAdd(no, n4 + "/" + n1 + " bias")
    if c15Trend == d
        pro += 1
        ok := f_cfAdd(ok, nC + " structure")
    else if c15Trend == -d
        con += 1
        no := f_cfAdd(no, nC + " structure")
    if r1.active
        bool disc = e < r1.mid
        if (d == 1) == disc
            pro += 1
            ok := f_cfAdd(ok, n1 + (disc ? " discount" : " premium"))
        else
            con += 1
            no := f_cfAdd(no, n1 + (disc ? " discount" : " premium"))
    bool fSup = false
    bool fOpp = false
    for g in fvgs
        if g.state < 2
            if g.dir == d and (d == 1 ? g.bot <= e and e - g.top <= atrE : g.top >= e and g.bot - e <= atrE)
                fSup := true
            if g.dir == -d and (d == 1 ? g.bot > e and g.bot < t1 : g.top < e and g.top > t1)
                fOpp := true
    if fSup and mdl != "FVG"
        pro += 1
        ok := f_cfAdd(ok, "FVG support")
    if fOpp
        con += 1
        no := f_cfAdd(no, "FVG before TP1")
    bool zSup = false
    bool zOpp = false
    for z in zones
        if z.state == 0
            if z.dir == d and (d == 1 ? z.bot <= e and e - z.top <= atrE : z.top >= e and z.bot - e <= atrE)
                zSup := true
            if z.dir == -d and (d == 1 ? z.bot > e and z.bot < t1 : z.top < e and z.top > t1)
                zOpp := true
    if zSup
        pro += 1
        ok := f_cfAdd(ok, d == 1 ? "demand" : "supply")
    if zOpp
        con += 1
        no := f_cfAdd(no, (d == 1 ? "supply" : "demand") + " before TP1")
    if mdl != "AMD" and AD.state == 3
        if AD.dir == d
            pro += 1
            ok := f_cfAdd(ok, "AMD")
        else
            con += 1
            no := f_cfAdd(no, "AMD")
    int sw = d == 1 ? lastSSLBar : lastBSLBar
    if not na(sw) and bar_index - sw <= 12
        pro += 1
        ok := f_cfAdd(ok, d == 1 ? "SSL swept" : "BSL swept")
    string txt = "✓ " + str.tostring(pro) + (ok != "" ? " (" + ok + ")" : "") + " · ✕ " + str.tostring(con) + (no != "" ? " (" + no + ")" : "")
    [pro, con, txt, biasOK, not fOpp and not zOpp]

// Returns "" if the candidate passes the configured confluence rules, else the reason.
f_cfReject(int pro, int con, bool biasOK, bool clear, string mdl) =>
    bool applies = cfModels == "All models" or (cfModels == "FVG model only" and mdl == "FVG") or (cfModels == "Models A + C only" and (mdl == "A" or mdl == "C"))
    string r = ""
    if applies
        if cfReqBias and not biasOK
            r := "4H and 1H bias are not both aligned (mandatory)"
        else if cfReqClear and not clear
            r := "an opposing FVG / zone sits between entry and TP1 (mandatory)"
        else if cfMode == "Filter — min aligned / max opposing" and pro < cfMinPro
            r := "only " + str.tostring(pro) + " aligned factor(s), needs " + str.tostring(cfMinPro)
        else if cfMode == "Filter — min aligned / max opposing" and con > cfMaxCon
            r := str.tostring(con) + " opposing factor(s), max " + str.tostring(cfMaxCon)
    r

f_engA(EV e, Setup p_S, int p_h4Bias, int p_lastBSLBar, string p_lastBlock, string p_lastLiq, int p_lastSSLBar, int p_simN, float p_simR, int p_simW) =>
    Setup w_S = p_S
    int w_h4Bias = p_h4Bias
    int w_lastBSLBar = p_lastBSLBar
    string w_lastBlock = p_lastBlock
    string w_lastLiq = p_lastLiq
    int w_lastSSLBar = p_lastSSLBar
    int w_simN = p_simN
    float w_simR = p_simR
    int w_simW = p_simW
    // ── 2. Roll CRT reference ranges on completion of a 4H / 1H candle
    if h4New
        r4.roll(h4H, h4L, h4T, h4ATR, pools, hist4, vis4, keepHist, primHigh, true, h4PH, h4PL)
    if h1New
        r1.roll(h1H, h1L, h1T, h1ATR, pools, hist1, vis1, keepHist, not primHigh, false, h1PH, h1PL)
    CRTRange pr = primHigh ? (r4.active ? r4 : r1) : (r1.active ? r1 : r4)

    // ── 3. Liquidity pools (built only from information that existed before this bar)
    float tol = eqTolATR * atrE
    int expD = time + poolDays * dayMs
    if trackPD and pdNew
        f_addPool(pools, pdH, 1, "PDH", tol, expD, na, false)
        f_addPool(pools, pdL, -1, "PDL", tol, expD, na, false)
    if trackPW and pwNew
        f_addPool(pools, pwH, 1, "PWH", tol, time + poolDays * 3 * dayMs, na, false)
        f_addPool(pools, pwL, -1, "PWL", tol, time + poolDays * 3 * dayMs, na, false)
    if trackSess
        if asEnd
            f_addPool(pools, asDH, 1, "ASIA H", tol, expD, asDT, false)
            f_addPool(pools, asDL, -1, "ASIA L", tol, expD, asDT, false)
        if lnEnd
            f_addPool(pools, lnDH, 1, "LDN H", tol, expD, lnDT, false)
            f_addPool(pools, lnDL, -1, "LDN L", tol, expD, lnDT, false)
        if nyEnd
            f_addPool(pools, nyDH, 1, "NY H", tol, expD, nyDT, false)
            f_addPool(pools, nyDL, -1, "NY L", tol, expD, nyDT, false)
    if trackSw
        if swHNew and not na(c15SwH)
            f_addPool(pools, c15SwH, 1, nC + " SWING H", tol, expD, c15SwHT, true)
        if swLNew and not na(c15SwL)
            f_addPool(pools, c15SwL, -1, nC + " SWING L", tol, expD, c15SwLT, true)

    // ── 4. Sweep / breakout classification for every tracked level
    Liq best = na
    int bestScore = 0
    float bHi = na
    float bLo = na
    string bTF = ""
    int bT0 = na
    for l in pools
        if l.retired and l.state != 1
            continue
        bool  nwR = l.rcTF == 1 ? c15New : l.rcTF == 2 ? h1New : h4New
        float ccR = l.rcTF == 1 ? c15C : l.rcTF == 2 ? h1C : h4C
        int   tcR = l.rcTF == 1 ? c15TC : l.rcTF == 2 ? h1TC : h4TC
        int ev = l.process(minPen, reclaimBars, acceptBars, nwR, ccR, tcR)
        if ev == 2
            bool qual = false
            int score = 0
            float qHi = na
            float qLo = na
            string qTF = ""
            int qT0 = na
            if l.isCRT
                if (l.hiTF ? src4 : src1) and not l.external
                    w_lastBlock := l.kind + " sweep ignored: internal boundary (an earlier " + l.tf + " candle already traded beyond it)"
                if (l.hiTF ? src4 : src1) and l.external
                    qual := true
                    score := l.hiTF ? 3 : 2
                    qHi := l.rHi
                    qLo := l.rLo
                    qTF := l.tf
                    qT0 := l.rT0
            else if usePools and pr.active
                l.aligned := l.side == 1 ? l.price >= pr.mid : l.price <= pr.mid
                if l.aligned
                    qual := true
                    score := 1
                    qHi := pr.hi
                    qLo := pr.lo
                    qTF := pr.tf
                    qT0 := pr.t0
            qual := qual and tfOK and math.abs(l.ext - l.price) <= maxSweepATR * atrE
            if isDet
                f_sweepLabel(evLabels, l, qual and not l.isCRT)
                if isDet
                    zoneQ.push(box.new(l.breachBar, math.max(l.price, l.ext), bar_index, math.min(l.price, l.ext), border_color = color.new(l.side == 1 ? cBear : cBull, 60), bgcolor = color.new(l.side == 1 ? cBear : cBull, 88)))
                    if zoneQ.size() > 40
                        box.delete(zoneQ.shift())
            if l.side == -1
                w_lastSSLBar := bar_index
            else
                w_lastBSLBar := bar_index
            w_lastLiq := (l.isCRT ? l.kind + " swept" : (l.side == 1 ? "BSL swept · " : "SSL swept · ") + l.kind) + " " + f_p(l.price)
            e.evReclaim := true
            if l.isCRT
                if l.side == 1
                    e.evHiSwept := true
                else
                    e.evLoSwept := true
            if alSweep
                f_alert(l.isCRT ? (l.side == 1 ? "CRT_HIGH_SWEPT" : "CRT_LOW_SWEPT") : "LIQUIDITY_RECLAIMED", -l.side, l.price, na, na, na, na, l.kind + " reclaimed, extreme " + f_p(l.ext))
            if qual and score > bestScore
                best := l
                bestScore := score
                bHi := qHi
                bLo := qLo
                bTF := qTF
                bT0 := qT0
        else if ev == 3 and isDet
            f_evLabel(evLabels, bar_index, l.price, (l.isCRT ? l.kind + " BROKEN" : (l.side == 1 ? "BSL BREAK · " : "SSL BREAK · ") + l.kind), color.new(C_GREY, 30), color.white, l.side == 1 ? label.style_label_down : label.style_label_up, size.tiny, "Accepted beyond " + f_p(l.price) + " — breakout, not a sweep", yloc.price)
        if (ev == 2 or ev == 3) and not na(l.ln)
            line.set_extend(l.ln, extend.none)
            line.set_x2(l.ln, time)
            line.set_color(l.ln, color.new(C_GREY, 40))
            label.set_x(l.lb, time)
            label.set_textcolor(l.lb, color.new(C_GREY, 20))
            label.set_text(l.lb, l.kind + (ev == 2 ? " ✓ swept" : " ✗ broken"))

    // ── 5. Higher-TF (4H) bias from the active 4H CRT range
    w_h4Bias := 0
    if r4.active
        bool bu = r4.loLiq.state == 2 or r4.hiLiq.state == 3
        bool bd = r4.hiLiq.state == 2 or r4.loLiq.state == 3
        w_h4Bias := bu and not bd ? 1 : bd and not bu ? -1 : 0

    // ── 6. Simulated fill (next bar open after the signal)
    if w_S.state == 5 and bar_index > w_S.sigBar
        f_fill(w_S, evLabels, "A")
        e.evFill := true

    // ── 7. Position management — conservative intrabar order: STOP first (shared with Model C)
    if w_S.state == 6
        [oA, t1A, stA] = f_manage(w_S, evLabels, "A")
        e.evTP1 := t1A
        e.evStop := stA
        e.evTP2 := oA == "TP2 HIT"
        e.evEarly := oA == "EARLY EXIT"
        if oA != ""
            e.evDone := true
            w_simN += 1
            w_simW += w_S.resultR > 0 ? 1 : 0
            w_simR += w_S.resultR

    // ── 8. Pending-setup checks. Each ending has ONE category and a plain-English reason.
    //    A new 4H / 1H candle opening never ends a setup: all levels below are LOCKED in S.
    if w_S.state == 3 or w_S.state == 4
        int dA = w_S.dir
        string cat = ""
        string why = ""
        // STRUCTURAL: price reached the planned stop (sweep extreme ∓ buffer) — the trade would have lost
        bool through = dA == 1 ? (wickInval ? low <= w_S.invalLvl : close <= w_S.invalLvl) : (wickInval ? high >= w_S.invalLvl : close >= w_S.invalLvl)
        // CONFLICT: the confirmation TF printed a structure break the OTHER way after the reclaim
        int oppT = dA == 1 ? c15BearT : c15BullT
        bool conflict = conflictInval and w_S.state == 3 and not na(oppT) and oppT > w_S.reclaimT
        // MISSED: TP1 area reached before an entry existed (no chasing)
        bool ran = dA == 1 ? high >= w_S.rMid : low <= w_S.rMid
        if through
            cat := "STRUCTURAL"
            why := "Price " + (wickInval ? "traded" : "closed") + " through the planned stop " + f_p(w_S.invalLvl) + " (sweep extreme " + f_p(w_S.ext) + " + buffer) before an entry — the sweep failed."
        else if conflict
            cat := "CONFLICT"
            why := nC + " broke structure " + (dA == 1 ? "DOWN at " + f_p(c15BearLvl) : "UP at " + f_p(c15BullLvl)) + " after the reclaim — opposite confirmation, setup cancelled."
        else if ran
            cat := "MISSED"
            why := "Price reached the CRT 50% " + f_p(w_S.rMid) + " " + (w_S.state == 3 ? "before " + nC + " confirmed" : "after " + nC + " but before a valid " + nE + " entry") + " — move missed, not chased."
        else if w_S.state == 3 and bar_index - w_S.reclaimBar > confExpiry
            cat := "EXPIRED"
            why := "No " + nC + " confirmation within " + str.tostring(confExpiry) + " bars of the reclaim."
        else if w_S.state == 4 and bar_index - w_S.confBar > entryExpiry
            bool sess = str.contains(w_S.reject, "entry window")
            cat := sess ? "SESSION" : "EXPIRED"
            why := sess ? "Valid " + nE + " triggers appeared only while new entries were OFF (outside the entry windows); expired after " + str.tostring(entryExpiry) + " bars." : "No valid " + nE + " entry within " + str.tostring(entryExpiry) + " bars of " + nC + " confirmation" + (w_S.reject != "" ? " (last trigger rejected: " + w_S.reject + ")." : ".")
        if cat != ""
            f_invalidate(w_S, cat, why, evLabels)
            e.evInval := true

    // ── 9. New setup from the best qualifying sweep on this bar
    if not na(best)
        int dB = -best.side
        float bMid = (bHi + bLo) / 2
        float bufB = math.max(stopBufTk * syminfo.mintick, stopBufATR * atrE)
        float invB = dB == 1 ? best.ext - bufB : best.ext + bufB
        string block = ""
        bool logIt = true
        if htfFilter and w_h4Bias == -dB and not best.hiTF
            block := "it is against the " + n4 + " CRT bias"
        else if (dB == 1 ? high >= bMid : low <= bMid) or (dB == 1 ? best.fav >= bMid : best.fav <= bMid)
            block := "price already reached the CRT 50% before the reclaim was confirmed"
        else if w_S.state == 5 or w_S.state == 6
            block := "a trade is already active"
            logIt := false
        else if roomCheck
            // Best plausible entry = a retest of the swept level. If even that has no ≥ min-R:R target,
            // the sweep can never become a trade → say so instead of showing SETUP FORMING.
            float rBest = dB * (best.price - invB)
            float t2B = na
            if rBest > 0
                [x1, x2, x1s, x2s] = f_targets(dB, best.price, rBest, bHi, bLo, bMid, bTF, pools)
                t2B := x2
            if na(t2B)
                block := "there is no target ≥ " + f_r(minRR) + "R even from a retest of the level"
        if block == ""
            if (w_S.state == 3 or w_S.state == 4) and w_S.dir != dB
                f_invalidate(w_S, "REPLACED", "Replaced by an opposite qualifying sweep (" + best.kind + " " + f_p(best.price) + ").", evLabels)
                e.evInval := true
            if w_S.state == 0 or w_S.state == 8 or w_S.state == 9
                w_S := Setup.new(state = 3, dir = dB, srcTF = bTF, srcKind = best.kind, hiTF = best.hiTF, level = best.price, ext = best.ext, invalLvl = invB, breachTime = best.breachTime, breachBar = best.breachBar, reclaimBar = bar_index, reclaimT = time, rT0 = bT0, rHi = bHi, rLo = bLo, rMid = bMid, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                w_lastBlock := ""
                if not best.labeled
                    f_sweepLabel(evLabels, best, true)
                label.set_text(best.lbSweep, label.get_text(best.lbSweep) + "\nRECLAIMED · WATCH " + (dB == 1 ? "LONG ↑" : "SHORT ↓"))
                // Locked levels for the pending setup (independent of later range rolls)
                int xs = bar_index
                if isDet
                    w_S.plInv := line.new(xs, invB, bar_index + 3, invB, color = color.new(cSL, 35), style = line.style_dotted, width = 1)
                    w_S.plMid := line.new(xs, bMid, bar_index + 3, bMid, color = color.new(cMid, 25), style = line.style_dotted, width = 1)
                    w_S.pbInv := label.new(bar_index + 3, invB, "INVALID " + (dB == 1 ? "≤ " : "≥ ") + f_p(invB), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(cSL, 10), size = size.tiny)
                    w_S.pbMid := label.new(bar_index + 3, bMid, "LOCKED " + bTF + " 50% " + f_p(bMid), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(cMid, 10), size = size.tiny)
            else
                block := "a " + (w_S.dir == 1 ? "long" : "short") + " setup is already pending"
                logIt := false
        if block != ""
            w_lastBlock := best.kind + " sweep reclaimed but not traded: " + block
            if logIt
                f_log((dB == 1 ? "LONG · " : "SHORT · ") + best.kind + " " + f_p(best.price), "SKIPPED", "Sweep confirmed but not traded: " + block + ".")

    // ── 10. 15M confirmation (only candles that CLOSED after the breach began)
    if w_S.state == 3
        int dC = w_S.dir
        int   mT   = dC == 1 ? c15BullT : c15BearT
        bool  mCh  = dC == 1 ? c15BullCh : c15BearCh
        bool  mDs  = dC == 1 ? c15BullDs : c15BearDs
        float mLvl = dC == 1 ? c15BullLvl : c15BearLvl
        int   dT   = dC == 1 ? c15BullDT : c15BearDT
        bool mssOK  = not na(mT) and mT > w_S.breachTime and (not reqChoch or mCh)
        bool dispOK = not na(dT) and dT > w_S.breachTime
        bool ok = switch confMode
            "MSS / CHoCH"        => mssOK
            "MSS + Displacement" => mssOK and mDs
            => mssOK or dispOK
        if ok
            w_S.state := 4
            w_S.confBar := bar_index
            w_S.rtLvl := mssOK ? mLvl : w_S.level
            w_S.confText := mssOK ? ((mCh ? "CHoCH " : "BOS ") + (dC == 1 ? "↑ " : "↓ ") + f_p(mLvl) + (mDs ? " + displacement" : "")) : ("Displacement " + (dC == 1 ? "↑" : "↓"))
            if dC == 1
                e.evConfBull := true
            else
                e.evConfBear := true
            if isDet
                f_evLabel(evLabels, bar_index, dC == 1 ? low : high, nC + " ✓", color.new(dC == 1 ? cBull : cBear, 45), color.white, dC == 1 ? label.style_label_up : label.style_label_down, size.tiny, nC + " confirmed: " + w_S.confText, dC == 1 ? yloc.belowbar : yloc.abovebar)
            if alConf
                f_alert(dC == 1 ? "CONF_15M_BULLISH" : "CONF_15M_BEARISH", dC, w_S.rtLvl, na, na, na, na, w_S.confText)

    // ── 11. 5M entry trigger + risk/target qualification → SIGNAL
    if w_S.state == 4
        int dD = w_S.dir
        float tolR = retestTol * atrE
        bool brk = dD == 1 ? bull5Brk : bear5Brk
        bool rt  = dD == 1 ? (low <= w_S.rtLvl + tolR and close > w_S.rtLvl and close > open) : (high >= w_S.rtLvl - tolR and close < w_S.rtLvl and close < open)
        bool mom = dD == 1 ? (close > open and close > high[1]) : (close < open and close < low[1])
        // Timestamp-paired: on the bar the 15M confirmation becomes known, a 5M break that already
        // happened after the breach (and ≤ pairBars ago) completes the 5M side. Entry = THIS bar's close.
        int l5 = dD == 1 ? lastBull5Bar : lastBear5Bar
        bool paired = pairedConf and w_S.confBar == bar_index and not na(l5) and l5 >= w_S.breachBar and bar_index - l5 <= pairBars
        bool trig = switch trigMode
            "5M structure break"  => brk or paired
            "Retest of 15M break" => rt
            "Momentum candle"     => mom
            => brk or rt or paired
        if trig
            float eRef = close
            float stp  = w_S.invalLvl
            float risk = dD * (eRef - stp)
            string rej = ""
            float t1 = na
            float t2 = na
            string t1s = ""
            string t2s = ""
            if risk <= 0
                rej := "entry beyond stop"
            else if risk > maxRiskATR * atrE
                rej := "too far from stop (" + f_r(risk / atrE) + " ATR > " + f_r(maxRiskATR) + ")"
            else if maxStopPts > 0 and risk > maxStopPts
                rej := "stop " + f_p(risk) + " pts > max " + f_p(maxStopPts) + " pts"
            else if reqDiscount and (dD == 1 ? eRef >= w_S.rMid : eRef <= w_S.rMid)
                rej := dD == 1 ? "entry not in discount" : "entry not in premium"
            else if not entryAllowed
                rej := "outside entry window"
            else if htfFilter and w_h4Bias == -dD and not w_S.hiTF
                rej := "against " + n4 + " CRT bias"
            else
                [a1, a2, a1s, a2s] = f_targets(dD, eRef, risk, w_S.rHi, w_S.rLo, w_S.rMid, w_S.srcTF, pools)
                t1 := a1
                t2 := a2
                t1s := a1s
                t2s := a2s
                if na(t2)
                    rej := "no target with ≥ " + f_r(minRR) + "R"
                else if dD * (t2 - eRef) / risk < minRR
                    rej := "R:R " + f_r(dD * (t2 - eRef) / risk) + " < " + f_r(minRR)
            string cfA = ""
            if rej == ""
                [cPa, cNa, cTa, cBa, cCa] = f_conf(dD, eRef, t1, "A")
                cfA := cTa
                string cra = f_cfReject(cPa, cNa, cBa, cCa, "A")
                if cra != ""
                    rej := "confluence: " + cra
            if rej == ""
                w_S.state := 5
                w_S.cfTxt := cfA
                w_S.sigBar := bar_index
                w_S.entryRef := eRef
                w_S.stop := stp
                w_S.stopInit := stp
                w_S.riskRef := risk
                w_S.tp1 := t1
                w_S.tp2 := t2
                w_S.tp1Src := t1s
                w_S.tp2Src := t2s
                w_S.reject := ""
                if dD == 1
                    e.evBuy := true
                else
                    e.evSell := true
                string tipS = w_S.srcKind + " sweep → " + nC + " " + w_S.confText + " → " + nE + " trigger | R:R to TP2 " + f_r(dD * (t2 - eRef) / risk) + " | confluence " + cfA
                f_log(f_desc(w_S), "SIGNAL", "CRT qualifies · confluence " + cfA)
                f_evLabel(evLabels, bar_index, dD == 1 ? low : high, (dD == 1 ? "A · BUY\n" : "A · SELL\n") + f_p(eRef), dD == 1 ? cBull : cBear, color.white, dD == 1 ? label.style_label_up : label.style_label_down, size.normal, tipS, dD == 1 ? yloc.belowbar : yloc.abovebar)
                f_pendDel(w_S)
                f_tradeDraw(w_S, "A ")
                tradeHist.push(w_S)
                if tradeHist.size() > keepTrades
                    f_tradeDelete(tradeHist.shift())
                if alSig
                    f_alert(dD == 1 ? "BUY_CONFIRMED" : "SELL_CONFIRMED", dD, w_S.level, eRef, stp, t1, t2, "fill assumed at next bar open")
            else
                w_S.reject := rej

    // Keep the locked pending levels at the right edge
    if (w_S.state == 3 or w_S.state == 4) and not na(w_S.plInv)
        line.set_x2(w_S.plInv, bar_index + 3)
        line.set_x2(w_S.plMid, bar_index + 3)
        label.set_x(w_S.pbInv, bar_index + 3)
        label.set_x(w_S.pbMid, bar_index + 3)

    // ── 12. Housekeeping: drop expired / resolved / retired levels
    if pools.size() > 0
        for i = pools.size() - 1 to 0
            Liq l = pools.get(i)
            bool rm = l.isCRT ? (l.retired and l.state != 1) : ((l.state == 0 and time > l.expires) or ((l.state == 2 or l.state == 3) and bar_index - l.resolvedBar > keepResolved))
            if rm
                f_poolUndraw(l)
                pools.remove(i)

    // ── 13. Detailed-mode 15M structure markers
    if msShow == "Always" or (msShow == "Detailed mode only" and isDet and showMSS)
        if mBullNew and not na(c15BullPT)
            mssQ.push(line.new(c15BullPT, c15BullLvl, time, c15BullLvl, xloc = xloc.bar_time, color = color.new(cBull, 30), style = line.style_dashed, width = 1))
            f_evLabel(evLabels, bar_index, c15BullLvl, nC + (c15BullCh and c15BullDs ? " MSS ↑" : c15BullCh ? " CHoCH ↑" : " BOS ↑"), C_CLEAR, color.new(cBull, 0), label.style_label_down, size.tiny, "Confirmed on a closed " + nC + " candle", yloc.price)
        if mBearNew and not na(c15BearPT)
            mssQ.push(line.new(c15BearPT, c15BearLvl, time, c15BearLvl, xloc = xloc.bar_time, color = color.new(cBear, 30), style = line.style_dashed, width = 1))
            f_evLabel(evLabels, bar_index, c15BearLvl, nC + (c15BearCh and c15BearDs ? " MSS ↓" : c15BearCh ? " CHoCH ↓" : " BOS ↓"), C_CLEAR, color.new(cBear, 0), label.style_label_up, size.tiny, "Confirmed on a closed " + nC + " candle", yloc.price)
        while mssQ.size() > 30
            line.delete(mssQ.shift())

    // ── 14. Range styling
    r4.refresh(barstate.islast, true)
    r1.refresh(barstate.islast, false)
    [w_S, w_h4Bias, w_lastBSLBar, w_lastBlock, w_lastLiq, w_lastSSLBar, w_simN, w_simR, w_simW]

if barstate.isconfirmed
    [r_S, r_h4Bias, r_lastBSLBar, r_lastBlock, r_lastLiq, r_lastSSLBar, r_simN, r_simR, r_simW] = f_engA(E, S, h4Bias, lastBSLBar, lastBlock, lastLiq, lastSSLBar, simN, simR, simW)
    S := r_S
    h4Bias := r_h4Bias
    lastBSLBar := r_lastBSLBar
    lastBlock := r_lastBlock
    lastLiq := r_lastLiq
    lastSSLBar := r_lastSSLBar
    simN := r_simN
    simR := r_simR
    simW := r_simW

// ═══════════════════════════════════════════════════════════════════════════════
//  MODEL C — 15M DOUBLE-RANGE CONFIRMATION (independent of Model A)
//  Runs on CLOSED chart bars. Each completed 15M candle is processed exactly once,
//  on the chart bar whose close coincides with the 15M close (or, if that bar is
//  missing, on the next chart bar — flagged "late"). Fill = NEXT chart bar open.
// ═══════════════════════════════════════════════════════════════════════════════
var CRef         CR        = CRef.new(lns = array.new<line>())
var array<CRef>  cHist     = array.new<CRef>()
var Setup        TC        = Setup.new()
var array<Setup> cTrades   = array.new<Setup>()
var int    cLastT      = na
var int    cLastPairT2 = na
var bool   cArmed      = false
var int    cArmT       = na
var float  cPrevH      = na
var float  cPrevL      = na
var int    cPrevT      = na
var int    cSimN       = 0
var int    cSimW       = 0
var float  cSimR       = 0.0


f_engC(EV e, CRef p_CR, Setup p_TC, int p_cArmT, bool p_cArmed, int p_cLastPairT2, int p_cLastT, float p_cPrevH, float p_cPrevL, int p_cPrevT, int p_cSimN, float p_cSimR, int p_cSimW) =>
    CRef w_CR = p_CR
    Setup w_TC = p_TC
    int w_cArmT = p_cArmT
    bool w_cArmed = p_cArmed
    int w_cLastPairT2 = p_cLastPairT2
    int w_cLastT = p_cLastT
    float w_cPrevH = p_cPrevH
    float w_cPrevL = p_cPrevL
    int w_cPrevT = p_cPrevT
    int w_cSimN = p_cSimN
    float w_cSimR = p_cSimR
    int w_cSimW = p_cSimW
    // ── C1. Trade lifecycle (shared rules with Model A)
    if w_TC.state == 5 and bar_index > w_TC.sigBar
        f_fill(w_TC, evLabels, "C")
        e.evCFill := true
    if w_TC.state == 6
        [oC, t1C, stC] = f_manage(w_TC, evLabels, "C")
        e.evCTP1 := t1C
        e.evCStop := stC
        e.evCTP2 := oC == "TP2 HIT"
        e.evCEarly := oC == "EARLY EXIT"
        if oC != ""
            e.evCDone := true
            if not isDet and w_CR.state == 7
                w_CR.cErase()
            w_cSimN += 1
            w_cSimW += w_TC.resultR > 0 ? 1 : 0
            w_cSimR += w_TC.resultR

    // ── C2. Structure-event arming (event known only after its 15M candle closed)
    if cRefMode == "First pair after 15M structure event" and (mBullNew or mBearNew)
        w_cArmed := true
        w_cArmT := math.max(nz(c15BullT), nz(c15BearT))

    // ── C3. Pick at most one completed, not-yet-processed 15M candle
    bool  haveC = false
    bool  late  = false
    float kO = na
    float kH = na
    float kL = na
    float kC = na
    int   kT = na
    float kV = na
    float kA = na
    float kVA = na
    if not na(p15T) and (na(w_cLastT) or p15T > w_cLastT)
        haveC := true
        late := not na(w_cLastT)
        kO := p15O
        kH := p15H
        kL := p15L
        kC := p15C
        kT := p15T
        kV := p15V
        kA := p15ATR
        kVA := p15VA
    else if c15Last and not na(q15T) and (na(w_cLastT) or q15T > w_cLastT)
        haveC := true
        kO := q15O
        kH := q15H
        kL := q15L
        kC := q15C
        kT := q15T
        kV := q15V
        kA := q15ATR
        kVA := q15VA

    if haveC
        w_cLastT := kT
        string openNm = cRefMode == "Session-opening pair" ? f_cOpen(kT) : ""
        float cBuf = cBufTk * syminfo.mintick
        bool strictR = cSweepRule == "Strict: any trade beyond"
        bool sweepR  = cSweepRule == "Sweep: trade beyond + 15M close back inside"

        // A new session-opening candle supersedes a pair that is still waiting
        if w_CR.state == 2 and openNm != ""
            w_CR.cEnd(10, "Superseded by the " + openNm + " reference pair before any breakout.", evLabels)
            e.evCExp := true

        // ── C4. Watch a locked pair (only candles strictly AFTER the second reference candle)
        if w_CR.state == 2 and kT > w_CR.t2
            w_CR.nSeen := w_CR.nSeen + 1
            bool inWin = cSweepWin == 0 or w_CR.nSeen <= cSweepWin
            if inWin and (strictR or sweepR)
                if kH > w_CR.up
                    w_CR.upHit := true
                    if strictR and not w_CR.bearDQ
                        w_CR.bearDQ := true
                        w_CR.bearWhy := "a 15M high (" + f_p(kH) + " at " + f_fmtT(kT) + ") traded above the upper boundary " + f_p(w_CR.up)
                if kL < w_CR.lo
                    w_CR.dnHit := true
                    if strictR and not w_CR.bullDQ
                        w_CR.bullDQ := true
                        w_CR.bullWhy := "a 15M low (" + f_p(kL) + " at " + f_fmtT(kT) + ") traded below the lower boundary " + f_p(w_CR.lo)
                if sweepR and w_CR.upHit and kC <= w_CR.up and not w_CR.bearDQ
                    w_CR.bearDQ := true
                    w_CR.bearWhy := "the upper boundary " + f_p(w_CR.up) + " was swept and a 15M candle closed back inside (" + f_fmtT(kT) + ")"
                if sweepR and w_CR.dnHit and kC >= w_CR.lo and not w_CR.bullDQ
                    w_CR.bullDQ := true
                    w_CR.bullWhy := "the lower boundary " + f_p(w_CR.lo) + " was swept and a 15M candle closed back inside (" + f_fmtT(kT) + ")"
            bool bearC = kC < w_CR.lo - cBuf
            bool bullC = kC > w_CR.up + cBuf
            if bearC or bullC
                int dK = bullC ? 1 : -1
                string side = dK == 1 ? "above the upper" : "below the lower"
                string bnd = f_p(dK == 1 ? w_CR.up : w_CR.lo)
                if (dK == 1 ? w_CR.bullDQ : w_CR.bearDQ)
                    w_CR.cEnd(9, "15M closed " + side + " boundary " + bnd + " but the " + (dK == 1 ? "long" : "short") + " side was disqualified: " + (dK == 1 ? w_CR.bullWhy : w_CR.bearWhy) + ".", evLabels)
                    e.evCInval := true
                else
                    string flt = f_cFilter(dK, kT, kO, kC, kA, kV, kVA)
                    if flt != ""
                        w_CR.cEnd(9, "Confirmed close " + side + " boundary " + bnd + " filtered out: " + flt + ".", evLabels)
                        e.evCInval := true
                    else if w_TC.state == 5 or w_TC.state == 6
                        w_CR.cEnd(11, "Confirmed close " + side + " boundary " + bnd + ", but a Model C trade is already open.", evLabels)
                        e.evCMiss := true
                    else if cNeedWin and not entryAllowed
                        w_CR.cEnd(11, "Setup detected (15M closed " + side + " boundary " + bnd + ") but NOT ACTIONABLE: entries are OFF outside the entry windows.", evLabels)
                        e.evCMiss := true
                    else
                        // Risk plan from the signal-time price (this bar's close = the 15M close when on time)
                        float eRef = close
                        float sbuf = cStopTk * syminfo.mintick
                        float capR = math.min(na(kA) ? 1e12 : cMaxRiskATR * kA, maxStopPts > 0 ? maxStopPts : 1e12)
                        float minR = na(kA) ? 0.0 : cMinStopATR * kA
                        float stp = na
                        string stpTxt = "opposite boundary"
                        if cStopMode == "Smart: nearest structure, then ATR"
                            array<float> cand = array.from(dK == 1 ? kL - sbuf : kH + sbuf, dK == 1 ? c15SwL - sbuf : c15SwH + sbuf, dK == 1 ? sw5L - sbuf : sw5H + sbuf)
                            array<string> cnm = array.from("breakout candle", nC + " swing", nE + " swing")
                            float bestR = na
                            for [ix, cv] in cand
                                if not na(cv)
                                    float rr = dK * (eRef - cv)
                                    if rr >= minR and rr <= capR and (na(bestR) or rr < bestR)
                                        bestR := rr
                                        stp := cv
                                        stpTxt := cnm.get(ix)
                            if na(stp) and not na(kA)
                                float ra = math.max(cStopATR * kA, minR)
                                if ra <= capR
                                    stp := eRef - dK * ra
                                    stpTxt := f_r(cStopATR) + " ATR"
                        else
                            if cStopMode == "Recent confirmed 15M swing"
                                float sw = dK == 1 ? c15SwL : c15SwH
                                if not na(sw) and dK * (eRef - sw) > 0
                                    stp := sw - dK * sbuf
                                    stpTxt := nC + " swing"
                            else if cStopMode == "ATR" and not na(kA)
                                stp := eRef - dK * cStopATR * kA
                                stpTxt := f_r(cStopATR) + " ATR"
                            if na(stp)
                                stp := dK == 1 ? w_CR.lo - sbuf : w_CR.up + sbuf
                        float risk = na(stp) ? na : dK * (eRef - stp)
                        float t1 = na
                        float t2 = na
                        string t1s = ""
                        string t2s = ""
                        string miss = ""
                        if na(stp)
                            miss := "no stop fits the limits (structure and ATR stops are all wider than " + f_p(capR) + " pts or tighter than " + f_p(minR) + " pts)"
                        else if risk <= 0
                            miss := "price is already beyond the planned stop"
                        else if risk > capR
                            miss := "stop " + f_p(risk) + " pts (" + stpTxt + ") is wider than the " + f_p(capR) + " pts maximum"
                        else
                            [x1, x2, x1s, x2s, xm] = f_cTargets(dK, eRef, risk, pools)
                            t1 := x1
                            t2 := x2
                            t1s := x1s
                            t2s := x2s
                            miss := xm
                        string cfTc = ""
                        if miss == ""
                            [cPc, cNc, cTc, cBc, cCc] = f_conf(dK, eRef, t1, "C")
                            cfTc := cTc
                            string crc = f_cfReject(cPc, cNc, cBc, cCc, "C")
                            if crc != ""
                                miss := "confluence: " + crc
                        if miss != ""
                            w_CR.cEnd(11, "Setup detected (15M closed " + side + " boundary " + bnd + ") but NOT TRADABLE: " + miss + ".", evLabels)
                            e.evCMiss := true
                        else
                            w_TC := Setup.new(state = 5, dir = dK, srcTF = nC, srcKind = "C " + w_CR.src, level = dK == 1 ? w_CR.up : w_CR.lo, sigBar = bar_index, entryRef = eRef, stop = stp, stopInit = stp, riskRef = risk, tp1 = t1, tp2 = t2, tp1Src = t1s, tp2Src = t2s, cfTxt = cfTc, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                            f_tradeDraw(w_TC, "C ")
                            f_log(f_desc(w_TC), "SIGNAL", "RANGE BREAK qualifies · confluence " + cfTc)
                            cTrades.push(w_TC)
                            if cTrades.size() > keepTrades
                                f_tradeDelete(cTrades.shift())
                            string tipC = "Model C · " + w_CR.src + " pair " + f_fmtT(w_CR.t1) + " + " + f_fmtT(w_CR.t2) + " · signal = 15M close " + f_fmtT(kT + c15Ms) + (late ? " (processed late)" : "") + " · fill = next bar open (simulated) · stop: " + stpTxt + " · R:R to TP2 " + f_r(dK * (t2 - eRef) / risk) + " · confluence " + cfTc
                            f_evLabel(evLabels, bar_index, dK == 1 ? low : high, (dK == 1 ? "C · BUY\n" : "C · SELL\n") + f_p(eRef), color.new(dK == 1 ? cBull : cBear, 0), color.white, dK == 1 ? label.style_label_up : label.style_label_down, size.small, tipC, dK == 1 ? yloc.belowbar : yloc.abovebar)
                            w_CR.cEnd(7, "Confirmed " + (dK == 1 ? "LONG" : "SHORT") + ": 15M closed " + side + " boundary " + bnd + ".", evLabels)
                            if dK == 1
                                e.evCBuy := true
                            else
                                e.evCSell := true
                            if alSig
                                f_alert(dK == 1 ? "C_BUY_CONFIRMED" : "C_SELL_CONFIRMED", dK, dK == 1 ? w_CR.up : w_CR.lo, eRef, stp, t1, t2, "Model C " + w_CR.src + " · fill assumed at next bar open")
            else if w_CR.bullDQ and w_CR.bearDQ
                w_CR.cEnd(9, "Both sides disqualified before any breakout: short — " + w_CR.bearWhy + "; long — " + w_CR.bullWhy + ".", evLabels)
                e.evCInval := true
            else if w_CR.nSeen >= cExpiry
                w_CR.cEnd(10, "No 15M close beyond either boundary within " + str.tostring(cExpiry) + " candles.", evLabels)
                e.evCExp := true
            else
                w_CR.cExtend(time + labOff)

        // ── C5. Second reference candle → lock (must be the very next 15M candle)
        if w_CR.state == 1
            if kT == w_CR.t1 + c15Ms
                w_CR.cLock(kH, kL, kT)
                w_cLastPairT2 := kT
                e.evCLock := true
            else
                w_CR.state := 0

        // ── C6. First reference candle (never reuses a candle from a previous pair or its ending candle)
        if w_CR.state != 1 and w_CR.state != 2
            bool fresh = na(w_cLastPairT2) or kT > w_cLastPairT2
            int endT = w_CR.state >= 7 ? w_CR.endT : na
            string nmNew = ""
            if cRefMode == "Session-opening pair" and openNm != ""
                nmNew := openNm
            else if cRefMode == "First pair after 15M structure event" and w_cArmed and kT >= w_cArmT
                nmNew := "after " + nC + " structure"
                w_cArmed := false
            else if cRefMode == "Rolling consecutive pair" and not na(w_cPrevT) and kT == w_cPrevT + c15Ms and w_cPrevT > nz(w_cLastPairT2) and (na(endT) or w_cPrevT >= endT)
                nmNew := "rolling"
            if nmNew != "" and fresh
                if w_CR.state != 0
                    cHist.push(w_CR)
                    if cHist.size() > 3
                        CRef oldC = cHist.shift()
                        oldC.cErase()
                else
                    w_CR.cErase()
                if nmNew == "rolling"
                    w_CR := CRef.new(state = 1, src = nmNew, h1 = w_cPrevH, l1 = w_cPrevL, t1 = w_cPrevT, lns = array.new<line>())
                    w_CR.cLock(kH, kL, kT)
                    w_cLastPairT2 := kT
                    e.evCLock := true
                else
                    w_CR := CRef.new(state = 1, src = nmNew, h1 = kH, l1 = kL, t1 = kT, lns = array.new<line>())
        w_cPrevH := kH
        w_cPrevL := kL
        w_cPrevT := kT
    [w_CR, w_TC, w_cArmT, w_cArmed, w_cLastPairT2, w_cLastT, w_cPrevH, w_cPrevL, w_cPrevT, w_cSimN, w_cSimR, w_cSimW]

if barstate.isconfirmed and cOn and tfOK
    [r_CR, r_TC, r_cArmT, r_cArmed, r_cLastPairT2, r_cLastT, r_cPrevH, r_cPrevL, r_cPrevT, r_cSimN, r_cSimR, r_cSimW] = f_engC(E, CR, TC, cArmT, cArmed, cLastPairT2, cLastT, cPrevH, cPrevL, cPrevT, cSimN, cSimR, cSimW)
    CR := r_CR
    TC := r_TC
    cArmT := r_cArmT
    cArmed := r_cArmed
    cLastPairT2 := r_cLastPairT2
    cLastT := r_cLastT
    cPrevH := r_cPrevH
    cPrevL := r_cPrevL
    cPrevT := r_cPrevT
    cSimN := r_cSimN
    cSimR := r_cSimR
    cSimW := r_cSimW

// ── Draw only the nearest relevant zones (redrawn on the last bar; no history clutter)
f_blkZonesDraw() =>
    for b in ctxBox
        box.delete(b)
    ctxBox.clear()
    int xR = time + labOff * 2
    if fvgOn and fvgShow and fvgs.size() > 0
        for side in array.from(1, -1)
            array<int> used = array.new<int>()
            for n = 1 to fvgShowN
                int bi = -1
                float bd = na
                bool bs = false
                for [i, g] in fvgs
                    bool okSide = side == 1 ? g.bot < close : g.top > close
                    if g.dir == side and okSide and (fvgShowInv or not g.inv) and (not fvgStrongOnly or g.strong or g.inv) and not used.includes(i)
                        float dist = math.max(0.0, side == 1 ? close - g.top : g.bot - close)
                        if dist <= fvgMaxDist * atrE and (bi < 0 or (g.strong and not bs) or (g.strong == bs and dist < bd))
                            bi := i
                            bd := dist
                            bs := g.strong
                if bi >= 0
                    used.push(bi)
                    FVG g = fvgs.get(bi)
                    string tx = (g.inv ? "IFVG" : "FVG") + (g.strong ? " ★" : "") + (g.state == 1 ? " ◐" : "")
                    ctxBox.push(box.new(g.t0, g.top, xR, g.bot, xloc = xloc.bar_time, border_color = g.inv ? color.new(#9E9E9E, 40) : C_CLEAR, border_style = line.style_dashed, bgcolor = g.inv ? fvgInvC : side == 1 ? fvgBullC : fvgBearC, text = tx, text_size = size.tiny, text_color = color.new(#B0BEC5, 10), text_halign = text.align_right))
    if sdOn and sdShow and zones.size() > 0
        for side in array.from(1, -1)
            array<int> used = array.new<int>()
            for n = 1 to sdShowN
                int bi = -1
                float bd = na
                for [i, z] in zones
                    bool okSide = side == 1 ? z.bot < close : z.top > close
                    if z.state == 0 and z.dir == side and okSide and not used.includes(i)
                        float dist = math.max(0.0, side == 1 ? close - z.top : z.bot - close)
                        if dist <= sdMaxDist * atrE and (bi < 0 or dist < bd)
                            bi := i
                            bd := dist
                if bi >= 0
                    used.push(bi)
                    Zone z = zones.get(bi)
                    ctxBox.push(box.new(z.t0, z.top, xR, z.bot, xloc = xloc.bar_time, border_color = color.new(side == 1 ? sdDemC : sdSupC, 40), border_width = 1, bgcolor = side == 1 ? sdDemC : sdSupC, text = (side == 1 ? "DEMAND " : "SUPPLY ") + str.tostring(f_zRank(z)) + "/5" + (z.bos ? " · BOS" : ""), text_size = size.tiny, text_color = color.new(#B0BEC5, 10), text_halign = text.align_left))
        if sdShowDead
            int nDead = 0
            if zones.size() > 0
                for i = zones.size() - 1 to 0
                    Zone z = zones.get(i)
                    if z.state == 1 and nDead < 2 and math.abs((z.top + z.bot) / 2 - close) <= sdMaxDist * atrE
                        nDead += 1
                        ctxBox.push(box.new(z.t0, z.top, time + labOff, z.bot, xloc = xloc.bar_time, border_color = color.new(#607D8B, 70), border_style = line.style_dotted, bgcolor = color.new(#607D8B, 95), text = (z.dir == 1 ? "demand" : "supply") + " invalid", text_size = size.tiny, text_color = color.new(#607D8B, 30), text_halign = text.align_left))
    true

if barstate.islast
    f_blkZonesDraw()

// ═══════════════════════════════════════════════════════════════════════════════
//  MODEL AMD — ACCUMULATION → MANIPULATION → DISTRIBUTION (independent, optional)
//  All decisions on CLOSED chart bars. Signal at the distribution candle close,
//  simulated fill at the next bar open (shared trade routine with Models A and C).
// ═══════════════════════════════════════════════════════════════════════════════
float atrSlow = ta.atr(100)
float amdHiN  = ta.highest(high, amdLen)
float amdLoN  = ta.lowest(low, amdLen)



f_amdEnd(AMD a, int st, string why, array<label> q) =>
    a.state := st
    a.why := why
    a.endBar := bar_index
    if not na(a.bx)
        box.set_right(a.bx, time)
        if st != 7
            box.set_border_color(a.bx, color.new(amdCol, 75))
    if st != 7
        string cat = st == 9 ? "INVALIDATED" : st == 10 ? "EXPIRED" : "NOT TRADABLE"
        f_log("AMD · range " + f_p(a.lo) + " – " + f_p(a.hi) + (a.dir != 0 ? (a.dir == 1 ? " → LONG" : " → SHORT") : ""), cat, why)
        if alMgmt
            f_alert(st == 9 ? "AMD_INVALIDATED" : st == 10 ? "AMD_EXPIRED" : "AMD_NOT_TRADABLE", a.dir, na, na, na, na, na, why)

f_engAMD(EV e, AMD p_AD, Setup p_TD, int p_amdLastEnd) =>
    AMD w_AD = p_AD
    Setup w_TD = p_TD
    int w_amdLastEnd = p_amdLastEnd
    // ── D1. Trade lifecycle (shared rules)
    if w_TD.state == 5 and bar_index > w_TD.sigBar
        f_fill(w_TD, evLabels, "AMD")
        e.evDFill := true
    if w_TD.state == 6
        [oD, t1D, stD] = f_manage(w_TD, evLabels, "AMD")
        e.evDTP1 := t1D
        e.evDStop := stD
        e.evDTP2 := oD == "TP2 HIT"
        e.evDEarly := oD == "EARLY EXIT"
        if oD != ""
            e.evDDone := true

    float bufD = amdStopTk * syminfo.mintick
    // ── D2. Manipulation watch on a locked accumulation range
    bool asiaMode = amdAccMode == "Asia range → London / New York"
    bool manipSess = not asiaMode or inLon or inNy
    if w_AD.state >= 1 and w_AD.state <= 3 and asiaMode and nyEnd
        f_amdEnd(w_AD, 10, "The New York session ended — the Asia range is not carried into the next day.", evLabels)
        e.evDExp := true
    // Before London / NY the range is carried forward. Three outcomes, judged on completed candles:
    //  intact · swept & reclaimed (kept, noted) · accepted breakout / expansion (invalidated)
    if w_AD.state == 1 and bar_index > w_AD.lockBar and asiaMode and not manipSess
        float exMax = math.max(high - w_AD.hi, w_AD.lo - low)
        if exMax > amdMaxSweep * atrE
            f_amdEnd(w_AD, 9, "Before London, price moved " + f_r(exMax / atrE) + " ATR beyond the Asia range — expansion, not accumulation.", evLabels)
            e.evDInval := true
        else
            if exMax > 0
                w_AD.preSwept := true
            if c15Last
                int sideNow = close > w_AD.hi ? 1 : close < w_AD.lo ? -1 : 0
                if sideNow != 0
                    w_AD.preOut := sideNow == w_AD.preSide ? w_AD.preOut + 1 : 1
                    w_AD.preSide := sideNow
                    if w_AD.preOut >= amdAccept
                        f_amdEnd(w_AD, 9, "Accepted breakout before London: " + str.tostring(w_AD.preOut) + " consecutive 15M closes " + (sideNow == 1 ? "above " + f_p(w_AD.hi) : "below " + f_p(w_AD.lo)) + ".", evLabels)
                        e.evDInval := true
                else
                    w_AD.preOut := 0
                    w_AD.preSide := 0
    if w_AD.state == 1 and bar_index > w_AD.lockBar and manipSess
        bool upB = high - w_AD.hi >= minPen
        bool dnB = w_AD.lo - low >= minPen
        if upB and dnB
            f_amdEnd(w_AD, 9, "Both sides of the accumulation range were broken on the same candle — no clear manipulation.", evLabels)
            e.evDInval := true
        else if upB or dnB
            w_AD.state := 2
            w_AD.side := upB ? 1 : -1
            w_AD.mExt := upB ? high : low
            w_AD.mBar := bar_index
            w_AD.outCnt := 0
        else if not asiaMode and bar_index - w_AD.lockBar > amdAccExp
            f_amdEnd(w_AD, 10, "No manipulation within " + str.tostring(amdAccExp) + " bars of the accumulation lock.", evLabels)
            e.evDExp := true
    if w_AD.state == 2
        w_AD.mExt := w_AD.side == 1 ? math.max(w_AD.mExt, high) : math.min(w_AD.mExt, low)
        float depth = w_AD.side == 1 ? w_AD.mExt - w_AD.hi : w_AD.lo - w_AD.mExt
        // 15M mode: judge the reclaim only on the chart bar whose close IS the completed 15M close
        bool evalNow = amdRclTF == "Chart candle close" or c15Last
        int  rclWin = amdRclTF == "Chart candle close" ? amdReclaim : amdReclaim * math.max(1, int(timeframe.in_seconds(tfConf) / timeframe.in_seconds()))
        bool backIn = evalNow and (w_AD.side == 1 ? close < w_AD.hi : close > w_AD.lo)
        bool outC = evalNow and (w_AD.side == 1 ? close > w_AD.hi : close < w_AD.lo)
        if depth > amdMaxSweep * atrE
            f_amdEnd(w_AD, 9, "Move beyond the range was " + f_r(depth / atrE) + " ATR deep — expansion, not a manipulation sweep.", evLabels)
            e.evDInval := true
        else if backIn
            w_AD.state := 3
            w_AD.dir := -w_AD.side
            w_AD.confBar := bar_index
            w_AD.structOK := false
            e.evDManip := true
            if amdShowMark
                f_evLabel(evLabels, bar_index, w_AD.mExt, "M", color.new(amdCol, 20), color.black, w_AD.side == 1 ? label.style_triangledown : label.style_triangleup, size.tiny, "Manipulation confirmed: swept " + (w_AD.side == 1 ? "above " + f_p(w_AD.hi) : "below " + f_p(w_AD.lo)) + " (extreme " + f_p(w_AD.mExt) + ") and closed back inside", w_AD.side == 1 ? yloc.abovebar : yloc.belowbar)
            if alSweep
                f_alert("AMD_MANIPULATION_CONFIRMED", w_AD.dir, w_AD.side == 1 ? w_AD.hi : w_AD.lo, na, na, na, na, "range " + f_p(w_AD.lo) + " – " + f_p(w_AD.hi) + ", extreme " + f_p(w_AD.mExt))
        else
            if outC
                w_AD.outCnt := w_AD.outCnt + 1
            if w_AD.outCnt >= amdAccept or bar_index - w_AD.mBar + 1 >= rclWin
                f_amdEnd(w_AD, 9, "Price " + (w_AD.outCnt >= amdAccept ? "accepted outside the range (" + str.tostring(w_AD.outCnt) + " closes)" : "did not close back inside within " + str.tostring(amdReclaim) + (amdRclTF == "Chart candle close" ? " bars" : " " + nC + " candles")) + " — breakout, not manipulation.", evLabels)
                e.evDInval := true
    // ── D3. Distribution
    if w_AD.state == 3 and bar_index > w_AD.confBar
        int d = w_AD.dir
        float mid = (w_AD.hi + w_AD.lo) / 2
        if d == 1 ? bull5Brk : bear5Brk
            w_AD.structOK := true
        bool lost = d == 1 ? low < w_AD.mExt : high > w_AD.mExt
        bool dispC = d == 1 ? (close > open and close - open >= amdDispATR * atrE) : (close < open and open - close >= amdDispATR * atrE)
        float lvl = amdDistLvl == "Range midpoint" ? mid : d == 1 ? w_AD.hi : w_AD.lo
        bool beyond = d == 1 ? close > lvl : close < lvl
        if lost
            f_amdEnd(w_AD, 9, "Price broke the manipulation extreme " + f_p(w_AD.mExt) + " before distribution.", evLabels)
            e.evDInval := true
        else if dispC and beyond and (not amdStruct or w_AD.structOK)
            if amdShowMark
                f_evLabel(evLabels, bar_index, d == 1 ? low : high, "D", color.new(d == 1 ? cBull : cBear, 30), color.white, d == 1 ? label.style_triangleup : label.style_triangledown, size.tiny, "Distribution confirmed: displacement close " + (d == 1 ? "above " : "below ") + f_p(lvl), d == 1 ? yloc.belowbar : yloc.abovebar)
            [effD, cnfD, btD] = f_cBias()
            string why = ""
            if amdBias != "Off" and cBiasMode != "Off" and ((cBiasMode == "4H + 1H" and cnfD and cConflict == "Block trade") or effD != d)
                why := "against the directional bias (" + btD + ")"
            else if not entryAllowed
                why := "entries are OFF outside the entry windows"
            else if w_TD.state == 5 or w_TD.state == 6
                why := "an AMD trade is already open"
            float eRef = close
            float stp = amdStopMode == "Range midpoint" ? mid - d * bufD : amdStopMode == "Displacement candle" ? (d == 1 ? low - bufD : high + bufD) : (d == 1 ? w_AD.mExt - bufD : w_AD.mExt + bufD)
            float risk = d * (eRef - stp)
            float capD = math.min(amdCapMode == "Range-based" ? (w_AD.hi - w_AD.lo) + amdMaxSweep * atrE + bufD : amdMaxRisk * atrE, maxStopPts > 0 ? maxStopPts : 1e12)
            if why == "" and risk <= 0
                why := "price is already beyond the planned stop"
            else if why == "" and risk > capD
                why := "stop " + f_p(risk) + " pts is wider than the " + f_p(capD) + " pts maximum"
            else if why == "" and amdTp2R < amdMinRR
                why := "TP2 " + f_r(amdTp2R) + "R is below the minimum R:R"
            string cfTd = ""
            if why == ""
                [cPd, cNd, cTd, cBd, cCd] = f_conf(d, eRef, eRef + d * amdTp1R * risk, "AMD")
                cfTd := cTd
                string crd = f_cfReject(cPd, cNd, cBd, cCd, "AMD")
                if crd != ""
                    why := "confluence: " + crd
            if why != ""
                f_amdEnd(w_AD, 11, "Distribution confirmed but NOT TRADABLE: " + why + ".", evLabels)
                e.evDMiss := true
            else
                float t1 = eRef + d * amdTp1R * risk
                float t2 = eRef + d * amdTp2R * risk
                w_TD := Setup.new(state = 5, dir = d, srcTF = nE, srcKind = "AMD range " + f_p(w_AD.lo) + "–" + f_p(w_AD.hi), level = d == 1 ? w_AD.lo : w_AD.hi, ext = w_AD.mExt, sigBar = bar_index, entryRef = eRef, stop = stp, stopInit = stp, riskRef = risk, tp1 = t1, tp2 = t2, tp1Src = str.tostring(amdTp1R) + "R", tp2Src = str.tostring(amdTp2R) + "R", cfTxt = cfTd, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                f_tradeDraw(w_TD, "AMD ")
                f_log(f_desc(w_TD), "SIGNAL", "AMD qualifies · confluence " + cfTd)
                dTrades.push(w_TD)
                if dTrades.size() > keepTrades
                    f_tradeDelete(dTrades.shift())
                f_evLabel(evLabels, bar_index, d == 1 ? low : high, (d == 1 ? "AMD · BUY\n" : "AMD · SELL\n") + f_p(eRef), d == 1 ? cBull : cBear, color.white, d == 1 ? label.style_label_up : label.style_label_down, size.small, "AMD: accumulation " + f_p(w_AD.lo) + "–" + f_p(w_AD.hi) + " · manipulation extreme " + f_p(w_AD.mExt) + " · distribution close " + f_p(eRef) + " · fill = next bar open (simulated) · confluence " + cfTd, d == 1 ? yloc.belowbar : yloc.abovebar)
                f_amdEnd(w_AD, 7, "Distribution confirmed → " + (d == 1 ? "LONG" : "SHORT") + ".", evLabels)
                if d == 1
                    e.evDBuy := true
                else
                    e.evDSell := true
                if alSig
                    f_alert(d == 1 ? "AMD_BUY_CONFIRMED" : "AMD_SELL_CONFIRMED", d, lvl, eRef, stp, t1, t2, "fill assumed at next bar open")
        else if bar_index - w_AD.confBar > amdDistExp
            f_amdEnd(w_AD, 10, "No distribution within " + str.tostring(amdDistExp) + " bars of the manipulation.", evLabels)
            e.evDExp := true
    // ── D4. Accumulation detection (never overlaps the previous AMD range)
    if w_AD.state == 0 or w_AD.state >= 7
        int wStart = bar_index - amdLen + 1
        bool fresh = (na(w_amdLastEnd) or wStart > w_amdLastEnd) and (w_AD.state < 7 or wStart > w_AD.endBar)
        bool okRoll = not asiaMode and fresh and not na(atrSlow) and amdHiN - amdLoN <= amdRangeATR * atrSlow and atrE <= amdCompress * atrSlow
        // Asia mode: lock the COMPLETED Asia range on the first bar after Asia ends
        bool okAsia = asiaMode and asEnd and not na(asDH) and not na(h1ATR) and asDH - asDL <= amdAsiaH1 * h1ATR and asDH > asDL
        if asiaMode and asEnd and not na(asDH) and not okAsia and not na(h1ATR)
            f_log("AMD · Asia " + f_p(asDL) + " – " + f_p(asDH), "SKIPPED", "Asia range " + f_r((asDH - asDL) / h1ATR) + " × 1H ATR is wider than " + f_r(amdAsiaH1) + " — not a consolidation.")
        if okRoll or okAsia
            w_AD := okAsia ? AMD.new(state = 1, hi = asDH, lo = asDL, t0 = asDT, lockBar = bar_index) : AMD.new(state = 1, hi = amdHiN, lo = amdLoN, t0 = time[amdLen - 1], lockBar = bar_index)
            w_amdLastEnd := bar_index
            if amdShowBox
                w_AD.bx := box.new(w_AD.t0, w_AD.hi, time, w_AD.lo, xloc = xloc.bar_time, border_color = color.new(amdCol, 30), border_width = 1, bgcolor = color.new(amdCol, 96), text = asiaMode ? "ASIA ACCUMULATION" : "ACCUMULATION", text_size = size.tiny, text_color = color.new(amdCol, 30), text_halign = text.align_left, text_valign = text.align_top)
                amdBoxes.push(w_AD.bx)
                if amdBoxes.size() > 3
                    box.delete(amdBoxes.shift())
            e.evDLock := true
            if alMgmt
                f_alert("AMD_ACCUMULATION_LOCKED", 0, na, na, na, na, na, "range " + f_p(w_AD.lo) + " – " + f_p(w_AD.hi))
    if w_AD.state >= 1 and w_AD.state <= 3 and not na(w_AD.bx)
        box.set_right(w_AD.bx, time)
    if w_AD.state >= 7 and not na(w_AD.endBar)
        w_amdLastEnd := math.max(nz(w_amdLastEnd), w_AD.endBar)
    [w_AD, w_TD, w_amdLastEnd]

if barstate.isconfirmed and amdOn and tfOK
    [r_AD, r_TD, r_amdLastEnd] = f_engAMD(E, AD, TD, amdLastEnd)
    AD := r_AD
    TD := r_TD
    amdLastEnd := r_amdLastEnd

// ═══════════════════════════════════════════════════════════════════════════════
//  MODEL FVG — first retest of a strong, structure-breaking fair value gap (optional)
//  Gap known at the close of its 3rd candle → first tap on a later bar → rejection close
//  (beyond the gap midpoint, in the gap's direction) within N bars → signal at that close,
//  simulated fill at the next bar open. One candidate per gap. Inverted / filled gaps never qualify.
// ═══════════════════════════════════════════════════════════════════════════════

f_engFVG(EV e, Setup p_TF) =>
    Setup w_TF = p_TF
    if w_TF.state == 5 and bar_index > w_TF.sigBar
        f_fill(w_TF, evLabels, "FVG")
        e.evFFill := true
    if w_TF.state == 6
        [oF, t1F, stF] = f_manage(w_TF, evLabels, "FVG")
        e.evFTP1 := t1F
        e.evFStop := stF
        e.evFTP2 := oF == "TP2 HIT"
        e.evFEarly := oF == "EARLY EXIT"
        if oF != ""
            e.evFDone := true
    int fbi = -1
    if fvgs.size() > 0
        for [i, g] in fvgs
            if not g.used and not g.inv and g.state == 1 and not na(g.tapBar) and (not fmStrong or g.strong) and (not fmBos or g.bos)
                if g.tapBar - g.bar > fmMaxWait or bar_index - g.tapBar >= fmTrigWin
                    g.used := true
                else
                    float ce = (g.top + g.bot) / 2
                    bool rejC = g.dir == 1 ? (close > ce and close > open) : (close < ce and close < open)
                    if rejC and (fbi < 0 or g.bar > fvgs.get(fbi).bar)
                        fbi := i
    if fbi >= 0
        FVG gq = fvgs.get(fbi)
        gq.used := true
        int dF = gq.dir
        float eRef = close
        float stp = dF == 1 ? gq.bot - fmStopTk * syminfo.mintick : gq.top + fmStopTk * syminfo.mintick
        float risk = dF * (eRef - stp)
        float capF = math.min(fmMaxRisk * atrE, maxStopPts > 0 ? maxStopPts : 1e12)
        float t1 = eRef + dF * fmTp1R * risk
        float t2 = eRef + dF * fmTp2R * risk
        [effF, cnfF, btF] = f_cBias()
        string why = ""
        if fmBias != "Off" and cBiasMode != "Off" and ((cBiasMode == "4H + 1H" and cnfF and cConflict == "Block trade") or effF != dF)
            why := "against the directional bias (" + btF + ")"
        else if not entryAllowed
            why := "entries are OFF outside the entry windows"
        else if w_TF.state == 5 or w_TF.state == 6
            why := "an FVG-model trade is already open"
        else if risk <= 0
            why := "price is already beyond the planned stop"
        else if risk > capF
            why := "stop " + f_p(risk) + " pts is wider than the " + f_p(capF) + " pts maximum"
        else if fmTp2R < fmMinRR
            why := "TP2 " + f_r(fmTp2R) + "R is below the minimum R:R"
        string cfTf = ""
        if why == ""
            [cPf, cNf, cTf, cBf, cCf] = f_conf(dF, eRef, t1, "FVG")
            cfTf := cTf
            string crf = f_cfReject(cPf, cNf, cBf, cCf, "FVG")
            if crf != ""
                why := "confluence: " + crf
        string gDesc = (dF == 1 ? "LONG · " : "SHORT · ") + "FVG " + f_p(gq.bot) + "–" + f_p(gq.top)
        if why != ""
            f_log(gDesc, "NOT TRADABLE", "FVG retest confirmed but NOT TRADABLE: " + why + ".")
            e.evFMiss := true
            if alMgmt
                f_alert("FVG_NOT_TRADABLE", dF, dF == 1 ? gq.top : gq.bot, na, na, na, na, why)
        else
            w_TF := Setup.new(state = 5, dir = dF, srcTF = nE, srcKind = "FVG " + f_p(gq.bot) + "–" + f_p(gq.top), level = dF == 1 ? gq.bot : gq.top, sigBar = bar_index, entryRef = eRef, stop = stp, stopInit = stp, riskRef = risk, tp1 = t1, tp2 = t2, tp1Src = str.tostring(fmTp1R) + "R", tp2Src = str.tostring(fmTp2R) + "R", cfTxt = cfTf, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
            f_tradeDraw(w_TF, "FVG ")
            fTrades.push(w_TF)
            if fTrades.size() > keepTrades
                f_tradeDelete(fTrades.shift())
            f_evLabel(evLabels, bar_index, dF == 1 ? low : high, (dF == 1 ? "FVG · BUY\n" : "FVG · SELL\n") + f_p(eRef), dF == 1 ? cBull : cBear, color.white, dF == 1 ? label.style_label_up : label.style_label_down, size.small, "Strong FVG " + f_p(gq.bot) + "–" + f_p(gq.top) + (gq.bos ? " with BOS" : "") + " · first retest + rejection close · fill = next bar open (simulated) · confluence " + cfTf, dF == 1 ? yloc.belowbar : yloc.abovebar)
            f_log(gDesc, "SIGNAL", "FVG qualifies · confluence " + cfTf)
            if dF == 1
                e.evFBuy := true
            else
                e.evFSell := true
            if alSig
                f_alert(dF == 1 ? "FVG_BUY_CONFIRMED" : "FVG_SELL_CONFIRMED", dF, dF == 1 ? gq.top : gq.bot, eRef, stp, t1, t2, "fill assumed at next bar open")
    [w_TF]

if barstate.isconfirmed and fmOn and fvgOn and tfOK
    [r_TF] = f_engFVG(E, TF)
    TF := r_TF

// Event flags as plain series (alerts, strategy, dashboard)
bool evHiSwept = E.evHiSwept
bool evLoSwept = E.evLoSwept
bool evReclaim = E.evReclaim
bool evConfBull = E.evConfBull
bool evConfBear = E.evConfBear
bool evBuy = E.evBuy
bool evSell = E.evSell
bool evFill = E.evFill
bool evTP1 = E.evTP1
bool evTP2 = E.evTP2
bool evStop = E.evStop
bool evEarly = E.evEarly
bool evInval = E.evInval
bool evDone = E.evDone
bool evCLock = E.evCLock
bool evCBuy = E.evCBuy
bool evCSell = E.evCSell
bool evCInval = E.evCInval
bool evCExp = E.evCExp
bool evCMiss = E.evCMiss
bool evCFill = E.evCFill
bool evCTP1 = E.evCTP1
bool evCStop = E.evCStop
bool evCTP2 = E.evCTP2
bool evCEarly = E.evCEarly
bool evCDone = E.evCDone
bool evDLock = E.evDLock
bool evDManip = E.evDManip
bool evDBuy = E.evDBuy
bool evDSell = E.evDSell
bool evDInval = E.evDInval
bool evDExp = E.evDExp
bool evDMiss = E.evDMiss
bool evDFill = E.evDFill
bool evDTP1 = E.evDTP1
bool evDStop = E.evDStop
bool evDTP2 = E.evDTP2
bool evDEarly = E.evDEarly
bool evDDone = E.evDDone
bool evFBuy = E.evFBuy
bool evFSell = E.evFSell
bool evFMiss = E.evFMiss
bool evFFill = E.evFFill
bool evFTP1 = E.evFTP1
bool evFStop = E.evFStop
bool evFTP2 = E.evFTP2
bool evFEarly = E.evFEarly
bool evFDone = E.evFDone

// Keep labels of untouched pools at the right edge
if barstate.islast and pools.size() > 0
    for l in pools
        if l.state == 0 and not na(l.lb)
            label.set_x(l.lb, time + labOff)

// ═══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
string dashPos = switch dashPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right
var table dash = table.new(dashPos, 2, 22, bgcolor = color.new(#0B0F17, 6), frame_color = color.new(C_GOLD, 45), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)

f_row(table t, int rw, string k, string v, color vc) =>
    table.cell(t, 0, rw, k, text_color = C_MUTED, text_halign = text.align_left, text_valign = text.align_top, text_size = dashSz)
    table.cell(t, 1, rw, v, text_color = vc, text_halign = text.align_left, text_size = dashSz)

if barstate.isfirst and showDash and dashStyle != "Compact"
    table.cell(dash, 0, 0, "MEKA CRT PRO  ·  " + nE, text_color = C_GOLD, text_halign = text.align_center, text_size = dashSz, bgcolor = color.new(#141A24, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

f_blkDashFull() =>
    table.clear(dash, 0, 1, 1, 21)
    CRTRange prD = primHigh ? (r4.active ? r4 : r1) : (r1.active ? r1 : r4)
    string dW = S.dir == 1 ? "LONG" : "SHORT"
    color dC = S.dir == 1 ? cBull : cBear
    int row = 1

    // Market
    string mTxt = mkt + " · " + syminfo.type + (syminfo.type == "futures" ? " (" + syminfo.root + ")" : "") + " · tick " + str.tostring(syminfo.mintick)
    f_row(dash, row, "Market", mTxt, color.white)
    row += 1

    // 4H / 1H
    string t4 = f_rangeRow(r4, n4) + (h4Bias == 1 ? "  · bias ↑" : h4Bias == -1 ? "  · bias ↓" : "")
    f_row(dash, row, n4 + " CRT", t4, h4Bias == 1 ? cBull : h4Bias == -1 ? cBear : color.white)
    row += 1
    string t1r = f_rangeRow(r1, n1) + (r1.active and r4.active ? (r1.mid < r4.mid ? "  · in " + n4 + " discount" : "  · in " + n4 + " premium") : "")
    color c1r = r1.active and r1.loLiq.state == 2 ? cBull : r1.active and r1.hiLiq.state == 2 ? cBear : color.white
    f_row(dash, row, n1 + " CRT", t1r, c1r)
    row += 1

    // 15M
    string t15 = ""
    color c15 = color.white
    if S.state == 3
        float lv = S.dir == 1 ? (c15SwHB ? na : c15SwH) : (c15SwLB ? na : c15SwL)
        t15 := "Waiting: " + (na(lv) ? "new swing + break" : (S.dir == 1 ? "close > " : "close < ") + f_p(lv) + " (MSS)") + (confMode == "MSS or Displacement" ? " or displacement" : confMode == "MSS + Displacement" ? " with displacement" : "")
        c15 := C_GOLD
    else if S.state >= 4 and S.state <= 6
        t15 := (S.dir == 1 ? "Bullish confirmed · " : "Bearish confirmed · ") + S.confText
        c15 := dC
    else
        t15 := "Structure " + (c15Trend == 1 ? "bullish" : c15Trend == -1 ? "bearish" : "neutral") + (c15Trend == 1 and not na(c15BullLvl) ? " (last break ↑ " + f_p(c15BullLvl) + ")" : c15Trend == -1 and not na(c15BearLvl) ? " (last break ↓ " + f_p(c15BearLvl) + ")" : "")
        c15 := c15Trend == 1 ? color.new(cBull, 30) : c15Trend == -1 ? color.new(cBear, 30) : color.white
    f_row(dash, row, nC, t15, c15)
    row += 1

    // 5M
    bool useBrk = trigMode == "Break or Retest" or trigMode == "5M structure break"
    bool useRt  = trigMode == "Break or Retest" or trigMode == "Retest of 15M break"
    string trigTxt = ""
    if S.state == 4
        if useBrk
            float sv = S.dir == 1 ? (sw5HB ? na : sw5H) : (sw5LB ? na : sw5L)
            trigTxt := na(sv) ? "new " + nE + " swing + break" : (S.dir == 1 ? "close > " : "close < ") + f_p(sv)
        if useRt
            trigTxt := trigTxt + (trigTxt != "" ? " or " : "") + "retest of " + f_p(S.rtLvl)
        if trigMode == "Momentum candle"
            trigTxt := S.dir == 1 ? "bullish close > prior high" : "bearish close < prior low"
    string t5 = S.state == 4 ? "Waiting: " + trigTxt + (S.reject != "" ? "\nLast trigger rejected: " + S.reject : "") : S.state == 5 ? "Entry confirmed — fill at next open" : S.state == 6 ? "In trade · filled " + f_p(S.entry) : S.state == 3 ? "Waiting for " + nC + " first" : "No active setup"
    f_row(dash, row, nE, t5, S.state == 4 ? C_GOLD : S.state == 5 or S.state == 6 ? dC : color.white)
    row += 1

    // Liquidity
    float nb = na
    float ns = na
    for l in pools
        if l.state == 0 and not l.retired
            if l.side == 1 and l.price > close and (na(nb) or l.price < nb)
                nb := l.price
            if l.side == -1 and l.price < close and (na(ns) or l.price > ns)
                ns := l.price
    f_row(dash, row, "Liquidity", lastLiq + "\nNext BSL " + f_p(nb) + " · SSL " + f_p(ns), color.white)
    row += 1

    // Session
    string sNow = (inAsia ? "Asia " : "") + (inLon ? "London " : "") + (inNy ? "New York " : "")
    sNow := sNow == "" ? "Off-session" : sNow
    f_row(dash, row, "Session", sNow + "· " + (entryAllowed ? "entries ON" : "entries OFF (tracking)"), entryAllowed ? cBull : C_MUTED)
    row += 1

    // Status + precise next requirement
    Liq brL = na
    for l in pools
        if l.state == 1 and ((l.isCRT and l.external and (l.hiTF ? src4 : src1)) or (not l.isCRT and usePools and prD.active and (l.side == 1 ? l.price >= prD.mid : l.price <= prD.mid)))
            if na(brL) or (l.isCRT and not brL.isCRT)
                brL := l
    bool recentDone = (S.state == 8 or S.state == 9) and bar_index - S.doneBar <= 6
    string st = "WATCHING RANGE"
    color stc = C_GOLD
    string nx = ""
    if not tfOK
        st := "CHECK TIMEFRAMES"
        stc := cBear
        nx := "Need chart ≤ " + nC + " and " + nC + " < " + n1 + " < " + n4
    else if S.state == 3
        st := "SWEEP CONFIRMED & RECLAIMED · WATCH " + dW
        stc := dC
        nx := "Need " + nC + " " + (S.dir == 1 ? "bullish" : "bearish") + " confirmation (" + t15 + ") · expires in " + str.tostring(math.max(0, confExpiry - (bar_index - S.reclaimBar))) + " bars · invalid " + (S.dir == 1 ? "≤ " : "≥ ") + f_p(S.invalLvl)
    else if S.state == 4
        st := nC + " CONFIRMED · WATCH " + dW
        stc := dC
        nx := "Need " + nE + " " + trigTxt + " · in discount/premium · ≥ " + f_r(minRR) + "R · " + (entryAllowed ? "window OPEN" : "window CLOSED") + " · expires in " + str.tostring(math.max(0, entryExpiry - (bar_index - S.confBar))) + " bars · invalid " + (S.dir == 1 ? "≤ " : "≥ ") + f_p(S.invalLvl)
    else if S.state == 5
        st := S.dir == 1 ? "BUY CONFIRMED" : "SELL CONFIRMED"
        stc := dC
        nx := "Simulated fill at next candle open"
    else if S.state == 6
        st := S.tp1Done ? "TP1 HIT · RUNNER ACTIVE" : "TRADE ACTIVE · " + dW
        stc := dC
        nx := S.tp1Done ? "Managing runner to TP2 " + f_p(S.tp2) : "Managing to TP1 " + f_p(S.tp1) + " / SL " + f_p(S.stop)
    else if recentDone
        st := S.state == 9 ? (S.cat == "STRUCTURAL" ? "SETUP INVALIDATED" : S.cat == "CONFLICT" ? "SETUP CANCELLED · CONFLICT" : S.cat == "MISSED" ? "MISSED ENTRY" : S.cat == "SESSION" ? "EXPIRED · SESSION CLOSED" : S.cat == "REPLACED" ? "SETUP REPLACED" : "SETUP EXPIRED") : S.outcome
        stc := S.state == 9 ? C_GREY : S.resultR > 0 ? cTP : cSL
        nx := S.state == 9 ? S.reason : "Result " + (S.resultR >= 0 ? "+" : "") + f_r(S.resultR) + "R · watching for the next sweep"
    else if not na(brL)
        st := "SWEEP IN PROGRESS"
        stc := C_GOLD
        string rcName = brL.rcTF == 0 ? nE : brL.rcTF == 1 ? nC : brL.rcTF == 2 ? n1 : n4
        string leftTxt = brL.rcTF == 0 ? str.tostring(math.max(0, reclaimBars - (bar_index - brL.breachBar + 1))) + " bars" : str.tostring(math.max(0, (brL.rcTF == 1 ? reclaimWin15 : 1) - brL.tfCnt)) + " " + rcName + " close(s)"
        nx := brL.kind + " " + f_p(brL.price) + " breached (extreme " + f_p(brL.ext) + ") · need a completed " + rcName + " close " + (brL.side == 1 ? "< " : "> ") + f_p(brL.price) + " within " + leftTxt + (brL.pend ? " · " + nE + " already back inside (reclaim pending)" : "")
    else if not r4.active and not r1.active
        st := "IDLE · NO VALID RANGE"
        stc := C_MUTED
        nx := "Waiting for a valid " + n1 + " / " + n4 + " reference candle"
    else
        string wl = prD.loLiq.state == 0 ? "L " + f_p(prD.lo) : ""
        string wh = prD.hiLiq.state == 0 ? "H " + f_p(prD.hi) : ""
        nx := "Watch sweep + reclaim of " + prD.tf + " " + wl + (wl != "" and wh != "" ? " / " : "") + wh + (wl == "" and wh == "" ? "range (both sides used — wait for next candle)" : "")
        if lastBlock != ""
            nx := nx + "\n" + lastBlock
    f_row(dash, row, "Status", st, stc)
    table.cell_set_bgcolor(dash, 1, row, color.new(stc, 82))
    row += 1
    f_row(dash, row, "Next", nx, color.new(color.white, 10))
    row += 1
    if S.state >= 3 and S.state <= 6
        f_row(dash, row, "Locked", S.srcKind + " " + f_p(S.level) + " · ext " + f_p(S.ext) + " · " + S.srcTF + " range H " + f_p(S.rHi) + " / 50% " + f_p(S.rMid) + " / L " + f_p(S.rLo) + (not na(S.rT0) and ((S.srcTF == n1 and r1.active and r1.t0 != S.rT0) or (S.srcTF == n4 and r4.active and r4.t0 != S.rT0)) ? "\n(reference candle has rolled — setup keeps its own levels)" : ""), C_MUTED)
        row += 1
    if diagT.size() > 0
        int lk = diagT.size() - 1
        string lc = diagC.get(lk)
        f_row(dash, row, "Last setup", diagT.get(lk) + " · " + diagS.get(lk) + " → " + lc + "\n" + diagR.get(lk), lc == "TRADE" ? cTP : lc == "SKIPPED" ? C_MUTED : C_GREY)
        row += 1

    // ── Model C (independent state machine)
    if cOn
        [cEff, cCnf, cBTxt] = f_cBias()
        float cb = cBufTk * syminfo.mintick
        string cst = CR.state == 0 ? "WAITING FOR REFERENCE · " + cRefMode : CR.state == 1 ? "REFERENCE · 1st candle " + f_fmtT(CR.t1) + " captured, waiting for the 2nd" : CR.state == 2 ? "REFERENCE LOCKED · WATCHING BREAKOUT (" + str.tostring(CR.nSeen) + "/" + str.tostring(cExpiry) + ")\nU " + f_p(CR.up) + " / L " + f_p(CR.lo) + " · " + CR.src + "\nShort: " + (CR.bearDQ ? "✕ " + CR.bearWhy : "needs 15M close < " + f_p(CR.lo - cb)) + "\nLong: " + (CR.bullDQ ? "✕ " + CR.bullWhy : "needs 15M close > " + f_p(CR.up + cb)) : CR.state == 7 ? (TC.dir == 1 ? "CONFIRMED LONG" : "CONFIRMED SHORT") + " · " + CR.endWhy : (CR.state == 9 ? "INVALIDATED — " : CR.state == 10 ? "EXPIRED — " : "MISSED ENTRY — ") + CR.endWhy
        color cstc = CR.state == 2 ? cCol : CR.state == 7 ? (TC.dir == 1 ? cBull : cBear) : CR.state >= 9 ? C_GREY : C_MUTED
        f_row(dash, row, "Model C", cst, cstc)
        row += 1
        f_row(dash, row, "C bias", cBTxt, cCnf and cBiasMode == "4H + 1H" ? C_GOLD : C_MUTED)
        row += 1
        if TC.state == 5 or TC.state == 6
            float cRisk = math.abs((TC.state == 5 ? TC.entryRef : TC.entry) - TC.stopInit)
            float perU = cRisk * syminfo.pointvalue
            float qty = perU > 0 ? (syminfo.type == "futures" ? math.floor(cRiskCash / perU) : math.floor(cRiskCash / perU * 100) / 100) : na
            f_row(dash, row, "C trade", (TC.dir == 1 ? "LONG" : "SHORT") + " · E " + (TC.state == 5 ? "next open (signal " + f_p(TC.entryRef) + ")" : f_p(TC.entry)) + " · SL " + f_p(TC.stop) + "\nTP1 " + f_p(TC.tp1) + (TC.tp1Done ? " ✓" : "") + " · TP2 " + f_p(TC.tp2) + " (" + TC.tp2Src + ") · " + f_r(math.abs(TC.tp2 - TC.entryRef) / TC.riskRef) + "R\nSize " + str.tostring(qty) + (syminfo.type == "futures" ? " contracts" : " units") + " for " + str.tostring(cRiskCash) + " " + syminfo.currency + " risk (" + f_p(cRisk) + " pts × " + str.tostring(syminfo.pointvalue) + "/pt)", TC.dir == 1 ? cBull : cBear)
            row += 1

    // Trade levels (actual calculated values only)
    if S.state == 5 or S.state == 6 or (recentDone and S.state == 8)
        f_row(dash, row, "A entry", S.state == 5 ? "next open (signal " + f_p(S.entryRef) + ")" : f_p(S.entry), cEntry)
        row += 1
        f_row(dash, row, "SL", f_p(S.stop) + (S.beOn ? " (breakeven)" : ""), cSL)
        row += 1
        f_row(dash, row, "TP1", f_p(S.tp1) + " · " + S.tp1Src + (S.tp1Done ? " ✓" : ""), cTP)
        row += 1
        f_row(dash, row, "TP2", f_p(S.tp2) + " · " + S.tp2Src + " · " + f_r(math.abs(S.tp2 - S.entryRef) / S.riskRef) + "R", cTP)
        row += 1
        float riskPts = math.abs((S.state == 5 ? S.entryRef : S.entry) - S.stopInit)
        f_row(dash, row, "Risk", f_p(riskPts) + " pts ≈ " + str.tostring(riskPts * syminfo.pointvalue, "#,##0.00") + " " + syminfo.currency + " per 1 " + (syminfo.type == "futures" ? "contract" : "unit"), color.white)
        row += 1
    if showSim
        f_row(dash, row, "Sim tally", str.tostring(simN) + " trades · " + str.tostring(simW) + "W / " + str.tostring(simN - simW) + "L · " + (simR >= 0 ? "+" : "") + f_r(simR) + "R", C_MUTED)
        row += 1
    true

if barstate.islast and showDash and dashStyle != "Compact"
    f_blkDashFull()

// ═══════════════════════════════════════════════════════════════════════════════
//  COMPACT DASHBOARD — what to do now. All engines keep running underneath.
//  BUY / SELL is shown ONLY for an actionable trade (signal issued inside the entry
//  windows). A setup that was detected but not actionable is shown as such.
// ═══════════════════════════════════════════════════════════════════════════════
var table dashC = table.new(dashPos, 2, 9, bgcolor = color.new(#0B0F17, 4), frame_color = color.new(C_GOLD, 55), frame_width = 1, border_color = color.new(#0B0F17, 0), border_width = 2)

f_cRow(table t, int rw, string k, string v, color vc, string tip) =>
    table.cell(t, 0, rw, k, text_color = C_MUTED, text_halign = text.align_left, text_size = dashSz)
    table.cell(t, 1, rw, v, text_color = vc, text_halign = text.align_right, text_size = dashSz, tooltip = tip)

f_blkDashCompact() =>
    table.cell(dashC, 0, 0, "MEKA CRT PRO", text_color = C_GOLD, text_halign = text.align_left, text_size = dashSz)
    table.cell(dashC, 1, 0, syminfo.ticker + " · " + nE, text_color = C_MUTED, text_halign = text.align_right, text_size = dashSz)
    bool aLive = S.state == 5 or S.state == 6
    bool cLive = cOn and (TC.state == 5 or TC.state == 6)
    bool dLive = amdOn and (TD.state == 5 or TD.state == 6)
    bool fLive = fmOn and (TF.state == 5 or TF.state == 6)
    // newest actionable trade wins the panel
    int sA = aLive ? S.sigBar : -1
    int sC = cLive ? TC.sigBar : -1
    int sD = dLive ? TD.sigBar : -1
    int sF = fLive ? TF.sigBar : -1
    int sMax = math.max(math.max(sA, sC), math.max(sD, sF))
    int  pick  = sF == sMax and fLive ? 4 : sD == sMax and dLive ? 3 : sC == sMax and cLive ? 2 : 1
    bool useCt = pick == 2
    bool live  = aLive or cLive or dLive or fLive
    Setup Ts   = pick == 4 ? TF : pick == 3 ? TD : useCt ? TC : S
    string mdl = pick == 4 ? "FVG" : pick == 3 ? "AMD" : useCt ? "C" : "A"
    // 1 · Bias (last completed 4H / 1H close vs EMA)
    string a4 = cBias4 == 1 ? "↑" : cBias4 == -1 ? "↓" : "–"
    string a1 = cBias1 == 1 ? "↑" : cBias1 == -1 ? "↓" : "–"
    bool bConf = cBias4 != cBias1
    string biasTxt = not bConf and cBias4 == 1 ? "BULLISH" : not bConf and cBias4 == -1 ? "BEARISH" : "NEUTRAL"
    f_cRow(dashC, 1, "BIAS", biasTxt, biasTxt == "BULLISH" ? cBull : biasTxt == "BEARISH" ? cBear : C_GOLD, n4 + " " + a4 + " · " + n1 + " " + a1 + " (last completed close vs EMA " + str.tostring(cEmaLen) + ")" + (bConf ? " — they disagree, so NEUTRAL. Model C conflict policy: " + cConflict : ""))
    // 2 · Current setup
    string stp = "No active setup"
    color stpc = C_MUTED
    if live
        stp := (mdl == "FVG" ? "FVG" : mdl == "AMD" ? "AMD" : mdl == "C" ? "RANGE BREAK" : "CRT") + " · " + (Ts.dir == 1 ? "LONG" : "SHORT")
        stpc := color.white
    else if S.state == 3 or S.state == 4
        stp := "CRT · " + (S.dir == 1 ? "LONG" : "SHORT") + " forming"
        stpc := S.dir == 1 ? cBull : cBear
    else if amdOn and AD.state == 3
        stp := "AMD · " + (AD.dir == 1 ? "LONG" : "SHORT") + " forming"
        stpc := AD.dir == 1 ? cBull : cBear
    else if cOn and CR.state == 2
        stp := "RANGE BREAK · watching"
        stpc := cCol
    else if cOn and CR.state == 1
        stp := "RANGE BREAK · forming"
        stpc := cCol
    else if amdOn and (AD.state == 1 or AD.state == 2)
        stp := AD.state == 1 ? "AMD · accumulation" : "AMD · sweep in progress"
        stpc := amdCol
    string stpTip = live ? Ts.srcKind + " " + f_p(Ts.level) + (Ts.cfTxt != "" ? "\nConfluence " + Ts.cfTxt : "") : (S.state == 3 or S.state == 4) ? "Model A · " + S.srcKind + " " + f_p(S.level) + (S.state == 3 ? " · needs " + nC + " confirmation" : " · needs " + nE + " entry") : (amdOn and AD.state == 3) ? "AMD · range " + f_p(AD.lo) + " – " + f_p(AD.hi) + " · manipulation extreme " + f_p(AD.mExt) + " · needs a displacement close beyond " + (amdDistLvl == "Range midpoint" ? "the midpoint" : AD.dir == 1 ? f_p(AD.hi) : f_p(AD.lo)) : (cOn and CR.state == 2) ? "Model C · " + CR.src + " pair · lower " + f_p(CR.lo) + " / upper " + f_p(CR.up) : (amdOn and AD.state >= 1 and AD.state <= 2) ? "AMD · range " + f_p(AD.lo) + " – " + f_p(AD.hi) + (AD.state == 1 ? (AD.preOut > 0 ? " · " + str.tostring(AD.preOut) + " 15M close(s) outside — " + str.tostring(amdAccept) + " = accepted breakout" : AD.preSwept ? " · swept before London, reclaimed (range kept)" : " · intact") : "") : ""
    f_cRow(dashC, 2, "SETUP", stp == "No active setup" ? "—" : stp, stpc, stpTip)
    // 3 · Signal: BUY / SELL only when actionable
    string sig = "WAIT"
    color sigc = C_MUTED
    string sigTip = ""
    bool dRecentNA = amdOn and AD.state == 11 and bar_index - AD.endBar <= 3
    bool cRecentNA = (cOn and CR.state == 11 and time - CR.endT <= 2 * c15Ms) or dRecentNA
    bool doneRecent = (S.state == 8 and bar_index - S.doneBar <= 6) or (TC.state == 8 and bar_index - TC.doneBar <= 6) or (TD.state == 8 and bar_index - TD.doneBar <= 6) or (TF.state == 8 and bar_index - TF.doneBar <= 6)
    if live
        string dw = Ts.dir == 1 ? "BUY" : "SELL"
        sig := Ts.state == 5 ? dw + " · fill next open" : Ts.tp1Done ? dw + " ACTIVE · TP1 ✓" : dw + " ACTIVE"
        sigc := Ts.dir == 1 ? cBull : cBear
    else if cRecentNA
        sig := "WAIT · not tradable"
        sigc := C_GOLD
        sigTip := dRecentNA ? AD.why : CR.endWhy
    else if doneRecent
        int dbA = S.state == 8 ? S.doneBar : -1
        int dbC = TC.state == 8 ? TC.doneBar : -1
        int dbD = TD.state == 8 ? TD.doneBar : -1
        int dbF = TF.state == 8 ? TF.doneBar : -1
        Setup Td = dbF >= dbD and dbF >= dbC and dbF >= dbA ? TF : dbD >= dbC and dbD >= dbA ? TD : dbC >= dbA ? TC : S
        sig := Td.outcome + " " + (Td.resultR >= 0 ? "+" : "") + f_r(Td.resultR) + "R"
        sigc := Td.resultR > 0 ? cTP : cSL
    else if (S.state == 3 or S.state == 4) and not entryAllowed
        sig := "WAIT · entries off"
    else if S.state == 4
        sig := "WAIT · " + nE + " trigger"
        sigTip := S.reject != "" ? "Last trigger rejected: " + S.reject : ""
    f_cRow(dashC, 3, "SIGNAL", sig, sigc, sigTip)
    // 4–7 · Levels (actual values of the actionable trade only)
    float ent = live ? (Ts.state == 6 ? Ts.entry : Ts.entryRef) : na
    float rk  = live ? math.abs(ent - Ts.stop) : na
    f_cRow(dashC, 4, "ENTRY", live ? f_p(ent) + (Ts.state == 5 ? " (signal)" : "") : "—", live ? cEntry : C_MUTED, "")
    f_cRow(dashC, 5, "SL", live ? f_p(Ts.stop) + "  (" + f_p(rk) + " pts)" : "—", live ? cSL : C_MUTED, live ? "Initial risk " + f_p(Ts.riskRef) + " pts" : "")
    f_cRow(dashC, 6, "TP1", live ? f_p(Ts.tp1) + (Ts.tp1Done ? " ✓" : "") : "—", live ? cTP : C_MUTED, live ? Ts.tp1Src : "")
    f_cRow(dashC, 7, "TP2", live ? f_p(Ts.tp2) + "  (" + f_r(math.abs(Ts.tp2 - Ts.entryRef) / Ts.riskRef) + "R)" : "—", live ? cTP : C_MUTED, live ? Ts.tp2Src : "")
    // 8 · Session
    string sn = inNy ? "New York" : inLon ? "London" : inAsia ? "Asia" : "Off-session"
    f_cRow(dashC, 8, "SESSION", sn + " · " + (entryAllowed ? "entries ON" : live ? "entries OFF · managing trade" : "entries OFF"), entryAllowed ? cBull : C_MUTED, "New entries are allowed only inside the entry windows (input group ⑨). Ranges, liquidity and setups keep updating outside them.")
    true

if barstate.islast and showDash and dashStyle == "Compact"
    f_blkDashCompact()

// ═══════════════════════════════════════════════════════════════════════════════
//  DIAGNOSTIC LOG — last 20 setup outcomes (tiny, bottom of chart, optional)
// ═══════════════════════════════════════════════════════════════════════════════
string diagPos = diagPosIn == "Bottom right" ? position.bottom_right : diagPosIn == "Bottom center" ? position.bottom_center : position.bottom_left
var table diag = table.new(diagPos, 4, 22, bgcolor = color.new(#0B0F17, 15), frame_color = color.new(C_GREY, 60), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)
f_blkDiag() =>
    table.clear(diag, 0, 0, 3, 21)
    table.cell(diag, 0, 0, "MEKA DIAGNOSTICS", text_color = C_GOLD, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 1, 0, "last " + str.tostring(diagT.size()) + " setups · newest first", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 2, 0, "OUTCOME", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 3, 0, "REASON", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    int nD = diagT.size()
    if nD > 0
        for k = 0 to nD - 1
            int src = nD - 1 - k
            string cg = diagC.get(src)
            color cc = cg == "TRADE" or cg == "SIGNAL" ? cTP : cg == "STRUCTURAL" or cg == "CONFLICT" ? cSL : cg == "SKIPPED" ? C_MUTED : C_GOLD
            table.cell(diag, 0, k + 1, diagT.get(src), text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 1, k + 1, diagS.get(src), text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 2, k + 1, cg, text_color = cc, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 3, k + 1, diagR.get(src), text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
    true

if barstate.islast and showDiag
    f_blkDiag()

// ═══════════════════════════════════════════════════════════════════════════════
//  DATA WINDOW
// ═══════════════════════════════════════════════════════════════════════════════
bool liveTrade = S.state == 5 or S.state == 6
plot(liveTrade ? (S.state == 6 ? S.entry : S.entryRef) : na, "Entry", color = cEntry, display = display.data_window)
plot(liveTrade ? S.stop : na, "Stop", color = cSL, display = display.data_window)
plot(liveTrade ? S.tp1 : na, "TP1", color = cTP, display = display.data_window)
plot(liveTrade ? S.tp2 : na, "TP2", color = cTP, display = display.data_window)
plot(r1.active ? r1.mid : na, "Setup-TF CRT 50%", color = cMid, display = display.data_window)
plot(r4.active ? r4.mid : na, "Higher-TF CRT 50%", color = cMid, display = display.data_window)
bool liveC = TC.state == 5 or TC.state == 6
plot(liveC ? (TC.state == 6 ? TC.entry : TC.entryRef) : na, "C Entry", color = cCol, display = display.data_window)
plot(liveC ? TC.stop : na, "C Stop", color = cSL, display = display.data_window)
plot(liveC ? TC.tp1 : na, "C TP1", color = cTP, display = display.data_window)
plot(liveC ? TC.tp2 : na, "C TP2", color = cTP, display = display.data_window)
plot(CR.state == 2 ? CR.up : na, "C Upper", color = cCol, display = display.data_window)
bool liveD = TD.state == 5 or TD.state == 6
plot(liveD ? (TD.state == 6 ? TD.entry : TD.entryRef) : na, "AMD Entry", color = amdCol, display = display.data_window)
plot(liveD ? TD.stop : na, "AMD Stop", color = cSL, display = display.data_window)
plot(AD.state >= 1 and AD.state <= 3 ? AD.hi : na, "AMD Range High", color = amdCol, display = display.data_window)
plot(AD.state >= 1 and AD.state <= 3 ? AD.lo : na, "AMD Range Low", color = amdCol, display = display.data_window)
plot(CR.state == 2 ? CR.lo : na, "C Lower", color = cCol, display = display.data_window)

// (alertcondition() block removed in the strategy build — alert() calls still work)

// ═══════════════════════════════════════════════════════════════════════════════
//  STRATEGY EXECUTION LAYER — driven 1:1 by the indicator engine's events above.
//  One model is traded per run, so Model A and Model C are tested independently.
//  Entry: market order on the signal bar close → filled by TradingView at the
//  NEXT bar's open (same assumption as the indicator's simulated fill).
//  Exits: native stop / limit orders at the engine's SL / TP1 / TP2.
// ═══════════════════════════════════════════════════════════════════════════════
string G_ST = "⑬ Strategy (backtest only)"
string stModel  = input.string("Model A — CRT sweep / reclaim", "Model traded by this strategy", options = ["Model A — CRT sweep / reclaim", "Model C — 15M double-range", "Model AMD — Power of Three", "Model FVG — FVG retest"], group = G_ST)
string sizeMode = input.string("Fixed quantity", "Position sizing", options = ["Fixed quantity", "Risk % of equity", "Risk cash per trade"], group = G_ST)
float  fixedQty = input.float(2, "Fixed quantity (contracts / units)", minval = 0.000001, group = G_ST, tooltip = "Use ≥ 2 whole contracts on futures so the TP1 partial is possible.")
float  riskPct  = input.float(0.5, "Risk % of equity per trade", minval = 0.01, maxval = 10, step = 0.05, group = G_ST)
float  riskCash = input.float(500, "Risk cash per trade", minval = 1, group = G_ST, tooltip = "Quantity = risk cash ÷ (stop distance in points × syminfo.pointvalue), rounded DOWN to the quantity step. Never inferred from P&L.")
float  qtyStep  = input.float(1, "Quantity step (1 = whole contracts)", minval = 0.000001, group = G_ST, tooltip = "Futures: 1. Spot / CFD gold: broker lot step in units (e.g. 1 oz). FX: 1000 units, etc.")
float  maxQty   = input.float(50, "Maximum quantity", minval = 0.000001, group = G_ST)
int    fromDate = input.time(timestamp("2022-01-01T00:00:00"), "Trade from", group = G_ST)
int    toDate   = input.time(timestamp("2099-12-31T00:00:00"), "Trade until", group = G_ST, tooltip = "Use this to hold back an UNTOUCHED out-of-sample period while tuning.")
bool   showStats = input.bool(true, "Show results table (by direction / session)", group = G_ST)

f_floorStep(float q, float st) => math.floor(q / st + 1e-9) * st

bool useC   = stModel == "Model C — 15M double-range"
bool useD   = stModel == "Model AMD — Power of Three"
bool useF   = stModel == "Model FVG — FVG retest"
Setup T     = useF ? TF : useD ? TD : useC ? TC : S
bool sigL   = useF ? evFBuy : useD ? evDBuy : useC ? evCBuy : evBuy
bool sigS   = useF ? evFSell : useD ? evDSell : useC ? evCSell : evSell
bool mTP1   = useF ? evFTP1 : useD ? evDTP1 : useC ? evCTP1 : evTP1
bool mEarly = useF ? evFEarly : useD ? evDEarly : useC ? evCEarly : evEarly
bool mDone  = useF ? evFDone : useD ? evDDone : useC ? evCDone : evDone
string mTag = useF ? "FVG" : useD ? "AMD" : useC ? "C" : "A"
bool inDates = time >= fromDate and time <= toDate

var array<float> stRisk = array.new<float>()   // planned risk (account currency) per position, in entry order

if barstate.isconfirmed
    // New signal → entry + bracket
    if (sigL or sigS) and inDates and strategy.position_size == 0
        float riskPts = math.abs(T.entryRef - T.stop)
        float perUnit = riskPts * syminfo.pointvalue
        float rawQty  = sizeMode == "Fixed quantity" ? fixedQty : sizeMode == "Risk % of equity" ? (strategy.equity * riskPct / 100) / perUnit : riskCash / perUnit
        float q  = math.min(f_floorStep(rawQty, qtyStep), maxQty)
        float q1 = f_floorStep(q * tp1Pct / 100, qtyStep)
        if q > 0
            string eid = mTag + (sigL ? " L" : " S")
            strategy.entry(eid, sigL ? strategy.long : strategy.short, qty = q, comment = mTag + (sigL ? " BUY" : " SELL"))
            stRisk.push(perUnit * q)
            if q1 > 0 and q1 < q
                strategy.exit(eid + " TP1", eid, qty = q1, stop = T.stop, limit = T.tp1, comment_profit = "TP1", comment_loss = "SL")
                strategy.exit(eid + " TP2", eid, qty = q - q1, stop = T.stop, limit = T.tp2, comment_profit = "TP2", comment_loss = "SL")
            else if q1 >= q
                strategy.exit(eid + " TP1", eid, stop = T.stop, limit = T.tp1, comment_profit = "TP1", comment_loss = "SL")
            else
                strategy.exit(eid + " TP2", eid, stop = T.stop, limit = T.tp2, comment_profit = "TP2", comment_loss = "SL")

    // Breakeven after TP1 (only if enabled in the engine inputs)
    if mTP1 and useBE and strategy.position_size != 0
        string bid = mTag + (strategy.position_size > 0 ? " L" : " S")
        strategy.exit(bid + " TP2", bid, qty = math.abs(strategy.position_size), stop = strategy.position_avg_price, limit = T.tp2, comment_profit = "TP2", comment_loss = "BE")

    // Time-based early exit at this bar's close
    if mEarly and strategy.position_size != 0
        strategy.close_all(comment = "EARLY EXIT", immediately = true)

    // Keep broker emulator and engine in lock-step (see docs: intrabar ordering)
    if mDone and not mEarly and strategy.position_size != 0
        strategy.close_all(comment = "SYNC", immediately = true)

// ───────────────────────────── RESULTS TABLE (measured by TradingView, nothing assumed) ─────────────────────────────
// Partial exits create several closed-trade records per position; they are grouped by entry time.
f_sessIdx(int t) =>
    f_inSessT(t, nySess, nyTZ) ? 4 : f_inSessT(t, lonSess, lonTZ) ? 5 : f_inSessT(t, asiaSess, asiaTZ) ? 6 : 7

var table stT = table.new(position.bottom_right, 9, 10, bgcolor = color.new(#0B0F17, 10), frame_color = color.new(C_GOLD, 50), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)
f_stStats() =>
    // groups: 0 ALL · 1 LONG · 2 SHORT · 3 (unused) · 4 New York · 5 London · 6 Asia · 7 Other
    array<float> gN  = array.new<float>(8, 0.0)
    array<float> gW  = array.new<float>(8, 0.0)
    array<float> gGP = array.new<float>(8, 0.0)
    array<float> gGL = array.new<float>(8, 0.0)
    array<float> gR  = array.new<float>(8, 0.0)
    array<float> gRn = array.new<float>(8, 0.0)
    int nCT = strategy.closedtrades
    int pos = -1
    int lastET = na
    float pnl = 0.0
    int pDir = 0
    int pET = na
    for i = 0 to nCT
        bool flush = i == nCT or (i < nCT and strategy.closedtrades.entry_time(i) != lastET)
        if flush and pos >= 0
            float rr = pos < stRisk.size() ? pnl / stRisk.get(pos) : na
            for g in array.from(0, pDir == 1 ? 1 : 2, f_sessIdx(pET))
                gN.set(g, gN.get(g) + 1)
                gW.set(g, gW.get(g) + (pnl > 0 ? 1 : 0))
                gGP.set(g, gGP.get(g) + math.max(pnl, 0))
                gGL.set(g, gGL.get(g) + math.min(pnl, 0))
                if not na(rr)
                    gR.set(g, gR.get(g) + rr)
                    gRn.set(g, gRn.get(g) + 1)
        if i < nCT
            int et = strategy.closedtrades.entry_time(i)
            if et != lastET
                pos += 1
                lastET := et
                pnl := 0.0
                pET := et
                pDir := strategy.closedtrades.size(i) > 0 ? 1 : -1
            pnl += strategy.closedtrades.profit(i)
    table.clear(stT, 0, 0, 8, 9)
    array<string> hdr = array.from("Model " + mTag + " · " + syminfo.ticker, "Trades", "Win %", "PF", "Net", "Avg win", "Avg loss", "Expect.", "Avg R")
    for [c, h] in hdr
        table.cell(stT, c, 0, h, text_color = C_GOLD, text_size = size.tiny)
    array<string> names = array.from("ALL", "LONG", "SHORT", "", "New York", "London", "Asia", "Other")
    int rw = 1
    for g = 0 to 7
        if g != 3 and gN.get(g) > 0
            float n = gN.get(g)
            float w = gW.get(g)
            float gp = gGP.get(g)
            float gl = gGL.get(g)
            array<string> vals = array.from(names.get(g), str.tostring(n, "#"), str.tostring(100 * w / n, "#.0"), gl < 0 ? str.tostring(gp / -gl, "#.00") : "—", str.tostring(gp + gl, "#,##0"), w > 0 ? str.tostring(gp / w, "#,##0") : "—", n - w > 0 ? str.tostring(gl / (n - w), "#,##0") : "—", str.tostring((gp + gl) / n, "#,##0.0"), gRn.get(g) > 0 ? str.tostring(gR.get(g) / gRn.get(g), "#.00") : "—")
            for [c, v] in vals
                table.cell(stT, c, rw, v, text_color = g == 0 ? color.white : color.new(color.white, 25), text_size = size.tiny)
            rw += 1
    table.cell(stT, 0, rw, "Max DD " + str.tostring(strategy.max_drawdown, "#,##0") + " " + syminfo.currency + " · tick " + str.tostring(syminfo.mintick) + " · " + str.tostring(syminfo.pointvalue) + "/pt · commission & slippage = Properties tab", text_color = C_MUTED, text_size = size.tiny)
    true

if barstate.islastconfirmedhistory and showStats or barstate.islast and showStats
    f_stStats()

