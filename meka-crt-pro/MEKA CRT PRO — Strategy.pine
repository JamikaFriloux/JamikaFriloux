bool   htfFilter   = input.bool(true, "Block setups against the 4H CRT bias", group = G_ENT)

string G_RSK = "⑥ Stops & targets"
float  stopBufATR  = input.float(0.10, "Stop buffer (× chart ATR14)", minval = 0.0, step = 0.05, group = G_RSK)
int    stopBufTk   = input.int(2, "Minimum stop buffer (ticks)", minval = 0, group = G_RSK)
float  minRR       = input.float(2.0, "Minimum reward:risk to TP2", minval = 0.5, step = 0.1, group = G_RSK)
string tp1Mode     = input.string("CRT 50%", "TP1 method", options = ["CRT 50%", "Internal liquidity", "R multiple"], group = G_RSK)
