bool   alMgmt      = input.bool(true, "TP / SL / early exit / invalidation", group = G_ALR)

string G_COL = "⑫ Colours"
color  cHi    = input.color(#FF3B3B, "CRT high", inline = "c1", group = G_COL)
color  cLo    = input.color(#22C55E, "CRT low", inline = "c1", group = G_COL)
color  cMid   = input.color(#FFC83D, "CRT 50%", inline = "c1", group = G_COL)
color  cBull  = input.color(#00C176, "Bull", inline = "c2", group = G_COL)
color  cBear  = input.color(#FF3D57, "Bear", inline = "c2", group = G_COL)
color  cBSL   = input.color(#FF8A65, "BSL", inline = "c3", group = G_COL)
color  cSSL   = input.color(#4DD0E1, "SSL", inline = "c3", group = G_COL)
color  cEntry = input.color(#2F80ED, "Entry", inline = "c4", group = G_COL)
color  cTP    = input.color(#00E676, "Targets", inline = "c4", group = G_COL)
color  cSL    = input.color(#FF5252, "Stop", inline = "c4", group = G_COL)

color C_CLEAR = color.new(color.black, 100)
color C_GOLD  = #E6B422
color C_MUTED = #8B95A5
color C_GREY  = #607D8B

// ───────────────────────────── HELPERS ─────────────────────────────
f_p(float x) => na(x) ? "—" : str.tostring(x, format.mintick)
f_r(float x) => na(x) ? "—" : str.tostring(x, "#.##")

f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec >= 86400 ? str.tostring(sec / 86400) + "D" : sec >= 3600 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "M"

f_market() =>
    string t = str.upper(syminfo.ticker)
    string r = str.upper(syminfo.root)
    if str.contains(t, "XAU") or r == "GC" or r == "MGC" or str.contains(t, "GOLD")
        "GOLD"
    else if r == "NQ" or r == "MNQ" or str.contains(t, "NAS100") or str.contains(t, "US100") or str.contains(t, "NDX") or str.contains(t, "USTEC")
        "NASDAQ"
    else if r == "ES" or r == "MES" or str.contains(t, "SPX") or str.contains(t, "US500") or str.contains(t, "SP500")
        "S&P 500"
    else if str.contains(t, "EURUSD") or r == "6E" or r == "M6E"
        "EUR/USD"
    else if str.contains(t, "USDJPY") or r == "6J"
        "USD/JPY"
    else
        "OTHER"

// ───────────────────────────── DERIVED SETTINGS ─────────────────────────────
string mkt     = marketSel == "Auto-detect" ? f_market() : marketSel
bool   isIdx   = mkt == "NASDAQ" or mkt == "S&P 500"
bool   wAsiaOn = usePresetWin ? mkt == "USD/JPY" : winAsiaIn
bool   wLonOn  = usePresetWin ? not isIdx : winLonIn
bool   wNyOn   = usePresetWin ? true : winNyIn
string wAsiaS  = usePresetWin ? "0900-1130" : winAsiaS
string wLonS   = usePresetWin ? "0800-1100" : winLonS
string wNyS    = usePresetWin ? (isIdx ? "0930-1130" : "0830-1130") : winNyS

bool   isDet     = dispMode == "Detailed"
bool   primHigh  = primaryTF == "Higher TF (4H)"
bool   vis4      = isDet ? show4H : primHigh
bool   vis1      = isDet ? show1H : not primHigh
bool   keepHist  = isDet and showHist
string n4        = f_tfName(tfHigh)
string n1        = f_tfName(tfLow)
string nC        = f_tfName(tfConf)
string nE        = f_tfName(timeframe.period)
bool   tfOK      = timeframe.in_seconds() <= timeframe.in_seconds(tfConf) and timeframe.in_seconds(tfConf) < timeframe.in_seconds(tfLow) and timeframe.in_seconds(tfLow) < timeframe.in_seconds(tfHigh)
bool   src4      = setupSrc != "Setup TF (1H) only"
bool   src1      = setupSrc != "Higher TF (4H) only"
float  minPen    = sweepTicks * syminfo.mintick
float  w1        = tp1Pct / 100.0
// Reclaim timeframe code per level: 0 chart · 1 confirmation TF (15M) · 2 setup TF (1H) · 3 higher TF (4H)
int    rcPool    = reclaimMode == "Chart candle close (v1 behaviour)" ? 0 : 1
int    rcCRT1    = reclaimMode == "Reference-TF candle close (classic CRT)" ? 2 : rcPool
int    rcCRT4    = reclaimMode == "Reference-TF candle close (classic CRT)" ? 3 : rcPool
int    extK      = math.max(extLook, 1)
int    labOff    = 3 * timeframe.in_seconds() * 1000
int    dayMs     = 86400000
int    keepResolved = 144
string dashSz    = dashSizeIn == "Tiny" ? size.tiny : dashSizeIn == "Normal" ? size.normal : size.small

// ───────────────────────────── TYPES ─────────────────────────────
// A tracked liquidity level (CRT boundaries are liquidity levels too).
type Liq
    float  price
    int    side              // +1 buy-side (above price) · -1 sell-side (below price)
    string kind
    string tf = ""
    bool   isCRT = false
    bool   hiTF = false      // belongs to the higher (4H) CRT range
    float  rHi               // CRT range this level belongs to (CRT levels only)
    float  rLo
    int    state = 0         // 0 untouched · 1 breached (unconfirmed) · 2 swept (reclaimed) · 3 broken (breakout)
    int    breachBar
    int    breachTime
    float  ext               // sweep extreme
    int    beyond = 0
    int    resolvedBar
    int    created
    int    expires
    bool   retired = false
    bool   aligned = false
    bool   labeled = false
    bool   external = true     // CRT only: boundary lies beyond the previous N reference candles
    int    rcTF = 0            // timeframe whose completed close confirms the reclaim
    int    tfCnt = 0           // completed reclaim-TF candles that closed beyond the level
    bool   pend = false        // chart candle is back inside, waiting for the reclaim-TF close
    float  fav                 // best price toward the 50% since the breach
    int    rT0                 // reference candle open time (CRT levels)
    line   ln
    label  lb
    label  lbSweep

type CRTRange
    string tf
    float  hi
    float  lo
    float  mid
    int    t0
    int    age = 0
    bool   active = false
    bool   lastFail = false
    Liq    hiLiq
    Liq    loLiq
    line   lnHi
    line   lnLo
    line   lnMid
    label  lbHi
    label  lbLo
    label  lbMid
    box    bxP
    box    bxD

// Setup / trade state machine.
// 0 idle · 3 sweep confirmed & reclaimed (awaiting 15M) · 4 15M confirmed · 5 signal (fill pending)
// 6 position · 8 complete · 9 ended without a trade (cat = STRUCTURAL / CONFLICT / MISSED / EXPIRED / SESSION / REPLACED)
// Everything below is LOCKED at the reclaim and never re-read from the live ranges.
type Setup
    int    state = 0
    int    dir = 0
    string srcTF = ""
    string srcKind = ""
    bool   hiTF = false
    float  level
    float  ext
    float  invalLvl            // planned stop = sweep extreme ∓ buffer (locked)
    int    breachTime
    int    breachBar
    int    reclaimBar
    int    reclaimT
    int    rT0
    string cat = ""
    line   plInv
    line   plMid
    label  pbInv
    label  pbMid
    float  rHi
    float  rLo
    float  rMid
    int    confBar
    string confText = ""
    float  rtLvl
    int    sigBar
    float  entryRef
    float  entry
    float  stop
    float  stopInit
    float  riskRef
    float  tp1
    float  tp2
    string tp1Src = ""
    string tp2Src = ""
    bool   tp1Done = false
    bool   beOn = false
    int    fillBar
    int    doneBar
    float  resultR
    string outcome = ""
    string reason = ""
    string reject = ""
    array<line>  lines
    array<label> labels
    array<box>   boxes

// ───────────────────────────── LIQUIDITY HELPERS ─────────────────────────────
f_tag(Liq l) =>
    na(l) ? "" : l.state == 1 ? " · BREACHED" : l.state == 2 ? " · SWEPT ✓" : l.state == 3 ? " · BROKEN" : not l.external ? " · internal" : ""

f_poolName(Liq l) =>
    (l.side == 1 ? "BSL " : "SSL ") + l.kind + " " + f_p(l.price)

f_poolDraw(Liq l, int x0) =>
    color c = l.side == 1 ? cBSL : cSSL
    l.ln := line.new(x0, l.price, time, l.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(c, 35), style = line.style_dotted, width = 1)
    l.lb := label.new(time + labOff, l.price, f_poolName(l), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = color.new(c, 10), size = size.tiny)

f_poolUndraw(Liq l) =>
    if not na(l.ln)
        line.delete(l.ln)
    if not na(l.lb)
        label.delete(l.lb)

f_trimPools(array<Liq> arr, int side) =>
    int cnt = 0
    for l in arr
        if not l.isCRT and l.state == 0 and l.side == side
            cnt += 1
    while cnt > poolMax
        int oi = -1
        int ot = na
        for [i, l] in arr
            if not l.isCRT and l.state == 0 and l.side == side and (na(ot) or l.created < ot)
                oi := i
                ot := l.created
        if oi >= 0
            Liq o = arr.remove(oi)
            f_poolUndraw(o)
        cnt -= 1

// Add a pool, merging with an untouched pool on the same side within tolerance.
// Two 15M swings within tolerance become EQH / EQL.
f_addPool(array<Liq> arr, float p, int side, string kind, float tol, int expT, int x0, bool isSwing) =>
    bool done = false
    if not na(p) and arr.size() > 0
        for l in arr
            if not l.isCRT and l.state == 0 and l.side == side and math.abs(l.price - p) <= tol
                if isSwing and (str.contains(l.kind, "SWING") or str.startswith(l.kind, "EQ"))
                    l.kind := side == 1 ? "EQH" : "EQL"
                    l.price := side == 1 ? math.max(l.price, p) : math.min(l.price, p)
                else if not str.contains(l.kind, kind)
                    l.kind := l.kind + " + " + kind
                l.expires := math.max(l.expires, expT)
                if not na(l.ln)
                    line.set_y1(l.ln, l.price)
                    line.set_y2(l.ln, l.price)
                    label.set_y(l.lb, l.price)
                    label.set_text(l.lb, f_poolName(l))
                done := true
                break
    if not na(p) and not done
        Liq n = Liq.new(price = p, side = side, kind = kind, created = time, expires = expT, rcTF = rcPool)
        if isDet and showPools
            f_poolDraw(n, na(x0) ? time : x0)
        arr.push(n)
        f_trimPools(arr, side)
    done

// Sweep classifier — runs once per CLOSED chart bar. Returns 0 none · 1 breach · 2 swept & reclaimed · 3 broken.
// nw/cc/tc = "a reclaim-TF candle just completed" / its close / its close time, chosen by the caller
// from completed-candle data only (expr[1] + lookahead_on).
method process(Liq l, float pen, int rcl, int acc, bool nw, float cc, int tc) =>
    int ev = 0
    if l.state == 0
        bool br = l.side == 1 ? high - l.price >= pen - syminfo.mintick * 0.01 : l.price - low >= pen - syminfo.mintick * 0.01
        if br
            l.state := 1
            l.breachBar := bar_index
            l.breachTime := time
            l.ext := l.side == 1 ? high : low
            l.fav := l.side == 1 ? low : high
            l.beyond := 0
            l.tfCnt := 0
            ev := 1
    else if l.state == 1
        l.ext := l.side == 1 ? math.max(l.ext, high) : math.min(l.ext, low)
        l.fav := l.side == 1 ? math.min(l.fav, low) : math.max(l.fav, high)
    if l.state == 1 and l.rcTF != 0
        // Reclaim must be confirmed by a COMPLETED reclaim-TF candle that closed after the breach began
        l.pend := l.side == 1 ? close < l.price : close > l.price
        if nw and not na(tc) and tc > l.breachTime
            bool backTF = l.side == 1 ? cc < l.price : cc > l.price
            if backTF
                l.state := 2
                l.resolvedBar := bar_index
                ev := 2
            else
                l.tfCnt := l.tfCnt + 1
                if l.tfCnt >= (l.rcTF == 1 ? reclaimWin15 : 1)
                    l.state := 3
                    l.resolvedBar := bar_index
                    ev := 3
    else if l.state == 1
        bool backIn = l.side == 1 ? close < l.price : close > l.price
        bool beyondNow = l.side == 1 ? close > l.price : close < l.price
        if backIn
            l.state := 2
            l.resolvedBar := bar_index
            ev := 2
        else
            if beyondNow
                l.beyond := l.beyond + 1
            if l.beyond >= acc or bar_index - l.breachBar + 1 >= rcl
                l.state := 3
                l.resolvedBar := bar_index
                ev := 3
    ev

// Nearest untouched level on `side`, at least `minDist` beyond `from`, not beyond `maxP`.
f_nearestLiq(array<Liq> arr, int side, float fromP, float minDist, float maxP) =>
    float best = na
    string bk = ""
    for l in arr
        if l.state == 0 and not l.retired and l.side == side
            float dist = side * (l.price - fromP)
            bool inCap = na(maxP) or side * (maxP - l.price) >= 0
            if dist >= minDist and inCap and (na(best) or dist < side * (best - fromP))
                best := l.price
                bk := l.kind
    [best, bk]

// ───────────────────────────── CRT RANGE METHODS ─────────────────────────────
method retire(CRTRange r, array<line> hist, bool keep) =>
    if not na(r.hiLiq)
        r.hiLiq.retired := true
    if not na(r.loLiq)
        r.loLiq.retired := true
    if not na(r.lnHi)
        if keep
            line.set_extend(r.lnHi, extend.none)
            line.set_extend(r.lnLo, extend.none)
            line.set_extend(r.lnMid, extend.none)
            line.set_x2(r.lnHi, time)
            line.set_x2(r.lnLo, time)
            line.set_x2(r.lnMid, time)
            line.set_color(r.lnHi, color.new(cHi, 70))
            line.set_color(r.lnLo, color.new(cLo, 70))
            line.set_color(r.lnMid, color.new(cMid, 70))
            line.set_width(r.lnHi, 1)
            line.set_width(r.lnLo, 1)
            line.set_width(r.lnMid, 1)
            hist.push(r.lnHi)
            hist.push(r.lnLo)
            hist.push(r.lnMid)
            while hist.size() > histCount * 3
                line.delete(hist.shift())
        else
            line.delete(r.lnHi)
            line.delete(r.lnLo)
            line.delete(r.lnMid)
    if not na(r.lbHi)
        label.delete(r.lbHi)
        label.delete(r.lbLo)
        label.delete(r.lbMid)
    if not na(r.bxP)
        box.delete(r.bxP)
        box.delete(r.bxD)
    r.lnHi := na
    r.lnLo := na
    r.lnMid := na
    r.lbHi := na
    r.lbLo := na
    r.lbMid := na
    r.bxP := na
    r.bxD := na

method drawNew(CRTRange r, bool primary, bool isHigh) =>
    int w = isHigh ? 2 : 1
    int tr = isHigh ? 0 : 15
    r.lnHi  := line.new(r.t0, r.hi, time, r.hi, xloc = xloc.bar_time, extend = extend.right, color = color.new(cHi, tr), style = line.style_solid, width = w)
    r.lnLo  := line.new(r.t0, r.lo, time, r.lo, xloc = xloc.bar_time, extend = extend.right, color = color.new(cLo, tr), style = line.style_solid, width = w)
    r.lnMid := line.new(r.t0, r.mid, time, r.mid, xloc = xloc.bar_time, extend = extend.right, color = color.new(cMid, tr), style = line.style_dashed, width = w)
    int xl = time + labOff * (isHigh ? 6 : 1)
    r.lbHi  := label.new(xl, r.hi, r.tf + " CRT HIGH " + f_p(r.hi), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cHi, size = size.small)
    r.lbLo  := label.new(xl, r.lo, r.tf + " CRT LOW " + f_p(r.lo), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cLo, size = size.small)
    r.lbMid := label.new(xl, r.mid, r.tf + " CRT 50% " + f_p(r.mid), xloc = xloc.bar_time, style = label.style_label_left, color = C_CLEAR, textcolor = cMid, size = size.small)
    if showPD and primary
        r.bxP := box.new(r.t0, r.hi, time, r.mid, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(cHi, 93))
        r.bxD := box.new(r.t0, r.mid, time, r.lo, border_color = C_CLEAR, xloc = xloc.bar_time, extend = extend.right, bgcolor = color.new(cLo, 93))

// Called on the first chart bar after a reference candle completes.
method roll(CRTRange r, float hi, float lo, int t0, float atrH, array<Liq> arr, array<line> hist, bool vis, bool keep, bool primary, bool isHigh, float priorH, float priorL) =>
    float rng = hi - lo
    bool valid = not na(hi) and not na(lo) and not na(atrH) and rng > 0 and rng >= minRangeATR * atrH and rng <= maxRangeATR * atrH
    if valid
        if r.active
            r.retire(hist, keep)
        r.hi := hi
        r.lo := lo
        r.mid := (hi + lo) / 2
        r.t0 := t0
        r.age := 0
        r.active := true
        r.lastFail := false
        int rc = isHigh ? rcCRT4 : rcCRT1
        Liq lh = Liq.new(price = hi, side = 1, kind = r.tf + " CRT HIGH", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = extLook == 0 or na(priorH) or hi > priorH)
        Liq ll = Liq.new(price = lo, side = -1, kind = r.tf + " CRT LOW", tf = r.tf, isCRT = true, hiTF = isHigh, rHi = hi, rLo = lo, created = time, rcTF = rc, rT0 = t0, external = extLook == 0 or na(priorL) or lo < priorL)
        r.hiLiq := lh
        r.loLiq := ll
        arr.push(lh)
        arr.push(ll)
        if vis
            r.drawNew(primary, isHigh)
    else
        r.lastFail := true
        r.age := r.age + 1
        if r.active and r.age > rangeMaxAge
            r.retire(hist, keep)
            r.active := false
    valid

method refresh(CRTRange r, bool isLast, bool isHigh) =>
    if r.active and not na(r.lnHi)
        line.set_style(r.lnHi, r.hiLiq.state == 2 ? line.style_dotted : r.hiLiq.state == 3 ? line.style_dashed : line.style_solid)
        line.set_style(r.lnLo, r.loLiq.state == 2 ? line.style_dotted : r.loLiq.state == 3 ? line.style_dashed : line.style_solid)
        if isLast
            int xl = time + labOff * (isHigh ? 6 : 1)
            label.set_x(r.lbHi, xl)
            label.set_x(r.lbLo, xl)
            label.set_x(r.lbMid, xl)
            label.set_text(r.lbHi, r.tf + " CRT HIGH " + f_p(r.hi) + f_tag(r.hiLiq))
            label.set_text(r.lbLo, r.tf + " CRT LOW " + f_p(r.lo) + f_tag(r.loLiq))

f_rangeRow(CRTRange r, string name) =>
    string s = ""
    if not r.active
        s := r.lastFail ? "No valid range (last " + name + " candle failed size filter)" : "Waiting for a completed " + name + " candle"
    else
        Liq h = r.hiLiq
        Liq lo = r.loLiq
        bool hiEv = h.state > 0
        bool loEv = lo.state > 0
        if hiEv or loEv
            Liq e = hiEv and loEv ? (h.breachTime >= lo.breachTime ? h : lo) : hiEv ? h : lo
            bool isH = e.side == 1
            s := e.state == 1 ? (isH ? "High breached — awaiting reclaim" : "Low breached — awaiting reclaim") : e.state == 2 ? (isH ? "High swept & reclaimed → bearish" : "Low swept & reclaimed → bullish") : (isH ? "Broke above high (accepted)" : "Broke below low (accepted)")
        else
            s := close >= r.mid ? "Inside range · PREMIUM" : "Inside range · DISCOUNT"
        s := s + "\nH " + f_p(r.hi) + " · 50% " + f_p(r.mid) + " · L " + f_p(r.lo)
    s

// ───────────────────────────── EVENT / TRADE DRAWING ─────────────────────────────
f_evLabel(array<label> q, int x, float y, string txt, color bg, color tc, string st, string sz, string tip, string yl) =>
    label lb = label.new(x, y, txt, xloc = xloc.bar_index, yloc = yl, color = bg, style = st, textcolor = tc, size = sz, tooltip = tip)
    q.push(lb)
    if q.size() > 250
        label.delete(q.shift())
    lb

f_sweepLabel(array<label> q, Liq l, bool star) =>
    bool bsl = l.side == 1
    string head = l.isCRT ? (l.tf + (bsl ? " CRT HIGH SWEPT" : " CRT LOW SWEPT")) : ((bsl ? "BSL SWEPT · " : "SSL SWEPT · ") + l.kind)
    string txt = head + (star ? " ★" : "") + "\n" + f_p(l.price)
    color bg = bsl ? color.new(cBear, 20) : color.new(cBull, 20)
    string tip = "Level " + f_p(l.price) + " | extreme " + f_p(l.ext) + " | breach→reclaim " + str.tostring(bar_index - l.breachBar + 1) + " bar(s)" + (star ? " | ★ aligned with active CRT setup" : "")
    l.lbSweep := f_evLabel(q, bar_index, l.ext, txt, bg, color.white, bsl ? label.style_label_down : label.style_label_up, size.small, tip, yloc.price)
    l.labeled := true

f_alert(string ev, int d, float lvl, float en, float sl, float t1, float t2, string note) =>
    string ds = d == 1 ? "LONG" : d == -1 ? "SHORT" : "NONE"
    string msg = ""
    if alJSON
        msg := "{\"source\":\"MEKA CRT PRO\",\"symbol\":\"" + syminfo.ticker + "\",\"exchange\":\"" + syminfo.prefix + "\",\"timeframe\":\"" + timeframe.period + "\",\"event\":\"" + ev + "\",\"direction\":\"" + ds + "\",\"close\":" + str.tostring(close, format.mintick) + ",\"level\":" + (na(lvl) ? "null" : str.tostring(lvl, format.mintick)) + ",\"entry\":" + (na(en) ? "null" : str.tostring(en, format.mintick)) + ",\"sl\":" + (na(sl) ? "null" : str.tostring(sl, format.mintick)) + ",\"tp1\":" + (na(t1) ? "null" : str.tostring(t1, format.mintick)) + ",\"tp2\":" + (na(t2) ? "null" : str.tostring(t2, format.mintick)) + ",\"note\":\"" + note + "\",\"bar_time\":" + str.tostring(time) + "}"
    else
        msg := "MEKA CRT PRO | " + syminfo.ticker + " " + timeframe.period + " | " + ev + " " + ds + " | close " + f_p(close) + (na(lvl) ? "" : " | level " + f_p(lvl)) + (na(en) ? "" : " | entry " + f_p(en)) + (na(sl) ? "" : " | SL " + f_p(sl)) + (na(t1) ? "" : " | TP1 " + f_p(t1)) + (na(t2) ? "" : " | TP2 " + f_p(t2)) + (note == "" ? "" : " | " + note)
    alert(msg, alert.freq_once_per_bar_close)

f_tradeDraw(Setup s) =>
    int x1 = bar_index
    int x2 = bar_index + 6
    line lE = line.new(x1, s.entryRef, x2, s.entryRef, color = cEntry, width = 2)
    line lS = line.new(x1, s.stop, x2, s.stop, color = cSL, width = 2)
    line lA = line.new(x1, s.tp1, x2, s.tp1, color = cTP, width = 1, style = line.style_dashed)
    line lB = line.new(x1, s.tp2, x2, s.tp2, color = cTP, width = 2)
    s.lines := array.from(lE, lS, lA, lB)
    label bE = label.new(x2, s.entryRef, "ENTRY " + f_p(s.entryRef) + " (signal)", style = label.style_label_left, color = C_CLEAR, textcolor = cEntry, size = size.small)
    label bS = label.new(x2, s.stop, "SL " + f_p(s.stop), style = label.style_label_left, color = C_CLEAR, textcolor = cSL, size = size.small)
    label bA = label.new(x2, s.tp1, "TP1 " + f_p(s.tp1) + " · " + s.tp1Src, style = label.style_label_left, color = C_CLEAR, textcolor = cTP, size = size.small)
    label bB = label.new(x2, s.tp2, "TP2 " + f_p(s.tp2) + " · " + s.tp2Src, style = label.style_label_left, color = C_CLEAR, textcolor = cTP, size = size.small)
    s.labels := array.from(bE, bS, bA, bB)
    box zr = box.new(x1, math.max(s.entryRef, s.stop), x2, math.min(s.entryRef, s.stop), border_color = C_CLEAR, bgcolor = color.new(cSL, 88))
    box zw = box.new(x1, math.max(s.entryRef, s.tp2), x2, math.min(s.entryRef, s.tp2), border_color = C_CLEAR, bgcolor = color.new(cTP, 90))
    s.boxes := array.from(zr, zw)

f_tradeExtend(Setup s, int x2) =>
    if not na(s.lines)
        for ln in s.lines
            line.set_x2(ln, x2)
        for lb in s.labels
            label.set_x(lb, x2)
        for bx in s.boxes
            box.set_right(bx, x2)

f_tradeDelete(Setup s) =>
    if not na(s.lines)
        for ln in s.lines
            line.delete(ln)
        for lb in s.labels
            label.delete(lb)
        for bx in s.boxes
            box.delete(bx)

// Targets. d = +1 long / -1 short. Returns [tp1, tp2, tp1 source, tp2 source]; tp2 = na → no valid target.
f_targets(int d, float entry, float risk, float rHi, float rLo, float rMid, string rTF, array<Liq> arr) =>
    float opp = d == 1 ? rHi : rLo
    float tp2 = na
    string tp2s = ""
    if tp2Mode == "R multiple"
        tp2 := entry + d * tp2R * risk
        tp2s := str.tostring(tp2R) + "R"
    else
        if d * (opp - entry) >= minRR * risk
            tp2 := opp
            tp2s := rTF + (d == 1 ? " CRT HIGH" : " CRT LOW")
        else
            // external liquidity beyond the opposite boundary, capped at one extra range height
            [px, kx] = f_nearestLiq(arr, d, entry, minRR * risk, opp + d * (rHi - rLo))
            if not na(px)
                tp2 := px
                tp2s := kx
    float tp1 = na
    string tp1s = ""
    if not na(tp2)
        if tp1Mode == "R multiple"
            tp1 := entry + d * tp1R * risk
            tp1s := str.tostring(tp1R) + "R"
        else
            if tp1Mode == "CRT 50%" and d * (rMid - entry) >= tp1MinR * risk and d * (tp2 - rMid) > 0
                tp1 := rMid
                tp1s := "CRT 50%"
            if na(tp1)
                [p1x, k1x] = f_nearestLiq(arr, d, entry, tp1MinR * risk, tp2)
                if not na(p1x) and d * (tp2 - p1x) > 0
                    tp1 := p1x
                    tp1s := k1x
            if na(tp1)
                tp1 := entry + d * tp1R * risk
                tp1s := str.tostring(tp1R) + "R"
        if d * (tp2 - tp1) <= 0
            tp1 := entry + (tp2 - entry) * 0.5
            tp1s := "½ way to TP2"
    [tp1, tp2, tp1s, tp2s]

// ── Diagnostic log (last 20 setup outcomes). Arrays, so functions may append to them.
var array<string> diagT = array.new<string>()
var array<string> diagS = array.new<string>()
var array<string> diagC = array.new<string>()
var array<string> diagR = array.new<string>()

f_log(string what, string cat, string why) =>
    diagT.push(str.format_time(time, "MM-dd HH:mm", syminfo.timezone))
    diagS.push(what)
    diagC.push(cat)
    diagR.push(why)
    if diagT.size() > 20
        diagT.shift()
        diagS.shift()
        diagC.shift()
        diagR.shift()

f_desc(Setup s) =>
    (s.dir == 1 ? "LONG · " : "SHORT · ") + s.srcKind + " " + f_p(s.level)

f_pendDel(Setup s) =>
    if not na(s.plInv)
        line.delete(s.plInv)
        line.delete(s.plMid)
        label.delete(s.pbInv)
        label.delete(s.pbMid)
    s.plInv := na
    s.plMid := na
    s.pbInv := na
    s.pbMid := na

// Ends a pending setup WITHOUT a trade. cat: STRUCTURAL · CONFLICT · MISSED · EXPIRED · SESSION · REPLACED
f_invalidate(Setup s, string cat, string why, array<label> q) =>
    s.state := 9
    s.cat := cat
    s.reason := why
    s.doneBar := bar_index
    f_pendDel(s)
    string tag = cat == "STRUCTURAL" ? "✕ INVALIDATED" : cat == "CONFLICT" ? "✕ CONFLICT" : cat == "MISSED" ? "MISSED ENTRY" : cat == "SESSION" ? "SESSION CLOSED" : cat == "REPLACED" ? "REPLACED" : "EXPIRED"
    f_evLabel(q, bar_index, s.dir == 1 ? low : high, tag, color.new(C_GREY, 15), color.white, s.dir == 1 ? label.style_label_up : label.style_label_down, size.tiny, why, s.dir == 1 ? yloc.belowbar : yloc.abovebar)
    f_log(f_desc(s), cat, why)
    if alMgmt
        f_alert("SETUP_" + cat, s.dir, s.level, na, na, na, na, why)

// Session high/low tracker (must be called on every bar).
f_sess(bool inS) =>
    var float sH = na
    var float sL = na
    var int   sT = na
    var float dH = na
    var float dL = na
    var int   dT = na
    bool ended = false
    if inS and not inS[1]
        sH := high
        sL := low
        sT := time
    else if inS
        sH := math.max(sH, high)
        sL := math.min(sL, low)
    if not inS and inS[1] and not na(sH)
        dH := sH
        dL := sL
        dT := sT
        ended := true
    [sH, sL, dH, dL, dT, ended]

// 15M market-structure engine. Runs INSIDE request.security on the confirmation TF.
// Every returned value is shifted [1] → with lookahead_on this yields only the last
// COMPLETED confirmation candle (no future leak, no repaint).
f_struct(int L, int R, float dm) =>
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    float a  = ta.atr(14)
    bool disp = math.abs(close - open) >= dm * a
    var float swH = na
    var float swL = na
    var int   swHT = na
    var int   swLT = na
    var bool  swHB = true
    var bool  swLB = true
    var int   trend = 0
    var int   bullT = na
    var float bullLvl = na
    var int   bullPT = na
    var bool  bullCh = false
    var bool  bullDs = false
    var int   bearT = na
    var float bearLvl = na
    var int   bearPT = na
    var bool  bearCh = false
    var bool  bearDs = false
    var int   bullDT = na
    var int   bearDT = na
    if not na(ph)
        swH := ph
        swHT := time[R]
        swHB := false
    if not na(pl)
        swL := pl
        swLT := time[R]
        swLB := false
    if not swHB and close > swH
        swHB := true
        bullCh := trend <= 0
        bullDs := disp and close > open
        trend := 1
        bullT := time_close
        bullLvl := swH
        bullPT := swHT
    if not swLB and close < swL
        swLB := true
        bearCh := trend >= 0
        bearDs := disp and close < open
        trend := -1
        bearT := time_close
        bearLvl := swL
        bearPT := swLT
    if close > open and disp and close > high[1]
        bullDT := time_close
    if close < open and disp and close < low[1]
        bearDT := time_close
    [bullT[1], bullLvl[1], bullPT[1], bullCh[1], bullDs[1], bullDT[1], bearT[1], bearLvl[1], bearPT[1], bearCh[1], bearDs[1], bearDT[1], trend[1], swH[1], swHB[1], swHT[1], swL[1], swLB[1], swLT[1]]

// ───────────────────────────── MULTI-TIMEFRAME DATA (non-repainting) ─────────────────────────────
// Pattern: expression[1] + lookahead_on = the last fully closed higher-TF candle,
// identical on historical and realtime bars.
// [2] = the candles BEFORE the reference candle (external-boundary rule)
[h4H, h4L, h4T, h4ATR, h4C, h4TC, h4PH, h4PL] = request.security(syminfo.tickerid, tfHigh, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[h1H, h1L, h1T, h1ATR, h1C, h1TC, h1PH, h1PL] = request.security(syminfo.tickerid, tfLow, [high[1], low[1], time[1], ta.atr(14)[1], close[1], time_close[1], ta.highest(high, extK)[2], ta.lowest(low, extK)[2]], lookahead = barmerge.lookahead_on)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[c15BullT, c15BullLvl, c15BullPT, c15BullCh, c15BullDs, c15BullDT, c15BearT, c15BearLvl, c15BearPT, c15BearCh, c15BearDs, c15BearDT, c15Trend, c15SwH, c15SwHB, c15SwHT, c15SwL, c15SwLB, c15SwLT] = request.security(syminfo.tickerid, tfConf, f_struct(pivL15, pivR15, dispMult), lookahead = barmerge.lookahead_on)

[c15C, c15TC] = request.security(syminfo.tickerid, tfConf, [close[1], time_close[1]], lookahead = barmerge.lookahead_on)

bool h4New   = not na(h4T) and (na(h4T[1]) or h4T != h4T[1])
bool c15New  = not na(c15TC) and (na(c15TC[1]) or c15TC != c15TC[1])
bool h1New   = not na(h1T) and (na(h1T[1]) or h1T != h1T[1])
bool pdNew   = not na(pdT) and (na(pdT[1]) or pdT != pdT[1])
bool pwNew   = not na(pwT) and (na(pwT[1]) or pwT != pwT[1])
bool swHNew  = not na(c15SwHT) and (na(c15SwHT[1]) or c15SwHT != c15SwHT[1])
bool swLNew  = not na(c15SwLT) and (na(c15SwLT[1]) or c15SwLT != c15SwLT[1])
bool mBullNew = not na(c15BullT) and (na(c15BullT[1]) or c15BullT != c15BullT[1])
bool mBearNew = not na(c15BearT) and (na(c15BearT[1]) or c15BearT != c15BearT[1])

// ───────────────────────────── CHART-TF SERIES ─────────────────────────────
float atrE = ta.atr(14)
float ph5  = ta.pivothigh(high, pivL5, pivR5)
float pl5  = ta.pivotlow(low, pivL5, pivR5)

bool inAsia = not na(time(timeframe.period, asiaSess, asiaTZ))
bool inLon  = not na(time(timeframe.period, lonSess, lonTZ))
bool inNy   = not na(time(timeframe.period, nySess, nyTZ))
[asH, asL, asDH, asDL, asDT, asEnd] = f_sess(inAsia)
[lnH, lnL, lnDH, lnDL, lnDT, lnEnd] = f_sess(inLon)
[nyH, nyL, nyDH, nyDL, nyDT, nyEnd] = f_sess(inNy)

bool winAsia = wAsiaOn and not na(time(timeframe.period, wAsiaS, asiaTZ))
bool winLon  = wLonOn and not na(time(timeframe.period, wLonS, lonTZ))
bool winNy   = wNyOn and not na(time(timeframe.period, wNyS, nyTZ))
bool entryAllowed = winAsia or winLon or winNy

// ───────────────────────────── STATE ─────────────────────────────
var array<Liq>   pools     = array.new<Liq>()
var array<line>  hist4     = array.new<line>()
var array<line>  hist1     = array.new<line>()
var array<label> evLabels  = array.new<label>()
var array<box>   zoneQ     = array.new<box>()
var array<line>  mssQ      = array.new<line>()
var array<Setup> tradeHist = array.new<Setup>()
var CRTRange r4 = CRTRange.new(tf = n4)
var CRTRange r1 = CRTRange.new(tf = n1)
var Setup S = Setup.new()
var int    h4Bias    = 0
var string lastLiq   = "No sweep yet"
var string lastBlock = ""
var float  sw5H  = na
var float  sw5L  = na
var bool   sw5HB = true
var bool   sw5LB = true
var int    lastBull5Bar = na
var int    lastBear5Bar = na
var int    simN  = 0
var int    simW  = 0
var float  simR  = 0.0

// Per-bar event flags (alertcondition + strategy layer)
bool evHiSwept  = false
bool evLoSwept  = false
bool evReclaim  = false
bool evConfBull = false
bool evConfBear = false
bool evBuy      = false
bool evSell     = false
bool evFill     = false
bool evTP1      = false
bool evTP2      = false
bool evStop     = false
bool evEarly    = false
bool evInval    = false
bool evDone     = false
bool bull5Brk   = false
bool bear5Brk   = false

// ═══════════════════════════════════════════════════════════════════════════════
//  ENGINE — runs once per CLOSED chart bar only (no intrabar signals, no repaint)
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // ── 1. Entry-TF structure (pivot levels exist only after their right bars close)
    if not na(ph5)
        sw5H := ph5
        sw5HB := false
    if not na(pl5)
        sw5L := pl5
        sw5LB := false
    if not sw5HB and close > sw5H
        sw5HB := true
        bull5Brk := true
        lastBull5Bar := bar_index
    if not sw5LB and close < sw5L
        sw5LB := true
        bear5Brk := true
        lastBear5Bar := bar_index

    // ── 2. Roll CRT reference ranges on completion of a 4H / 1H candle
    if h4New
        r4.roll(h4H, h4L, h4T, h4ATR, pools, hist4, vis4, keepHist, primHigh, true, h4PH, h4PL)
    if h1New
        r1.roll(h1H, h1L, h1T, h1ATR, pools, hist1, vis1, keepHist, not primHigh, false, h1PH, h1PL)
    CRTRange pr = primHigh ? (r4.active ? r4 : r1) : (r1.active ? r1 : r4)

    // ── 3. Liquidity pools (built only from information that existed before this bar)
    float tol = eqTolATR * atrE
    int expD = time + poolDays * dayMs
    if trackPD and pdNew
        f_addPool(pools, pdH, 1, "PDH", tol, expD, na, false)
        f_addPool(pools, pdL, -1, "PDL", tol, expD, na, false)
    if trackPW and pwNew
        f_addPool(pools, pwH, 1, "PWH", tol, time + poolDays * 3 * dayMs, na, false)
        f_addPool(pools, pwL, -1, "PWL", tol, time + poolDays * 3 * dayMs, na, false)
    if trackSess
        if asEnd
            f_addPool(pools, asDH, 1, "ASIA H", tol, expD, asDT, false)
            f_addPool(pools, asDL, -1, "ASIA L", tol, expD, asDT, false)
        if lnEnd
            f_addPool(pools, lnDH, 1, "LDN H", tol, expD, lnDT, false)
            f_addPool(pools, lnDL, -1, "LDN L", tol, expD, lnDT, false)
        if nyEnd
            f_addPool(pools, nyDH, 1, "NY H", tol, expD, nyDT, false)
            f_addPool(pools, nyDL, -1, "NY L", tol, expD, nyDT, false)
    if trackSw
        if swHNew and not na(c15SwH)
            f_addPool(pools, c15SwH, 1, nC + " SWING H", tol, expD, c15SwHT, true)
        if swLNew and not na(c15SwL)
            f_addPool(pools, c15SwL, -1, nC + " SWING L", tol, expD, c15SwLT, true)

    // ── 4. Sweep / breakout classification for every tracked level
    Liq best = na
    int bestScore = 0
    float bHi = na
    float bLo = na
    string bTF = ""
    int bT0 = na
    for l in pools
        if l.retired and l.state != 1
            continue
        bool  nwR = l.rcTF == 1 ? c15New : l.rcTF == 2 ? h1New : h4New
        float ccR = l.rcTF == 1 ? c15C : l.rcTF == 2 ? h1C : h4C
        int   tcR = l.rcTF == 1 ? c15TC : l.rcTF == 2 ? h1TC : h4TC
        int ev = l.process(minPen, reclaimBars, acceptBars, nwR, ccR, tcR)
        if ev == 2
            bool qual = false
            int score = 0
            float qHi = na
            float qLo = na
            string qTF = ""
            int qT0 = na
            if l.isCRT
                if (l.hiTF ? src4 : src1) and not l.external
                    lastBlock := l.kind + " sweep ignored: internal boundary (an earlier " + l.tf + " candle already traded beyond it)"
                if (l.hiTF ? src4 : src1) and l.external
                    qual := true
                    score := l.hiTF ? 3 : 2
                    qHi := l.rHi
                    qLo := l.rLo
                    qTF := l.tf
                    qT0 := l.rT0
            else if usePools and pr.active
                l.aligned := l.side == 1 ? l.price >= pr.mid : l.price <= pr.mid
                if l.aligned
                    qual := true
                    score := 1
                    qHi := pr.hi
                    qLo := pr.lo
                    qTF := pr.tf
                    qT0 := pr.t0
            qual := qual and tfOK and math.abs(l.ext - l.price) <= maxSweepATR * atrE
            if l.isCRT or isDet
                f_sweepLabel(evLabels, l, qual and not l.isCRT)
                if isDet
                    zoneQ.push(box.new(l.breachBar, math.max(l.price, l.ext), bar_index, math.min(l.price, l.ext), border_color = color.new(l.side == 1 ? cBear : cBull, 60), bgcolor = color.new(l.side == 1 ? cBear : cBull, 88)))
                    if zoneQ.size() > 40
                        box.delete(zoneQ.shift())
            lastLiq := (l.isCRT ? l.kind + " swept" : (l.side == 1 ? "BSL swept · " : "SSL swept · ") + l.kind) + " " + f_p(l.price)
            evReclaim := true
            if l.isCRT
                if l.side == 1
                    evHiSwept := true
                else
                    evLoSwept := true
            if alSweep
                f_alert(l.isCRT ? (l.side == 1 ? "CRT_HIGH_SWEPT" : "CRT_LOW_SWEPT") : "LIQUIDITY_RECLAIMED", -l.side, l.price, na, na, na, na, l.kind + " reclaimed, extreme " + f_p(l.ext))
            if qual and score > bestScore
                best := l
                bestScore := score
                bHi := qHi
                bLo := qLo
                bTF := qTF
                bT0 := qT0
        else if ev == 3 and isDet
            f_evLabel(evLabels, bar_index, l.price, (l.isCRT ? l.kind + " BROKEN" : (l.side == 1 ? "BSL BREAK · " : "SSL BREAK · ") + l.kind), color.new(C_GREY, 30), color.white, l.side == 1 ? label.style_label_down : label.style_label_up, size.tiny, "Accepted beyond " + f_p(l.price) + " — breakout, not a sweep", yloc.price)
        if (ev == 2 or ev == 3) and not na(l.ln)
            line.set_extend(l.ln, extend.none)
            line.set_x2(l.ln, time)
            line.set_color(l.ln, color.new(C_GREY, 40))
            label.set_x(l.lb, time)
            label.set_textcolor(l.lb, color.new(C_GREY, 20))
            label.set_text(l.lb, l.kind + (ev == 2 ? " ✓ swept" : " ✗ broken"))

    // ── 5. Higher-TF (4H) bias from the active 4H CRT range
    h4Bias := 0
    if r4.active
        bool bu = r4.loLiq.state == 2 or r4.hiLiq.state == 3
        bool bd = r4.hiLiq.state == 2 or r4.loLiq.state == 3
        h4Bias := bu and not bd ? 1 : bd and not bu ? -1 : 0

    // ── 6. Simulated fill (next bar open after the signal)
    if S.state == 5 and bar_index > S.sigBar
        S.entry := open
        S.fillBar := bar_index
        S.state := 6
        evFill := true
        if not na(S.lines)
            line.set_y1(S.lines.get(0), open)
            line.set_y2(S.lines.get(0), open)
            label.set_y(S.labels.get(0), open)
            label.set_text(S.labels.get(0), "ENTRY " + f_p(open) + " (filled)")
            if S.dir == 1
                box.set_top(S.boxes.get(0), open)
                box.set_bottom(S.boxes.get(1), open)
            else
                box.set_bottom(S.boxes.get(0), open)
                box.set_top(S.boxes.get(1), open)
        f_evLabel(evLabels, bar_index, open, "FILL " + f_p(open), color.new(cEntry, 25), color.white, label.style_label_left, size.tiny, "Simulated fill at this bar's open (signal was on the previous closed bar)", yloc.price)
        if alSig
            f_alert("ENTRY_FILLED_SIM", S.dir, na, open, S.stop, S.tp1, S.tp2, "simulated fill at bar open")

    // ── 7. Position management — conservative intrabar order: STOP first
    if S.state == 6
        int dP = S.dir
        string outc = ""
        bool hitStop = dP == 1 ? low <= S.stop : high >= S.stop
        if hitStop
            float xPx = dP == 1 ? math.min(open, S.stop) : math.max(open, S.stop)
            float rLeg = dP * (xPx - S.entry) / S.riskRef
            S.resultR := S.tp1Done ? S.resultR + (1 - w1) * rLeg : rLeg
            outc := S.tp1Done and S.beOn ? "BE STOP" : "STOP HIT"
            evStop := true
        else
            bool hitT1 = not S.tp1Done and (dP == 1 ? high >= S.tp1 : low <= S.tp1)
            if hitT1
                S.tp1Done := true
                S.resultR := w1 * dP * (S.tp1 - S.entry) / S.riskRef
                evTP1 := true
                if not na(S.labels)
                    label.set_text(S.labels.get(2), "TP1 ✓ " + f_p(S.tp1))
                f_evLabel(evLabels, bar_index, S.tp1, "TP1 HIT", color.new(cTP, 20), color.black, dP == 1 ? label.style_label_down : label.style_label_up, size.small, "Partial " + str.tostring(tp1Pct) + "% closed at " + f_p(S.tp1), yloc.price)
                if alMgmt
                    f_alert("TP1_HIT", dP, S.tp1, S.entry, S.stop, S.tp1, S.tp2, "")
                if w1 >= 1.0
                    outc := "TP1 HIT"
            if outc == "" and S.tp1Done and (dP == 1 ? high >= S.tp2 : low <= S.tp2)
                S.resultR := S.resultR + (1 - w1) * dP * (S.tp2 - S.entry) / S.riskRef
                outc := "TP2 HIT"
                evTP2 := true
            if outc == "" and maxBars > 0 and bar_index - S.fillBar + 1 >= maxBars
                float rE = dP * (close - S.entry) / S.riskRef
                S.resultR := S.tp1Done ? S.resultR + (1 - w1) * rE : rE
                outc := "EARLY EXIT"
                evEarly := true
            if hitT1 and useBE and outc == ""
                S.beOn := true
                S.stop := S.entry
                if not na(S.lines)
                    line.set_y1(S.lines.get(1), S.entry)
                    line.set_y2(S.lines.get(1), S.entry)
                    label.set_y(S.labels.get(1), S.entry)
                    label.set_text(S.labels.get(1), "SL → BE " + f_p(S.entry))
        if outc != ""
            S.state := 8
            S.outcome := outc
            S.doneBar := bar_index
            evDone := true
            f_tradeExtend(S, bar_index)
            bool isWin = S.resultR > 0
            float yO = outc == "STOP HIT" or outc == "BE STOP" ? S.stop : outc == "EARLY EXIT" ? close : outc == "TP1 HIT" ? S.tp1 : S.tp2
            bool towardTP = outc == "TP2 HIT" or outc == "TP1 HIT"
            string stO = (dP == 1) == towardTP ? label.style_label_down : label.style_label_up
            f_evLabel(evLabels, bar_index, yO, outc + " " + (S.resultR >= 0 ? "+" : "") + f_r(S.resultR) + "R", color.new(isWin ? cTP : outc == "BE STOP" ? C_GREY : cSL, 15), isWin ? color.black : color.white, stO, size.small, "Simulated result incl. " + str.tostring(tp1Pct) + "% partial at TP1", yloc.price)
            f_log(f_desc(S), "TRADE", outc + " " + (S.resultR >= 0 ? "+" : "") + f_r(S.resultR) + "R (simulated)")
            simN += 1
            simW += isWin ? 1 : 0
            simR += S.resultR
            if alMgmt
                f_alert(outc == "TP2 HIT" ? "TP2_HIT" : outc == "TP1 HIT" ? "TP1_FULL_EXIT" : outc == "EARLY EXIT" ? "EARLY_EXIT" : "STOP_HIT", dP, yO, S.entry, S.stop, S.tp1, S.tp2, "result " + f_r(S.resultR) + "R")
        else
            f_tradeExtend(S, bar_index + 6)

    // ── 8. Pending-setup checks. Each ending has ONE category and a plain-English reason.
    //    A new 4H / 1H candle opening never ends a setup: all levels below are LOCKED in S.
    if S.state == 3 or S.state == 4
        int dA = S.dir
        string cat = ""
        string why = ""
        // STRUCTURAL: price reached the planned stop (sweep extreme ∓ buffer) — the trade would have lost
        bool through = dA == 1 ? (wickInval ? low <= S.invalLvl : close <= S.invalLvl) : (wickInval ? high >= S.invalLvl : close >= S.invalLvl)
        // CONFLICT: the confirmation TF printed a structure break the OTHER way after the reclaim
        int oppT = dA == 1 ? c15BearT : c15BullT
        bool conflict = conflictInval and S.state == 3 and not na(oppT) and oppT > S.reclaimT
        // MISSED: TP1 area reached before an entry existed (no chasing)
        bool ran = dA == 1 ? high >= S.rMid : low <= S.rMid
        if through
            cat := "STRUCTURAL"
            why := "Price " + (wickInval ? "traded" : "closed") + " through the planned stop " + f_p(S.invalLvl) + " (sweep extreme " + f_p(S.ext) + " + buffer) before an entry — the sweep failed."
        else if conflict
            cat := "CONFLICT"
            why := nC + " broke structure " + (dA == 1 ? "DOWN at " + f_p(c15BearLvl) : "UP at " + f_p(c15BullLvl)) + " after the reclaim — opposite confirmation, setup cancelled."
        else if ran
            cat := "MISSED"
            why := "Price reached the CRT 50% " + f_p(S.rMid) + " " + (S.state == 3 ? "before " + nC + " confirmed" : "after " + nC + " but before a valid " + nE + " entry") + " — move missed, not chased."
        else if S.state == 3 and bar_index - S.reclaimBar > confExpiry
            cat := "EXPIRED"
            why := "No " + nC + " confirmation within " + str.tostring(confExpiry) + " bars of the reclaim."
        else if S.state == 4 and bar_index - S.confBar > entryExpiry
            bool sess = str.contains(S.reject, "entry window")
            cat := sess ? "SESSION" : "EXPIRED"
            why := sess ? "Valid " + nE + " triggers appeared only while new entries were OFF (outside the entry windows); expired after " + str.tostring(entryExpiry) + " bars." : "No valid " + nE + " entry within " + str.tostring(entryExpiry) + " bars of " + nC + " confirmation" + (S.reject != "" ? " (last trigger rejected: " + S.reject + ")." : ".")
        if cat != ""
            f_invalidate(S, cat, why, evLabels)
            evInval := true

    // ── 9. New setup from the best qualifying sweep on this bar
    if not na(best)
        int dB = -best.side
        float bMid = (bHi + bLo) / 2
        float bufB = math.max(stopBufTk * syminfo.mintick, stopBufATR * atrE)
        float invB = dB == 1 ? best.ext - bufB : best.ext + bufB
        string block = ""
        bool logIt = true
        if htfFilter and h4Bias == -dB and not best.hiTF
            block := "it is against the " + n4 + " CRT bias"
        else if (dB == 1 ? high >= bMid : low <= bMid) or (dB == 1 ? best.fav >= bMid : best.fav <= bMid)
            block := "price already reached the CRT 50% before the reclaim was confirmed"
        else if S.state == 5 or S.state == 6
            block := "a trade is already active"
            logIt := false
        else if roomCheck
            // Best plausible entry = a retest of the swept level. If even that has no ≥ min-R:R target,
            // the sweep can never become a trade → say so instead of showing SETUP FORMING.
            float rBest = dB * (best.price - invB)
            float t2B = na
            if rBest > 0
                [x1, x2, x1s, x2s] = f_targets(dB, best.price, rBest, bHi, bLo, bMid, bTF, pools)
                t2B := x2
            if na(t2B)
                block := "there is no target ≥ " + f_r(minRR) + "R even from a retest of the level"
        if block == ""
            if (S.state == 3 or S.state == 4) and S.dir != dB
                f_invalidate(S, "REPLACED", "Replaced by an opposite qualifying sweep (" + best.kind + " " + f_p(best.price) + ").", evLabels)
                evInval := true
            if S.state == 0 or S.state == 8 or S.state == 9
                S := Setup.new(state = 3, dir = dB, srcTF = bTF, srcKind = best.kind, hiTF = best.hiTF, level = best.price, ext = best.ext, invalLvl = invB, breachTime = best.breachTime, breachBar = best.breachBar, reclaimBar = bar_index, reclaimT = time, rT0 = bT0, rHi = bHi, rLo = bLo, rMid = bMid, lines = array.new<line>(), labels = array.new<label>(), boxes = array.new<box>())
                lastBlock := ""
                if not best.labeled
                    f_sweepLabel(evLabels, best, true)
                label.set_text(best.lbSweep, label.get_text(best.lbSweep) + "\nRECLAIMED · WATCH " + (dB == 1 ? "LONG ↑" : "SHORT ↓"))
                // Locked levels for the pending setup (independent of later range rolls)
                int xs = bar_index
                S.plInv := line.new(xs, invB, bar_index + 3, invB, color = color.new(cSL, 35), style = line.style_dotted, width = 1)
                S.plMid := line.new(xs, bMid, bar_index + 3, bMid, color = color.new(cMid, 25), style = line.style_dotted, width = 1)
                S.pbInv := label.new(bar_index + 3, invB, "INVALID " + (dB == 1 ? "≤ " : "≥ ") + f_p(invB), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(cSL, 10), size = size.tiny)
                S.pbMid := label.new(bar_index + 3, bMid, "LOCKED " + bTF + " 50% " + f_p(bMid), style = label.style_label_left, color = C_CLEAR, textcolor = color.new(cMid, 10), size = size.tiny)
            else
                block := "a " + (S.dir == 1 ? "long" : "short") + " setup is already pending"
                logIt := false
        if block != ""
            lastBlock := best.kind + " sweep reclaimed but not traded: " + block
            if logIt
                f_log((dB == 1 ? "LONG · " : "SHORT · ") + best.kind + " " + f_p(best.price), "SKIPPED", "Sweep confirmed but not traded: " + block + ".")

    // ── 10. 15M confirmation (only candles that CLOSED after the breach began)
    if S.state == 3
        int dC = S.dir
        int   mT   = dC == 1 ? c15BullT : c15BearT
        bool  mCh  = dC == 1 ? c15BullCh : c15BearCh
        bool  mDs  = dC == 1 ? c15BullDs : c15BearDs
        float mLvl = dC == 1 ? c15BullLvl : c15BearLvl
        int   dT   = dC == 1 ? c15BullDT : c15BearDT
        bool mssOK  = not na(mT) and mT > S.breachTime and (not reqChoch or mCh)
        bool dispOK = not na(dT) and dT > S.breachTime
        bool ok = switch confMode
            "MSS / CHoCH"        => mssOK
            "MSS + Displacement" => mssOK and mDs
            => mssOK or dispOK
        if ok
            S.state := 4
            S.confBar := bar_index
            S.rtLvl := mssOK ? mLvl : S.level
            S.confText := mssOK ? ((mCh ? "CHoCH " : "BOS ") + (dC == 1 ? "↑ " : "↓ ") + f_p(mLvl) + (mDs ? " + displacement" : "")) : ("Displacement " + (dC == 1 ? "↑" : "↓"))
            if dC == 1
                evConfBull := true
            else
                evConfBear := true
            f_evLabel(evLabels, bar_index, dC == 1 ? low : high, nC + " ✓", color.new(dC == 1 ? cBull : cBear, 45), color.white, dC == 1 ? label.style_label_up : label.style_label_down, size.tiny, nC + " confirmed: " + S.confText, dC == 1 ? yloc.belowbar : yloc.abovebar)
            if alConf
                f_alert(dC == 1 ? "CONF_15M_BULLISH" : "CONF_15M_BEARISH", dC, S.rtLvl, na, na, na, na, S.confText)

    // ── 11. 5M entry trigger + risk/target qualification → SIGNAL
    if S.state == 4
        int dD = S.dir
        float tolR = retestTol * atrE
        bool brk = dD == 1 ? bull5Brk : bear5Brk
        bool rt  = dD == 1 ? (low <= S.rtLvl + tolR and close > S.rtLvl and close > open) : (high >= S.rtLvl - tolR and close < S.rtLvl and close < open)
        bool mom = dD == 1 ? (close > open and close > high[1]) : (close < open and close < low[1])
        // Timestamp-paired: on the bar the 15M confirmation becomes known, a 5M break that already
        // happened after the breach (and ≤ pairBars ago) completes the 5M side. Entry = THIS bar's close.
        int l5 = dD == 1 ? lastBull5Bar : lastBear5Bar
        bool paired = pairedConf and S.confBar == bar_index and not na(l5) and l5 >= S.breachBar and bar_index - l5 <= pairBars
        bool trig = switch trigMode
            "5M structure break"  => brk or paired
            "Retest of 15M break" => rt
            "Momentum candle"     => mom
            => brk or rt or paired
        if trig
            float eRef = close
            float stp  = S.invalLvl
            float risk = dD * (eRef - stp)
            string rej = ""
            float t1 = na
            float t2 = na
            string t1s = ""
            string t2s = ""
            if risk <= 0
                rej := "entry beyond stop"
            else if risk > maxRiskATR * atrE
                rej := "too far from stop (" + f_r(risk / atrE) + " ATR > " + f_r(maxRiskATR) + ")"
            else if reqDiscount and (dD == 1 ? eRef >= S.rMid : eRef <= S.rMid)
                rej := dD == 1 ? "entry not in discount" : "entry not in premium"
            else if not entryAllowed
                rej := "outside entry window"
            else if htfFilter and h4Bias == -dD and not S.hiTF
                rej := "against " + n4 + " CRT bias"
            else
                [a1, a2, a1s, a2s] = f_targets(dD, eRef, risk, S.rHi, S.rLo, S.rMid, S.srcTF, pools)
                t1 := a1
                t2 := a2
                t1s := a1s
                t2s := a2s
                if na(t2)
                    rej := "no target with ≥ " + f_r(minRR) + "R"
                else if dD * (t2 - eRef) / risk < minRR
                    rej := "R:R " + f_r(dD * (t2 - eRef) / risk) + " < " + f_r(minRR)
            if rej == ""
                S.state := 5
                S.sigBar := bar_index
                S.entryRef := eRef
                S.stop := stp
                S.stopInit := stp
                S.riskRef := risk
                S.tp1 := t1
                S.tp2 := t2
                S.tp1Src := t1s
                S.tp2Src := t2s
                S.reject := ""
                if dD == 1
                    evBuy := true
                else
                    evSell := true
                string tipS = S.srcKind + " sweep → " + nC + " " + S.confText + " → " + nE + " trigger | R:R to TP2 " + f_r(dD * (t2 - eRef) / risk)
                f_evLabel(evLabels, bar_index, dD == 1 ? low : high, (dD == 1 ? "BUY\n" : "SELL\n") + f_p(eRef), dD == 1 ? cBull : cBear, color.white, dD == 1 ? label.style_label_up : label.style_label_down, size.normal, tipS, dD == 1 ? yloc.belowbar : yloc.abovebar)
                f_pendDel(S)
                f_tradeDraw(S)
                tradeHist.push(S)
                if tradeHist.size() > keepTrades
                    f_tradeDelete(tradeHist.shift())
                if alSig
                    f_alert(dD == 1 ? "BUY_CONFIRMED" : "SELL_CONFIRMED", dD, S.level, eRef, stp, t1, t2, "fill assumed at next bar open")
            else
                S.reject := rej

    // Keep the locked pending levels at the right edge
    if (S.state == 3 or S.state == 4) and not na(S.plInv)
        line.set_x2(S.plInv, bar_index + 3)
        line.set_x2(S.plMid, bar_index + 3)
        label.set_x(S.pbInv, bar_index + 3)
        label.set_x(S.pbMid, bar_index + 3)

    // ── 12. Housekeeping: drop expired / resolved / retired levels
    if pools.size() > 0
        for i = pools.size() - 1 to 0
            Liq l = pools.get(i)
            bool rm = l.isCRT ? (l.retired and l.state != 1) : ((l.state == 0 and time > l.expires) or ((l.state == 2 or l.state == 3) and bar_index - l.resolvedBar > keepResolved))
            if rm
                f_poolUndraw(l)
                pools.remove(i)

    // ── 13. Detailed-mode 15M structure markers
    if isDet and showMSS
        if mBullNew and not na(c15BullPT)
            mssQ.push(line.new(c15BullPT, c15BullLvl, time, c15BullLvl, xloc = xloc.bar_time, color = color.new(cBull, 30), style = line.style_dashed, width = 1))
            f_evLabel(evLabels, bar_index, c15BullLvl, nC + (c15BullCh ? " CHoCH ↑" : " BOS ↑"), C_CLEAR, color.new(cBull, 0), label.style_label_down, size.tiny, "Confirmed on a closed " + nC + " candle", yloc.price)
        if mBearNew and not na(c15BearPT)
            mssQ.push(line.new(c15BearPT, c15BearLvl, time, c15BearLvl, xloc = xloc.bar_time, color = color.new(cBear, 30), style = line.style_dashed, width = 1))
            f_evLabel(evLabels, bar_index, c15BearLvl, nC + (c15BearCh ? " CHoCH ↓" : " BOS ↓"), C_CLEAR, color.new(cBear, 0), label.style_label_up, size.tiny, "Confirmed on a closed " + nC + " candle", yloc.price)
        while mssQ.size() > 30
            line.delete(mssQ.shift())

    // ── 14. Range styling
    r4.refresh(barstate.islast, true)
    r1.refresh(barstate.islast, false)

// Keep labels of untouched pools at the right edge
if barstate.islast and pools.size() > 0
    for l in pools
        if l.state == 0 and not na(l.lb)
            label.set_x(l.lb, time + labOff)

// ═══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
string dashPos = switch dashPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right
var table dash = table.new(dashPos, 2, 18, bgcolor = color.new(#0B0F17, 6), frame_color = color.new(C_GOLD, 45), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)

f_row(table t, int rw, string k, string v, color vc) =>
    table.cell(t, 0, rw, k, text_color = C_MUTED, text_halign = text.align_left, text_valign = text.align_top, text_size = dashSz)
    table.cell(t, 1, rw, v, text_color = vc, text_halign = text.align_left, text_size = dashSz)

if barstate.isfirst and showDash
    table.cell(dash, 0, 0, "MEKA CRT PRO  ·  " + nE, text_color = C_GOLD, text_halign = text.align_center, text_size = dashSz, bgcolor = color.new(#141A24, 0))
    table.merge_cells(dash, 0, 0, 1, 0)

if barstate.islast and showDash
    table.clear(dash, 0, 1, 1, 17)
    CRTRange prD = primHigh ? (r4.active ? r4 : r1) : (r1.active ? r1 : r4)
    string dW = S.dir == 1 ? "LONG" : "SHORT"
    color dC = S.dir == 1 ? cBull : cBear
    int row = 1

    // Market
    string mTxt = mkt + " · " + syminfo.type + (syminfo.type == "futures" ? " (" + syminfo.root + ")" : "") + " · tick " + str.tostring(syminfo.mintick)
    f_row(dash, row, "Market", mTxt, color.white)
    row += 1

    // 4H / 1H
    string t4 = f_rangeRow(r4, n4) + (h4Bias == 1 ? "  · bias ↑" : h4Bias == -1 ? "  · bias ↓" : "")
    f_row(dash, row, n4 + " CRT", t4, h4Bias == 1 ? cBull : h4Bias == -1 ? cBear : color.white)
    row += 1
    string t1r = f_rangeRow(r1, n1) + (r1.active and r4.active ? (r1.mid < r4.mid ? "  · in " + n4 + " discount" : "  · in " + n4 + " premium") : "")
    color c1r = r1.active and r1.loLiq.state == 2 ? cBull : r1.active and r1.hiLiq.state == 2 ? cBear : color.white
    f_row(dash, row, n1 + " CRT", t1r, c1r)
    row += 1

    // 15M
    string t15 = ""
    color c15 = color.white
    if S.state == 3
        float lv = S.dir == 1 ? (c15SwHB ? na : c15SwH) : (c15SwLB ? na : c15SwL)
        t15 := "Waiting: " + (na(lv) ? "new swing + break" : (S.dir == 1 ? "close > " : "close < ") + f_p(lv) + " (MSS)") + (confMode == "MSS or Displacement" ? " or displacement" : confMode == "MSS + Displacement" ? " with displacement" : "")
        c15 := C_GOLD
    else if S.state >= 4 and S.state <= 6
        t15 := (S.dir == 1 ? "Bullish confirmed · " : "Bearish confirmed · ") + S.confText
        c15 := dC
    else
        t15 := "Structure " + (c15Trend == 1 ? "bullish" : c15Trend == -1 ? "bearish" : "neutral") + (c15Trend == 1 and not na(c15BullLvl) ? " (last break ↑ " + f_p(c15BullLvl) + ")" : c15Trend == -1 and not na(c15BearLvl) ? " (last break ↓ " + f_p(c15BearLvl) + ")" : "")
        c15 := c15Trend == 1 ? color.new(cBull, 30) : c15Trend == -1 ? color.new(cBear, 30) : color.white
    f_row(dash, row, nC, t15, c15)
    row += 1

    // 5M
    bool useBrk = trigMode == "Break or Retest" or trigMode == "5M structure break"
    bool useRt  = trigMode == "Break or Retest" or trigMode == "Retest of 15M break"
    string trigTxt = ""
    if S.state == 4
        if useBrk
            float sv = S.dir == 1 ? (sw5HB ? na : sw5H) : (sw5LB ? na : sw5L)
            trigTxt := na(sv) ? "new " + nE + " swing + break" : (S.dir == 1 ? "close > " : "close < ") + f_p(sv)
        if useRt
            trigTxt := trigTxt + (trigTxt != "" ? " or " : "") + "retest of " + f_p(S.rtLvl)
        if trigMode == "Momentum candle"
            trigTxt := S.dir == 1 ? "bullish close > prior high" : "bearish close < prior low"
    string t5 = S.state == 4 ? "Waiting: " + trigTxt + (S.reject != "" ? "\nLast trigger rejected: " + S.reject : "") : S.state == 5 ? "Entry confirmed — fill at next open" : S.state == 6 ? "In trade · filled " + f_p(S.entry) : S.state == 3 ? "Waiting for " + nC + " first" : "No active setup"
    f_row(dash, row, nE, t5, S.state == 4 ? C_GOLD : S.state == 5 or S.state == 6 ? dC : color.white)
    row += 1

    // Liquidity
    float nb = na
    float ns = na
    for l in pools
        if l.state == 0 and not l.retired
            if l.side == 1 and l.price > close and (na(nb) or l.price < nb)
                nb := l.price
            if l.side == -1 and l.price < close and (na(ns) or l.price > ns)
                ns := l.price
    f_row(dash, row, "Liquidity", lastLiq + "\nNext BSL " + f_p(nb) + " · SSL " + f_p(ns), color.white)
    row += 1

    // Session
    string sNow = (inAsia ? "Asia " : "") + (inLon ? "London " : "") + (inNy ? "New York " : "")
    sNow := sNow == "" ? "Off-session" : sNow
    f_row(dash, row, "Session", sNow + "· " + (entryAllowed ? "entries ON" : "entries OFF (tracking)"), entryAllowed ? cBull : C_MUTED)
    row += 1

    // Status + precise next requirement
    Liq brL = na
    for l in pools
        if l.state == 1 and ((l.isCRT and l.external and (l.hiTF ? src4 : src1)) or (not l.isCRT and usePools and prD.active and (l.side == 1 ? l.price >= prD.mid : l.price <= prD.mid)))
            if na(brL) or (l.isCRT and not brL.isCRT)
                brL := l
    bool recentDone = (S.state == 8 or S.state == 9) and bar_index - S.doneBar <= 6
    string st = "WATCHING RANGE"
    color stc = C_GOLD
    string nx = ""
    if not tfOK
        st := "CHECK TIMEFRAMES"
        stc := cBear
        nx := "Need chart ≤ " + nC + " and " + nC + " < " + n1 + " < " + n4
    else if S.state == 3
        st := "SWEEP CONFIRMED & RECLAIMED · WATCH " + dW
        stc := dC
        nx := "Need " + nC + " " + (S.dir == 1 ? "bullish" : "bearish") + " confirmation (" + t15 + ") · expires in " + str.tostring(math.max(0, confExpiry - (bar_index - S.reclaimBar))) + " bars · invalid " + (S.dir == 1 ? "≤ " : "≥ ") + f_p(S.invalLvl)
    else if S.state == 4
        st := nC + " CONFIRMED · WATCH " + dW
        stc := dC
        nx := "Need " + nE + " " + trigTxt + " · in discount/premium · ≥ " + f_r(minRR) + "R · " + (entryAllowed ? "window OPEN" : "window CLOSED") + " · expires in " + str.tostring(math.max(0, entryExpiry - (bar_index - S.confBar))) + " bars · invalid " + (S.dir == 1 ? "≤ " : "≥ ") + f_p(S.invalLvl)
    else if S.state == 5
        st := S.dir == 1 ? "BUY CONFIRMED" : "SELL CONFIRMED"
        stc := dC
        nx := "Simulated fill at next candle open"
    else if S.state == 6
        st := S.tp1Done ? "TP1 HIT · RUNNER ACTIVE" : "TRADE ACTIVE · " + dW
        stc := dC
        nx := S.tp1Done ? "Managing runner to TP2 " + f_p(S.tp2) : "Managing to TP1 " + f_p(S.tp1) + " / SL " + f_p(S.stop)
    else if recentDone
        st := S.state == 9 ? (S.cat == "STRUCTURAL" ? "SETUP INVALIDATED" : S.cat == "CONFLICT" ? "SETUP CANCELLED · CONFLICT" : S.cat == "MISSED" ? "MISSED ENTRY" : S.cat == "SESSION" ? "EXPIRED · SESSION CLOSED" : S.cat == "REPLACED" ? "SETUP REPLACED" : "SETUP EXPIRED") : S.outcome
        stc := S.state == 9 ? C_GREY : S.resultR > 0 ? cTP : cSL
        nx := S.state == 9 ? S.reason : "Result " + (S.resultR >= 0 ? "+" : "") + f_r(S.resultR) + "R · watching for the next sweep"
    else if not na(brL)
        st := "SWEEP IN PROGRESS"
        stc := C_GOLD
        string rcName = brL.rcTF == 0 ? nE : brL.rcTF == 1 ? nC : brL.rcTF == 2 ? n1 : n4
        string leftTxt = brL.rcTF == 0 ? str.tostring(math.max(0, reclaimBars - (bar_index - brL.breachBar + 1))) + " bars" : str.tostring(math.max(0, (brL.rcTF == 1 ? reclaimWin15 : 1) - brL.tfCnt)) + " " + rcName + " close(s)"
        nx := brL.kind + " " + f_p(brL.price) + " breached (extreme " + f_p(brL.ext) + ") · need a completed " + rcName + " close " + (brL.side == 1 ? "< " : "> ") + f_p(brL.price) + " within " + leftTxt + (brL.pend ? " · " + nE + " already back inside (reclaim pending)" : "")
    else if not r4.active and not r1.active
        st := "IDLE · NO VALID RANGE"
        stc := C_MUTED
        nx := "Waiting for a valid " + n1 + " / " + n4 + " reference candle"
    else
        string wl = prD.loLiq.state == 0 ? "L " + f_p(prD.lo) : ""
        string wh = prD.hiLiq.state == 0 ? "H " + f_p(prD.hi) : ""
        nx := "Watch sweep + reclaim of " + prD.tf + " " + wl + (wl != "" and wh != "" ? " / " : "") + wh + (wl == "" and wh == "" ? "range (both sides used — wait for next candle)" : "")
        if lastBlock != ""
            nx := nx + "\n" + lastBlock
    f_row(dash, row, "Status", st, stc)
    table.cell_set_bgcolor(dash, 1, row, color.new(stc, 82))
    row += 1
    f_row(dash, row, "Next", nx, color.new(color.white, 10))
    row += 1
    if S.state >= 3 and S.state <= 6
        f_row(dash, row, "Locked", S.srcKind + " " + f_p(S.level) + " · ext " + f_p(S.ext) + " · " + S.srcTF + " range H " + f_p(S.rHi) + " / 50% " + f_p(S.rMid) + " / L " + f_p(S.rLo) + (not na(S.rT0) and ((S.srcTF == n1 and r1.active and r1.t0 != S.rT0) or (S.srcTF == n4 and r4.active and r4.t0 != S.rT0)) ? "\n(reference candle has rolled — setup keeps its own levels)" : ""), C_MUTED)
        row += 1
    if diagT.size() > 0
        int lk = diagT.size() - 1
        string lc = diagC.get(lk)
        f_row(dash, row, "Last setup", diagT.get(lk) + " · " + diagS.get(lk) + " → " + lc + "\n" + diagR.get(lk), lc == "TRADE" ? cTP : lc == "SKIPPED" ? C_MUTED : C_GREY)
        row += 1

    // Trade levels (actual calculated values only)
    if S.state == 5 or S.state == 6 or (recentDone and S.state == 8)
        f_row(dash, row, "Entry", S.state == 5 ? "next open (signal " + f_p(S.entryRef) + ")" : f_p(S.entry), cEntry)
        row += 1
        f_row(dash, row, "SL", f_p(S.stop) + (S.beOn ? " (breakeven)" : ""), cSL)
        row += 1
        f_row(dash, row, "TP1", f_p(S.tp1) + " · " + S.tp1Src + (S.tp1Done ? " ✓" : ""), cTP)
        row += 1
        f_row(dash, row, "TP2", f_p(S.tp2) + " · " + S.tp2Src + " · " + f_r(math.abs(S.tp2 - S.entryRef) / S.riskRef) + "R", cTP)
        row += 1
        float riskPts = math.abs((S.state == 5 ? S.entryRef : S.entry) - S.stopInit)
        f_row(dash, row, "Risk", f_p(riskPts) + " pts ≈ " + str.tostring(riskPts * syminfo.pointvalue, "#,##0.00") + " " + syminfo.currency + " per 1 " + (syminfo.type == "futures" ? "contract" : "unit"), color.white)
        row += 1
    if showSim
        f_row(dash, row, "Sim tally", str.tostring(simN) + " trades · " + str.tostring(simW) + "W / " + str.tostring(simN - simW) + "L · " + (simR >= 0 ? "+" : "") + f_r(simR) + "R", C_MUTED)
        row += 1

// ═══════════════════════════════════════════════════════════════════════════════
//  DIAGNOSTIC LOG — last 20 setup outcomes (tiny, bottom of chart, optional)
// ═══════════════════════════════════════════════════════════════════════════════
string diagPos = diagPosIn == "Bottom right" ? position.bottom_right : diagPosIn == "Bottom center" ? position.bottom_center : position.bottom_left
var table diag = table.new(diagPos, 4, 22, bgcolor = color.new(#0B0F17, 15), frame_color = color.new(C_GREY, 60), frame_width = 1, border_color = color.new(#1C2430, 0), border_width = 1)
if barstate.islast and showDiag
    table.clear(diag, 0, 0, 3, 21)
    table.cell(diag, 0, 0, "MEKA DIAGNOSTICS", text_color = C_GOLD, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 1, 0, "last " + str.tostring(diagT.size()) + " setups · newest first", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 2, 0, "OUTCOME", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    table.cell(diag, 3, 0, "REASON", text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
    int nD = diagT.size()
    if nD > 0
        for k = 0 to nD - 1
            int src = nD - 1 - k
            string cg = diagC.get(src)
            color cc = cg == "TRADE" ? cTP : cg == "STRUCTURAL" or cg == "CONFLICT" ? cSL : cg == "SKIPPED" ? C_MUTED : C_GOLD
            table.cell(diag, 0, k + 1, diagT.get(src), text_color = C_MUTED, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 1, k + 1, diagS.get(src), text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 2, k + 1, cg, text_color = cc, text_size = size.tiny, text_halign = text.align_left)
            table.cell(diag, 3, k + 1, diagR.get(src), text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)

// ═══════════════════════════════════════════════════════════════════════════════
//  DATA WINDOW
// ═══════════════════════════════════════════════════════════════════════════════
bool liveTrade = S.state == 5 or S.state == 6
plot(liveTrade ? (S.state == 6 ? S.entry : S.entryRef) : na, "Entry", color = cEntry, display = display.data_window)
plot(liveTrade ? S.stop : na, "Stop", color = cSL, display = display.data_window)
plot(liveTrade ? S.tp1 : na, "TP1", color = cTP, display = display.data_window)
plot(liveTrade ? S.tp2 : na, "TP2", color = cTP, display = display.data_window)
plot(r1.active ? r1.mid : na, "Setup-TF CRT 50%", color = cMid, display = display.data_window)
plot(r4.active ? r4.mid : na, "Higher-TF CRT 50%", color = cMid, display = display.data_window)

// (alertcondition() block removed in the strategy build — alert() calls still work)

// ═══════════════════════════════════════════════════════════════════════════════
//  STRATEGY EXECUTION LAYER — driven 1:1 by the indicator engine's events above.
//  Entry: market order on the signal bar close → filled by TradingView at the
//  NEXT bar's open (same assumption as the indicator's simulated fill).
//  Exits: native stop / limit orders at the engine's SL / TP1 / TP2.
// ═══════════════════════════════════════════════════════════════════════════════
string G_ST = "⑬ Strategy (backtest only)"
string sizeMode = input.string("Fixed quantity", "Position sizing", options = ["Fixed quantity", "Risk % of equity"], group = G_ST)
float  fixedQty = input.float(2, "Fixed quantity (contracts / units)", minval = 0.000001, group = G_ST, tooltip = "Use ≥ 2 whole contracts on futures so the 50% TP1 partial is possible.")
float  riskPct  = input.float(0.5, "Risk % of equity per trade", minval = 0.01, maxval = 10, step = 0.05, group = G_ST)
float  qtyStep  = input.float(1, "Quantity step (1 = whole contracts)", minval = 0.000001, group = G_ST, tooltip = "Futures: 1. Spot / CFD gold: broker lot step in units (e.g. 1 oz). FX: 1000 units, etc.")
float  maxQty   = input.float(50, "Maximum quantity", minval = 0.000001, group = G_ST)
int    fromDate = input.time(timestamp("2022-01-01T00:00:00"), "Trade from", group = G_ST)
int    toDate   = input.time(timestamp("2099-12-31T00:00:00"), "Trade until", group = G_ST, tooltip = "Use this to hold back an UNTOUCHED out-of-sample period while tuning.")

f_floorStep(float q, float st) => math.floor(q / st + 1e-9) * st

bool inDates = time >= fromDate and time <= toDate

if barstate.isconfirmed
    // New signal → entry + bracket
    if (evBuy or evSell) and inDates and strategy.position_size == 0
        float riskPts = math.abs(S.entryRef - S.stop)
        float rawQty  = sizeMode == "Fixed quantity" ? fixedQty : (strategy.equity * riskPct / 100) / (riskPts * syminfo.pointvalue)
        float q  = math.min(f_floorStep(rawQty, qtyStep), maxQty)
        float q1 = f_floorStep(q * tp1Pct / 100, qtyStep)
        if q > 0
            string eid = evBuy ? "MEKA L" : "MEKA S"
            strategy.entry(eid, evBuy ? strategy.long : strategy.short, qty = q, comment = evBuy ? "BUY" : "SELL")
            if q1 > 0 and q1 < q
                strategy.exit(eid + " TP1", eid, qty = q1, stop = S.stop, limit = S.tp1, comment_profit = "TP1", comment_loss = "SL")
                strategy.exit(eid + " TP2", eid, qty = q - q1, stop = S.stop, limit = S.tp2, comment_profit = "TP2", comment_loss = "SL")
            else if q1 >= q
                strategy.exit(eid + " TP1", eid, stop = S.stop, limit = S.tp1, comment_profit = "TP1", comment_loss = "SL")
            else
                strategy.exit(eid + " TP2", eid, stop = S.stop, limit = S.tp2, comment_profit = "TP2", comment_loss = "SL")

    // Breakeven after TP1 (only if enabled in the engine inputs)
    if evTP1 and useBE and strategy.position_size != 0
        string bid = strategy.position_size > 0 ? "MEKA L" : "MEKA S"
        strategy.exit(bid + " TP2", bid, qty = math.abs(strategy.position_size), stop = strategy.position_avg_price, limit = S.tp2, comment_profit = "TP2", comment_loss = "BE")

    // Time-based early exit at this bar's close
    if evEarly and strategy.position_size != 0
        strategy.close_all(comment = "EARLY EXIT", immediately = true)

    // Keep broker emulator and engine in lock-step (see docs: intrabar ordering)
    if evDone and not evEarly and strategy.position_size != 0
        strategy.close_all(comment = "SYNC", immediately = true)

