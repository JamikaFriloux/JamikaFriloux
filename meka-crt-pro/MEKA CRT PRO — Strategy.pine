bool   trackSw     = input.bool(true, "Confirmed 15M swing highs / lows (+ equal highs/lows)", group = G_LIQ)
float  eqTolATR    = input.float(0.10, "Equal-level & merge tolerance (× chart ATR14)", minval = 0.0, step = 0.02, group = G_LIQ)
int    poolMax     = input.int(8, "Max untouched pools per side", minval = 2, maxval = 25, group = G_LIQ)
int    poolDays    = input.int(3, "Pool expiry in days (weekly levels × 3)", minval = 1, maxval = 30, group = G_LIQ)

