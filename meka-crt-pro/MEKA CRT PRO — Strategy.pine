bool   useBE       = input.bool(false, "Move stop to breakeven after TP1 (untested — off by default)", group = G_RSK)
int    maxBars     = input.int(0, "Early exit after N bars in trade (0 = off)", minval = 0, group = G_RSK)
bool   wickInval   = input.bool(true, "Invalidate pending setup on a WICK through the sweep extreme (off = close)", group = G_RSK)

string G_LIQ = "⑦ Liquidity engine"
bool   trackPD     = input.bool(true, "Previous day high / low", group = G_LIQ)
bool   trackPW     = input.bool(true, "Previous week high / low", group = G_LIQ)
