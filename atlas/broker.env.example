# Alpaca PAPER credentials — mounted ONLY into the `executor` container.
# Create paper keys at https://app.alpaca.markets (switch to the Paper account first).
# Live endpoints and live-looking keys are rejected at startup.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# iex (free) | sip (paid subscription) | delayed_sip
ALPACA_DATA_FEED=iex

# Reference data (executor only, optional; Phase 7). Without these, stocks get no earnings
# clearance and entries in them are rejected; ETFs listed in config/instruments.yaml trade.
# SEC EDGAR sectors: no key, but a User-Agent with a contact email is required.
ATLAS_REFDATA_SEC_USER_AGENT=
# Earnings calendar (https://finnhub.io, free tier is enough). Never commit the key.
ATLAS_REFDATA_FINNHUB_API_KEY=
