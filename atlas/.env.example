# Shared, non-broker configuration (all backend services). Copy to .env and edit.
# NEVER commit .env, broker.env or llm.env.

ATLAS_ENVIRONMENT=development
ATLAS_TRADING_MODE=paper
POSTGRES_PASSWORD=change-me-local-only
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:change-me-local-only@postgres:5432/atlas
ATLAS_REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_JWT_SECRET=
ATLAS_JWT_TTL_MINUTES=60
ATLAS_CORS_ORIGINS=["http://localhost:3000"]
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_JSON=true
ATLAS_TIMEZONE=America/New_York

# Optional: Telegram (create a bot with @BotFather; see docs/setup.md)
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_ID=

# Optional: error monitoring / tracing
ATLAS_SENTRY_DSN=
ATLAS_OTEL_ENABLED=false
