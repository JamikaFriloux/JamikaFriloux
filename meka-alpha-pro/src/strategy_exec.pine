// STRATEGY EXECUTION - TradingView's broker emulator is the execution record.
// Contract: closed-bar decisions, calc_on_every_tick=false, calc_on_order_fills=false,
// process_orders_on_close=false, pyramiding=0, no automatic reversal.
//  - The entry order (market or limit) and every target's bracket (fixed stop + limit) are sent in
//    the same calculation, so the position is protected from its first tick.
//  - Fills, targets and P&L are read back from strategy.closedtrades / opentrades (evidence),
//    never inferred from a price merely touching a level.
//  - Statistics = emulator P&L (includes any commission/slippage set in Properties) minus the
//    modeled cost model from group 4. Leave Properties costs at 0 OR turn the model off - not both.
var int side = 0
var bool pending = false
var bool isLimit = false
var float refEntry = na
var float fillEntry = na
var float curStop = na
var float initialStop = na
var float riskPlan = na
var float target1 = na
var float target2 = na
var float target3 = na
var float initialQty = na
var float part1 = 0.0
var float part2 = 0.0
var float part3 = 0.0
var float remaining = 0.0
var bool done1 = false
var bool done2 = false
var bool done3 = false
var bool touched1 = false
var bool touched2 = false
var bool touched3 = false
var bool trigSeen = false
var int submittedBar = na
var int filledBar = na
var int lastClosed = na
var int seenClosed = 0
var int closedAtSubmit = 0
var string tradeID = ""
var string tradeName = ""
var bool closing = false
var string closingWhy = ""
var float fillRiskRatio = na
var float emuNet = 0.0
var float costCash = 0.0
var float plannedCash = na
var int tradeSess = 0
var bool tradeTrend = false
var bool tradeHV = false
var bool tradeOOS = false
var string lastExitText = ""
var string execBlock = ""
bool entered = false
bool evFill = false
bool tpEvent = false
bool evTP1 = false
bool evTP2 = false
bool evTP3 = false
bool evStopHit = false
bool earlyNow = false
bool exited = false
bool cancelNow = false
string cancelText = ""
const string basisWord = "emulator"
f_sendExits() =>
    if part1 > 0 and not done1
        strategy.exit("TP1", "ENTRY", qty=part1, limit=target1, stop=curStop, comment_profit="TP1", comment_loss="STOP", alert_message=tradeID)
    if part2 > 0 and not done2
        strategy.exit("TP2", "ENTRY", qty=part2, limit=target2, stop=curStop, comment_profit="TP2", comment_loss="STOP", alert_message=tradeID)
    if part3 > 0 and not done3
        strategy.exit("TP3", "ENTRY", qty=part3, limit=target3, stop=curStop, comment_profit="TP3", comment_loss="STOP", alert_message=tradeID)
    true

int evSide = side
if barstate.isconfirmed
    int nowClosed = strategy.closedtrades
    // 1) Execution evidence since the last calculation.
    if nowClosed > seenClosed
        for n = seenClosed to nowClosed - 1
            string xid = strategy.closedtrades.exit_id(n)
            string xc = strategy.closedtrades.exit_comment(n)
            float xq = math.abs(strategy.closedtrades.size(n))
            float xp = strategy.closedtrades.exit_price(n)
            bool isTP = xc == "TP1" or xc == "TP2" or xc == "TP3"
            emuNet += strategy.closedtrades.profit(n)
            costCash += f_cost(xq, not isTP)
            if na(fillEntry)
                fillEntry := strategy.closedtrades.entry_price(n)
                filledBar := strategy.closedtrades.entry_bar_index(n)
            if xid == "TP1"
                done1 := true
            else if xid == "TP2"
                done2 := true
            else if xid == "TP3"
                done3 := true
            if xc == "TP1"
                evTP1 := true
                f_bump(tpFill, 0)
            else if xc == "TP2"
                evTP2 := true
                f_bump(tpFill, 1)
            else if xc == "TP3"
                evTP3 := true
                f_bump(tpFill, 2)
            else if xc == "STOP"
                evStopHit := true
                lastExitText := "Stop hit at " + f_px(xp) + "."
            else
                lastExitText := (closingWhy != "" ? closingWhy : "Position closed.") + " Closed at " + f_px(xp) + "."
        seenClosed := nowClosed
    tpEvent := evTP1 or evTP2 or evTP3
    // 2) Entry fill, or an order that must be canceled.
    if pending and (strategy.position_size != 0 or nowClosed > closedAtSubmit)
        pending := false
        evFill := true
        if strategy.position_size != 0
            fillEntry := strategy.opentrades.entry_price(0)
            filledBar := strategy.opentrades.entry_bar_index(0)
        costCash += f_cost(initialQty, not isLimit)
        fillRiskRatio := (side == 1 ? fillEntry - initialStop : initialStop - fillEntry) / riskPlan
    else if pending and bar_index > submittedBar and (not isLimit or bar_index - submittedBar >= limitBars)
        cancelNow := true
        cancelText := isLimit ? (side == 1 ? "Buy" : "Sell") + " limit at " + f_px(refEntry) + " expired without a fill." : "The entry order was not filled. Check capital, margin and position size in Properties."
        strategy.cancel_all()
        pending := false
        side := 0
        lastClosed := bar_index
    // 3) Which target levels were touched while the position existed (touch is not a fill).
    if side != 0 and not pending
        if (side == 1 ? high >= target1 : low <= target1) and not touched1
            touched1 := true
            f_bump(tpTouch, 0)
        if (side == 1 ? high >= target2 : low <= target2) and not touched2
            touched2 := true
            f_bump(tpTouch, 1)
        if use3 and (side == 1 ? high >= target3 : low <= target3) and not touched3
            touched3 := true
            f_bump(tpTouch, 2)
    // 4) Flat again -> the position is complete.
    if side != 0 and not pending and strategy.position_size == 0
        exited := true
        strategy.cancel_all()
        float netCash = emuNet - costCash
        float tradeR = netCash / plannedCash
        f_record(tradeR, netCash, side, tradeSess, tradeTrend, tradeHV, tradeOOS)
        dayR += tradeR
        lossStreak := tradeR < 0 ? lossStreak + 1 : 0
        lastExitText := (lastExitText == "" ? "All targets filled." : lastExitText) + " Result " + (tradeR >= 0 ? "+" : "") + str.tostring(tradeR, "#.##") + "R after modeled costs."
        lastClosed := bar_index
        side := 0
        closing := false
    // 5) Manage the open position: close-based stop updates (tighten only) and exit decisions.
    if side != 0 and not pending and strategy.position_size != 0
        remaining := math.abs(strategy.position_size)
        trigSeen := trigSeen or touched1
        if beOn and trigSeen
            curStop := side == 1 ? math.max(curStop, f_floorTick(fillEntry)) : math.min(curStop, f_ceilTick(fillEntry))
        if trailMode == "ATR" and trigSeen
            curStop := side == 1 ? math.max(curStop, f_floorTick(close - trailATR * atr)) : math.min(curStop, f_ceilTick(close + trailATR * atr))
        if trailMode == "Swing structure" and trigSeen and not na(side == 1 ? swingLow : swingHigh)
            curStop := side == 1 ? math.max(curStop, f_floorTick(swingLow - stopPad * atr)) : math.min(curStop, f_ceilTick(swingHigh + stopPad * atr))
        f_sendExits()
        string why = evFill and gapMaxRisk > 0 and fillRiskRatio > gapMaxRisk ? "The entry gapped and the real risk is too large." : time_close >= testEnd ? "End of the selected trading dates." : inForceFlat ? "End-of-day flat period." : flattenOutside and not inWindow ? "Session window ended." : exitOnChoch and (side == 1 ? breakDn : breakUp) ? "Market structure broke against the trade." : exitOnBias and htfBias == -side ? "Higher-timeframe bias flipped against the trade." : bar_index - filledBar >= holdBars ? "Maximum holding time reached." : ""
        if why != "" and not closing
            strategy.close("ENTRY", comment="EXIT", alert_message=tradeID)
            closing := true
            closingWhy := why
            earlyNow := true
    // 6) Alerts (strategy alert() calls; order fills also raise TradingView order-fill alerts).
    string base = syminfo.ticker + " " + timeframe.period + "m: "
    if evFill
        alert(f_json("ENTRY_FILLED", evSide, "emulator_fill", tradeID, base + f_sideWord(evSide) + " filled at " + f_px(fillEntry) + ".", fillEntry, initialStop, target1, target2, target3, initialQty, plannedCash), alert.freq_once_per_bar_close)
    if evTP1
        alert(f_json("TP1_REACHED", evSide, "emulator_fill", tradeID, base + "TP1 filled at " + f_px(target1) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evTP2
        alert(f_json("TP2_REACHED", evSide, "emulator_fill", tradeID, base + "TP2 filled at " + f_px(target2) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evTP3
        alert(f_json("TP3_REACHED", evSide, "emulator_fill", tradeID, base + "TP3 filled at " + f_px(target3) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evStopHit
        alert(f_json("STOP_HIT", evSide, "emulator_fill", tradeID, base + lastExitText, fillEntry, curStop, target1, target2, target3, 0, na), alert.freq_once_per_bar_close)
    if earlyNow
        alert(f_json("EARLY_EXIT", evSide, "close_decision", tradeID, base + "Exit at the next open. " + closingWhy, fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if cancelNow
        alert(f_json("SETUP_CANCELED", evSide, "close_decision", tradeID, base + cancelText, refEntry, initialStop, target1, target2, target3, na, na), alert.freq_once_per_bar_close)
    // 7) New entry: order + all brackets together. Never on the bar a position closed.
    execBlock := f_dayBlock()
    bool rested = na(lastClosed) or bar_index - lastClosed > cooldown
    if side == 0 and setupFormed
        alert(f_json("SETUP_FORMING", setupSide, "close_decision", "", base + (setupSide == 1 ? "Bullish" : "Bearish") + " break at " + f_px(brokenLevel) + ". Watching for a pullback.", na, na, na, na, na, na, na), alert.freq_once_per_bar_close)
    if side == 0 and setupCanceled and not cancelNow
        alert(f_json("SETUP_CANCELED", prevSide, "close_decision", "", base + setupEndText, na, na, na, na, na, na, na), alert.freq_once_per_bar_close)
    if signal != 0 and side == 0 and strategy.position_size == 0 and rested and execBlock == ""
        side := signal
        isLimit := useLimit
        refEntry := refPx
        fillEntry := na
        filledBar := na
        curStop := plannedStop
        initialStop := plannedStop
        riskPlan := plannedRisk
        [t1, t2, t3] = f_targets(signal, refPx, plannedRisk)
        target1 := t1
        target2 := t2
        target3 := t3
        initialQty := plannedQty
        [a, b, c] = f_parts(plannedQty)
        part1 := a
        part2 := b
        part3 := c
        remaining := 0.0
        done1 := false
        done2 := false
        done3 := false
        touched1 := false
        touched2 := false
        touched3 := false
        trigSeen := false
        pending := true
        closing := false
        closingWhy := ""
        lastExitText := ""
        fillRiskRatio := na
        emuNet := 0.0
        costCash := 0.0
        plannedCash := plannedQty * plannedRisk * unitUSD
        closedAtSubmit := strategy.closedtrades
        submittedBar := bar_index
        tradeName := candName
        tradeSess := sessCode
        tradeTrend := trending
        tradeHV := hiVol
        tradeOOS := time >= oosStart
        tradeID := syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time_close)
        dayEntries += 1
        strategy.entry("ENTRY", side == 1 ? strategy.long : strategy.short, qty=initialQty, limit=isLimit ? refEntry : na, comment=tradeName, alert_message=tradeID)
        f_sendExits()
        entered := true
        alert(f_json(side == 1 ? "LONG_ENTRY_CONFIRMED" : "SHORT_ENTRY_CONFIRMED", side, isLimit ? "limit_order" : "next_open", tradeID, base + (side == 1 ? "BUY " : "SELL ") + (isLimit ? "limit at " + f_px(refEntry) : "at next open (~" + f_px(refEntry) + ")") + ". Stop " + f_px(curStop) + ", TP1 " + f_px(target1) + ", TP2 " + f_px(target2) + (use3 ? ", TP3 " + f_px(target3) : "") + ". Size " + str.tostring(initialQty) + ".", refEntry, curStop, target1, target2, target3, initialQty, plannedCash), alert.freq_once_per_bar_close)
