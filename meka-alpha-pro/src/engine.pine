// COMMON SIGNAL ENGINE BEGIN
// Everything between the BEGIN/END markers is byte-identical in the indicator and the strategy
// (enforced by tools/build.py). Raw signals therefore cannot differ between the two scripts.
// Native chart direction only: 6J LONG = long JPY / short USD, the opposite of a USDJPY LONG.
const string VERSION = "4.0-r2.1"
gSetup = "Setup"
gMarket = "Market / sizing"
gRisk = "Risk / targets"
gDay = "Trading-day limits (exits always stay active)"
gSess = "Entry windows (local time, research windows - not exchange hours)"
gNews = "Manual news / blocks / dates (NOT a news feed)"
gCal = "Calibration (UNVALIDATED research defaults)"
gDisp = "Display"

mode = input.string("DAY TRADE", "Mode", options=["SCALP", "DAY TRADE"], group=gSetup)
engine = input.string("ICC", "Entry framework", options=["ICC", "Trend pullback", "Either"], group=gSetup, tooltip="ICC = indication -> correction -> continuation on three different closed bars. Either = ICC has priority; trend pullback only while no ICC setup is in progress. One entry per bar at most.")

profileInput = input.string("Auto", "Market family", options=["Auto", "Gold", "Nasdaq", "S&P", "EURUSD", "JPY"], group=gMarket)
unitValueInput = input.float(0, "USD per 1.0 price move per order unit (0 = auto)", minval=0, group=gMarket, tooltip="0: USD-quoted symbols use syminfo.pointvalue; USD-base symbols (e.g. USDJPY) use pointvalue / close. Any other quote currency must be set here or entries are blocked.")
qtyStepInput = input.float(1, "Non-futures quantity step", minval=0.000001, group=gMarket, tooltip="Futures always use 1 whole contract.")

account = input.float(10000, "Sizing reference balance USD (fixed, not compounding)", minval=1, group=gRisk)
riskPct = input.float(0.5, "Planned initial risk % of reference balance", minval=0.01, maxval=5, group=gRisk)
maxQty = input.float(100000, "Maximum order units", minval=1, group=gRisk)
useTP3 = input.bool(false, "Enable TP3 (40/30/30 instead of 50/50)", group=gRisk)
r1 = input.float(1, "TP1 planned R", minval=0.1, group=gRisk)
r2 = input.float(2, "TP2 planned R", minval=0.2, group=gRisk)
r3 = input.float(3, "TP3 planned R", minval=0.3, group=gRisk)
beOn = input.bool(false, "Break-even after TP1 level is observed (updates after that close)", group=gRisk)
trailOn = input.bool(false, "ATR trail after TP1 level is observed (updates after each close)", group=gRisk)
trailATR = input.float(2.0, "Trail distance ATR", minval=0.1, group=gRisk)
gapMaxRisk = input.float(1.5, "Gap policy: exit if fill risk > N x planned risk (0 = keep)", minval=0, group=gRisk, tooltip="Checked at the close of the fill bar; the exit is requested for the next tick. The protective stop is active the whole time.")
stopPad = input.float(0.15, "Structure padding ATR", minval=0, group=gRisk)
roomGate = input.bool(true, "Require room to TP1 before the last opposing pivot", group=gRisk)

dayTZ = input.string("America/New_York", "Trading-day timezone (IANA)", group=gDay)
dayReset = input.int(1700, "Trading-day reset time HHMM (local)", minval=0, maxval=2359, group=gDay, tooltip="1700 New York matches the CME Globex day roll. Day counters reset here, never at midnight. Open positions are never reset.")
dailyLossR = input.float(0, "Daily loss gate in R (0 = off)", minval=0, group=gDay)
maxEntries = input.int(0, "Max entry intents per trading day (0 = off)", minval=0, group=gDay)
maxLossStreak = input.int(0, "Pause after N consecutive losing positions (0 = off)", minval=0, group=gDay)

useAsia = input.bool(true, "Asia (Tokyo) window", inline="as", group=gSess)
asia = input.session("0900-1500", "", inline="as", group=gSess)
asiaTZ = input.string("Asia/Tokyo", "Asia timezone", group=gSess)
useLondon = input.bool(true, "London window", inline="ld", group=gSess)
london = input.session("0800-1200", "", inline="ld", group=gSess)
londonTZ = input.string("Europe/London", "London timezone", group=gSess)
useNY = input.bool(true, "New York window", inline="ny", group=gSess)
ny = input.session("0830-1200", "", inline="ny", group=gSess)
nyTZ = input.string("America/New_York", "New York timezone", group=gSess)
weekdays = input.string("23456", "Weekday mask (1=Sun ... 7=Sat, local to each window)", group=gSess)
cutoffMin = input.int(5, "Latest entry: minutes before window end", minval=0, group=gSess, tooltip="A signal whose bar closes less than this many minutes before the window end is rejected, so the next-tick fill is unlikely to land outside the window. Not a guarantee after data gaps.")
flattenOutside = input.bool(false, "Request exit when outside every enabled window", group=gSess)
forceFlatOn = input.bool(false, "Force-flat window (no holding through it)", inline="ff", group=gSess)
forceFlat = input.session("1555-1600", "", inline="ff", group=gSess, tooltip="Interpreted in the trading-day timezone. Blocks new entries and requests an exit at the close of the first bar that touches it.")

blockEntries = input.bool(false, "EMERGENCY: block all new entries", group=gNews)
news1On = input.bool(false, "Event 1", inline="n1", group=gNews)
news1 = input.time(timestamp("01 Jan 2026 13:30 +0000"), "", inline="n1", group=gNews)
news2On = input.bool(false, "Event 2", inline="n2", group=gNews)
news2 = input.time(timestamp("01 Jan 2026 15:00 +0000"), "", inline="n2", group=gNews)
news3On = input.bool(false, "Event 3", inline="n3", group=gNews)
news3 = input.time(timestamp("01 Jan 2026 19:00 +0000"), "", inline="n3", group=gNews)
newsPre = input.int(30, "Minutes before each event", minval=0, group=gNews)
newsPost = input.int(30, "Minutes after each event", minval=0, group=gNews)
recurOn = input.bool(false, "Recurring daily exclusion", inline="rc", group=gNews)
recur = input.session("0825-0835", "", inline="rc", group=gNews)
recurTZ = input.string("America/New_York", "Recurring exclusion timezone", group=gNews)
testStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Entry evaluation start", group=gNews)
testEnd = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Entry evaluation end (open position exit requested)", group=gNews)

scalpTF = input.timeframe("15", "Scalp trend timeframe (must be > chart)", group=gCal)
dayTF = input.timeframe("60", "Day trend timeframe (must be > chart)", group=gCal)
scalpPivot = input.int(3, "Scalp pivot strength (bars each side)", minval=2, maxval=20, group=gCal)
dayPivot = input.int(5, "Day pivot strength (bars each side)", minval=2, maxval=20, group=gCal)
scalpExpiry = input.int(12, "Scalp ICC expiry bars", minval=3, group=gCal)
dayExpiry = input.int(24, "Day ICC expiry bars", minval=3, group=gCal)
scalpHold = input.int(20, "Scalp maximum hold bars", minval=1, group=gCal)
dayHold = input.int(48, "Day maximum hold bars", minval=1, group=gCal)
scalpCool = input.int(2, "Scalp cooldown full bars", minval=0, group=gCal)
dayCool = input.int(3, "Day cooldown full bars", minval=0, group=gCal)
scalpMinStop = input.float(0.5, "Scalp minimum stop ATR", minval=0.1, group=gCal)
dayMinStop = input.float(0.6, "Day minimum stop ATR", minval=0.1, group=gCal)
scalpMaxStop = input.float(2.5, "Scalp maximum stop ATR (farther = reject)", minval=0.2, group=gCal)
dayMaxStop = input.float(3.0, "Day maximum stop ATR (farther = reject)", minval=0.2, group=gCal)
minADX = input.float(18, "Minimum ADX(14)", minval=1, group=gCal)
displace = input.float(0.6, "Indication body / prior ATR minimum", minval=0.1, group=gCal)
retestPad = input.float(0.25, "Broken-level retest band ATR", minval=0.01, group=gCal)
bosTicks = input.int(1, "Structure break buffer (ticks)", minval=0, group=gCal)
minAtrTicks = input.int(4, "Minimum ATR(14) in ticks", minval=1, group=gCal)
maxExtension = input.float(2.5, "Maximum distance from EMA20 in ATR", minval=0.1, group=gCal)
volumeRequired = input.bool(false, "Require volume >= SMA20 volume (missing volume BLOCKS)", group=gCal)

showLevels = input.bool(true, "Show planned / active levels", group=gDisp)
showDash = input.bool(true, "Show dashboard", group=gDisp)
dashFull = input.bool(false, "Full dashboard (14 rows; off = compact)", group=gDisp)
dashPosIn = input.string("Top right", "Dashboard position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gDisp)
dashSizeIn = input.string("Small", "Dashboard text size", options=["Tiny", "Small", "Normal"], group=gDisp)

// ---- Market profile -------------------------------------------------------------------------
string root = syminfo.root
// Futures roots, then common CFD / spot tickers (e.g. TVC:GOLD, OANDA:XAUUSD), then currencies.
f_isOne(string list, string x) => str.contains("," + list + ",", "," + x + ",")
string tk = syminfo.ticker
string autoProfile = root == "GC" or root == "MGC" or syminfo.basecurrency == "XAU" or f_isOne("GOLD,XAUUSD,GOLDUSD,XAUUSD.,GOLDSPOT", tk) ? "Gold" : root == "NQ" or root == "MNQ" or f_isOne("NAS100,NAS100USD,US100,USTEC,NDX100,US100.cash", tk) ? "Nasdaq" : root == "ES" or root == "MES" or f_isOne("SPX500,SPX500USD,US500,US500USD,US500.cash", tk) ? "S&P" : root == "6E" or root == "M6E" or (syminfo.basecurrency == "EUR" and syminfo.currency == "USD") or tk == "EURUSD" ? "EURUSD" : root == "6J" or (syminfo.basecurrency == "USD" and syminfo.currency == "JPY") or tk == "USDJPY" ? "JPY" : "Unknown"
string profile = profileInput == "Auto" ? autoProfile : profileInput
bool isFuture = syminfo.type == "futures"
float qtyStep = isFuture ? 1.0 : qtyStepInput
// Price moves in quote currency. USD quote: pointvalue is already USD. USD base (USDJPY):
// 1.0 move on one unit = 1 quote unit = 1 / close USD. Everything else needs an override.
string unitSource = unitValueInput > 0 ? "manual override" : syminfo.currency == "USD" ? "pointvalue (USD quote)" : syminfo.basecurrency == "USD" ? "pointvalue / close (USD base)" : "UNKNOWN - set override"
float unitUSD = unitValueInput > 0 ? unitValueInput : syminfo.currency == "USD" ? syminfo.pointvalue : syminfo.basecurrency == "USD" and close > 0 ? syminfo.pointvalue / close : na
bool marketOK = profile != "Unknown" and not na(unitUSD) and unitUSD > 0
// 6J (USD per JPY) LONG = JPY strength; USDJPY LONG = USD strength. Only this display is inverted.
bool jpyPerUsdQuote = root == "6J" or (syminfo.basecurrency == "JPY" and syminfo.currency == "USD")
string htf = mode == "SCALP" ? scalpTF : dayTF
int strength = mode == "SCALP" ? scalpPivot : dayPivot
int expiry = mode == "SCALP" ? scalpExpiry : dayExpiry
int holdBars = mode == "SCALP" ? scalpHold : dayHold
int cooldown = mode == "SCALP" ? scalpCool : dayCool
float minStop = mode == "SCALP" ? scalpMinStop : dayMinStop
float maxStop = mode == "SCALP" ? scalpMaxStop : dayMaxStop

// ---- Local-time helpers (IANA zones, DST handled per zone by TradingView) -------------------
f_hhmm(string s, int pos) => int(str.tonumber(str.substring(s, pos, pos + 4)))
f_mins(int hhmm) => math.floor(hhmm / 100) * 60 + hhmm % 100
f_localMins(int t, string zone) => hour(t, zone) * 60 + minute(t, zone)
f_dateKey(int t, string zone) => year(t, zone) * 10000 + month(t, zone) * 100 + dayofmonth(t, zone)
f_validSess(string s) =>
    int a = f_hhmm(s, 0)
    int b = f_hhmm(s, 5)
    not na(a) and not na(b) and str.length(s) >= 9 and a % 100 < 60 and b % 100 < 60 and a < b
// Whole chart bar inside [start, end) on one local weekday. Boundary-crossing bars are rejected.
f_inside(string s, string zone) =>
    int o = f_localMins(time, zone)
    int c = f_localMins(time_close - 1, zone)
    bool sameDay = f_dateKey(time, zone) == f_dateKey(time_close - 1, zone)
    bool dayOK = str.contains(weekdays, str.tostring(dayofweek(time, zone)))
    dayOK and sameDay and o >= f_mins(f_hhmm(s, 0)) and c < f_mins(f_hhmm(s, 5))
// Minutes from bar close to window end (only meaningful when f_inside is true).
f_left(string s, string zone) => f_mins(f_hhmm(s, 5)) - (f_localMins(time_close - 1, zone) + 1)
// Any part of the bar touches [start, end) on its local day(s).
f_touches(string s, string zone) =>
    int o = f_localMins(time, zone)
    int c = f_localMins(time_close - 1, zone)
    int a = f_mins(f_hhmm(s, 0))
    int b = f_mins(f_hhmm(s, 5))
    bool sameDay = f_dateKey(time, zone) == f_dateKey(time_close - 1, zone)
    sameDay ? (o < b and c >= a) : (o < b or c >= a)
f_dayKey(int t) =>
    f_localMins(t, dayTZ) >= f_mins(dayReset) ? f_dateKey(t + 86400000, dayTZ) : f_dateKey(t, dayTZ)

if barstate.isfirst
    if not timeframe.isminutes or timeframe.in_seconds(htf) <= timeframe.in_seconds()
        runtime.error("MEKA: use a minute chart strictly below the selected trend timeframe.")
    if not chart.is_standard
        runtime.error("MEKA: use standard time-based candles (no Heikin Ashi / Renko / range).")
    if r2 <= r1 or (useTP3 and r3 <= r2) or maxStop < minStop or testEnd <= testStart
        runtime.error("MEKA: check target ordering (TP1 < TP2 < TP3), stop limits, and date range.")
    if not f_validSess(asia) or not f_validSess(london) or not f_validSess(ny) or not f_validSess(forceFlat) or not f_validSess(recur)
        runtime.error("MEKA: sessions must be same-day HHMM-HHMM windows with start < end.")
    if dayReset % 100 >= 60
        runtime.error("MEKA: trading-day reset must be a valid HHMM time.")

// ---- Gates that depend only on time / settings ---------------------------------------------
bool inAsia = useAsia and f_inside(asia, asiaTZ)
bool inLondon = useLondon and f_inside(london, londonTZ)
bool inNY = useNY and f_inside(ny, nyTZ)
bool inWindow = inAsia or inLondon or inNY
int minsLeft = math.max(inAsia ? f_left(asia, asiaTZ) : -1, inLondon ? f_left(london, londonTZ) : -1, inNY ? f_left(ny, nyTZ) : -1)
bool beforeCutoff = inWindow and minsLeft >= cutoffMin
string sessionText = (inAsia ? "Asia " : "") + (inLondon ? "London " : "") + (inNY ? "NY" : "")
bool inForceFlat = forceFlatOn and f_touches(forceFlat, dayTZ)
f_news(bool on, int t) => on and time < t + newsPost * 60000 and time_close > t - newsPre * 60000
bool newsBlocked = f_news(news1On, news1) or f_news(news2On, news2) or f_news(news3On, news3) or (recurOn and f_touches(recur, recurTZ))
bool inDates = time >= testStart and time_close < testEnd
bool entryGate = marketOK and beforeCutoff and not blockEntries and not newsBlocked and not inForceFlat and inDates

// ---- Trend / quality (confirmed HTF only: offset [1] with lookahead_on) ---------------------
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
atr = ta.atr(14)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
[hc, he, heOld] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[2]], lookahead=barmerge.lookahead_on)
bool trendLong = hc > he and he > heOld and emaFast > emaSlow
bool trendShort = hc < he and he < heOld and emaFast < emaSlow
vAvg = ta.sma(volume, 20)
bool volumeMissing = na(volume) or na(vAvg) or vAvg <= 0
bool volumeOK = not volumeRequired or (not volumeMissing and volume >= vAvg)
string volumeText = not volumeRequired ? "Volume filter OFF" : volumeMissing ? "Volume MISSING -> entries blocked" : "Volume filter ON"
bool qualityGate = not na(heOld) and not na(atr) and atr >= minAtrTicks * syminfo.mintick and adx >= minADX and math.abs(close - emaFast) <= maxExtension * atr and volumeOK

// ---- Structure: a pivot is usable only from its confirmation bar onward ---------------------
ph = ta.pivothigh(high, strength, strength)
pl = ta.pivotlow(low, strength, strength)
var float swingHigh = na
var float swingLow = na
var int highID = na       // origin bar of the pivot
var int lowID = na
var int highAvail = na    // bar on which the pivot became known
var int lowAvail = na
var int consumedHigh = na
var int consumedLow = na
float bosBuf = bosTicks * syminfo.mintick
// Uses the structure known BEFORE this bar; pivots confirmed on this bar are committed afterwards.
bool bosLong = not na(swingHigh) and close > swingHigh + bosBuf and close[1] <= swingHigh + bosBuf
bool bosShort = not na(swingLow) and close < swingLow - bosBuf and close[1] >= swingLow - bosBuf
bool pullLong = ta.crossover(close, emaFast) and low[1] <= emaFast[1] and close > open and trendLong
bool pullShort = ta.crossunder(close, emaFast) and high[1] >= emaFast[1] and close < open and trendShort

// ---- ICC setup state machine: IDLE(0) -> INDICATED(1) -> CORRECTED(2) -> READY event --------
// Each transition needs a strictly later closed bar. Frozen at indication: side, broken level,
// indication ATR, invalidation, consumed pivot. Continuation trigger is frozen at correction.
var int setupState = 0
var int setupSide = 0
var int indicationBar = na
var int correctionBar = na
var float brokenLevel = na
var float indicationATR = na
var float invalidation = na
var float correctionLow = na
var float correctionHigh = na
var float contTrigger = na
var string setupID = ""
var string setupEnd = "-"
int candidate = 0
float candidateStop = na
string candidateName = ""
string candidateSetup = ""
if barstate.isconfirmed
    if setupState != 0
        bool invalid = setupSide == 1 ? low <= invalidation or not trendLong : high >= invalidation or not trendShort
        bool expired = bar_index - indicationBar > expiry
        bool blocked = not inWindow or newsBlocked or blockEntries or inForceFlat
        if invalid or expired or blocked
            setupEnd := (invalid ? "INVALIDATED" : expired ? "EXPIRED" : "CANCELLED (window/news/block)") + " " + setupID
            setupState := 0
        else if setupState == 1 and bar_index > indicationBar
            bool revisit = low <= brokenLevel + retestPad * indicationATR and high >= brokenLevel - retestPad * indicationATR
            bool holdSide = setupSide == 1 ? close >= brokenLevel - retestPad * indicationATR : close <= brokenLevel + retestPad * indicationATR
            if revisit and holdSide
                correctionLow := low
                correctionHigh := high
                contTrigger := setupSide == 1 ? high : low
                correctionBar := bar_index
                setupState := 2
        else if setupState == 2 and bar_index > correctionBar
            // Trigger was saved on an earlier bar; this bar cannot move it.
            bool continuation = setupSide == 1 ? close > contTrigger + bosBuf and close > open : close < contTrigger - bosBuf and close < open
            if continuation
                candidate := setupSide
                // Stop beyond every correction-phase extreme, including this closed bar.
                candidateStop := setupSide == 1 ? math.min(correctionLow, low) - stopPad * indicationATR : math.max(correctionHigh, high) + stopPad * indicationATR
                candidateName := "ICC"
                candidateSetup := setupID
                setupEnd := "FIRED " + setupID
                setupState := 0
            else
                correctionLow := math.min(correctionLow, low)
                correctionHigh := math.max(correctionHigh, high)
    else if engine != "Trend pullback" and entryGate and qualityGate
        bool freshLong = na(consumedHigh) or highID != consumedHigh
        bool freshShort = na(consumedLow) or lowID != consumedLow
        if bosLong and trendLong and freshLong and close - open >= displace * atr[1]
            setupSide := 1
            brokenLevel := swingHigh
            invalidation := low - stopPad * atr[1]
            indicationATR := atr[1]
            indicationBar := bar_index
            consumedHigh := highID
            setupID := "L" + str.tostring(time_close)
            setupState := 1
        else if bosShort and trendShort and freshShort and open - close >= displace * atr[1]
            setupSide := -1
            brokenLevel := swingLow
            invalidation := high + stopPad * atr[1]
            indicationATR := atr[1]
            indicationBar := bar_index
            consumedLow := lowID
            setupID := "S" + str.tostring(time_close)
            setupState := 1
    if candidate == 0 and setupState == 0 and engine != "ICC"
        if pullLong
            candidate := 1
            candidateStop := math.min(low, low[1]) - stopPad * atr[1]
            candidateName := "Trend pullback"
            candidateSetup := "P" + str.tostring(time_close)
        else if pullShort
            candidate := -1
            candidateStop := math.max(high, high[1]) + stopPad * atr[1]
            candidateName := "Trend pullback"
            candidateSetup := "P" + str.tostring(time_close)
    if not na(ph)
        swingHigh := ph
        highID := bar_index - strength
        highAvail := bar_index
    if not na(pl)
        swingLow := pl
        lowID := bar_index - strength
        lowAvail := bar_index

// ---- Candidate validation (all on the signal bar's closed data) ------------------------------
f_floorTick(float x) => math.floor(x / syminfo.mintick + 1e-9) * syminfo.mintick
f_ceilTick(float x) => math.ceil(x / syminfo.mintick - 1e-9) * syminfo.mintick
f_qty(float distance) =>
    float raw = distance > 0 and marketOK ? account * riskPct / 100 / (distance * unitUSD) : 0.0
    math.floor(math.min(raw, maxQty) / qtyStep + 1e-9) * qtyStep
// Whole-unit tranches. Too few units for the scale-out -> one tranche at the final target.
f_parts(float q) =>
    int units = int(math.round(q / qtyStep))
    int need = useTP3 ? 3 : 2
    int u1 = units >= need ? int(math.floor(units * (useTP3 ? 0.4 : 0.5))) : 0
    int u2 = useTP3 and units >= need ? math.max(1, int(math.floor(units * 0.3))) : 0
    [u1 * qtyStep, u2 * qtyStep, (units - u1 - u2) * qtyStep]
float plannedStop = candidate == 1 ? f_floorTick(candidateStop) : candidate == -1 ? f_ceilTick(candidateStop) : na
float plannedRisk = candidate == 1 ? close - plannedStop : candidate == -1 ? plannedStop - close : na
bool stopOK = not na(plannedRisk) and plannedRisk >= math.max(minStop * atr, syminfo.mintick) and plannedRisk <= maxStop * atr
float plannedQty = stopOK ? f_qty(plannedRisk) : 0.0
float opposing = candidate == 1 ? swingHigh : swingLow
float room = candidate == 1 ? opposing - close : close - opposing
bool roomOK = not roomGate or na(opposing) or room <= 0 or room >= plannedRisk * r1 + syminfo.mintick
int signal = barstate.isconfirmed and entryGate and qualityGate and stopOK and roomOK and plannedQty >= qtyStep ? candidate : 0
string reason = not marketOK ? (profile == "Unknown" ? "Unknown market: choose family" : "Set USD unit value override") : not inDates ? "Outside test dates" : blockEntries ? "Emergency entry block" : newsBlocked ? "Manual news / exclusion block" : inForceFlat ? "Force-flat window" : not inWindow ? "Outside entry windows" : not beforeCutoff ? "Past latest-entry cutoff" : volumeRequired and volumeMissing ? "Volume required but missing" : not qualityGate ? "Trend / volatility / volume gate" : candidate != 0 and not stopOK ? "Rejected: stop distance" : candidate != 0 and not roomOK ? "Rejected: no room to TP1" : candidate != 0 and plannedQty < qtyStep ? "Rejected: risk below 1 unit" : setupState == 1 ? "ICC indicated: wait correction" : setupState == 2 ? "ICC corrected: wait continuation" : "Wait for setup"
string setupText = setupState == 1 ? "INDICATED " + (setupSide == 1 ? "L " : "S ") + setupID : setupState == 2 ? "CORRECTED " + (setupSide == 1 ? "L " : "S ") + setupID : "IDLE | last: " + setupEnd
// COMMON SIGNAL ENGINE END
