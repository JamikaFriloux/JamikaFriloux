// SHARED DISPLAY BEGIN
// Main state: WAIT / ENTER / HOLD / TP / EXIT. Each event label lasts exactly its event bar.
// Priority when several happen on one bar: EXIT > TP > ENTER > HOLD > WAIT. All events of the bar
// are kept in the "Last events" history row.
bool activeView = side != 0
plot(emaFast, "EMA20", color=color.aqua)
plot(emaSlow, "EMA50", color=color.orange)
plot(showLevels and activeView ? refEntry : na, "Signal reference (not a fill)", color=color.yellow, style=plot.style_linebr)
plot(showLevels and activeView and not pending ? fillEntry : na, "Fill (simulated or emulator)", color=color.white, style=plot.style_linebr)
plot(showLevels and activeView ? curStop : na, "Protective stop", color=color.red, style=plot.style_linebr)
plot(showLevels and activeView and part1 > 0 and not done1 ? target1 : na, "TP1", color=color.lime, style=plot.style_linebr)
plot(showLevels and activeView and (useTP3 ? part2 > 0 and not done2 : not doneFinal) ? target2 : na, "TP2", color=color.green, style=plot.style_linebr)
plot(showLevels and activeView and useTP3 and not doneFinal ? target3 : na, "TP3", color=color.teal, style=plot.style_linebr)
plotshape(entered and side == 1, title="Long intent", text="ENTER", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(entered and side == -1, title="Short intent", text="ENTER", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)
plotshape(tpEvent and not exited, title="Partial target", text="TP", style=shape.diamond, location=location.abovebar, color=color.teal, size=size.tiny)
plotshape(exited, title="Full exit", text="EXIT", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny)
// Data Window parity outputs: compare these bar by bar between indicator and strategy.
plot(signal, "Raw eligible candidate direction", display=display.data_window)
plot(candidate, "Raw candidate before gates", display=display.data_window)
plot(setupState, "ICC setup state (0 idle, 1 indicated, 2 corrected)", display=display.data_window)

var table dash = showDash ? table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 60)) : na
if barstate.islast and showDash
    color stateColor = status == "EXIT" ? color.orange : status == "TP" ? color.teal : status == "ENTER" ? color.blue : status == "HOLD" ? color.green : color.gray
    string dirText = side == 1 ? "LONG" : side == -1 ? "SHORT" : "FLAT"
    string jpyText = profile == "JPY" and side != 0 ? (jpyPerUsdQuote ? " = long " + (side == 1 ? "JPY (USDJPY-equiv SHORT)" : "USD (USDJPY-equiv LONG)") : " = long " + (side == 1 ? "USD vs JPY" : "JPY vs USD")) : ""
    string fillText = not activeView ? "-" : str.tostring(refEntry, format.mintick) + " / " + (pending ? "pending" : str.tostring(fillEntry, format.mintick)) + (na(fillRiskRatio) ? "" : " | fill risk " + str.tostring(fillRiskRatio, "#.##") + "x plan")
    string tpText = not activeView ? "-" : (part1 > 0 ? str.tostring(target1, format.mintick) + (done1 ? " done" : "") : "skip") + " / " + (useTP3 and part2 == 0 ? "skip" : str.tostring(target2, format.mintick)) + (useTP3 ? " / " + str.tostring(target3, format.mintick) : "")
    int newsCount = (news1On ? 1 : 0) + (news2On ? 1 : 0) + (news3On ? 1 : 0)
    table.cell(dash, 0, 0, "MEKA " + VERSION + " RESEARCH - UNCALIBRATED", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, status, text_color=color.white, bgcolor=stateColor, text_size=size.normal)
    table.cell(dash, 0, 1, profile + " / " + mode + " / " + engine, text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, dirText + jpyText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, sessionText == "" ? "No entry window" : sessionText, text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, detail, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "Setup state", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, setupText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Reference / fill", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, fillText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Stop initial / now", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, activeView ? str.tostring(initialStop, format.mintick) + " / " + str.tostring(curStop, format.mintick) : "-", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "TP1 / TP2" + (useTP3 ? " / TP3" : ""), text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, tpText, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "Units initial / remaining", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, (activeView ? str.tostring(initialQty) + " / " + str.tostring(remaining) + " " : "") + posState, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Trading day (" + resultLabel + ")", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(dayR, "#.##") + "R | entries " + str.tostring(dayEntries) + " | loss streak " + str.tostring(lossStreak) + (execBlock != "" ? " | BLOCK: " + execBlock : ""), text_color=execBlock != "" ? color.orange : color.white, text_size=size.small)
    table.cell(dash, 0, 9, "Execution", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, executionLabel, text_color=color.yellow, text_size=size.small)
    table.cell(dash, 0, 10, "News / blocks", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 10, (newsBlocked ? "BLOCKED now" : "clear") + " | " + str.tostring(newsCount) + " manual event(s)" + (recurOn ? " + daily exclusion" : "") + " | NO calendar feed", text_color=newsBlocked ? color.orange : color.yellow, text_size=size.small)
    table.cell(dash, 0, 11, "Tick / USD per unit / step", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(syminfo.mintick) + " / " + (na(unitUSD) ? "UNKNOWN" : str.tostring(unitUSD, "#.######")) + " (" + unitSource + ") / " + str.tostring(qtyStep), text_color=marketOK ? color.white : color.orange, text_size=size.small)
    table.cell(dash, 0, 12, "Volume", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 12, volumeText, text_color=volumeRequired and volumeMissing ? color.orange : color.white, text_size=size.small)
    table.cell(dash, 0, 13, "Last events", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 13, array.size(eventLog) == 0 ? "-" : array.join(eventLog, "\n"), text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
// SHARED DISPLAY END
