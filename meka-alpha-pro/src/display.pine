// SHARED DISPLAY BEGIN
// ---- Status: one instruction per candle. Priority: EXIT > TAKE PROFIT > ENTER > HOLD > NO TRADE >
// WATCH > WAIT. Every event status lasts exactly the candle it happened on.
string sideName = side == 1 ? "long" : "short"
string status = exited or earlyNow ? "EXIT" : tpEvent ? "TAKE PROFIT" : side != 0 and pending ? (side == 1 ? "ENTER LONG" : "ENTER SHORT") : side != 0 ? "HOLD" : noTradeText != "" or execBlock != "" ? "NO TRADE" : setupState != 0 ? (setupSide == 1 ? "WATCH LONG" : "WATCH SHORT") : "WAIT"
string doneWord = basisWord == "simulated" ? "filled (simulated)" : "filled"
f_tpState(float part, bool done, bool touched) => part <= 0 ? "not used at this size" : done ? doneWord : touched ? "touched, not filled" : "open"
string nextTarget = part1 > 0 and not done1 ? "TP1 " + f_px(target1) : part2 > 0 and not done2 ? "TP2 " + f_px(target2) : part3 > 0 and not done3 ? "TP3 " + f_px(target3) : "-"
string tpList = (evTP1 ? "TP1 " : "") + (evTP2 ? "TP2 " : "") + (evTP3 ? "TP3 " : "")
string actionText = exited ? "Position closed. Wait for the next setup." : earlyNow ? "Close the " + sideName + " at the next open." : tpEvent ? "Take profit: " + str.trim(tpList) + " " + doneWord + ". Hold the remaining " + str.tostring(remaining) + " with the stop at " + f_px(curStop) + "." : side != 0 and pending ? (entered ? (isLimit ? "Place a " + (side == 1 ? "buy" : "sell") + " limit at " + f_px(refEntry) + " (valid " + str.tostring(limitBars) + " candles) with the stop and targets below." : (side == 1 ? "Buy" : "Sell") + " at the next open (about " + f_px(refEntry) + ") with the stop and targets below.") : (side == 1 ? "Buy" : "Sell") + " limit at " + f_px(refEntry) + " is working (" + str.tostring(math.max(0, limitBars - (bar_index - submittedBar))) + " candles left).") : side != 0 ? (closing ? "Exit requested - closing at the next open." : "Hold the " + sideName + ". Next target " + nextTarget + ".") : status == "NO TRADE" ? "Stand aside." : setupState != 0 ? (setupSide == 1 ? "Get ready to buy." : "Get ready to sell.") : "Do nothing yet."
string reasonText = exited ? lastExitText : earlyNow ? closingWhy : side != 0 ? (evFill ? (side == 1 ? "Long" : "Short") + " filled at " + f_px(fillEntry) + (fillRiskRatio > 1.05 ? " (gap: risk " + str.tostring(fillRiskRatio, "#.#") + "x planned)" : "") + "." : tradeName + " setup. Stop " + f_px(curStop) + (curStop != initialStop ? " (moved from " + f_px(initialStop) + ")" : "") + ".") : cancelNow ? cancelText : execBlock != "" ? execBlock : noTradeText != "" ? noTradeText : setupState != 0 ? watchText : rejectText != "" ? rejectText : setupCanceled ? setupEndText : waitText
string setupLine = side != 0 ? tradeName : setupState == 1 ? "ICC: break confirmed, waiting for pullback" : setupState == 2 ? "ICC: pullback done, waiting for trigger" : framework == "ICC hybrid" ? "No active setup" : framework
string tradeLine = side == 0 ? "Flat" : pending ? "Order working" : (side == 1 ? "Long" : "Short") + " open: " + str.tostring(remaining) + " of " + str.tostring(initialQty) + " units left"

// ---- Palette: restrained, dark-chart friendly. Context is faint; the trade is prominent. --------
color cBg = color.rgb(13, 17, 28)
color cHead = color.rgb(22, 29, 46)
color cTxt = color.rgb(226, 232, 240)
color cMute = color.rgb(148, 163, 184)
color cUp = color.rgb(34, 197, 94)
color cDn = color.rgb(239, 68, 68)
color cAmber = color.rgb(245, 158, 11)
color cBlue = color.rgb(96, 165, 250)
color cGray = color.rgb(100, 116, 139)
color cTeal = color.rgb(20, 184, 166)
color statusColor = str.contains(status, "LONG") and not str.contains(status, "WATCH") ? cUp : str.contains(status, "SHORT") and not str.contains(status, "WATCH") ? cDn : status == "HOLD" ? cBlue : status == "TAKE PROFIT" ? cTeal : status == "EXIT" ? cAmber : str.contains(status, "WATCH") ? color.rgb(202, 138, 4) : status == "NO TRADE" ? color.rgb(127, 29, 29) : cGray
bool detailed = viewMode == "Detailed"

// ---- Context lines (Detailed only, faint so candles stay readable) -------------------------------
plot(detailed ? emaFast : na, "EMA 20", color=color.new(cBlue, 70))
plot(detailed ? emaSlow : na, "EMA 50", color=color.new(cAmber, 75))
plot(detailed and vwapReq ? vwapVal : na, "VWAP", color=color.new(color.white, 75))
bool sl = detailed and showSessLv
plot(sl ? sAsia.lastHi : na, "Prior Asia high", color=color.new(cMute, 70), style=plot.style_stepline)
plot(sl ? sAsia.lastLo : na, "Prior Asia low", color=color.new(cMute, 70), style=plot.style_stepline)
plot(sl ? sLondon.lastHi : na, "Prior London high", color=color.new(cBlue, 70), style=plot.style_stepline)
plot(sl ? sLondon.lastLo : na, "Prior London low", color=color.new(cBlue, 70), style=plot.style_stepline)
plot(sl ? sNY.lastHi : na, "Prior New York high", color=color.new(cAmber, 70), style=plot.style_stepline)
plot(sl ? sNY.lastLo : na, "Prior New York low", color=color.new(cAmber, 70), style=plot.style_stepline)
// Data Window outputs for indicator-vs-strategy parity checks.
plot(signal, "Signal (+1 long, -1 short)", display=display.data_window)
plot(candidate, "Candidate before filters", display=display.data_window)
plot(setupState, "ICC stage (0 idle, 1 indicated, 2 corrected)", display=display.data_window)

// ---- Detailed: confirmed structure, sweeps and ICC zones, capped to the most recent ones ------------
var array<line> markLines = array.new<line>()
var array<label> markLabels = array.new<label>()
var array<box> zoneBoxes = array.new<box>()
f_keepLines(array<line> a, int n) =>
    while array.size(a) > n
        line.delete(array.shift(a))
    true
f_keepLabels(array<label> a, int n) =>
    while array.size(a) > n
        label.delete(array.shift(a))
    true
f_keepBoxes(array<box> a, int n) =>
    while array.size(a) > n
        box.delete(array.shift(a))
    true
if barstate.isconfirmed and detailed
    // A break is drawn on the candle that CLOSED through the level, from the swing it broke.
    if breakUp
        array.push(markLines, line.new(breakUpOrigin, breakUpLevel, bar_index, breakUpLevel, color=color.new(cUp, 45), style=line.style_dotted, width=1))
        array.push(markLabels, label.new(bar_index, breakUpLevel, chochUp ? "CHoCH" : "BOS", style=label.style_label_lower_left, color=color.new(cBg, 100), textcolor=color.new(cUp, 15), size=size.tiny))
    if breakDn
        array.push(markLines, line.new(breakDnOrigin, breakDnLevel, bar_index, breakDnLevel, color=color.new(cDn, 45), style=line.style_dotted, width=1))
        array.push(markLabels, label.new(bar_index, breakDnLevel, chochDn ? "CHoCH" : "BOS", style=label.style_label_upper_left, color=color.new(cBg, 100), textcolor=color.new(cDn, 15), size=size.tiny))
    if sweepLow
        array.push(markLabels, label.new(bar_index, low, "sweep", style=label.style_label_up, color=color.new(cBg, 100), textcolor=color.new(cUp, 30), size=size.tiny))
    if sweepHigh
        array.push(markLabels, label.new(bar_index, high, "sweep", style=label.style_label_down, color=color.new(cBg, 100), textcolor=color.new(cDn, 30), size=size.tiny))
    f_keepLines(markLines, maxMarks)
    f_keepLabels(markLabels, maxMarks * 2)

// ICC pullback zone: drawn from the indication candle while the setup is alive; last 3 kept.
var box zoneBox = na
float dLeg = math.abs(impExt - impOrigin)
float dTop = setupSide == 1 ? (useFib ? impExt - fibShallow * dLeg : brokenLevel + retestPad * indATR) : (useFib ? impExt + fibDeep * dLeg : brokenLevel + retestPad * indATR)
float dBot = setupSide == 1 ? (useFib ? impExt - fibDeep * dLeg : brokenLevel - retestPad * indATR) : (useFib ? impExt + fibShallow * dLeg : brokenLevel - retestPad * indATR)
if barstate.isconfirmed and detailed
    if setupFormed
        zoneBox := box.new(indBar, dTop, bar_index + 1, dBot, border_color=color.new(setupSide == 1 ? cUp : cDn, 75), bgcolor=color.new(setupSide == 1 ? cUp : cDn, 93), text="ICC zone", text_color=color.new(cMute, 20), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
        array.push(zoneBoxes, zoneBox)
        f_keepBoxes(zoneBoxes, 3)
    else if setupState != 0 and not na(zoneBox)
        box.set_right(zoneBox, bar_index + 1)
        if setupState == 1
            box.set_top(zoneBox, dTop)
            box.set_bottom(zoneBox, dBot)
    else if prevState != 0 and setupState == 0 and not na(zoneBox)
        box.set_right(zoneBox, bar_index)
        zoneBox := na

// Opening range of the active session (Detailed + session levels on).
var box orBox = na
if barstate.isconfirmed and sl and not na(sMain)
    if sMain.startBar == bar_index or na(orBox)
        orBox := box.new(sMain.startBar, sMain.orHi, bar_index, sMain.orLo, border_color=color.new(cMute, 70), bgcolor=color.new(cMute, 95), text="opening range", text_color=color.new(cMute, 40), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
    else
        box.set_top(orBox, sMain.orHi)
        box.set_bottom(orBox, sMain.orLo)
        box.set_right(orBox, sMain.orDone ? sMain.orEndBar : bar_index)
if barstate.isconfirmed and na(sMain)
    orBox := na

// ---- Trade markers (both views) -------------------------------------------------------------------
if entered
    label.new(bar_index, side == 1 ? low : high, side == 1 ? "BUY" : "SELL", style=side == 1 ? label.style_label_up : label.style_label_down, color=side == 1 ? cUp : cDn, textcolor=color.white, size=size.normal)
if evFill and isLimit
    label.new(bar_index, fillEntry, "filled", style=label.style_label_left, color=color.new(cBg, 100), textcolor=cTxt, size=size.tiny)
if tpEvent and not exited
    label.new(bar_index, evSide == 1 ? high : low, str.trim(tpList), style=evSide == 1 ? label.style_label_down : label.style_label_up, color=cTeal, textcolor=color.white, size=size.small)
if exited or earlyNow
    label.new(bar_index, evSide == 1 ? high : low, evStopHit ? "STOP" : earlyNow ? "EXIT" : "DONE", style=evSide == 1 ? label.style_label_down : label.style_label_up, color=evStopHit ? cDn : cAmber, textcolor=color.white, size=size.small)

// ---- Active trade levels: risk / reward shading, bold entry and stop, readable target tags --------
var line lnE = na
var line lnS = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
var box bxRisk = na
var box bxReward = na
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lb3 = na
var float drawnStop = na
var array<line> oldLines = array.new<line>()
var array<box> oldBoxes = array.new<box>()
f_tag(label l, float y, string txt, color bg) =>
    label lab = l
    if na(y)
        if not na(lab)
            label.delete(lab)
        lab := na
    else if na(lab)
        lab := label.new(bar_index + 2, y, txt, style=label.style_label_left, color=bg, textcolor=color.white, size=size.normal)
    else
        label.set_xy(lab, bar_index + 2, y)
        label.set_text(lab, txt)
        label.set_color(lab, bg)
    lab
float finalTarget = use3 and part3 > 0 ? target3 : target2
if barstate.isconfirmed
    if entered
        bxRisk := box.new(bar_index, math.max(refEntry, curStop), bar_index + 1, math.min(refEntry, curStop), border_color=color.new(cDn, 100), bgcolor=color.new(cDn, 90))
        bxReward := box.new(bar_index, math.max(refEntry, finalTarget), bar_index + 1, math.min(refEntry, finalTarget), border_color=color.new(cUp, 100), bgcolor=color.new(cUp, 92))
        lnE := line.new(bar_index, refEntry, bar_index + 1, refEntry, color=color.new(cTxt, 10), width=2)
        lnS := line.new(bar_index, curStop, bar_index + 1, curStop, color=cDn, width=3)
        ln1 := part1 > 0 ? line.new(bar_index, target1, bar_index + 1, target1, color=cUp, style=line.style_dashed, width=2) : na
        ln2 := line.new(bar_index, target2, bar_index + 1, target2, color=cUp, style=line.style_dashed, width=2)
        ln3 := use3 and part3 > 0 ? line.new(bar_index, target3, bar_index + 1, target3, color=cUp, style=line.style_dashed, width=2) : na
        drawnStop := curStop
    else if side != 0
        if not pending and not na(fillEntry) and not na(lnE) and line.get_y1(lnE) != fillEntry
            // Show the actual (simulated / emulator) fill once it is known.
            line.set_y1(lnE, fillEntry)
            line.set_y2(lnE, fillEntry)
            box.set_top(bxRisk, math.max(fillEntry, curStop))
            box.set_bottom(bxRisk, math.min(fillEntry, curStop))
            box.set_top(bxReward, math.max(fillEntry, finalTarget))
            box.set_bottom(bxReward, math.min(fillEntry, finalTarget))
        if curStop != drawnStop
            // Stop moved (break-even / trail): end the old segment, start a new one.
            line.set_x2(lnS, bar_index)
            line.set_color(lnS, color.new(cDn, 60))
            array.push(oldLines, lnS)
            lnS := line.new(bar_index, curStop, bar_index + 1, curStop, color=cDn, width=3)
            float eLvl = na(fillEntry) ? refEntry : fillEntry
            box.set_top(bxRisk, math.max(eLvl, curStop))
            box.set_bottom(bxRisk, math.min(eLvl, curStop))
            drawnStop := curStop
        for l in array.from(lnE, lnS, ln1, ln2, ln3)
            if not na(l)
                line.set_x2(l, bar_index + 1)
        box.set_right(bxRisk, bar_index + 1)
        box.set_right(bxReward, bar_index + 1)
        if done1 and not na(ln1)
            line.set_style(ln1, line.style_dotted)
            line.set_color(ln1, color.new(cUp, 55))
        if done2 and not na(ln2)
            line.set_style(ln2, line.style_dotted)
            line.set_color(ln2, color.new(cUp, 55))
    else if exited or cancelNow
        for l in array.from(lnE, lnS, ln1, ln2, ln3)
            if not na(l)
                line.set_x2(l, bar_index)
                line.set_color(l, color.new(line.get_color(l), 60))
        box.set_right(bxRisk, bar_index)
        box.set_right(bxReward, bar_index)
        box.set_bgcolor(bxRisk, color.new(cDn, 95))
        box.set_bgcolor(bxReward, color.new(cUp, 96))
        // Detailed keeps the last few finished trades (faded); Clean removes them completely.
        for l in array.from(lnE, lnS, ln1, ln2, ln3)
            if not na(l)
                array.push(oldLines, l)
        for b in array.from(bxRisk, bxReward)
            if not na(b)
                array.push(oldBoxes, b)
        f_keepLines(oldLines, detailed ? 25 : 0)
        f_keepBoxes(oldBoxes, detailed ? 10 : 0)
        lnE := na
        lnS := na
        ln1 := na
        ln2 := na
        ln3 := na
        bxRisk := na
        bxReward := na
bool showTags = side != 0
lbE := f_tag(lbE, showTags ? (pending ? refEntry : fillEntry) : na, (pending ? "ENTRY ORDER  " : "ENTRY  ") + f_px(pending ? refEntry : fillEntry), cGray)
lbS := f_tag(lbS, showTags ? curStop : na, "STOP  " + f_px(curStop), cDn)
lb1 := f_tag(lb1, showTags and part1 > 0 ? target1 : na, "TP1  " + f_px(target1) + (done1 ? "  ✓" : ""), done1 ? color.new(cUp, 50) : color.rgb(21, 128, 61))
lb2 := f_tag(lb2, showTags and part2 > 0 ? target2 : na, "TP2  " + f_px(target2) + (done2 ? "  ✓" : ""), done2 ? color.new(cUp, 50) : color.rgb(21, 128, 61))
lb3 := f_tag(lb3, showTags and use3 and part3 > 0 ? target3 : na, "TP3  " + f_px(target3) + (done3 ? "  ✓" : ""), done3 ? color.new(cUp, 50) : color.rgb(21, 128, 61))

// ---- Dashboard: the instruction first, its explanation second, technical details last -------------
f_wrap(string txt, int w) =>
    string out = ""
    int len = 0
    for wd in str.split(txt, " ")
        int n = str.length(wd)
        if len > 0 and len + 1 + n > w
            out += "\n" + wd
            len := n
        else
            out += (len > 0 ? " " : "") + wd
            len += (len > 0 ? 1 : 0) + n
    out
dashPos = dashPosIn == "Top left" ? position.top_left : dashPosIn == "Bottom right" ? position.bottom_right : dashPosIn == "Bottom left" ? position.bottom_left : position.top_right
tMain = dashSizeIn == "Small" ? size.small : dashSizeIn == "Large" ? size.large : size.normal
tBig = dashSizeIn == "Small" ? size.normal : dashSizeIn == "Large" ? size.huge : size.large
tSub = dashSizeIn == "Large" ? size.normal : size.small
var table dash = table.new(dashPos, 2, 20, bgcolor=cBg, frame_color=cHead, frame_width=1, border_color=cBg, border_width=2)
f_row(int r, string k, string v, color vc, string sz) =>
    table.cell(dash, 0, r, k, text_color=cMute, text_size=sz, text_halign=text.align_left, bgcolor=cBg)
    table.cell(dash, 1, r, v, text_color=vc, text_size=sz, text_halign=text.align_left, bgcolor=cBg)
    r + 1
if barstate.islast
    table.clear(dash, 0, 0, 1, 19)
    // 1) What to do.
    table.cell(dash, 0, 0, status, text_color=color.white, text_size=tBig, bgcolor=statusColor)
    table.cell(dash, 1, 0, fam + " · " + mode + " · " + timeframe.period + "m", text_color=cMute, text_size=tSub, text_halign=text.align_right, bgcolor=cHead)
    int r = 1
    r := f_row(r, "NEXT", f_wrap(actionText, 44), color.white, tMain)
    r := f_row(r, status == "EXIT" ? "WHY" : side != 0 ? "NOTE" : "MISSING", f_wrap(reasonText, 48), status == "NO TRADE" ? color.rgb(252, 165, 165) : cTxt, tSub)
    // 2) The trade.
    if side != 0
        r := f_row(r, pending ? "Entry order" : "Entry", f_px(pending ? refEntry : fillEntry), cTxt, tMain)
        r := f_row(r, "Stop", f_px(curStop) + (curStop != initialStop ? "  (moved from " + f_px(initialStop) + ")" : ""), cDn, tMain)
        r := f_row(r, "TP1", part1 > 0 ? f_px(target1) + "  ·  " + f_tpState(part1, done1, touched1) : "not used at this size", cUp, tMain)
        r := f_row(r, "TP2", f_px(target2) + "  ·  " + f_tpState(part2, done2, touched2), cUp, tMain)
        if use3
            r := f_row(r, "TP3", f_px(target3) + "  ·  " + f_tpState(part3, done3, touched3), cUp, tMain)
        r := f_row(r, "Risk · size", "$" + str.tostring(plannedCash, "#,###.##") + "  ·  " + str.tostring(initialQty) + " units  ·  " + str.tostring(remaining) + " open", cTxt, tSub)
    else
        r := f_row(r, "Risk per trade", "$" + str.tostring(account * riskPct / 100, "#,###.##") + " (" + str.tostring(riskPct) + "% of $" + str.tostring(account, "#,###") + ")", cMute, tSub)
    // 3) Background (Detailed view).
    if detailed
        r := f_row(r, "Bias", biasText + " (" + biasDetail + ")", htfBias == 1 ? cUp : htfBias == -1 ? cDn : cMute, tSub)
        r := f_row(r, "Setup", setupLine, cMute, tSub)
        r := f_row(r, "Session", sessName + (not na(sMain) ? (sMain.orDone ? " · opening range set" : " · opening range forming") : ""), cMute, tSub)
        r := f_row(r, "Trade", tradeLine, cMute, tSub)
        r := f_row(r, "Filters", filterText, cMute, tSub)
        r := f_row(r, "Mode", mode + " · confirms on " + f_tfName(tf1) + (useTF2 ? " + " + f_tfName(tf2) : "") + " · " + framework, cMute, tSub)

// ---- Performance table (OFF by default; complete positions, after modeled costs) ------------------
statsPos = statsPosIn == "Bottom right" ? position.bottom_right : statsPosIn == "Top left" ? position.top_left : statsPosIn == "Top right" ? position.top_right : position.bottom_left
var table perf = table.new(statsPos, 9, NG + 3, bgcolor=cBg, frame_color=cHead, frame_width=1, border_color=cHead, border_width=1)
var array<string> grpNames = array.from("All trades", "Long", "Short", "Asia", "London", "New York", "Long · Asia", "Long · London", "Long · New York", "Short · Asia", "Short · London", "Short · New York", "Trending (ADX 25+)", "Ranging", "High volatility", "Normal volatility", "Development (in-sample)", "Validation", "Holdout")
// 95% Wilson interval for the win rate: with few trades the true rate is very uncertain.
f_wilson(float w, float n) =>
    float z = 1.96
    float p = w / n
    float c = (p + z * z / (2 * n)) / (1 + z * z / n)
    float h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)
    str.tostring(math.max(0, c - h) * 100, "#") + "-" + str.tostring(math.min(1, c + h) * 100, "#") + "%"
if barstate.islast and showStats
    table.clear(perf, 0, 0, 8, NG + 2)
    table.cell(perf, 0, 0, "Measured performance (" + basisWord + ", after modeled costs)", text_color=cTxt, text_size=size.small, text_halign=text.align_left, bgcolor=cHead)
    table.cell(perf, 1, 0, fam + " · " + mode + " · " + framework + " · " + timeframe.period + "m", text_color=cMute, text_size=size.small, text_halign=text.align_left, bgcolor=cHead)
    array<string> heads = array.from("Group", "Trades", "Win rate (95% range)", "Avg win", "Avg loss", "Profit factor", "Expectancy", "Max drawdown", "Net USD")
    for c = 0 to 8
        table.cell(perf, c, 1, array.get(heads, c), text_color=cMute, text_size=size.small, bgcolor=cBg)
    for g = 0 to NG - 1
        float n = array.get(stN, g)
        float w = array.get(stW, g)
        float gl = array.get(stGL, g)
        string pf = n == 0 ? "-" : gl == 0 ? (array.get(stGW, g) > 0 ? "no losses" : "-") : str.tostring(array.get(stGW, g) / gl, "#.##")
        table.cell(perf, 0, g + 2, array.get(grpNames, g), text_color=g >= 16 ? cBlue : cTxt, text_size=size.small, text_halign=text.align_left, bgcolor=cBg)
        table.cell(perf, 1, g + 2, str.tostring(n, "#"), text_color=n < 30 ? cAmber : cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 2, g + 2, n == 0 ? "-" : str.tostring(w / n * 100, "#") + "% (" + f_wilson(w, n) + ")", text_color=cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 3, g + 2, w == 0 ? "-" : "+" + str.tostring(array.get(stSW, g) / w, "#.##") + "R", text_color=cUp, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 4, g + 2, n - w == 0 ? "-" : "-" + str.tostring(array.get(stSL, g) / (n - w), "#.##") + "R", text_color=cDn, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 5, g + 2, pf, text_color=cTxt, text_size=size.small, bgcolor=cBg)
        float ex = n == 0 ? na : (array.get(stSW, g) - array.get(stSL, g)) / n
        table.cell(perf, 6, g + 2, na(ex) ? "-" : (ex >= 0 ? "+" : "") + str.tostring(ex, "#.##") + "R", text_color=na(ex) ? cMute : ex >= 0 ? cUp : cDn, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 7, g + 2, n == 0 ? "-" : str.tostring(array.get(stDD, g), "#.##") + "R", text_color=cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 8, g + 2, n == 0 ? "-" : str.tostring(array.get(stNet, g), "#,###.##"), text_color=array.get(stNet, g) >= 0 ? cUp : cDn, text_size=size.small, bgcolor=cBg)
    table.cell(perf, 0, NG + 2, "Settings fingerprint " + fingerprint + " · targets touched/" + doneWord + ": TP1 " + str.tostring(array.get(tpTouch, 0)) + "/" + str.tostring(array.get(tpFill, 0)) + " · TP2 " + str.tostring(array.get(tpTouch, 1)) + "/" + str.tostring(array.get(tpFill, 1)) + (use3 ? " · TP3 " + str.tostring(array.get(tpTouch, 2)) + "/" + str.tostring(array.get(tpFill, 2)) : "") + (basisWord == "simulated" ? " · same-candle stop/target " + str.tostring(ambiguousBars) : "") + " · amber = under 30 trades · Holdout counts as untouched only if settings were frozen before it was viewed", text_color=cMute, text_size=size.tiny, text_halign=text.align_left, bgcolor=cBg)
// SHARED DISPLAY END
