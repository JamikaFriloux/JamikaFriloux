//@version=6
indicator("MEKA ALPHA PRO 4.0", shorttitle="MEKA 4.0", overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500, max_boxes_count=200)
// MEKA ALPHA PRO 4.0 - private trading assistant (indicator). Signals use closed bars only.
// The position shown is a SIMULATION with assumed fills and modeled costs - not a broker record.
// No win rate or profitability is claimed; measure it with the companion strategy.
// Generated by tools/build.py from src/*.pine - edit the sources, then rebuild.

// COMMON SIGNAL ENGINE BEGIN
// Everything between the BEGIN/END markers is byte-identical in the indicator and the strategy
// (enforced by tools/build.py), so both scripts always produce the same raw signals.
// All decisions are taken on CLOSED bars only. Higher-timeframe data is the previous completed
// higher-timeframe bar ([1] offset + lookahead_on), never the forming one.
const string VERSION = "4.0"

gQuick = "1 · Quick setup"
gRisk = "2 · Risk & targets"
gMgmt = "3 · Trade management"
gExec = "4 · Entry execution & costs"
gSess = "5 · Sessions"
gNews = "6 · News, daily limits & test dates"
gCustom = "7 · Custom thresholds (only when presets are off)"
gVis = "8 · Display"

marketIn = input.string("Auto", "Market", options=["Auto", "Gold", "Nasdaq-100", "S&P 500", "EUR/USD", "USD/JPY"], group=gQuick)
mode = input.string("SCALP", "Trading mode", options=["SCALP", "DAY TRADE"], group=gQuick, tooltip="SCALP: 1-5 minute charts, confirmation on 15m + 1H. DAY TRADE: 5-15 minute charts, confirmation on 1H + 4H.")
framework = input.string("ICC hybrid", "Strategy logic", options=["ICC hybrid", "Trend pullback (baseline)", "Breakout (baseline)"], group=gQuick, tooltip="The two baselines exist so the ICC hybrid can be compared against simpler rules under identical costs and dates.")
viewMode = input.string("Clean", "Chart view", options=["Clean", "Detailed"], group=gQuick)
usePreset = input.bool(true, "Use market preset thresholds", group=gQuick, tooltip="Preset values are research starting points, NOT validated settings. Turn off to use group 7.")
usePresetSess = input.bool(true, "Use market preset sessions", group=gQuick)

account = input.float(10000, "Account size (USD)", minval=1, group=gRisk)
riskPct = input.float(0.5, "Risk per trade (% of account)", minval=0.01, maxval=5, group=gRisk)
targetsIn = input.string("TP1 + TP2", "Targets", options=["TP1 + TP2", "TP1 + TP2 + TP3"], group=gRisk)
r1 = input.float(1.0, "TP1 (R multiple)", minval=0.1, group=gRisk)
r2 = input.float(2.0, "TP2 (R multiple)", minval=0.2, group=gRisk)
r3 = input.float(3.0, "TP3 (R multiple)", minval=0.3, group=gRisk)
alloc2 = input.int(50, "Two targets: % closed at TP1 (rest at TP2)", minval=1, maxval=99, group=gRisk)
alloc3a = input.int(50, "Three targets: % closed at TP1", minval=1, maxval=98, group=gRisk)
alloc3b = input.int(30, "Three targets: % closed at TP2 (rest at TP3)", minval=1, maxval=98, group=gRisk)
maxQty = input.float(100000, "Maximum position size (units)", minval=1, group=gRisk)
unitValueIn = input.float(0, "USD per 1.0 price move per unit (0 = automatic)", minval=0, group=gRisk, tooltip="Automatic: USD-quoted symbols use the symbol point value; USD-base symbols such as USDJPY use point value / price. Anything else must be entered here.")
qtyStepIn = input.float(1, "Position size step (non-futures)", minval=0.000001, group=gRisk, tooltip="Futures always trade whole contracts. For spot / CFD use your broker's minimum lot step in units.")
roomGate = input.bool(true, "Require room to TP1 before the next opposing swing", group=gRisk)

stopMethod = input.string("Structure", "Stop placement", options=["Structure", "ATR", "Wider of both"], group=gMgmt)
atrStopMult = input.float(1.5, "ATR stop distance (ATR)", minval=0.2, group=gMgmt)
beOn = input.bool(false, "Move stop to entry after TP1 is reached", group=gMgmt, tooltip="Off by default on purpose. Run the strategy with this on and off over the same out-of-sample dates and keep it only if it measurably helps.")
trailMode = input.string("Off", "Trailing stop (after TP1)", options=["Off", "ATR", "Swing structure"], group=gMgmt)
trailATR = input.float(2.0, "ATR trail distance (ATR)", minval=0.2, group=gMgmt)
exitOnChoch = input.bool(true, "Early exit when structure breaks against the trade", group=gMgmt)
exitOnBias = input.bool(false, "Early exit when the higher-timeframe bias flips", group=gMgmt)
gapMaxRisk = input.float(1.5, "Exit if actual fill risk exceeds planned risk by (x, 0 = off)", minval=0, group=gMgmt)

entryType = input.string("Market at next open", "Entry order", options=["Market at next open", "Limit at breakout retest"], group=gExec)
limitBars = input.int(3, "Limit order valid for (bars)", minval=1, maxval=20, group=gExec)
fillTicks = input.int(1, "Limit fill requires trading through by (ticks)", minval=0, maxval=10, group=gExec, tooltip="Keep equal to the strategy property 'Verify price for limit orders' (declared as 1).")
usePresetCost = input.bool(true, "Use preset cost model", group=gExec, tooltip="Illustrative costs per market. Replace with your broker's real numbers before trusting any statistic.")
commIn = input.float(0, "Commission per unit per side (USD)", minval=0, group=gExec)
spreadIn = input.float(0, "Typical spread (price units)", minval=0, group=gExec)
slipIn = input.int(1, "Slippage on market and stop fills (ticks)", minval=0, group=gExec)

asiaOn = input.bool(false, "Asia (Tokyo)", inline="as", group=gSess)
asiaWin = input.session("0900-1200", "", inline="as", group=gSess)
londonOn = input.bool(true, "London", inline="ld", group=gSess)
londonWin = input.session("0800-1100", "", inline="ld", group=gSess)
nyOn = input.bool(true, "New York", inline="ny", group=gSess)
nyWin = input.session("0830-1130", "", inline="ny", group=gSess)
asiaFull = input.session("0900-1500", "Asia full session (Tokyo time)", group=gSess)
londonFull = input.session("0800-1630", "London full session (London time)", group=gSess)
nyFull = input.session("0930-1600", "New York full session (New York time)", group=gSess, tooltip="Used for session highs/lows and opening ranges. Spot FX and gold presets use 08:00-17:00 automatically.")
weekdays = input.string("23456", "Trading days (1=Sun ... 7=Sat)", group=gSess)
cutoffMin = input.int(5, "No new entries in the last N minutes of a window", minval=0, group=gSess)
flattenOutside = input.bool(false, "Close positions outside every trading window", group=gSess)
forceFlatOn = input.bool(false, "Flat before the daily close", inline="ff", group=gSess)
forceFlat = input.session("1555-1600", "", inline="ff", group=gSess, tooltip="New York time. No new entries and open positions are closed when a bar touches this window.")

blockEntries = input.bool(false, "Pause all new entries", group=gNews)
news1On = input.bool(false, "News 1", inline="n1", group=gNews)
news1 = input.time(timestamp("01 Jan 2026 13:30 +0000"), "", inline="n1", group=gNews)
news2On = input.bool(false, "News 2", inline="n2", group=gNews)
news2 = input.time(timestamp("01 Jan 2026 15:00 +0000"), "", inline="n2", group=gNews)
news3On = input.bool(false, "News 3", inline="n3", group=gNews)
news3 = input.time(timestamp("01 Jan 2026 19:00 +0000"), "", inline="n3", group=gNews)
newsPre = input.int(15, "Minutes before news", minval=0, group=gNews)
newsPost = input.int(15, "Minutes after news", minval=0, group=gNews)
dailyLossR = input.float(0, "Stop for the day after losing (R, 0 = off)", minval=0, group=gNews)
maxEntries = input.int(0, "Max entries per day (0 = off)", minval=0, group=gNews)
maxLossStreak = input.int(0, "Pause after N losses in a row (0 = off)", minval=0, group=gNews)
dayTZ = "America/New_York"
dayReset = 1700
testStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Trade from", group=gNews)
testEnd = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Trade until", group=gNews)
oosStart = input.time(timestamp("01 Jul 2026 00:00 +0000"), "Out-of-sample starts", group=gNews, tooltip="Statistics are split into in-sample (before) and out-of-sample (from this date). Choose it BEFORE looking at results.")

cScalpTF1 = input.timeframe("15", "Scalp confirmation TF 1", group=gCustom)
cScalpTF2 = input.timeframe("60", "Scalp confirmation TF 2", group=gCustom)
cDayTF1 = input.timeframe("60", "Day confirmation TF 1", group=gCustom)
cDayTF2 = input.timeframe("240", "Day confirmation TF 2", group=gCustom)
cUseTF2 = input.bool(true, "Require both confirmation timeframes", group=gCustom)
cScalpPivot = input.int(3, "Scalp swing strength (bars)", minval=2, maxval=20, group=gCustom)
cDayPivot = input.int(5, "Day swing strength (bars)", minval=2, maxval=20, group=gCustom)
cScalpExpiry = input.int(12, "Scalp setup expiry (bars)", minval=3, group=gCustom)
cDayExpiry = input.int(24, "Day setup expiry (bars)", minval=3, group=gCustom)
cScalpHold = input.int(30, "Scalp max hold (bars)", minval=1, group=gCustom)
cDayHold = input.int(60, "Day max hold (bars)", minval=1, group=gCustom)
cScalpCool = input.int(2, "Scalp cooldown (bars)", minval=0, group=gCustom)
cDayCool = input.int(3, "Day cooldown (bars)", minval=0, group=gCustom)
cScalpOR = input.int(15, "Scalp opening range (minutes)", minval=1, group=gCustom)
cDayOR = input.int(30, "Day opening range (minutes)", minval=1, group=gCustom)
cMinStop = input.float(0.5, "Minimum stop (ATR)", minval=0.1, group=gCustom)
cMaxStop = input.float(3.0, "Maximum stop (ATR)", minval=0.2, group=gCustom)
cDisp = input.float(0.6, "Breakout candle body (ATR)", minval=0.1, group=gCustom)
cADX = input.float(18, "Minimum ADX", minval=1, group=gCustom)
cAtrPct = input.float(0.01, "Minimum ATR (% of price)", minval=0, step=0.001, group=gCustom)
cPad = input.float(0.15, "Stop buffer beyond structure (ATR)", minval=0, group=gCustom)
cExt = input.float(2.5, "Max distance from EMA20 (ATR)", minval=0.1, group=gCustom)
cVwap = input.bool(true, "Require correct side of VWAP", group=gCustom)
cVol = input.bool(false, "Require above-average volume on the trigger bar", group=gCustom)
corrType = input.string("Retracement or retest", "Correction definition", options=["Retracement or retest", "Retracement 38-79%", "Broken-level retest"], group=gCustom)
fibShallow = input.float(0.382, "Retracement zone start", minval=0.1, maxval=0.9, group=gCustom)
fibDeep = input.float(0.786, "Retracement zone end", minval=0.2, maxval=1.0, group=gCustom)
retestPad = input.float(0.25, "Retest band around the broken level (ATR)", minval=0.01, group=gCustom)
allowChoch = input.bool(true, "Allow change-of-character breaks as indication", group=gCustom)
needSweep = input.bool(false, "Require a liquidity sweep during the correction", group=gCustom)
bosTicks = input.int(1, "Break must close beyond the level by (ticks)", minval=0, group=gCustom)

showStats = input.bool(true, "Show performance table", group=gVis)
showSessLv = input.bool(true, "Detailed view: session highs/lows and opening ranges", group=gVis)
dashPosIn = input.string("Top right", "Dashboard position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=gVis)
dashSizeIn = input.string("Normal", "Dashboard text", options=["Small", "Normal", "Large"], group=gVis)
statsPosIn = input.string("Bottom left", "Performance table position", options=["Bottom left", "Bottom right", "Top left", "Top right"], group=gVis)

// ---- Market recognition ------------------------------------------------------------------------
f_isOne(string list, string x) => str.contains("," + list + ",", "," + x + ",")
string tk = syminfo.ticker
string root = syminfo.root
string autoFam = root == "GC" or root == "MGC" or syminfo.basecurrency == "XAU" or f_isOne("GOLD,XAUUSD,GOLDUSD,XAUUSD.,GOLDSPOT", tk) ? "Gold" : root == "NQ" or root == "MNQ" or f_isOne("NAS100,NAS100USD,US100,USTEC,NDX100,US100.cash", tk) ? "Nasdaq-100" : root == "ES" or root == "MES" or f_isOne("SPX500,SPX500USD,US500,US500USD,US500.cash", tk) ? "S&P 500" : root == "6E" or root == "M6E" or (syminfo.basecurrency == "EUR" and syminfo.currency == "USD") or tk == "EURUSD" ? "EUR/USD" : root == "6J" or (syminfo.basecurrency == "USD" and syminfo.currency == "JPY") or tk == "USDJPY" ? "USD/JPY" : "Unknown"
string fam = marketIn == "Auto" ? autoFam : marketIn
bool isFuture = syminfo.type == "futures"
bool isIndexFam = fam == "Nasdaq-100" or fam == "S&P 500"
float qtyStep = isFuture ? 1.0 : qtyStepIn
float unitUSD = unitValueIn > 0 ? unitValueIn : syminfo.currency == "USD" ? syminfo.pointvalue : syminfo.basecurrency == "USD" and close > 0 ? syminfo.pointvalue / close : na
bool marketOK = fam != "Unknown" and not na(unitUSD) and unitUSD > 0
// 6J is quoted in USD per JPY: a 6J LONG is long yen, the opposite of a USDJPY LONG.
bool yenFuture = root == "6J" or (syminfo.basecurrency == "JPY" and syminfo.currency == "USD")
bool scalp = mode == "SCALP"

// ---- Presets (UNVALIDATED research starting points; see the guide for the rationale) -----------
string tf1 = usePreset ? (scalp ? "15" : "60") : (scalp ? cScalpTF1 : cDayTF1)
string tf2 = usePreset ? (scalp ? "60" : "240") : (scalp ? cScalpTF2 : cDayTF2)
bool useTF2 = usePreset ? true : cUseTF2
int strength = usePreset ? (scalp ? 3 : 5) : (scalp ? cScalpPivot : cDayPivot)
int expiry = usePreset ? (scalp ? 12 : 24) : (scalp ? cScalpExpiry : cDayExpiry)
int holdBars = usePreset ? (scalp ? 30 : 60) : (scalp ? cScalpHold : cDayHold)
int cooldown = usePreset ? (scalp ? 2 : 3) : (scalp ? cScalpCool : cDayCool)
int orMins = usePreset ? (scalp ? 15 : 30) : (scalp ? cScalpOR : cDayOR)
float pDisp = switch fam
    "Gold" => 0.8
    "Nasdaq-100" => 0.8
    "USD/JPY" => 0.7
    => 0.6
float pADX = fam == "Gold" or fam == "Nasdaq-100" ? 20.0 : 18.0
float pAtrPct = switch fam
    "Gold" => scalp ? 0.010 : 0.025
    "Nasdaq-100" => scalp ? 0.015 : 0.035
    "S&P 500" => scalp ? 0.010 : 0.025
    "EUR/USD" => scalp ? 0.004 : 0.010
    "USD/JPY" => scalp ? 0.005 : 0.012
    => 0.01
float pPad = fam == "Gold" ? 0.20 : 0.15
float pMinStop = scalp ? 0.5 : 0.6
float pMaxStop = fam == "Gold" ? (scalp ? 3.0 : 3.5) : (scalp ? 2.5 : 3.0)
float pExt = fam == "Nasdaq-100" ? 3.0 : 2.5
// Volume-based filters are only preset ON when the feed actually reports volume
// (e.g. TVC:GOLD and many CFD feeds report none). Custom settings are honoured and block visibly.
bool feedVolume = syminfo.volumetype != "n/a"
bool pVwap = (fam == "Gold" or isIndexFam) and feedVolume
bool pVol = isFuture and feedVolume
float disp = usePreset ? pDisp : cDisp
float minADX = usePreset ? pADX : cADX
float minAtrPct = usePreset ? pAtrPct : cAtrPct
float stopPad = usePreset ? pPad : cPad
float minStop = usePreset ? pMinStop : cMinStop
float maxStop = usePreset ? pMaxStop : cMaxStop
float maxExt = usePreset ? pExt : cExt
bool vwapReq = usePreset ? pVwap : cVwap
bool volReq = usePreset ? pVol : cVol
// Preset costs per unit and side: futures commission by contract size; spot / CFD pays spread.
float pComm = isFuture ? (root == "MGC" or root == "MNQ" or root == "MES" or root == "M6E" ? 0.70 : 2.40) : 0.0
float pSpread = isFuture ? syminfo.mintick : fam == "Gold" ? 0.25 : fam == "EUR/USD" ? 0.00008 : fam == "USD/JPY" ? 0.010 : fam == "Nasdaq-100" ? 1.0 : fam == "S&P 500" ? 0.5 : 0.0
float commUnit = usePresetCost ? pComm : commIn
float spreadPx = usePresetCost ? pSpread : spreadIn
int slipTicks = usePresetCost ? (isFuture ? 1 : 0) : slipIn
// Preset sessions. Index futures trade the New York cash session; gold and FX also London; yen also Asia.
bool useAsia = usePresetSess ? fam == "USD/JPY" : asiaOn
bool useLondon = usePresetSess ? not isIndexFam : londonOn
bool useNY = usePresetSess ? true : nyOn
string asiaW = usePresetSess ? "0900-1200" : asiaWin
string londonW = usePresetSess ? "0800-1100" : londonWin
string nyW = usePresetSess ? (isIndexFam ? "0935-1130" : "0830-1130") : nyWin
string nyF = usePresetSess and not isIndexFam ? "0800-1700" : nyFull
bool use3 = targetsIn == "TP1 + TP2 + TP3"

// ---- Local-time helpers (IANA zones; TradingView applies each zone's daylight-saving rules) ----
f_hhmm(string s, int pos) => int(str.tonumber(str.substring(s, pos, pos + 4)))
f_mins(int hhmm) => math.floor(hhmm / 100) * 60 + hhmm % 100
f_localMins(int t, string zone) => hour(t, zone) * 60 + minute(t, zone)
f_dateKey(int t, string zone) => year(t, zone) * 10000 + month(t, zone) * 100 + dayofmonth(t, zone)
f_validSess(string s) =>
    int a = f_hhmm(s, 0)
    int b = f_hhmm(s, 5)
    not na(a) and not na(b) and str.length(s) >= 9 and a % 100 < 60 and b % 100 < 60 and a < b
f_dayOK(string zone) => str.contains(weekdays, str.tostring(dayofweek(time, zone)))
// Whole bar inside [start, end) on one local trading day. Bars crossing a boundary do not qualify.
f_inside(string s, string zone) =>
    int o = f_localMins(time, zone)
    int c = f_localMins(time_close - 1, zone)
    bool sameDay = f_dateKey(time, zone) == f_dateKey(time_close - 1, zone)
    f_dayOK(zone) and sameDay and o >= f_mins(f_hhmm(s, 0)) and c < f_mins(f_hhmm(s, 5))
f_left(string s, string zone) => f_mins(f_hhmm(s, 5)) - (f_localMins(time_close - 1, zone) + 1)
// Bar opens inside [start, end): used for session tracking.
f_opensIn(string s, string zone) =>
    int o = f_localMins(time, zone)
    f_dayOK(zone) and o >= f_mins(f_hhmm(s, 0)) and o < f_mins(f_hhmm(s, 5))
f_touches(string s, string zone) =>
    int o = f_localMins(time, zone)
    int c = f_localMins(time_close - 1, zone)
    int a = f_mins(f_hhmm(s, 0))
    int b = f_mins(f_hhmm(s, 5))
    f_dateKey(time, zone) == f_dateKey(time_close - 1, zone) ? (o < b and c >= a) : (o < b or c >= a)
f_dayKey(int t) =>
    f_localMins(t, dayTZ) >= f_mins(dayReset) ? f_dateKey(t + 86400000, dayTZ) : f_dateKey(t, dayTZ)
f_px(float x) => str.tostring(x, format.mintick)
f_tfName(string tf) => tf == "240" ? "4H" : tf == "60" ? "1H" : tf == "D" ? "Daily" : str.tostring(math.round(timeframe.in_seconds(tf) / 60)) + "m"

if barstate.isfirst
    if not timeframe.isminutes or timeframe.in_seconds(tf1) <= timeframe.in_seconds() or (useTF2 and timeframe.in_seconds(tf2) <= timeframe.in_seconds(tf1))
        runtime.error("MEKA: use a minute chart below the confirmation timeframes (Scalp 1-5m, Day 5-15m), and TF 2 above TF 1.")
    if not chart.is_standard
        runtime.error("MEKA: use standard candles (not Heikin Ashi, Renko or range bars).")
    if r2 <= r1 or (use3 and r3 <= r2) or maxStop < minStop or testEnd <= testStart or fibDeep <= fibShallow or alloc3a + alloc3b >= 100
        runtime.error("MEKA: check settings - TP1 < TP2 < TP3, min stop < max stop, retracement start < end, TP1% + TP2% < 100, and the date range.")
    if not f_validSess(asiaW) or not f_validSess(londonW) or not f_validSess(nyW) or not f_validSess(asiaFull) or not f_validSess(londonFull) or not f_validSess(nyF) or not f_validSess(forceFlat)
        runtime.error("MEKA: sessions must be same-day windows written HHMM-HHMM with start before end.")

// ---- Time gates ----------------------------------------------------------------------------------
bool inAsia = useAsia and f_inside(asiaW, "Asia/Tokyo")
bool inLondon = useLondon and f_inside(londonW, "Europe/London")
bool inNY = useNY and f_inside(nyW, "America/New_York")
bool inWindow = inAsia or inLondon or inNY
int minsLeft = math.max(inAsia ? f_left(asiaW, "Asia/Tokyo") : -1, inLondon ? f_left(londonW, "Europe/London") : -1, inNY ? f_left(nyW, "America/New_York") : -1)
bool beforeCutoff = inWindow and minsLeft >= cutoffMin
// Session label priority when windows overlap: New York, then London, then Asia (one entry either way).
int sessCode = inNY ? 3 : inLondon ? 2 : inAsia ? 1 : 0
string sessName = sessCode == 3 ? "New York" : sessCode == 2 ? "London" : sessCode == 1 ? "Asia" : "Outside sessions"
bool inForceFlat = forceFlatOn and f_touches(forceFlat, "America/New_York")
f_news(bool on, int t) => on and time < t + newsPost * 60000 and time_close > t - newsPre * 60000
bool newsBlocked = f_news(news1On, news1) or f_news(news2On, news2) or f_news(news3On, news3)
bool inDates = time >= testStart and time_close < testEnd
bool entryGate = marketOK and beforeCutoff and not blockEntries and not newsBlocked and not inForceFlat and inDates

// ---- Core series ---------------------------------------------------------------------------------
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
atr = ta.atr(14)
atrAvg = ta.sma(atr, 100)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
vwapVal = ta.vwap(hlc3)
vAvg = ta.sma(volume, 20)
bool volumeMissing = na(volume) or na(vAvg) or vAvg <= 0
bool vwapMissing = na(vwapVal)
// Confirmed higher-timeframe trend: previous completed HTF close vs its EMA50 and that EMA's slope.
[hc1, he1, heo1] = request.security(syminfo.tickerid, tf1, [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[2]], lookahead=barmerge.lookahead_on)
[hc2, he2, heo2] = request.security(syminfo.tickerid, tf2, [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[2]], lookahead=barmerge.lookahead_on)
int bias1 = hc1 > he1 and he1 > heo1 ? 1 : hc1 < he1 and he1 < heo1 ? -1 : 0
int bias2 = hc2 > he2 and he2 > heo2 ? 1 : hc2 < he2 and he2 < heo2 ? -1 : 0
int htfBias = useTF2 ? (bias1 == bias2 ? bias1 : 0) : bias1
f_biasWord(int b) => b == 1 ? "up" : b == -1 ? "down" : "flat"
string biasText = htfBias == 1 ? "Bullish" : htfBias == -1 ? "Bearish" : "Neutral"
string biasDetail = f_tfName(tf1) + " " + f_biasWord(bias1) + (useTF2 ? ", " + f_tfName(tf2) + " " + f_biasWord(bias2) : "")
bool trending = adx >= 25
bool hiVol = not na(atrAvg) and atr > atrAvg * 1.25
bool atrOK = not na(atr) and close > 0 and atr / close * 100 >= minAtrPct
bool extOK = not na(atr) and math.abs(close - emaFast) <= maxExt * atr
bool qualityGate = not na(heo1) and (not useTF2 or not na(heo2)) and atrOK and adx >= minADX and extOK
bool dataOK = (not vwapReq or not vwapMissing) and (not volReq or not volumeMissing)
bool vwapLongOK = not vwapReq or (not vwapMissing and close > vwapVal)
bool vwapShortOK = not vwapReq or (not vwapMissing and close < vwapVal)
bool volOK = not volReq or (not volumeMissing and volume >= vAvg)

// ---- Session tracking: highs/lows and opening ranges (updated at bar close) ---------------------
type SessTrack
    float hi = na
    float lo = na
    float lastHi = na
    float lastLo = na
    float orHi = na
    float orLo = na
    bool active = false
    bool orDone = false
    bool orUp = false
    bool orDn = false
    int startBar = na
    int orEndBar = na

method step(SessTrack s, bool inNow, int minsIn) =>
    if inNow and not s.active
        s.active := true
        s.hi := high
        s.lo := low
        s.orHi := high
        s.orLo := low
        s.orDone := false
        s.orUp := false
        s.orDn := false
        s.startBar := bar_index
        s.orEndBar := na
    else if inNow
        if not s.orDone and minsIn >= orMins
            s.orDone := true
            s.orEndBar := bar_index
        if not s.orDone
            s.orHi := math.max(s.orHi, high)
            s.orLo := math.min(s.orLo, low)
        s.hi := math.max(s.hi, high)
        s.lo := math.min(s.lo, low)
    else if s.active
        s.active := false
        s.lastHi := s.hi
        s.lastLo := s.lo
    s

f_minsIn(string s, string zone) => f_localMins(time, zone) - f_mins(f_hhmm(s, 0))
var SessTrack sAsia = SessTrack.new()
var SessTrack sLondon = SessTrack.new()
var SessTrack sNY = SessTrack.new()
if barstate.isconfirmed
    sAsia.step(f_opensIn(asiaFull, "Asia/Tokyo"), f_minsIn(asiaFull, "Asia/Tokyo"))
    sLondon.step(f_opensIn(londonFull, "Europe/London"), f_minsIn(londonFull, "Europe/London"))
    sNY.step(f_opensIn(nyF, "America/New_York"), f_minsIn(nyF, "America/New_York"))
// Session whose opening range drives the breakout baseline (same priority as the label).
SessTrack sMain = sNY.active ? sNY : sLondon.active ? sLondon : sAsia.active ? sAsia : na

// ---- Market structure: confirmed swings, BOS / CHoCH, liquidity sweeps ----------------------------
ph = ta.pivothigh(high, strength, strength)
pl = ta.pivotlow(low, strength, strength)
var float swingHigh = na
var float swingLow = na
var int highID = na
var int lowID = na
var int brokenHighID = na
var int brokenLowID = na
var int structTrend = 0
float bosBuf = bosTicks * syminfo.mintick
// Breaks use only swings that were confirmed BEFORE this bar; each swing can be broken once.
bool breakUp = not na(swingHigh) and close > swingHigh + bosBuf and (na(brokenHighID) or highID != brokenHighID)
bool breakDn = not na(swingLow) and close < swingLow - bosBuf and (na(brokenLowID) or lowID != brokenLowID)
bool chochUp = breakUp and structTrend != 1
bool chochDn = breakDn and structTrend != -1
float breakUpLevel = swingHigh
float breakDnLevel = swingLow
int breakUpOrigin = highID
int breakDnOrigin = lowID
// Liquidity sweep: wick through a known level, close back on the original side (first bar only).
f_sweptBelow(float lvl) => not na(lvl) and low < lvl and close > lvl and low[1] >= lvl
f_sweptAbove(float lvl) => not na(lvl) and high > lvl and close < lvl and high[1] <= lvl
bool sweepLow = f_sweptBelow(swingLow) or f_sweptBelow(sAsia.lastLo) or f_sweptBelow(sLondon.lastLo) or f_sweptBelow(sNY.lastLo)
bool sweepHigh = f_sweptAbove(swingHigh) or f_sweptAbove(sAsia.lastHi) or f_sweptAbove(sLondon.lastHi) or f_sweptAbove(sNY.lastHi)
bool pullLong = ta.crossover(close, emaFast) and low[1] <= emaFast[1] and close > open and htfBias == 1
bool pullShort = ta.crossunder(close, emaFast) and high[1] >= emaFast[1] and close < open and htfBias == -1

// ---- ICC state machine: 0 idle -> 1 indicated -> 2 corrected -> continuation (entry candidate) --
var int setupState = 0
var int setupSide = 0
var int indBar = na
var int corBar = na
var float brokenLevel = na
var float impOrigin = na
var float impExt = na
var float indATR = na
var float corExt = na
var float trigger = na
var bool corSwept = false
int prevState = setupState
int prevSide = setupSide
float legSize = math.abs(impExt - impOrigin)
float fibNear = setupSide == 1 ? impExt - fibShallow * legSize : impExt + fibShallow * legSize
float fibFar = setupSide == 1 ? impExt - fibDeep * legSize : impExt + fibDeep * legSize
bool useFib = corrType != "Broken-level retest"
bool useRetest = corrType != "Retracement 38-79%"
float zoneTop = setupSide == 1 ? (useFib ? fibNear : brokenLevel + retestPad * indATR) : (useFib ? fibFar : brokenLevel + retestPad * indATR)
float zoneBot = setupSide == 1 ? (useFib ? fibFar : brokenLevel - retestPad * indATR) : (useFib ? fibNear : brokenLevel - retestPad * indATR)
int candidate = 0
float candStop = na
float candLevel = na
string candName = ""
string setupEndText = ""
string contMissing = ""
bool setupFormed = false
bool setupCanceled = false
if barstate.isconfirmed
    if setupState != 0
        bool brokeOrigin = setupSide == 1 ? close < impOrigin : close > impOrigin
        bool biasLost = htfBias != setupSide
        bool expired = bar_index - indBar > expiry
        bool blocked = not inWindow or newsBlocked or blockEntries or inForceFlat
        if brokeOrigin or biasLost or expired or blocked
            setupEndText := brokeOrigin ? "Setup canceled: price closed beyond the impulse origin." : biasLost ? "Setup canceled: higher-timeframe bias changed." : expired ? "Setup canceled: no continuation in time." : "Setup canceled: session ended or entries paused."
            setupCanceled := true
            setupState := 0
        else if setupState == 1 and bar_index > indBar
            bool hitFib = useFib and (setupSide == 1 ? low <= fibNear : high >= fibNear)
            bool hitRetest = useRetest and (setupSide == 1 ? low <= brokenLevel + retestPad * indATR : high >= brokenLevel - retestPad * indATR)
            if hitFib or hitRetest
                setupState := 2
                corBar := bar_index
                corExt := setupSide == 1 ? low : high
                trigger := setupSide == 1 ? high : low
                corSwept := setupSide == 1 ? sweepLow or low < impOrigin : sweepHigh or high > impOrigin
            else
                impExt := setupSide == 1 ? math.max(impExt, high) : math.min(impExt, low)
        else if setupState == 2 and bar_index > corBar
            bool brk = setupSide == 1 ? close > trigger + bosBuf and close > open : close < trigger - bosBuf and close < open
            bool sideOK = setupSide == 1 ? vwapLongOK : vwapShortOK
            bool sweepOK = not needSweep or corSwept
            if brk and sideOK and volOK and sweepOK
                candidate := setupSide
                candStop := setupSide == 1 ? math.min(corExt, low) - stopPad * indATR : math.max(corExt, high) + stopPad * indATR
                candLevel := trigger
                candName := "ICC continuation"
                setupState := 0
            else
                contMissing := brk and not sideOK ? "Trigger broke, but price is on the wrong side of VWAP." : brk and not volOK ? "Trigger broke, but volume is below average." : brk and not sweepOK ? "Trigger broke, but no liquidity sweep happened in the pullback." : ""
                bool deeper = setupSide == 1 ? low < corExt : high > corExt
                if deeper
                    corExt := setupSide == 1 ? low : high
                    trigger := setupSide == 1 ? high : low
                corSwept := corSwept or (setupSide == 1 ? sweepLow or low < impOrigin : sweepHigh or high > impOrigin)
    else if framework == "ICC hybrid" and entryGate and qualityGate and dataOK
        bool upOK = breakUp and htfBias == 1 and (allowChoch or not chochUp) and close - open >= disp * atr[1] and not na(swingLow) and swingLow < close
        bool dnOK = breakDn and htfBias == -1 and (allowChoch or not chochDn) and open - close >= disp * atr[1] and not na(swingHigh) and swingHigh > close
        if upOK or dnOK
            setupSide := upOK ? 1 : -1
            brokenLevel := upOK ? swingHigh : swingLow
            impOrigin := upOK ? swingLow : swingHigh
            impExt := upOK ? high : low
            indATR := atr[1]
            indBar := bar_index
            corSwept := false
            setupState := 1
            setupFormed := true
    if candidate == 0 and framework == "Trend pullback (baseline)"
        if pullLong and vwapLongOK
            candidate := 1
            candStop := math.min(low, low[1]) - stopPad * atr[1]
            candLevel := emaFast
            candName := "Trend pullback"
        else if pullShort and vwapShortOK
            candidate := -1
            candStop := math.max(high, high[1]) + stopPad * atr[1]
            candLevel := emaFast
            candName := "Trend pullback"
    if candidate == 0 and framework == "Breakout (baseline)" and not na(sMain)
        if sMain.orDone
            float mid = (sMain.orHi + sMain.orLo) / 2
            if not sMain.orUp and close > sMain.orHi + bosBuf and close > open and htfBias == 1 and vwapLongOK and volOK
                candidate := 1
                candStop := mid - stopPad * atr[1]
                candLevel := sMain.orHi
                candName := "Opening-range breakout"
                sMain.orUp := true
            else if not sMain.orDn and close < sMain.orLo - bosBuf and close < open and htfBias == -1 and vwapShortOK and volOK
                candidate := -1
                candStop := mid + stopPad * atr[1]
                candLevel := sMain.orLo
                candName := "Opening-range breakout"
                sMain.orDn := true
    // Commit this bar's structure AFTER the setup logic: nothing above saw it early.
    if breakUp
        brokenHighID := highID
        structTrend := 1
    if breakDn
        brokenLowID := lowID
        structTrend := -1
    if not na(ph)
        swingHigh := ph
        highID := bar_index - strength
    if not na(pl)
        swingLow := pl
        lowID := bar_index - strength

// ---- Candidate validation: entry reference, stop, targets, size (closed-bar data only) ----------
f_floorTick(float x) => math.floor(x / syminfo.mintick + 1e-9) * syminfo.mintick
f_ceilTick(float x) => math.ceil(x / syminfo.mintick - 1e-9) * syminfo.mintick
bool useLimit = entryType == "Limit at breakout retest"
// Limit entries rest at the broken trigger level, never through the current price.
float refPx = candidate == 1 ? (useLimit ? f_floorTick(math.min(candLevel, close)) : close) : candidate == -1 ? (useLimit ? f_ceilTick(math.max(candLevel, close)) : close) : na
float atrStop = candidate == 1 ? refPx - atrStopMult * atr : refPx + atrStopMult * atr
float rawStop = stopMethod == "Structure" ? candStop : stopMethod == "ATR" ? atrStop : candidate == 1 ? math.min(candStop, atrStop) : math.max(candStop, atrStop)
float plannedStop = candidate == 1 ? f_floorTick(rawStop) : candidate == -1 ? f_ceilTick(rawStop) : na
float plannedRisk = candidate == 1 ? refPx - plannedStop : candidate == -1 ? plannedStop - refPx : na
bool stopTooTight = not na(plannedRisk) and plannedRisk < math.max(minStop * atr, syminfo.mintick)
bool stopTooWide = not na(plannedRisk) and plannedRisk > maxStop * atr
f_qty(float distance) =>
    float raw = distance > 0 and marketOK ? account * riskPct / 100 / (distance * unitUSD) : 0.0
    math.floor(math.min(raw, maxQty) / qtyStep + 1e-9) * qtyStep
float plannedQty = not na(plannedRisk) and not stopTooTight and not stopTooWide ? f_qty(plannedRisk) : 0.0
float opposing = candidate == 1 ? swingHigh : swingLow
float room = candidate == 1 ? opposing - refPx : refPx - opposing
bool roomOK = not roomGate or na(opposing) or room <= 0 or room >= plannedRisk * r1 + syminfo.mintick
int signal = barstate.isconfirmed and candidate != 0 and entryGate and qualityGate and dataOK and not stopTooTight and not stopTooWide and roomOK and plannedQty >= qtyStep ? candidate : 0
// Whole-unit allocation. TP1 and TP2 always get at least one unit when the position allows it;
// a single unit goes to TP2; leftover units always go to the last target.
f_parts(float q) =>
    int units = int(math.round(q / qtyStep))
    int u1 = 0
    int u2 = 0
    int u3 = 0
    if use3 and units >= 3
        u1 := math.max(1, math.min(units - 2, int(math.floor(units * alloc3a / 100.0))))
        u2 := math.max(1, math.min(units - u1 - 1, int(math.floor(units * alloc3b / 100.0))))
        u3 := units - u1 - u2
    else if units >= 2
        u1 := math.max(1, math.min(units - 1, int(math.floor(units * (use3 ? alloc3a : alloc2) / 100.0))))
        u2 := units - u1
    else
        u2 := units
    [u1 * qtyStep, u2 * qtyStep, u3 * qtyStep]
f_targets(int s, float ref, float risk) =>
    float t1 = s == 1 ? f_ceilTick(ref + risk * r1) : f_floorTick(ref - risk * r1)
    float t2 = s == 1 ? math.max(f_ceilTick(ref + risk * r2), t1 + syminfo.mintick) : math.min(f_floorTick(ref - risk * r2), t1 - syminfo.mintick)
    float t3 = s == 1 ? math.max(f_ceilTick(ref + risk * r3), t2 + syminfo.mintick) : math.min(f_floorTick(ref - risk * r3), t2 - syminfo.mintick)
    [t1, t2, t3]

// ---- Plain-English explanation of what is missing --------------------------------------------------
string noTradeText = not marketOK ? (fam == "Unknown" ? "Market not recognised. Choose it under Market in the settings." : "Enter the USD value per point for this symbol in the settings.") : not inDates ? "Outside the selected trading dates." : blockEntries ? "New entries are paused in the settings." : newsBlocked ? "News blackout. No new entries until it ends." : inForceFlat ? "End-of-day flat period." : not inWindow ? "Outside your trading sessions." : not beforeCutoff ? "Too close to the session end for a new entry." : not dataOK ? "This feed has no usable volume, so the volume / VWAP filter cannot confirm entries." : ""
string filterText = "VWAP side " + (vwapReq ? "on" : "off") + " · volume " + (volReq ? "on" : "off") + (feedVolume ? "" : " (this feed has no volume)")
string sideWord = htfBias == 1 ? "bullish" : "bearish"
string waitText = htfBias == 0 ? "Higher timeframes are not aligned (" + biasDetail + "). Waiting for agreement." : not atrOK ? "Market is too quiet. Volatility is below the minimum for this market." : adx < minADX ? "Trend strength is too weak (ADX " + str.tostring(math.round(adx)) + ", needs " + str.tostring(minADX) + ")." : not extOK ? "Price is stretched far from the 20 EMA. Waiting for it to come back." : framework == "Trend pullback (baseline)" ? "Waiting for a pullback to the 20 EMA and a " + sideWord + " close back through it." : framework == "Breakout (baseline)" ? (na(sMain) ? "Waiting for a session to open." : not sMain.orDone ? "Opening range is still forming." : "Waiting for a close " + (htfBias == 1 ? "above " + f_px(sMain.orHi) : "below " + f_px(sMain.orLo)) + " (opening range).") : htfBias == 1 ? (na(swingHigh) ? "Bias is bullish. Waiting for a swing high to form." : "Bias is bullish. Waiting for a strong close above the swing high at " + f_px(swingHigh) + ".") : (na(swingLow) ? "Bias is bearish. Waiting for a swing low to form." : "Bias is bearish. Waiting for a strong close below the swing low at " + f_px(swingLow) + ".")
string watchText = setupState == 1 ? (setupSide == 1 ? "Bullish" : "Bearish") + " break confirmed at " + f_px(brokenLevel) + ". Waiting for a pullback into " + f_px(math.min(zoneTop, zoneBot)) + " - " + f_px(math.max(zoneTop, zoneBot)) + "." : setupState == 2 ? (contMissing != "" ? contMissing + " " : "Pullback reached the zone" + (corSwept ? " with a liquidity sweep" : "") + ". ") + (setupSide == 1 ? "Buy trigger: a bullish close above " : "Sell trigger: a bearish close below ") + f_px(setupSide == 1 ? trigger + bosBuf : trigger - bosBuf) + "." : ""
string rejectText = candidate == 0 or signal != 0 ? "" : stopTooWide ? "Setup found, but the stop would be too wide (" + str.tostring(plannedRisk / atr, "#.#") + " ATR). Skipped." : stopTooTight ? "Setup found, but the stop would be too tight to survive normal noise. Skipped." : not roomOK ? "Setup found, but the next swing at " + f_px(opposing) + " leaves no room for TP1. Skipped." : plannedQty < qtyStep ? "Setup found, but the risk budget is too small for one unit. Skipped." : "Setup found, but a filter blocked it."
// COMMON SIGNAL ENGINE END

// SHARED EXECUTION HELPERS BEGIN
// Trading-day counters reset at 17:00 New York (the futures day roll), never at midnight, and
// never touch an open position.
var int dayKey = na
var float dayR = 0.0
var int dayEntries = 0
var int lossStreak = 0
int barDayKey = f_dayKey(time)
if barstate.isconfirmed and (na(dayKey) or barDayKey != dayKey)
    dayKey := barDayKey
    dayR := 0.0
    dayEntries := 0
    lossStreak := 0

f_dayBlock() =>
    dailyLossR > 0 and dayR <= -dailyLossR ? "Daily loss limit reached. No more entries today." : maxEntries > 0 and dayEntries >= maxEntries ? "Maximum entries for today reached." : maxLossStreak > 0 and lossStreak >= maxLossStreak ? "Paused after " + str.tostring(lossStreak) + " losses in a row." : ""

// Modeled trading costs for one fill of q units: commission + half the spread, plus slippage on
// market and stop fills. Limit fills (targets, limit entries) pay no slippage.
f_cost(float q, bool marketLike) =>
    commUnit * q + (spreadPx / 2 + (marketLike ? slipTicks * syminfo.mintick : 0.0)) * q * unitUSD

// ---- Performance ledger: one record per COMPLETE position (partial targets are not trades) ------
// Groups: 0 all, 1 long, 2 short, 3 Asia, 4 London, 5 New York, 6 trending, 7 ranging,
//         8 high volatility, 9 normal volatility, 10 in-sample, 11 out-of-sample.
var array<float> stN = array.new<float>(12, 0.0)
var array<float> stW = array.new<float>(12, 0.0)
var array<float> stSW = array.new<float>(12, 0.0)
var array<float> stSL = array.new<float>(12, 0.0)
var array<float> stGW = array.new<float>(12, 0.0)
var array<float> stGL = array.new<float>(12, 0.0)
var array<float> stCum = array.new<float>(12, 0.0)
var array<float> stPeak = array.new<float>(12, 0.0)
var array<float> stDD = array.new<float>(12, 0.0)
var array<float> stNet = array.new<float>(12, 0.0)
var array<int> tpTouch = array.new<int>(3, 0)
var array<int> tpFill = array.new<int>(3, 0)
var int ambiguousBars = 0

f_rec(int g, float r, float cash) =>
    array.set(stN, g, array.get(stN, g) + 1)
    if r > 0
        array.set(stW, g, array.get(stW, g) + 1)
        array.set(stSW, g, array.get(stSW, g) + r)
    else
        array.set(stSL, g, array.get(stSL, g) - r)
    if cash > 0
        array.set(stGW, g, array.get(stGW, g) + cash)
    else
        array.set(stGL, g, array.get(stGL, g) - cash)
    float cum = array.get(stCum, g) + r
    array.set(stCum, g, cum)
    array.set(stPeak, g, math.max(array.get(stPeak, g), cum))
    array.set(stDD, g, math.max(array.get(stDD, g), array.get(stPeak, g) - cum))
    array.set(stNet, g, array.get(stNet, g) + cash)
    true

f_record(float r, float cash, int dir, int sess, bool trend, bool hv, bool oos) =>
    f_rec(0, r, cash)
    f_rec(dir == 1 ? 1 : 2, r, cash)
    if sess > 0
        f_rec(2 + sess, r, cash)
    f_rec(trend ? 6 : 7, r, cash)
    f_rec(hv ? 8 : 9, r, cash)
    f_rec(oos ? 11 : 10, r, cash)
    true

f_bump(array<int> a, int i) =>
    array.set(a, i, array.get(a, i) + 1)
    true

// ---- Alerts: structured JSON, one message per distinct event, fired once at bar close ----------
f_jnum(float x) => na(x) ? "null" : str.tostring(x, format.mintick)
f_json(string ev, int s, string basis, string id, string msg, float entry, float sl, float t1, float t2, float t3, float q, float riskUsd) =>
    "{\"app\":\"MEKA ALPHA PRO\",\"version\":\"" + VERSION + "\",\"event\":\"" + ev + "\",\"symbol\":\"" + syminfo.tickerid + "\",\"market\":\"" + fam + "\",\"timeframe\":\"" + timeframe.period + "\",\"mode\":\"" + mode + "\",\"logic\":\"" + framework + "\",\"side\":\"" + (s == 1 ? "LONG" : s == -1 ? "SHORT" : "NONE") + "\",\"session\":\"" + sessName + "\",\"entry\":" + f_jnum(entry) + ",\"stop\":" + f_jnum(sl) + ",\"tp1\":" + f_jnum(t1) + ",\"tp2\":" + f_jnum(t2) + ",\"tp3\":" + (use3 ? f_jnum(t3) : "null") + ",\"qty\":" + (na(q) ? "null" : str.tostring(q)) + ",\"risk_usd\":" + (na(riskUsd) ? "null" : str.tostring(riskUsd, "#.##")) + ",\"basis\":\"" + basis + "\",\"trade_id\":\"" + id + "\",\"bar_close_utc\":\"" + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", "UTC") + "\",\"message\":\"" + msg + "\"}"
f_sideWord(int s) => s == 1 ? "LONG" : "SHORT"
// SHARED EXECUTION HELPERS END

// INDICATOR TRADE SIMULATION - assumed fills, no broker. Conservative conventions:
//  - ENTER is decided at a bar close. Market entries fill at the NEXT bar's open.
//  - Limit entries fill only if a later bar trades through the limit by `fillTicks`; a gap
//    through the limit fills at that bar's open. An intrabar limit fill cannot know whether the
//    stop or a target came first, so on that bar only the stop is checked (targets wait).
//  - From the fill onward each bar is judged from its open. If one bar touches both the stop and
//    a target, the stop is assumed first (counted as "ambiguous"). Gaps fill at the open.
//  - Break-even / trailing updates and close-based exits act from the next bar.
//  - Results include the modeled costs (commission, half spread, slippage) from group 4.
var int side = 0
var bool pending = false
var bool isLimit = false
var float refEntry = na
var float fillEntry = na
var float curStop = na
var float initialStop = na
var float riskPlan = na
var float target1 = na
var float target2 = na
var float target3 = na
var float initialQty = na
var float part1 = 0.0
var float part2 = 0.0
var float part3 = 0.0
var float remaining = 0.0
var bool done1 = false
var bool done2 = false
var bool done3 = false
var bool touched1 = false
var bool touched2 = false
var bool touched3 = false
var bool trigSeen = false
var int submittedBar = na
var int filledBar = na
var int lastClosed = na
var string tradeID = ""
var string tradeName = ""
var bool closing = false
var string closingWhy = ""
var float fillRiskRatio = na
var float grossCash = 0.0
var float costCash = 0.0
var float plannedCash = na
var int tradeSess = 0
var bool tradeTrend = false
var bool tradeHV = false
var bool tradeOOS = false
var string lastExitText = ""
var string execBlock = ""
bool entered = false
bool evFill = false
bool tpEvent = false
bool evTP1 = false
bool evTP2 = false
bool evTP3 = false
bool evStopHit = false
bool earlyNow = false
bool exited = false
bool cancelNow = false
string cancelText = ""
string tpText = ""
const string basisWord = "simulated"
f_fillCash(float px, float q) => (px - fillEntry) * side * q * unitUSD

int evSide = side
if barstate.isconfirmed
    // 1) Pending entry -> fill, or cancel when the limit expires unfilled.
    bool fillAtOpen = false
    if pending and bar_index > submittedBar
        bool gapThrough = isLimit and (side == 1 ? open <= refEntry : open >= refEntry)
        bool tradedThrough = isLimit and (side == 1 ? low <= refEntry - fillTicks * syminfo.mintick : high >= refEntry + fillTicks * syminfo.mintick)
        if not isLimit or gapThrough or tradedThrough
            fillAtOpen := not isLimit or gapThrough
            fillEntry := fillAtOpen ? open : refEntry
            filledBar := bar_index
            pending := false
            remaining := initialQty
            grossCash := 0.0
            costCash := f_cost(initialQty, not isLimit)
            fillRiskRatio := (side == 1 ? fillEntry - initialStop : initialStop - fillEntry) / riskPlan
            evFill := true
        else if bar_index - submittedBar >= limitBars
            cancelNow := true
            cancelText := (side == 1 ? "Buy" : "Sell") + " limit at " + f_px(refEntry) + " expired without a fill."
            pending := false
            side := 0
            lastClosed := bar_index
    // 2) Manage a position that exists at (or from inside) this bar.
    if side != 0 and not pending
        bool intrabarFill = evFill and not fillAtOpen
        bool stopHit = side == 1 ? low <= curStop : high >= curStop
        bool hit1 = part1 > 0 and not done1 and (side == 1 ? high >= target1 : low <= target1)
        bool hit2 = part2 > 0 and not done2 and (side == 1 ? high >= target2 : low <= target2)
        bool hit3 = part3 > 0 and not done3 and (side == 1 ? high >= target3 : low <= target3)
        bool lvl1 = side == 1 ? high >= target1 : low <= target1
        bool lvl2 = side == 1 ? high >= target2 : low <= target2
        bool lvl3 = use3 and (side == 1 ? high >= target3 : low <= target3)
        if lvl1 and not touched1
            touched1 := true
            f_bump(tpTouch, 0)
        if lvl2 and not touched2
            touched2 := true
            f_bump(tpTouch, 1)
        if lvl3 and not touched3
            touched3 := true
            f_bump(tpTouch, 2)
        if closing and not evFill
            grossCash += f_fillCash(open, remaining)
            costCash += f_cost(remaining, true)
            lastExitText := closingWhy + " Closed at " + f_px(open) + "."
            remaining := 0.0
            exited := true
        else if stopHit
            float px = side == 1 ? math.min(open, curStop) : math.max(open, curStop)
            if (hit1 or hit2 or hit3) and not intrabarFill
                ambiguousBars += 1
            grossCash += f_fillCash(px, remaining)
            costCash += f_cost(remaining, true)
            lastExitText := "Stop hit at " + f_px(px) + (hit1 or hit2 or hit3 ? " (a target was touched on the same bar; the stop is assumed first)." : ".")
            remaining := 0.0
            exited := true
            evStopHit := true
        else if not intrabarFill
            if hit1
                float p1 = side == 1 ? math.max(open, target1) : math.min(open, target1)
                grossCash += f_fillCash(p1, part1)
                costCash += f_cost(part1, false)
                remaining -= part1
                done1 := true
                evTP1 := true
                f_bump(tpFill, 0)
            if hit2
                float p2 = side == 1 ? math.max(open, target2) : math.min(open, target2)
                grossCash += f_fillCash(p2, part2)
                costCash += f_cost(part2, false)
                remaining -= part2
                done2 := true
                evTP2 := true
                f_bump(tpFill, 1)
            if hit3
                float p3 = side == 1 ? math.max(open, target3) : math.min(open, target3)
                grossCash += f_fillCash(p3, part3)
                costCash += f_cost(part3, false)
                remaining -= part3
                done3 := true
                evTP3 := true
                f_bump(tpFill, 2)
            tpEvent := evTP1 or evTP2 or evTP3
            if remaining <= qtyStep * 1e-6
                remaining := 0.0
                exited := true
                lastExitText := "All targets filled."
        if not exited
            // Close-based management; effective from the next bar.
            trigSeen := trigSeen or touched1
            if beOn and trigSeen
                curStop := side == 1 ? math.max(curStop, f_floorTick(fillEntry)) : math.min(curStop, f_ceilTick(fillEntry))
            if trailMode == "ATR" and trigSeen
                curStop := side == 1 ? math.max(curStop, f_floorTick(close - trailATR * atr)) : math.min(curStop, f_ceilTick(close + trailATR * atr))
            if trailMode == "Swing structure" and trigSeen and not na(side == 1 ? swingLow : swingHigh)
                curStop := side == 1 ? math.max(curStop, f_floorTick(swingLow - stopPad * atr)) : math.min(curStop, f_ceilTick(swingHigh + stopPad * atr))
            string why = evFill and gapMaxRisk > 0 and fillRiskRatio > gapMaxRisk ? "The entry gapped and the real risk is too large." : time_close >= testEnd ? "End of the selected trading dates." : inForceFlat ? "End-of-day flat period." : flattenOutside and not inWindow ? "Session window ended." : exitOnChoch and (side == 1 ? breakDn : breakUp) ? "Market structure broke against the trade." : exitOnBias and htfBias == -side ? "Higher-timeframe bias flipped against the trade." : bar_index - filledBar >= holdBars ? "Maximum holding time reached." : ""
            if why != "" and not closing
                closing := true
                closingWhy := why
                earlyNow := true
        if exited
            float netCash = grossCash - costCash
            float tradeR = netCash / plannedCash
            f_record(tradeR, netCash, side, tradeSess, tradeTrend, tradeHV, tradeOOS)
            dayR += tradeR
            lossStreak := tradeR < 0 ? lossStreak + 1 : 0
            lastExitText := lastExitText + " Result " + (tradeR >= 0 ? "+" : "") + str.tostring(tradeR, "#.##") + "R after modeled costs."
            lastClosed := bar_index
            side := 0
            closing := false
    // 3) Alerts for everything that happened on this bar (one message per event type).
    string base = syminfo.ticker + " " + timeframe.period + "m: "
    if evFill
        alert(f_json("ENTRY_FILLED", evSide, "simulated_fill", tradeID, base + f_sideWord(evSide) + " filled at " + f_px(fillEntry) + " (simulated).", fillEntry, initialStop, target1, target2, target3, initialQty, plannedCash), alert.freq_once_per_bar_close)
    if evTP1
        alert(f_json("TP1_REACHED", evSide, "simulated_fill", tradeID, base + "TP1 reached at " + f_px(target1) + ". Remaining " + str.tostring(remaining) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evTP2
        alert(f_json("TP2_REACHED", evSide, "simulated_fill", tradeID, base + "TP2 reached at " + f_px(target2) + ". Remaining " + str.tostring(remaining) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evTP3
        alert(f_json("TP3_REACHED", evSide, "simulated_fill", tradeID, base + "TP3 reached at " + f_px(target3) + ".", fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if evStopHit
        alert(f_json("STOP_HIT", evSide, "simulated_fill", tradeID, base + lastExitText, fillEntry, curStop, target1, target2, target3, 0, na), alert.freq_once_per_bar_close)
    if earlyNow
        alert(f_json("EARLY_EXIT", evSide, "close_decision", tradeID, base + "Exit at the next open. " + closingWhy, fillEntry, curStop, target1, target2, target3, remaining, na), alert.freq_once_per_bar_close)
    if cancelNow
        alert(f_json("SETUP_CANCELED", evSide, "close_decision", tradeID, base + cancelText, refEntry, initialStop, target1, target2, target3, na, na), alert.freq_once_per_bar_close)
    // 4) New entry. Never on the bar a position closed or an order was canceled.
    execBlock := f_dayBlock()
    bool rested = na(lastClosed) or bar_index - lastClosed > cooldown
    if side == 0 and setupFormed
        alert(f_json("SETUP_FORMING", setupSide, "close_decision", "", base + (setupSide == 1 ? "Bullish" : "Bearish") + " break at " + f_px(brokenLevel) + ". Watching for a pullback.", na, na, na, na, na, na, na), alert.freq_once_per_bar_close)
    if side == 0 and setupCanceled and not cancelNow
        alert(f_json("SETUP_CANCELED", prevSide, "close_decision", "", base + setupEndText, na, na, na, na, na, na, na), alert.freq_once_per_bar_close)
    if signal != 0 and side == 0 and rested and execBlock == ""
        side := signal
        isLimit := useLimit
        refEntry := refPx
        fillEntry := na
        curStop := plannedStop
        initialStop := plannedStop
        riskPlan := plannedRisk
        [t1, t2, t3] = f_targets(signal, refPx, plannedRisk)
        target1 := t1
        target2 := t2
        target3 := t3
        initialQty := plannedQty
        [a, b, c] = f_parts(plannedQty)
        part1 := a
        part2 := b
        part3 := c
        remaining := 0.0
        done1 := false
        done2 := false
        done3 := false
        touched1 := false
        touched2 := false
        touched3 := false
        trigSeen := false
        pending := true
        closing := false
        closingWhy := ""
        fillRiskRatio := na
        grossCash := 0.0
        costCash := 0.0
        plannedCash := plannedQty * plannedRisk * unitUSD
        submittedBar := bar_index
        tradeName := candName
        tradeSess := sessCode
        tradeTrend := trending
        tradeHV := hiVol
        tradeOOS := time >= oosStart
        tradeID := syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time_close)
        dayEntries += 1
        entered := true
        alert(f_json(side == 1 ? "LONG_ENTRY_CONFIRMED" : "SHORT_ENTRY_CONFIRMED", side, isLimit ? "limit_order" : "next_open", tradeID, base + (side == 1 ? "BUY " : "SELL ") + (isLimit ? "limit at " + f_px(refEntry) : "at next open (~" + f_px(refEntry) + ")") + ". Stop " + f_px(curStop) + ", TP1 " + f_px(target1) + ", TP2 " + f_px(target2) + (use3 ? ", TP3 " + f_px(target3) : "") + ". Size " + str.tostring(initialQty) + ".", refEntry, curStop, target1, target2, target3, initialQty, plannedCash), alert.freq_once_per_bar_close)

alertcondition(setupFormed and side == 0, "Setup forming", "MEKA: a setup is forming")
alertcondition(entered and side == 1, "Long entry confirmed", "MEKA: LONG entry confirmed")
alertcondition(entered and side == -1, "Short entry confirmed", "MEKA: SHORT entry confirmed")
alertcondition(evFill, "Pending entry filled", "MEKA: entry filled (simulated)")
alertcondition(evTP1, "TP1 reached", "MEKA: TP1 reached")
alertcondition(evTP2, "TP2 reached", "MEKA: TP2 reached")
alertcondition(evTP3, "TP3 reached", "MEKA: TP3 reached")
alertcondition(evStopHit, "Stop hit", "MEKA: stop hit")
alertcondition(earlyNow, "Early exit", "MEKA: exit at next open")
alertcondition(cancelNow or (setupCanceled and side == 0), "Setup canceled", "MEKA: pending setup canceled")

// SHARED DISPLAY BEGIN
// ---- Status: one instruction per bar. Priority: EXIT > TAKE PROFIT > ENTER > HOLD > NO TRADE >
// WATCH > WAIT. Every event status lasts exactly the bar it happened on.
string sideName = side == 1 ? "long" : "short"
string status = exited or earlyNow ? "EXIT" : tpEvent ? "TAKE PROFIT" : side != 0 and pending ? (side == 1 ? "ENTER LONG" : "ENTER SHORT") : side != 0 ? "HOLD" : noTradeText != "" or execBlock != "" ? "NO TRADE" : setupState != 0 ? (setupSide == 1 ? "WATCH LONG" : "WATCH SHORT") : "WAIT"
string doneWord = basisWord == "simulated" ? "reached (simulated)" : "filled"
f_tpState(float part, bool done, bool touched) => part <= 0 ? "not used for this size" : done ? doneWord : touched ? "touched, not filled" : "open"
string nextTarget = part1 > 0 and not done1 ? "TP1 " + f_px(target1) : part2 > 0 and not done2 ? "TP2 " + f_px(target2) : part3 > 0 and not done3 ? "TP3 " + f_px(target3) : "-"
string tpList = (evTP1 ? "TP1 " : "") + (evTP2 ? "TP2 " : "") + (evTP3 ? "TP3 " : "")
string actionText = exited ? "Position closed. Wait for the next setup." : earlyNow ? "Close the " + sideName + " at the next open." : tpEvent ? "Take profit: " + tpList + doneWord + ". Hold the remaining " + str.tostring(remaining) + " with the stop at " + f_px(curStop) + "." : side != 0 and pending ? (entered ? (isLimit ? "Place a " + (side == 1 ? "buy" : "sell") + " limit at " + f_px(refEntry) + " (valid " + str.tostring(limitBars) + " bars) with stop and targets." : (side == 1 ? "Buy" : "Sell") + " at the next open (about " + f_px(refEntry) + ") with stop and targets.") : (side == 1 ? "Buy" : "Sell") + " limit at " + f_px(refEntry) + " is working (" + str.tostring(math.max(0, limitBars - (bar_index - submittedBar))) + " bars left).") : side != 0 ? (closing ? "Exit requested - closing at the next open." : "Hold the " + sideName + ". Next target " + nextTarget + ".") : status == "NO TRADE" ? "Stand aside." : setupState != 0 ? (setupSide == 1 ? "Get ready to buy." : "Get ready to sell.") : "Do nothing yet."
string reasonText = exited ? lastExitText : earlyNow ? closingWhy : side != 0 ? (evFill ? (side == 1 ? "Long" : "Short") + " filled at " + f_px(fillEntry) + (fillRiskRatio > 1.05 ? " (gap: risk " + str.tostring(fillRiskRatio, "#.#") + "x planned)" : "") + "." : tradeName + " setup. Stop " + f_px(curStop) + (curStop != initialStop ? " (moved from " + f_px(initialStop) + ")" : "") + ".") : cancelNow ? cancelText : execBlock != "" ? execBlock : noTradeText != "" ? noTradeText : setupState != 0 ? watchText : rejectText != "" ? rejectText : setupCanceled ? setupEndText : waitText
string setupLine = side != 0 ? tradeName : setupState == 1 ? "ICC: break confirmed, waiting for pullback" : setupState == 2 ? "ICC: pullback done, waiting for trigger" : framework == "ICC hybrid" ? "No active setup" : framework
string tradeLine = side == 0 ? "Flat" : pending ? "Order working" : (side == 1 ? "Long" : "Short") + " open: " + str.tostring(remaining) + " of " + str.tostring(initialQty) + " units left"

// ---- Palette (dark-chart friendly, restrained) ---------------------------------------------------
color cBg = color.rgb(13, 17, 28)
color cHead = color.rgb(22, 29, 46)
color cTxt = color.rgb(226, 232, 240)
color cMute = color.rgb(148, 163, 184)
color cUp = color.rgb(34, 197, 94)
color cDn = color.rgb(239, 68, 68)
color cAmber = color.rgb(245, 158, 11)
color cBlue = color.rgb(96, 165, 250)
color cGray = color.rgb(100, 116, 139)
color statusColor = str.contains(status, "LONG") and not str.contains(status, "WATCH") ? cUp : str.contains(status, "SHORT") and not str.contains(status, "WATCH") ? cDn : status == "HOLD" ? cBlue : status == "TAKE PROFIT" ? color.rgb(20, 184, 166) : status == "EXIT" ? cAmber : str.contains(status, "WATCH") ? color.rgb(202, 138, 4) : status == "NO TRADE" ? color.rgb(127, 29, 29) : cGray
bool detailed = viewMode == "Detailed"

// ---- Indicator lines (Detailed view only) -------------------------------------------------------
plot(detailed ? emaFast : na, "EMA 20", color=color.new(cBlue, 40))
plot(detailed ? emaSlow : na, "EMA 50", color=color.new(cAmber, 50))
plot(detailed and vwapReq ? vwapVal : na, "VWAP", color=color.new(color.white, 60), style=plot.style_circles)
bool sl = detailed and showSessLv
plot(sl ? sAsia.lastHi : na, "Prior Asia high", color=color.new(cMute, 55), style=plot.style_stepline)
plot(sl ? sAsia.lastLo : na, "Prior Asia low", color=color.new(cMute, 55), style=plot.style_stepline)
plot(sl ? sLondon.lastHi : na, "Prior London high", color=color.new(cBlue, 60), style=plot.style_stepline)
plot(sl ? sLondon.lastLo : na, "Prior London low", color=color.new(cBlue, 60), style=plot.style_stepline)
plot(sl ? sNY.lastHi : na, "Prior New York high", color=color.new(cAmber, 60), style=plot.style_stepline)
plot(sl ? sNY.lastLo : na, "Prior New York low", color=color.new(cAmber, 60), style=plot.style_stepline)
// Data Window outputs for indicator-vs-strategy parity checks.
plot(signal, "Signal (+1 long, -1 short)", display=display.data_window)
plot(candidate, "Candidate before filters", display=display.data_window)
plot(setupState, "ICC stage (0 idle, 1 indicated, 2 corrected)", display=display.data_window)

if barstate.isconfirmed and detailed
    // Structure breaks: line from the swing that was broken to the bar that broke it.
    if breakUp
        line.new(breakUpOrigin, breakUpLevel, bar_index, breakUpLevel, color=color.new(cUp, 30), style=line.style_dotted)
        label.new(math.round((breakUpOrigin + bar_index) / 2), breakUpLevel, chochUp ? "CHoCH" : "BOS", style=label.style_none, textcolor=cUp, size=size.small)
    if breakDn
        line.new(breakDnOrigin, breakDnLevel, bar_index, breakDnLevel, color=color.new(cDn, 30), style=line.style_dotted)
        label.new(math.round((breakDnOrigin + bar_index) / 2), breakDnLevel, chochDn ? "CHoCH" : "BOS", style=label.style_none, textcolor=cDn, size=size.small)
    if sweepLow
        label.new(bar_index, low, "Sweep", style=label.style_label_up, color=color.new(cBg, 100), textcolor=color.new(cUp, 10), size=size.tiny)
    if sweepHigh
        label.new(bar_index, high, "Sweep", style=label.style_label_down, color=color.new(cBg, 100), textcolor=color.new(cDn, 10), size=size.tiny)

// ICC pullback zone (Detailed): drawn from the indication bar while the setup is alive.
var box zoneBox = na
float dLeg = math.abs(impExt - impOrigin)
float dTop = setupSide == 1 ? (useFib ? impExt - fibShallow * dLeg : brokenLevel + retestPad * indATR) : (useFib ? impExt + fibDeep * dLeg : brokenLevel + retestPad * indATR)
float dBot = setupSide == 1 ? (useFib ? impExt - fibDeep * dLeg : brokenLevel - retestPad * indATR) : (useFib ? impExt + fibShallow * dLeg : brokenLevel - retestPad * indATR)
if barstate.isconfirmed and detailed
    if setupFormed
        zoneBox := box.new(indBar, dTop, bar_index + 1, dBot, border_color=color.new(setupSide == 1 ? cUp : cDn, 60), bgcolor=color.new(setupSide == 1 ? cUp : cDn, 88), text="ICC pullback zone", text_color=color.new(cTxt, 40), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
    else if setupState != 0 and not na(zoneBox)
        box.set_right(zoneBox, bar_index + 1)
        if setupState == 1
            box.set_top(zoneBox, dTop)
            box.set_bottom(zoneBox, dBot)
    else if prevState != 0 and setupState == 0 and not na(zoneBox)
        box.set_right(zoneBox, bar_index)
        zoneBox := na

// Opening range of the active session (Detailed).
var box orBox = na
if barstate.isconfirmed and sl and not na(sMain)
    if sMain.startBar == bar_index or na(orBox)
        orBox := box.new(sMain.startBar, sMain.orHi, bar_index, sMain.orLo, border_color=color.new(cMute, 50), bgcolor=color.new(cMute, 92), text="Opening range", text_color=color.new(cMute, 30), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
    else
        box.set_top(orBox, sMain.orHi)
        box.set_bottom(orBox, sMain.orLo)
        box.set_right(orBox, sMain.orDone ? sMain.orEndBar : bar_index)
if barstate.isconfirmed and na(sMain)
    orBox := na

// ---- Trade markers and level lines (both views) --------------------------------------------------
if entered
    label.new(bar_index, side == 1 ? low : high, side == 1 ? "BUY" : "SELL", style=side == 1 ? label.style_label_up : label.style_label_down, color=side == 1 ? cUp : cDn, textcolor=color.white, size=size.normal)
if evFill and isLimit and detailed
    label.new(bar_index, fillEntry, "Filled", style=label.style_label_left, color=color.new(cBg, 100), textcolor=cTxt, size=size.tiny)
if tpEvent and not exited
    label.new(bar_index, evSide == 1 ? high : low, str.trim(tpList), style=evSide == 1 ? label.style_label_down : label.style_label_up, color=color.rgb(20, 184, 166), textcolor=color.white, size=size.small)
if exited or earlyNow
    label.new(bar_index, evSide == 1 ? high : low, evStopHit ? "STOP" : tpEvent ? "TP / EXIT" : "EXIT", style=evSide == 1 ? label.style_label_down : label.style_label_up, color=evStopHit ? cDn : cAmber, textcolor=color.white, size=size.small)

var line lnE = na
var line lnS = na
var line ln1 = na
var line ln2 = na
var line ln3 = na
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lb3 = na
var float drawnStop = na
f_kill(line l) =>
    if not na(l)
        line.delete(l)
    true
f_killL(label l) =>
    if not na(l)
        label.delete(l)
    true
f_tag(label l, float y, string txt, color c) =>
    label lab = l
    if na(y)
        f_killL(lab)
        lab := na
    else if na(lab)
        lab := label.new(bar_index + 3, y, txt, style=label.style_label_left, color=color.new(cBg, 20), textcolor=c, size=size.small)
    else
        label.set_xy(lab, bar_index + 3, y)
        label.set_text(lab, txt)
    lab
if barstate.isconfirmed
    if entered
        if not detailed
            f_kill(lnE)
            f_kill(lnS)
            f_kill(ln1)
            f_kill(ln2)
            f_kill(ln3)
        lnE := line.new(bar_index, refEntry, bar_index + 1, refEntry, color=color.new(cTxt, 30), style=line.style_dashed, width=1)
        lnS := line.new(bar_index, curStop, bar_index + 1, curStop, color=cDn, width=2)
        ln1 := part1 > 0 ? line.new(bar_index, target1, bar_index + 1, target1, color=color.new(cUp, 10), style=line.style_dotted, width=2) : na
        ln2 := line.new(bar_index, target2, bar_index + 1, target2, color=color.new(cUp, 10), style=line.style_dotted, width=2)
        ln3 := use3 and part3 > 0 ? line.new(bar_index, target3, bar_index + 1, target3, color=color.new(cUp, 10), style=line.style_dotted, width=2) : na
        drawnStop := curStop
    else if side != 0
        if curStop != drawnStop
            line.set_x2(lnS, bar_index)
            if not detailed
                f_kill(lnS)
            lnS := line.new(bar_index, curStop, bar_index + 1, curStop, color=cDn, width=2)
            drawnStop := curStop
        for l in array.from(lnE, lnS, ln1, ln2, ln3)
            if not na(l)
                line.set_x2(l, bar_index + 1)
    else if exited or cancelNow
        for l in array.from(lnE, lnS, ln1, ln2, ln3)
            if not na(l)
                line.set_x2(l, bar_index)
                if not detailed
                    line.delete(l)
bool showTags = side != 0
lbE := f_tag(lbE, showTags ? refEntry : na, (pending ? "Entry (order) " : "Entry ") + f_px(pending ? refEntry : fillEntry), cTxt)
lbS := f_tag(lbS, showTags ? curStop : na, "Stop " + f_px(curStop), cDn)
lb1 := f_tag(lb1, showTags and part1 > 0 and not done1 ? target1 : na, "TP1 " + f_px(target1), cUp)
lb2 := f_tag(lb2, showTags and part2 > 0 and not done2 ? target2 : na, "TP2 " + f_px(target2), cUp)
lb3 := f_tag(lb3, showTags and use3 and part3 > 0 and not done3 ? target3 : na, "TP3 " + f_px(target3), cUp)

// ---- Premium dashboard ---------------------------------------------------------------------------
f_wrap(string txt, int w) =>
    string out = ""
    int len = 0
    for wd in str.split(txt, " ")
        int n = str.length(wd)
        if len > 0 and len + 1 + n > w
            out += "\n" + wd
            len := n
        else
            out += (len > 0 ? " " : "") + wd
            len += (len > 0 ? 1 : 0) + n
    out
dashPos = dashPosIn == "Top left" ? position.top_left : dashPosIn == "Bottom right" ? position.bottom_right : dashPosIn == "Bottom left" ? position.bottom_left : position.top_right
tSize = dashSizeIn == "Small" ? size.small : dashSizeIn == "Large" ? size.large : size.normal
tBig = dashSizeIn == "Small" ? size.normal : dashSizeIn == "Large" ? size.huge : size.large
var table dash = table.new(dashPos, 2, 17, bgcolor=cBg, frame_color=cHead, frame_width=1, border_color=cHead, border_width=1)
f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color=cMute, text_size=tSize, text_halign=text.align_left, bgcolor=cBg)
    table.cell(dash, 1, r, v, text_color=vc, text_size=tSize, text_halign=text.align_left, bgcolor=cBg)
    r + 1
if barstate.islast
    table.clear(dash, 0, 0, 1, 16)
    string modeLine = mode + " · confirms on " + f_tfName(tf1) + (useTF2 ? " + " + f_tfName(tf2) : "")
    table.cell(dash, 0, 0, "MEKA ALPHA PRO\n" + fam + " · " + mode, text_color=cTxt, text_size=tSize, text_halign=text.align_left, bgcolor=cHead)
    table.cell(dash, 1, 0, status, text_color=color.white, text_size=tBig, bgcolor=statusColor)
    int r = 1
    r := f_row(r, "Next step", f_wrap(actionText, 42), cTxt)
    r := f_row(r, status == "EXIT" ? "Why" : side != 0 ? "Details" : "Missing", f_wrap(reasonText, 42), status == "NO TRADE" ? color.rgb(252, 165, 165) : cTxt)
    if detailed
        r := f_row(r, "Instrument", syminfo.ticker + " · " + fam + " · " + timeframe.period + "m chart", cTxt)
        r := f_row(r, "Mode", modeLine, cTxt)
        r := f_row(r, "Filters", filterText, cMute)
        r := f_row(r, "Session", sessName + (not na(sMain) ? (sMain.orDone ? " · opening range set" : " · opening range forming") : ""), sessCode > 0 ? cTxt : cMute)
        r := f_row(r, "Market bias", biasText + " (" + biasDetail + ")", htfBias == 1 ? cUp : htfBias == -1 ? cDn : cMute)
        r := f_row(r, "Setup", setupLine, cTxt)
        r := f_row(r, "Trade", tradeLine, side != 0 ? cBlue : cMute)
    if side != 0
        r := f_row(r, pending ? "Entry (order)" : "Entry", f_px(pending ? refEntry : fillEntry), cTxt)
        r := f_row(r, "Stop", f_px(curStop) + (curStop != initialStop ? "  (moved)" : ""), cDn)
        r := f_row(r, "TP1", part1 > 0 ? f_px(target1) + "  · " + f_tpState(part1, done1, touched1) : "skipped (size too small)", cUp)
        r := f_row(r, "TP2", f_px(target2) + "  · " + f_tpState(part2, done2, touched2), cUp)
        if use3
            r := f_row(r, "TP3", f_px(target3) + "  · " + f_tpState(part3, done3, touched3), cUp)
        r := f_row(r, "Risk / size", "$" + str.tostring(plannedCash, "#,###.##") + " · " + str.tostring(initialQty) + " units · " + str.tostring(remaining) + " open", cTxt)
    else
        r := f_row(r, "Risk per trade", "$" + str.tostring(account * riskPct / 100, "#,###.##") + " (" + str.tostring(riskPct) + "% of $" + str.tostring(account, "#,###") + ")", cMute)

// ---- Performance table (complete positions, after modeled costs) --------------------------------
statsPos = statsPosIn == "Bottom right" ? position.bottom_right : statsPosIn == "Top left" ? position.top_left : statsPosIn == "Top right" ? position.top_right : position.bottom_left
var table perf = table.new(statsPos, 9, 15, bgcolor=cBg, frame_color=cHead, frame_width=1, border_color=cHead, border_width=1)
var array<string> grpNames = array.from("All trades", "Long", "Short", "Asia", "London", "New York", "Trending (ADX 25+)", "Ranging", "High volatility", "Normal volatility", "In-sample", "Out-of-sample")
if barstate.islast and showStats
    table.clear(perf, 0, 0, 8, 14)
    table.cell(perf, 0, 0, "Measured performance (" + basisWord + ", after modeled costs)", text_color=cTxt, text_size=size.small, text_halign=text.align_left, bgcolor=cHead)
    table.cell(perf, 1, 0, fam + " · " + mode + " · " + framework + " · " + timeframe.period + "m", text_color=cMute, text_size=size.small, text_halign=text.align_left, bgcolor=cHead)
    array<string> heads = array.from("Group", "Trades", "Win rate", "Avg win", "Avg loss", "Profit factor", "Expectancy", "Max drawdown", "Net USD")
    for c = 0 to 8
        table.cell(perf, c, 1, array.get(heads, c), text_color=cMute, text_size=size.small, bgcolor=cBg)
    for g = 0 to 11
        float n = array.get(stN, g)
        float w = array.get(stW, g)
        float gl = array.get(stGL, g)
        string pf = n == 0 ? "-" : gl == 0 ? (array.get(stGW, g) > 0 ? "no losses" : "-") : str.tostring(array.get(stGW, g) / gl, "#.##")
        table.cell(perf, 0, g + 2, array.get(grpNames, g), text_color=cTxt, text_size=size.small, text_halign=text.align_left, bgcolor=cBg)
        table.cell(perf, 1, g + 2, str.tostring(n, "#"), text_color=n < 30 ? cAmber : cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 2, g + 2, n == 0 ? "-" : str.tostring(w / n * 100, "#.#") + "%", text_color=cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 3, g + 2, w == 0 ? "-" : "+" + str.tostring(array.get(stSW, g) / w, "#.##") + "R", text_color=cUp, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 4, g + 2, n - w == 0 ? "-" : "-" + str.tostring(array.get(stSL, g) / (n - w), "#.##") + "R", text_color=cDn, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 5, g + 2, pf, text_color=cTxt, text_size=size.small, bgcolor=cBg)
        float ex = n == 0 ? na : (array.get(stSW, g) - array.get(stSL, g)) / n
        table.cell(perf, 6, g + 2, na(ex) ? "-" : (ex >= 0 ? "+" : "") + str.tostring(ex, "#.##") + "R", text_color=na(ex) ? cMute : ex >= 0 ? cUp : cDn, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 7, g + 2, n == 0 ? "-" : str.tostring(array.get(stDD, g), "#.##") + "R", text_color=cTxt, text_size=size.small, bgcolor=cBg)
        table.cell(perf, 8, g + 2, n == 0 ? "-" : str.tostring(array.get(stNet, g), "#,###.##"), text_color=array.get(stNet, g) >= 0 ? cUp : cDn, text_size=size.small, bgcolor=cBg)
    table.cell(perf, 0, 14, "Targets touched / " + doneWord + ": TP1 " + str.tostring(array.get(tpTouch, 0)) + "/" + str.tostring(array.get(tpFill, 0)) + " · TP2 " + str.tostring(array.get(tpTouch, 1)) + "/" + str.tostring(array.get(tpFill, 1)) + (use3 ? " · TP3 " + str.tostring(array.get(tpTouch, 2)) + "/" + str.tostring(array.get(tpFill, 2)) : "") + (basisWord == "simulated" ? " · stop-first bars " + str.tostring(ambiguousBars) : "") + " · amber = under 30 trades", text_color=cMute, text_size=size.tiny, text_halign=text.align_left, bgcolor=cBg)
// SHARED DISPLAY END
